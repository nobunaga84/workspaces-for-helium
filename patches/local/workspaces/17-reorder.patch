+std::vector<WorkspaceEntry> MoveWorkspace(std::vector<WorkspaceEntry> entries,
+                                          std::string_view guid,
+                                          int offset) {
+  if (offset == 0) {
+    return entries;
+  }
+
+  int from = -1;
+  for (size_t i = 0; i < entries.size(); ++i) {
+    if (entries[i].guid == guid) {
+      from = static_cast<int>(i);
+      break;
+    }
+  }
+  if (from < 0) {
+    return entries;
+  }
+
+  const int target = from + offset;
+  if (target < 0 || target >= static_cast<int>(entries.size())) {
+    return entries;
+  }
+
+  // Lift it out and put it back, rather than a swap. A swap is only correct
+  // for an offset of one; for anything larger it would jump the entry over the
+  // ones in between and leave those in the wrong order relative to each other.
+  //
+  // `target` is an index into the list BEFORE the erase, and inserting at it
+  // afterwards is still right in both directions: moving later, the erase
+  // shifts everything after `from` down by one, which is exactly the shift the
+  // entry needs to land past them; moving earlier, nothing before `from`
+  // moves at all.
+  WorkspaceEntry moved = std::move(entries[from]);
+  entries.erase(entries.begin() + from);
+  entries.insert(entries.begin() + target, std::move(moved));
+  return entries;
+}
