+void WorkspaceService::MoveWorkspace(std::string_view guid, int offset) {
+  // Guarded here for the same reason CreateWorkspace() is: one of the two
+  // callers is a keyboard command, which can fire while the feature is off and
+  // nothing is on screen to show what it did.
+  if (!IsEnabled()) {
+    return;
+  }
+
+  const std::vector<std::string> before = known_guids_;
+
+  prefs::WriteWorkspaces(prefs_,
+                         prefs::MoveWorkspace(GetWorkspaces(), guid, offset));
+
+  // A refused move -- either end of the list, or a guid naming nothing --
+  // writes the list back unchanged, and JsonPrefStore drops a write whose value
+  // is equal to the stored one, so nothing downstream sees it. The guard here
+  // is not about the pref: it is about the log line, which is how this chunk
+  // gets verified, and "moved" printed for a keypress that did nothing is the
+  // kind of small lie nobody ever debugs (LOCAL.md 19).
+  //
+  // known_guids_ is the comparison because the write above refreshes it
+  // SYNCHRONOUSLY -- PrefChangeRegistrar notifies on the SetDict call, not on a
+  // later task, which is the same fact CreateWorkspace() relies on to switch
+  // into a workspace it has only just added.
+  if (known_guids_ != before) {
+    LOG(INFO) << "[workspaces] moved workspace '" << guid << "' by " << offset;
+  }
+}
