+
+void WorkspacePinnedSectionView::DropRows(const std::vector<std::string>& ids,
+                                          const DropTarget& target) {
+  if (!store_) {
+    return;
+  }
+  if (!target.to.empty()) {
+    // The group keeps its order. Into a folder a row goes in first, so the
+    // last goes first; after a row each goes after the one before it.
+    const bool into = target.where == Where::kInto;
+    const bool after = target.where == Where::kAfter;
+    std::string anchor = target.to;
+    for (size_t k = 0; k < ids.size(); ++k) {
+      const std::string& row = into ? ids[ids.size() - 1 - k] : ids[k];
+      if (store_->Move(row, drawn_guid_, after ? anchor : target.to,
+                       target.where)) {
+        LOG(INFO) << "[workspaces] pins: moved '" << row << "' "
+                  << WhereName(target.where) << " '"
+                  << (after ? anchor : target.to) << "'";
+        if (after) {
+          anchor = row;
+        }
+      }
+    }
+  } else if (target.list_index) {
+    // Each just before the tab the drop was before, so they land in order
+    // however the page tabs they move are placed.
+    TabStripModel* const here = browser_->GetTabStripModel();
+    tabs::TabInterface* const before =
+        *target.list_index < here->count()
+            ? here->GetTabAtIndex(*target.list_index)
+            : nullptr;
+    for (const std::string& id : ids) {
+      UnpinItem(id,
+                ids.size() == 1 ? *target.list_index
+                : before        ? here->GetIndexOfTab(before)
+                                : here->count(),
+                target.list_group, /*select=*/ids.size() == 1);
+    }
+    ClearSelection();
+  } else if (!target.workspace.empty()) {
+    // C4: as the menu's Move to workspace -- last there, its pages with it.
+    for (const std::string& id : ids) {
+      MoveRow(id, target.workspace);
+    }
+    ClearSelection();
+  }
+}
