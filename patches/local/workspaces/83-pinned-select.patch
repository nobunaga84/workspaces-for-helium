+std::vector<std::string> WithoutInside(const PinTree& tree,
+                                       const std::vector<std::string>& ids) {
+  // One walk of the tree, not one per pair: a Shift+click over an open folder
+  // can select a thousand rows.
+  const std::set<std::string_view> wanted(ids.begin(), ids.end());
+  std::set<std::string_view> inside;
+  for (const auto& [guid, roots] : tree) {
+    MarkInside(roots, wanted, false, inside);
+  }
+  std::vector<std::string> kept;
+  for (const std::string& id : ids) {
+    if (!inside.contains(id) && !std::ranges::contains(kept, id)) {
+      kept.push_back(id);
+    }
+  }
+  return kept;
+}
