+void WorkspacePinnedSectionView::OnRowPressed(const std::string& id,
+                                              bool folder,
+                                              bool selectable,
+                                              const ui::Event& event) {
+  const bool control = event.IsControlDown();
+  const bool shift = event.IsShiftDown();
+  // Left and Right open and close a folder (PinRow::OnKeyPressed), whatever
+  // modifier is held, and leave the selection alone.
+  const ui::KeyEvent* const key =
+      event.IsKeyEvent() ? event.AsKeyEvent() : nullptr;
+  const bool arrow = key && (key->key_code() == ui::VKEY_LEFT ||
+                             key->key_code() == ui::VKEY_RIGHT);
+  if (selectable && !arrow && (control || shift)) {
+    if (shift) {
+      // The rows from the first click to this one; Ctrl as well adds them to
+      // what is selected, else they are all that is.
+      const std::vector<std::string> drawn = DrawnIds();
+      if (!std::ranges::contains(drawn, select_anchor_)) {
+        select_anchor_ = id;
+      }
+      if (!control) {
+        selected_.clear();
+      }
+      for (std::string& row :
+           workspaces::pins::SelectRange(drawn, select_anchor_, id)) {
+        selected_.insert(std::move(row));
+      }
+    } else {
+      if (selected_.erase(id) == 0) {
+        selected_.insert(id);
+      }
+      select_anchor_ = id;
+    }
+    ApplySelection();
+    // A mouse press gives a button no focus, and Esc (letting go of the
+    // selection) goes to the row that has it.
+    if (views::View* const row = RowFor(id)) {
+      row->RequestFocus();
+    }
+    LOG(INFO) << "[workspaces] pins: selected " << SelectedInOrder().size()
+              << " row(s)";
+    return;
+  }
+  // Any other press lets go of a selection, then does what it always did.
+  if (!arrow) {
+    ClearSelection();
+  }
+  if (folder) {
+    OnFolderPressed(id);
+  } else {
+    OnItemPressed(id);
+  }
+}
+
+std::vector<std::string> WorkspacePinnedSectionView::DrawnIds() const {
+  std::vector<std::string> ids;
+  if (list_) {
+    for (const views::View* const child : list_->children()) {
+      const auto* const row = views::AsViewClass<PinRow>(child);
+      if (!row->peek()) {
+        ids.push_back(row->id());
+      }
+    }
+  }
+  return ids;
+}
+
+std::vector<std::string> WorkspacePinnedSectionView::SelectedInOrder() const {
+  std::vector<std::string> ids;
+  for (std::string& id : DrawnIds()) {
+    if (selected_.contains(id)) {
+      ids.push_back(std::move(id));
+    }
+  }
+  return store_ ? workspaces::pins::WithoutInside(store_->tree(), ids) : ids;
+}
+
+void WorkspacePinnedSectionView::ApplySelection() {
+  if (!list_) {
+    return;
+  }
+  for (views::View* const child : list_->children()) {
+    auto* const row = views::AsViewClass<PinRow>(child);
+    if (!row->peek()) {
+      row->SetSelected(selected_.contains(row->id()));
+    }
+  }
+}
+
+void WorkspacePinnedSectionView::ClearSelection() {
+  if (selected_.empty() && select_anchor_.empty()) {
+    return;
+  }
+  selected_.clear();
+  select_anchor_.clear();
+  ApplySelection();
+  LOG(INFO) << "[workspaces] pins: selection cleared";
+}
+
+bool WorkspacePinnedSectionView::HasSelection() const {
+  return !selected_.empty();
+}
+
+bool WorkspacePinnedSectionView::ClearSelectionForEscape() {
+  if (selected_.empty()) {
+    return false;
+  }
+  ClearSelection();
+  return true;
+}
