+std::vector<std::string> SelectRange(const std::vector<std::string>& drawn,
+                                     std::string_view anchor,
+                                     std::string_view clicked) {
+  const auto to = std::ranges::find(drawn, clicked);
+  if (to == drawn.end()) {
+    return {};
+  }
+  // No anchor, or one no longer drawn: the click alone.
+  auto from = std::ranges::find(drawn, anchor);
+  if (anchor.empty() || from == drawn.end()) {
+    from = to;
+  }
+  // Top to bottom, whichever of the two was clicked first; both ends in.
+  return std::vector<std::string>(std::min(from, to),
+                                  std::max(from, to) + 1);
+}
+
+namespace {
+
+// Adds to `inside` each row of `rows` -- and below -- that is in `wanted` while
+// an ancestor of it is too.
+void MarkInside(const std::vector<PinNode>& rows,
+                const std::set<std::string_view>& wanted,
+                bool under_wanted,
+                std::set<std::string_view>& inside) {
+  for (const PinNode& row : rows) {
+    const bool is_wanted = wanted.contains(row.id);
+    if (is_wanted && under_wanted) {
+      inside.insert(row.id);
+    }
+    MarkInside(row.children, wanted, under_wanted || is_wanted, inside);
+  }
+}
+
