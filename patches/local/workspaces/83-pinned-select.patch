+void WorkspacePinnedSectionView::ExecuteSelectionCommand(int command_id) {
+  // Taken now: the rows are drawn again as the commands change the store.
+  const std::vector<std::string> ids =
+      std::exchange(context_menu_selection_, {});
+  if (!store_) {
+    return;
+  }
+  if (command_id >= kCommandFirstWorkspace &&
+      command_id <= kCommandLastWorkspace) {
+    const size_t index =
+        static_cast<size_t>(command_id - kCommandFirstWorkspace);
+    if (index < menu_workspace_guids_.size()) {
+      // In the order drawn: each goes last, so they land in that order.
+      for (const std::string& id : ids) {
+        MoveRow(id, menu_workspace_guids_[index]);
+      }
+      LOG(INFO) << "[workspaces] pins: moved " << ids.size()
+                << " selected row(s) to workspace '"
+                << menu_workspace_guids_[index] << "'";
+      ClearSelection();
+    }
+    return;
+  }
+  switch (command_id) {
+    case kCommandClose:
+      for (const std::string& page : ItemIdsOfRows(*store_, ids)) {
+        OnItemClosePressed(page);
+      }
+      LOG(INFO) << "[workspaces] pins: closed the open pages of " << ids.size()
+                << " selected row(s)";
+      break;
+    case kCommandUnpin:
+      // Each goes to the top of Today, so the last first: the top row ends on
+      // top. A folder is not unpinned.
+      for (const std::string& id : std::views::reverse(ids)) {
+        UnpinItem(id, -1, std::nullopt, /*select=*/false);
+      }
+      LOG(INFO) << "[workspaces] pins: unpinned " << ids.size()
+                << " selected row(s)";
+      ClearSelection();
+      break;
+    case kCommandDelete:
+      ShowDeleteSelectionConfirm(ids);
+      break;
+    default:
+      break;
+  }
+}
