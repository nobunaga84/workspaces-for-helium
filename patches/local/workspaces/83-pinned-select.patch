+bool WorkspacePinnedSectionView::BuildSelectionMenu(const std::string& id,
+                                                    bool peek) {
+  context_menu_selection_.clear();
+  if (peek || selected_.empty()) {
+    return false;
+  }
+  // A right-click on a row that is not selected ends the selection, then is an
+  // ordinary one.
+  if (!selected_.contains(id)) {
+    ClearSelection();
+    return false;
+  }
+  std::vector<std::string> ids = SelectedInOrder();
+  if (ids.size() < 2 || !store_) {
+    return false;
+  }
+  const bool any_item = std::ranges::any_of(ids, [this](const std::string& id) {
+    const PinNode* const row = store_->Find(id);
+    return row && row->type != PinNode::Type::kFolder;
+  });
+  const bool any_open = std::ranges::any_of(
+      ItemIdsOfRows(*store_, ids), [this](const std::string& page) {
+        return LinkedTab(browser_->GetTabStripModel(), page) != nullptr;
+      });
+  context_menu_selection_ = std::move(ids);
+  context_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  // What the whole selection can do. Rename, New folder, Colour and a folder's
+  // own actions stay one row's (the owner's D2).
+  if (any_open) {
+    context_menu_model_->AddItemWithStringId(kCommandClose, IDS_APP_CLOSE);
+  }
+  if (any_item) {
+    context_menu_model_->AddItemWithStringId(kCommandUnpin,
+                                             IDS_HELIUM_PINNED_ITEM_UNPIN);
+  }
+  AddMoveToWorkspaceMenu();
+  context_menu_model_->AddItemWithStringId(kCommandDelete,
+                                           IDS_HELIUM_PINNED_ITEM_DELETE);
+  LOG(INFO) << "[workspaces] pins: menu for " << context_menu_selection_.size()
+            << " selected row(s)";
+  return true;
+}
+
+void WorkspacePinnedSectionView::AddMoveToWorkspaceMenu() {
+  // C3: to any other workspace, as a Today tab's menu has it (D2); built like
+  // the Colour submenu, after the menu that points at it.
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (const std::vector<workspaces::prefs::WorkspaceEntry> entries =
+          service ? service->GetWorkspaces()
+                  : std::vector<workspaces::prefs::WorkspaceEntry>();
+      entries.size() > 1) {
+    workspace_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    menu_workspace_guids_.clear();
+    for (const workspaces::prefs::WorkspaceEntry& entry : entries) {
+      const int command = kCommandFirstWorkspace +
+                          static_cast<int>(menu_workspace_guids_.size());
+      if (command > kCommandLastWorkspace) {
+        break;
+      }
+      workspace_menu_model_->AddItem(command,
+                                     WorkspaceRailView::DisplayName(entry));
+      menu_workspace_guids_.push_back(entry.guid);
+    }
+    context_menu_model_->AddSubMenuWithStringId(
+        kCommandMoveToWorkspace, IDS_HELIUM_PINNED_MOVE_TO_WORKSPACE,
+        workspace_menu_model_.get());
+  }
+}
