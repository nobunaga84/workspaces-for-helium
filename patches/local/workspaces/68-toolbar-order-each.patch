+void PinnedToolbarActionsContainer::SetButtonHost(
+    views::View* host,
+    base::RepeatingClosure on_change) {
+  CHECK(host);
+  CHECK(!button_host_);
+  button_host_ = host;
+  on_hosted_change_ = std::move(on_change);
+  host_observer_ = std::make_unique<HostObserver>(*this, host);
+  for (PinnedActionToolbarButton* const button : pinned_buttons_) {
+    MoveButtonTo(button, host);
+  }
+}
+
+PinnedActionToolbarButton* PinnedToolbarActionsContainer::AddButtonTo(
+    std::unique_ptr<PinnedActionToolbarButton> button,
+    views::View* parent) {
+  if (parent == this) {
+    button->ClearProperty(views::kFlexBehaviorKey);
+    button->set_drag_controller(this);
+  } else {
+    // No drag controller in the host: dragging a hosted button is off (6c),
+    // and this box may be freed before it when the toolbar is torn down. Full
+    // opacity: this box's fade-out may have left it at 0; the host never fades.
+    button->set_drag_controller(nullptr);
+    if (button->layer()) {
+      button->layer()->SetOpacity(1.0f);
+    }
+    // In the host's flex layout, a button that does not fit is dropped, as in
+    // this box: the order of ToolbarView's kToolbarActionsFlexOrder.
+    button->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::MinimumFlexSizeRule::kPreferredSnapToZero,
+                                 views::MaximumFlexSizeRule::kPreferred)
+            .WithOrder(1002));
+  }
+  return parent->AddChildView(std::move(button));
+}
+
+void PinnedToolbarActionsContainer::MoveButtonTo(
+    PinnedActionToolbarButton* button,
+    views::View* parent) {
+  if (button->parent() != parent) {
+    AddButtonTo(button->parent()->RemoveChildViewT(button), parent);
+  }
+}
+
+// Wish 6b: a hosted button's removal, posted by RemovePinnedActionButtonFor.
+// Home first, so upstream's RemoveButton -- which removes it from this box --
+// is right for it.
+void PinnedToolbarActionsContainer::RemoveHostedButton(
+    PinnedActionToolbarButton* button) {
+  MoveButtonTo(button, this);
+  RemoveButton(button);
 }
 
