+// The tops and bottoms of the tabs `view` draws, in `container`'s coordinates
+// -- the places a dragged item can go between them. A tab the list hides sits
+// in a zero-height slot (02) and has none.
+void CollectTabEdges(const views::View& view,
+                     const views::View& container,
+                     std::vector<int>& edges) {
+  for (const views::View* const child : view.children()) {
+    if (!child->GetVisible() || child->height() == 0) {
+      continue;
+    }
+    if (!views::IsViewClass<TabView>(child)) {
+      CollectTabEdges(*child, container, edges);
+      continue;
+    }
+    const gfx::Rect bounds =
+        views::View::ConvertRectToTarget(&view, &container, child->bounds());
+    edges.push_back(bounds.y());
+    edges.push_back(bounds.bottom());
+  }
