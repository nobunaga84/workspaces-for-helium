+WorkspacePinnedSectionView::DropTarget::DropTarget() = default;
+WorkspacePinnedSectionView::DropTarget::DropTarget(const DropTarget&) = default;
+WorkspacePinnedSectionView::DropTarget&
+WorkspacePinnedSectionView::DropTarget::operator=(const DropTarget&) = default;
+WorkspacePinnedSectionView::DropTarget::~DropTarget() = default;
+
+void WorkspacePinnedSectionView::OnRowDrag(const std::string& id,
+                                           DragStep step,
+                                           const gfx::Point& point_in_screen) {
+  if (step == DragStep::kMove) {
+    if (drag_id_.empty()) {
+      drag_id_ = id;
+      if (views::ScrollView* const scroll_view = GetScrollView()) {
+        drag_scrolled_subscription_ =
+            scroll_view->AddContentsScrolledCallback(base::BindRepeating(
+                &WorkspacePinnedSectionView::UpdateDrag,
+                base::Unretained(this)));
+      }
+    }
+    drag_point_ = point_in_screen;
+    UpdateDrag();
+    return;
+  }
+  // A drag ended by a rebuild (EndDrag) has nothing left to drop.
+  const DropTarget target = step == DragStep::kDrop && drag_id_ == id
+                                ? TargetAt(point_in_screen)
+                                : DropTarget();
+  EndDrag();
+  if (!target.to.empty()) {
+    if (store_ && store_->Move(id, drawn_guid_, target.to, target.where)) {
+      LOG(INFO) << "[workspaces] pins: moved '" << id << "' "
+                << (target.where == Where::kInto    ? "into"
+                    : target.where == Where::kAfter ? "after"
+                                                    : "before")
+                << " '" << target.to << "'";
+    }
+  } else if (target.list_index) {
+    UnpinItem(id, *target.list_index, target.list_group);
+  }
+}
+
+void WorkspacePinnedSectionView::UpdateDrag() {
+  views::View* const indicator = DropIndicator();
+  if (!indicator || drag_id_.empty()) {
+    return;
+  }
+  // Held near the top or bottom edge, the list scrolls, as for a dragged tab.
+  // Asked again after every scroll step too: that is where it stops at the
+  // end (TabDragScrollHandler stops only when told the position again).
+  if (views::ScrollView* const scroll_view = GetScrollView()) {
+    const int y =
+        views::View::ConvertPointFromScreen(scroll_view, drag_point_).y();
+    const int height = GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+    drag_scroll_.OnDraggedTabPositionUpdated(
+        *scroll_view,
+        gfx::Rect(0, y - height / 2, scroll_view->width(), height));
+  }
+  const DropTarget target = TargetAt(drag_point_);
+  indicator->SetVisible(!target.indicator.IsEmpty());
+  if (target.indicator.IsEmpty()) {
+    return;
+  }
+  indicator->SetBoundsRect(target.indicator);
+  if (target.where == Where::kInto) {
+    indicator->SetBackground(nullptr);
+    indicator->SetBorder(views::CreateRoundedRectBorder(
+        kDropLineThickness, kActiveRowRadius, kDropColor));
+  } else {
+    indicator->SetBorder(nullptr);
+    indicator->SetBackground(views::CreateSolidBackground(kDropColor));
+  }
+}
+
+void WorkspacePinnedSectionView::EndDrag() {
+  if (drag_id_.empty()) {
+    return;
+  }
+  drag_id_.clear();
+  drag_scrolled_subscription_ = {};
+  if (views::ScrollView* const scroll_view = GetScrollView()) {
+    drag_scroll_.StopScrolling(*scroll_view);
+  }
+  if (views::View* const indicator = drop_indicator_.view()) {
+    indicator->SetVisible(false);
+  }
+}
+
+WorkspacePinnedSectionView::DropTarget WorkspacePinnedSectionView::TargetAt(
+    const gfx::Point& point_in_screen) {
+  // Only where the list is on screen: not over the favorites above it, the
+  // rail below it, or the page.
+  views::ScrollView* const scroll_view = GetScrollView();
+  if (drag_id_.empty() || !list_ || !scroll_view ||
+      !scroll_view->GetLocalBounds().Contains(
+          views::View::ConvertPointFromScreen(scroll_view, point_in_screen))) {
+    return DropTarget();
+  }
+  // The section is the top of what scrolls: whatever is not in it is the list.
+  const gfx::Point in_section =
+      views::View::ConvertPointFromScreen(this, point_in_screen);
+  if (in_section.y() < height()) {
+    return RowTargetAt(
+        views::View::ConvertPointToTarget(this, list_, in_section).y());
+  }
+  return ListTargetAt(point_in_screen);
+}
+
+WorkspacePinnedSectionView::DropTarget WorkspacePinnedSectionView::RowTargetAt(
+    int y) {
+  const views::View::Views& rows = list_->children();
+  const auto row_at = [&rows](size_t i) {
+    return views::AsViewClass<PinRow>(rows[i].get());
+  };
+  // The dragged row and, when it is an open folder, the rows drawn inside it:
+  // nowhere there can it go.
+  size_t first = rows.size();
+  for (size_t i = 0; i < rows.size(); ++i) {
+    if (row_at(i)->id() == drag_id_) {
+      first = i;
+      break;
+    }
+  }
+  size_t past = first;
+  if (first < rows.size()) {
+    past = first + 1;
+    while (past < rows.size() &&
+           row_at(past)->level() > row_at(first)->level()) {
+      ++past;
+    }
+  }
+  size_t r = 0;
+  while (r < rows.size() && rows[r]->bounds().bottom() <= y) {
+    ++r;
+  }
+  if (r >= first && r < past) {
+    return DropTarget();
+  }
+
+  // A line at `line_y`, indented to the rows it would sit among.
+  const auto line_at = [this](int line_y, int level) {
+    const int x = kRowInset + level * kIndent;
+    return gfx::Rect(x, line_y - kDropLineThickness / 2,
+                     std::max(0, list_->width() - x - kRowInset),
+                     kDropLineThickness);
+  };
+  // The end of the section is after its last top-level row DRAWN, which may
+  // belong to a deleted workspace: the end of this workspace's own list would
+  // be above such rows (E15d review).
+  const auto to_end = [&]() {
+    DropTarget end;
+    for (size_t i = rows.size(); i-- > 0;) {
+      if (row_at(i)->level() == 0) {
+        end.to = row_at(i)->id();
+        end.where = Where::kAfter;
+        break;
+      }
+    }
+    return end;
+  };
+  DropTarget target;
+  gfx::Rect in_list;
+  if (r == rows.size()) {
+    // Under the last row -- over the line or "+ New Tab": the end.
+    target = to_end();
+    in_list = line_at(list_->height(), 0);
+  } else if (const PinRow* const row = row_at(r); row->folder() &&
+             y - row->y() >= row->height() / 4 &&
+             y - row->y() < row->height() * 3 / 4) {
+    // The middle of a folder: into it, first (Arc's order, Where::kInto).
+    target.to = row->id();
+    target.where = Where::kInto;
+    in_list = row->bounds();
+  } else if (y - row->y() < row->height() / 2) {
+    target.to = row->id();
+    in_list = line_at(row->y(), row->level());
+  } else if (r + 1 < rows.size()) {
+    // The lower half of a row is the top of the next, at the next one's level:
+    // under an open folder's name, that is inside it.
+    const PinRow* const next = row_at(r + 1);
+    target.to = next->id();
+    in_list = line_at(next->y(), next->level());
+  } else {
+    target = to_end();
+    in_list = line_at(row->bounds().bottom(), 0);
+  }
+  // Just before or after itself is where it already is.
+  if (target.to.empty() || target.to == drag_id_) {
+    return DropTarget();
+  }
+  target.indicator = views::View::ConvertRectToTarget(list_, parent(), in_list);
+  return target;
+}
+
+WorkspacePinnedSectionView::DropTarget WorkspacePinnedSectionView::ListTargetAt(
+    const gfx::Point& point_in_screen) {
+  // A folder does not become tabs.
+  const PinNode* const dragged = store_ ? store_->Find(drag_id_) : nullptr;
+  if (!dragged || dragged->type != PinNode::Type::kItem) {
+    return DropTarget();
+  }
+  UnpinnedTabContainerView* container = nullptr;
+  for (views::View* const child : parent()->children()) {
+    if ((container = views::AsViewClass<UnpinnedTabContainerView>(child))) {
+      break;
+    }
+  }
+  if (!container) {
+    return DropTarget();
+  }
+  // Between the two drawn tabs nearest the pointer. The list's own answer
+  // for that place: just below the edge is the top fifth of the tab under
+  // it, a place BEFORE that tab -- or the end, under the last one. It knows
+  // groups, splits and the hidden tabs of other workspaces (02's empty slots,
+  // LOCAL.md 43), which a count of drawn tabs would not.
+  const int y =
+      views::View::ConvertPointFromScreen(container, point_in_screen).y();
+  std::vector<int> edges;
+  CollectTabEdges(*container, *container, edges);
+  const int edge = edges.empty() ? 0
+                                 : *std::ranges::min_element(
+                                       edges, {}, [y](int edge_y) {
+                                         return std::abs(edge_y - y);
+                                       });
+  const std::optional<BrowserRootView::DropIndex> drop =
+      container->GetLinkDropIndex(gfx::Point(container->width() / 2, edge + 1));
+  if (!drop || drop->relative_to_index !=
+                   BrowserRootView::DropIndex::RelativeToIndex::
+                       kInsertBeforeIndex) {
+    return DropTarget();
+  }
+  // In a group when the place is inside it, or at its first tab and meant for
+  // it -- never a group split in two (MoveWebContentsAt and AddRestoredTab
+  // both keep a group whole only when told which).
+  TabStripModel* const model = browser_->GetTabStripModel();
+  std::optional<tab_groups::TabGroupId> group =
+      drop->index < model->count() ? model->GetTabGroupForTab(drop->index)
+                                   : std::nullopt;
+  if (group &&
+      drop->group_inclusion !=
+          BrowserRootView::DropIndex::GroupInclusion::kIncludeInGroup &&
+      (drop->index == 0 ||
+       model->GetTabGroupForTab(drop->index - 1) != group)) {
+    group.reset();
+  }
+  DropTarget target;
+  target.list_index = drop->index;
+  target.list_group = group;
+  target.indicator = views::View::ConvertRectToTarget(
+      container, parent(),
+      gfx::Rect(kRowInset, edge - kDropLineThickness / 2,
+                std::max(0, container->width() - 2 * kRowInset),
+                kDropLineThickness));
+  return target;
+}
+
+views::ScrollView* WorkspacePinnedSectionView::GetScrollView() {
+  return parent() ? views::ScrollView::GetScrollViewForContents(parent())
+                  : nullptr;
+}
+
+views::View* WorkspacePinnedSectionView::DropIndicator() {
+  if (!drop_indicator_.view() && parent()) {
+    auto indicator = std::make_unique<views::View>();
+    // Placed by hand over the rows and the tabs: never laid out, never hit.
+    indicator->SetProperty(views::kViewIgnoredByLayoutKey, true);
+    indicator->SetCanProcessEventsWithinSubtree(false);
+    // A layer of its own, so it is drawn above the tabs, which may paint to
+    // layers of their own. Added once, and kept hidden between drags: each
+    // add under the scroll view walks every tab's layer (E15b).
+    indicator->SetPaintToLayer();
+    indicator->layer()->SetFillsBoundsOpaquely(false);
+    indicator->SetVisible(false);
+    drop_indicator_.SetView(parent()->AddChildView(std::move(indicator)));
+  }
+  return drop_indicator_.view();
+}
