+TEST(ArcImportPlanTest, EachReadProblemHasItsOwnReason) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath file = dir.GetPath().AppendASCII("StorableSidebar.json");
+  EXPECT_EQ(ProblemOf(ReadArcSidebar(base::FilePath())),
+            ArcReadProblem::kNotFound);
+  EXPECT_EQ(ProblemOf(ReadArcSidebar(file)), ArcReadProblem::kNotFound);
+
+  ASSERT_TRUE(base::WriteFile(file, Sidebar("", "")));
+  EXPECT_EQ(ProblemOf(ReadArcSidebar(file)), std::nullopt);
+  {
+    // Another program holds it and lets nobody read it meanwhile.
+    base::File lock(file, base::File::FLAG_OPEN | base::File::FLAG_READ |
+                              base::File::FLAG_WIN_EXCLUSIVE_READ);
+    ASSERT_TRUE(lock.IsValid());
+    EXPECT_EQ(ProblemOf(ReadArcSidebar(file)), ArcReadProblem::kUnreadable);
+  }
+  {
+    // One byte over the cap (the length set, nothing written).
+    base::File big(file, base::File::FLAG_OPEN | base::File::FLAG_WRITE);
+    ASSERT_TRUE(big.SetLength(kMaxSidebarBytes + 1));
+  }
+  EXPECT_EQ(ProblemOf(ReadArcSidebar(file)), ArcReadProblem::kTooBig);
+}
