+ArcReadResult ReadArcSidebar(const base::FilePath& path) {
+  // The size from the folder entry, before the file is opened: an oversize
+  // file is refused unread.
+  const std::optional<int64_t> size =
+      path.empty() ? std::nullopt : base::GetFileSize(path);
+  if (!size) {
+    return base::unexpected(ArcReadProblem::kNotFound);
+  }
+  if (*size > static_cast<int64_t>(kMaxSidebarBytes)) {
+    return base::unexpected(ArcReadProblem::kTooBig);
+  }
+  std::string json;
+  if (!base::ReadFileToStringWithMaxSize(path, &json, kMaxSidebarBytes)) {
+    return base::unexpected(ArcReadProblem::kUnreadable);
+  }
+  return ParseArcSidebarJson(json);
+}
