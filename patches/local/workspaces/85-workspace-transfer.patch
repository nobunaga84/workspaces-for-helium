+#include "chrome/browser/ui/tabs/workspaces/workspace_transfer.h"
+
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "crypto/hash.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace workspaces::transfer {
+namespace {
+
+using archive::ArchiveEntry;
+using pins::PinNode;
+using pins::PinTree;
+
+PinNode Item(std::string id, std::string title, std::string url) {
+  PinNode node;
+  node.type = PinNode::Type::kItem;
+  node.id = std::move(id);
+  node.title = std::move(title);
+  node.url = std::move(url);
+  return node;
+}
+
+PinNode Folder(std::string id,
+               std::string title,
+               std::vector<PinNode> children,
+               bool open = false,
+               int color = -1) {
+  PinNode node;
+  node.type = PinNode::Type::kFolder;
+  node.id = std::move(id);
+  node.title = std::move(title);
+  node.children = std::move(children);
+  node.open = open;
+  node.color = color;
+  return node;
+}
+
+PinNode Split(std::string id, PinNode left, PinNode right) {
+  PinNode node;
+  node.type = PinNode::Type::kSplit;
+  node.id = std::move(id);
+  node.children.push_back(std::move(left));
+  node.children.push_back(std::move(right));
+  return node;
+}
+
+// Two workspaces, the second named with a comma and quotes (the csv's quoting).
+base::DictValue Prefs() {
+  base::DictValue work;
+  work.Set("guid", "w1");
+  work.Set("title", "Work, \"main\"");
+  base::DictValue home;
+  home.Set("guid", "default");
+  base::ListValue items;
+  items.Append(std::move(home));
+  items.Append(std::move(work));
+  base::DictValue list;
+  list.Set("items", std::move(items));
+  base::DictValue prefs;
+  prefs.Set("enabled", true);
+  prefs.Set("tab_row_height", 40);
+  prefs.Set("list", std::move(list));
+  return prefs;
+}
+
+// Home: a page, a folder (open, colour 3) holding a page with its own name;
+// Work: a split; a third workspace the list does not name.
+PinTree Tree() {
+  PinNode alpha = Item("a", "Alpha", "https://a.example/");
+  alpha.last_active = base::Time::FromSecondsSinceUnixEpoch(1'760'000'000);
+  PinNode beta = Item("b", "Beta", "https://b.example/");
+  beta.custom_title = "My, \"Beta\"";
+  PinTree tree;
+  tree["default"] = {alpha, Folder("f", "Docs", {beta}, /*open=*/true, 3)};
+  tree["w1"] = {Split("s", Item("c", "Left", "https://c.example/"),
+                      Item("d", "Right", "https://d.example/"))};
+  tree["orphan"] = {Item("o", "Orphan", "https://o.example/")};
+  return tree;
+}
+
+std::vector<ArchiveEntry> Entries() {
+  ArchiveEntry entry;
+  entry.id = "e1";
+  entry.url = "https://e.example/";
+  entry.title = "Eee";
+  entry.workspace = "w1";
+  entry.reason = ArchiveEntry::Reason::kManual;
+  entry.archived_at = base::Time::FromSecondsSinceUnixEpoch(1'760'000'100);
+  entry.last_active = base::Time::FromSecondsSinceUnixEpoch(1'760'000'000);
+  return {entry};
+}
+
+constexpr char kExportedAt[] = "2026-10-22T00:00:00+0800";
+
+// An export file of `members` (name -> text) with right sizes and checksums:
+// for texts BuildExport() would never write.
+std::string Craft(const std::vector<std::pair<std::string, std::string>>& members,
+                  std::string_view format = kFormat,
+                  int version = kVersion) {
+  base::DictValue files;
+  for (const auto& [name, text] : members) {
+    base::DictValue meta;
+    meta.Set("bytes", static_cast<int>(text.size()));
+    meta.Set("sha256", base::HexEncodeLower(crypto::hash::Sha256(text)));
+    meta.Set("content", text);
+    files.Set(name, std::move(meta));
+  }
+  base::DictValue doc;
+  doc.Set("format", format);
+  doc.Set("version", version);
+  doc.Set("files", std::move(files));
+  return base::WriteJson(doc).value();
+}
+
+const char kPrefsText[] = R"({"helium":{"workspaces":{"list":{"items":[]}}}})";
+
+// `text` with the first `from` inside member `name`'s content turned into `to`,
+// the manifest untouched: a file changed after it was written.
+std::string Tamper(const std::string& text,
+                   std::string_view name,
+                   std::string_view from,
+                   std::string_view to) {
+  std::optional<base::DictValue> doc =
+      base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+  base::DictValue* meta = doc->FindDict("files")->FindDict(name);
+  std::string content = *meta->FindString("content");
+  const size_t at = content.find(from);
+  EXPECT_NE(at, std::string::npos);
+  content.replace(at, from.size(), to);
+  meta->Set("content", content);
+  return base::WriteJson(*doc).value();
+}
+
+TEST(WorkspaceTransferTest, EverythingSurvivesAWriteAndARead) {
+  const PinTree tree = Tree();
+  const std::vector<ArchiveEntry> entries = Entries();
+  const std::string text =
+      BuildExport(Prefs(), &tree, &entries, kExportedAt, "test");
+  ParseResult result = ParseExport(text);
+  ASSERT_TRUE(result.value) << result.error;
+  EXPECT_EQ(result.value->prefs, Prefs());
+  EXPECT_EQ(result.value->pins, tree);
+  EXPECT_EQ(result.value->archive, entries);
+  EXPECT_EQ(result.value->exported_at, kExportedAt);
+  EXPECT_EQ(result.value->source, "test");
+  // 2 workspaces; pages a, b, c, d, o; one folder; one archive entry.
+  EXPECT_EQ(result.value->counts, (Counts{2, 5, 1, 1}));
+}
+
+TEST(WorkspaceTransferTest, OnlyTheSettingsAreRequired) {
+  const std::string text =
+      BuildExport(Prefs(), nullptr, nullptr, kExportedAt, "test");
+  ParseResult result = ParseExport(text);
+  ASSERT_TRUE(result.value) << result.error;
+  EXPECT_FALSE(result.value->pins);
+  EXPECT_FALSE(result.value->archive);
+  EXPECT_EQ(result.value->counts, (Counts{2, 0, 0, 0}));
+
+  const ParseResult none = ParseExport(Craft({{kPinsMember, R"({"version":2,"workspaces":{}})"}}));
+  EXPECT_FALSE(none.value);
+  EXPECT_NE(none.error.find("no workspace settings"), std::string::npos)
+      << none.error;
+}
+
+TEST(WorkspaceTransferTest, AChangedMemberIsRefusedByItsChecksum) {
+  const PinTree tree = Tree();
+  const std::vector<ArchiveEntry> entries = Entries();
+  const std::string text =
+      BuildExport(Prefs(), &tree, &entries, kExportedAt, "test");
+  for (const std::string_view member :
+       {kPrefsMember, kPinsMember, kArchiveMember}) {
+    const std::string from = member == kPrefsMember ? "40" : "https://";
+    const ParseResult result =
+        ParseExport(Tamper(text, member, from, member == kPrefsMember ? "41" : "http://"));
+    EXPECT_FALSE(result.value) << member;
+    EXPECT_NE(result.error.find("SHA-256"), std::string::npos) << result.error;
+  }
+}
+
+TEST(WorkspaceTransferTest, FilesThatAreNotOurExportAreRefused) {
+  EXPECT_FALSE(ParseExport("not json at all").value);
+  EXPECT_FALSE(ParseExport("[1, 2]").value);
+  EXPECT_FALSE(ParseExport(Craft({{kPrefsMember, kPrefsText}}, "something-else")).value);
+  const ParseResult newer = ParseExport(Craft({{kPrefsMember, kPrefsText}}, kFormat, kVersion + 1));
+  EXPECT_FALSE(newer.value);
+  EXPECT_NE(newer.error.find("newer"), std::string::npos) << newer.error;
+  EXPECT_FALSE(ParseExport(Craft({{kPrefsMember, kPrefsText}}, kFormat, 0)).value);
+  EXPECT_FALSE(ParseExport(Craft({{kPrefsMember, kPrefsText}, {"notes.txt", "{}"}})).value);
+  EXPECT_FALSE(ParseExport(Craft({{kPrefsMember, "this is not json"}})).value);
+  // A member without its content.
+  EXPECT_FALSE(ParseExport(R"({"format":"helium-workspaces-export","version":1,)"
+                           R"("files":{"prefs.json":{"bytes":3,"sha256":"x"}}})").value);
+}
+
+TEST(WorkspaceTransferTest, RightChecksumsButAFileTheStoresRefuseIsRefused) {
+  // A pins file from a version this browser does not know.
+  const ParseResult pins = ParseExport(Craft({{kPrefsMember, kPrefsText},
+                                              {kPinsMember, R"({"version":99,"workspaces":{}})"}}));
+  EXPECT_FALSE(pins.value);
+  EXPECT_NE(pins.error.find("pinned pages"), std::string::npos) << pins.error;
+  // An Archive entry with no address.
+  const ParseResult archive = ParseExport(Craft(
+      {{kPrefsMember, kPrefsText},
+       {kArchiveMember, R"({"version":1,"entries":[{"id":"x","url":"","title":"t","workspace":"default","reason":"manual","archived_at":"1","last_active":"0"}]})"}}));
+  EXPECT_FALSE(archive.value);
+  EXPECT_NE(archive.error.find("Archive"), std::string::npos) << archive.error;
+  // Settings that hold no workspaces.
+  EXPECT_FALSE(ParseExport(Craft({{kPrefsMember, R"({"helium":{}})"}})).value);
+}
+
+// Made by local/workspaces-transfer.py, the other writer of this file: 2
+// workspaces, 4 pinned pages (one named "My, \"Beta\""), a folder, a split, an
+// Archive entry; non-ASCII text in the workspace's title.
+constexpr char kFromPython[] = R"json({"format":"helium-workspaces-export","version":1,"exported_at":"2026-10-22T02:00:00+0800","source":"fixture","files":{"prefs.json":{"bytes":258,"sha256":"b00c2bf0f149ebd2af1966e93eec45207e987e4afe5436bb00828218b73b383b","content":"{\n \"helium\": {\n  \"workspaces\": {\n   \"enabled\": true,\n   \"tab_row_height\": 40,\n   \"list\": {\n    \"items\": [\n     {\n      \"guid\": \"default\"\n     },\n     {\n      \"guid\": \"w-work\",\n      \"title\": \"Work, \u201cmain\u201d\",\n      \"icon\": \"\ud83d\udc26\"\n     }\n    ]\n   }\n  }\n }\n}"},"Workspace Pins":{"bytes":678,"sha256":"ee6f6150de5185080e86bef4bdb7fdae4605a098ce0f7f8c2f6e650fa145e163","content":"{\"version\": 2, \"workspaces\": {\"default\": [{\"type\": \"item\", \"id\": \"a\", \"title\": \"Alpha\", \"url\": \"https://a.example/\", \"last_active\": \"13437074330809987\"}, {\"type\": \"folder\", \"id\": \"f\", \"title\": \"Docs\", \"open\": true, \"color\": 3, \"children\": [{\"type\": \"item\", \"id\": \"b\", \"title\": \"Beta\", \"url\": \"https://b.example/\", \"last_active\": \"13437074330809987\", \"custom_title\": \"My, \\\"Beta\\\"\"}]}], \"w-work\": [{\"type\": \"split\", \"id\": \"s\", \"title\": \"\", \"children\": [{\"type\": \"item\", \"id\": \"c\", \"title\": \"Left\", \"url\": \"https://c.example/\", \"last_active\": \"13437074330809987\"}, {\"type\": \"item\", \"id\": \"d\", \"title\": \"Right\", \"url\": \"https://d.example/\", \"last_active\": \"13437074330809987\"}]}]}}"},"Workspace Archive":{"bytes":201,"sha256":"fa59f39290e6325c92781b6ab7a2061a75c0e062f1efe8bb53ce8138ce460788","content":"{\"version\": 1, \"entries\": [{\"id\": \"e1\", \"url\": \"https://e.example/\", \"title\": \"Eee\", \"workspace\": \"w-work\", \"reason\": \"manual\", \"archived_at\": \"13437074330809987\", \"last_active\": \"13437074330809987\"}]}"}},"counts":{"workspaces":2,"pinned_pages":4,"folders":1,"archive_entries":1}})json";
+
+TEST(WorkspaceTransferTest, AFileMadeByThePythonToolIsRead) {
+  const ParseResult result = ParseExport(kFromPython);
