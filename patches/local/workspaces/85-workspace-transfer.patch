+const base::ListValue* ListItemsOf(const base::DictValue& workspace_prefs) {
+  const base::DictValue* list = workspace_prefs.FindDict("list");
+  return list ? list->FindList("items") : nullptr;
+}
+
+std::string ReadableTime(base::Time time) {
+  if (time.is_null()) {
+    return std::string();
+  }
+  base::Time::Exploded e;
+  time.UTCExplode(&e);
+  return base::StringPrintf("%04d-%02d-%02d %02d:%02d", e.year, e.month,
+                            e.day_of_month, e.hour, e.minute);
+}
+
+// RFC 4180: a field with a comma, a quote or a line break is quoted, its
+// quotes doubled.
+void AppendCsvField(std::string& out, std::string_view field_in) {
+  // A spreadsheet runs a cell that starts with = + - @ (or a tab or a
+  // carriage return) as a formula, and a page's title is the web's to choose:
+  // such a cell is made text with a leading quote ("CSV injection").
+  std::string text;
+  if (!field_in.empty() &&
+      std::string_view("=+-@\t\r").find(field_in.front()) !=
+          std::string_view::npos) {
+    text.push_back('\'');
+  }
+  text.append(field_in);
+  const std::string_view field = text;
+  if (field.find_first_of(",\"\r\n") == std::string_view::npos) {
+    out.append(field);
+    return;
+  }
+  out.push_back('"');
+  for (const char c : field) {
+    if (c == '"') {
+      out.push_back('"');
+    }
+    out.push_back(c);
+  }
+  out.push_back('"');
+}
+
+struct CsvRow {
+  std::string workspace;
+  std::string folder;
+  std::string kind;
+  std::string title;
+  std::string url;
+  std::string last_used;
+};
+
+void AppendRows(const std::string& workspace,
+                const std::vector<PinNode>& nodes,
+                std::vector<std::string>& path,
+                std::vector<CsvRow>& rows) {
+  const auto page = [&](const PinNode& item, std::string_view kind) {
+    rows.push_back(CsvRow{workspace, base::JoinString(path, " / "),
+                          std::string(kind),
+                          item.custom_title.empty() ? item.title
+                                                    : item.custom_title,
+                          item.url, ReadableTime(item.last_active)});
+  };
+  for (const PinNode& node : nodes) {
+    switch (node.type) {
+      case PinNode::Type::kFolder:
+        path.push_back(node.title);
+        AppendRows(workspace, node.children, path, rows);
+        path.pop_back();
+        break;
+      case PinNode::Type::kSplit:
+        if (node.children.size() == 2) {
+          page(node.children[0], "split-left");
+          page(node.children[1], "split-right");
+        }
+        break;
+      case PinNode::Type::kItem:
+        page(node, "page");
+        break;
+    }
+  }
+}
+
+}  // namespace
+
+Export::Export() = default;
+Export::Export(Export&&) = default;
+Export& Export::operator=(Export&&) = default;
+Export::~Export() = default;
+
+ParseResult::ParseResult() = default;
+ParseResult::ParseResult(ParseResult&&) = default;
+ParseResult& ParseResult::operator=(ParseResult&&) = default;
+ParseResult::~ParseResult() = default;
+
+Counts CountsOf(const base::DictValue& workspace_prefs,
+                const pins::PinTree* pins,
+                const std::vector<archive::ArchiveEntry>* archive) {
+  Counts counts;
+  if (const base::ListValue* items = ListItemsOf(workspace_prefs)) {
+    counts.workspaces = static_cast<int>(items->size());
+  }
+  if (pins) {
+    for (const auto& [guid, rows] : *pins) {
+      pins::CountRows(rows, counts.pinned_pages, counts.folders);
+    }
+  }
+  if (archive) {
+    counts.archive_entries = static_cast<int>(archive->size());
+  }
+  return counts;
+}
+
+std::string BuildExport(const base::DictValue& workspace_prefs,
+                        const pins::PinTree* pins,
+                        const std::vector<archive::ArchiveEntry>* archive,
+                        std::string_view exported_at,
+                        std::string_view source) {
+  base::DictValue helium;
+  helium.Set("workspaces", workspace_prefs.Clone());
+  base::DictValue wrapper;
+  wrapper.Set("helium", std::move(helium));
+
+  std::vector<std::pair<std::string_view, std::string>> members;
+  members.emplace_back(kPrefsMember, Json(wrapper));
+  if (pins) {
+    members.emplace_back(kPinsMember, Json(pins::PinTreeToValue(*pins)));
+  }
+  if (archive) {
+    members.emplace_back(kArchiveMember,
+                         Json(archive::ArchiveToValue(*archive)));
+  }
+
+  base::DictValue files;
+  for (auto& [name, text] : members) {
+    base::DictValue meta;
+    meta.Set("bytes", static_cast<int>(text.size()));
+    meta.Set("sha256", Sha256Hex(text));
+    meta.Set("content", std::move(text));
+    files.Set(name, std::move(meta));
+  }
+
+  const Counts counts = CountsOf(workspace_prefs, pins, archive);
+  base::DictValue counts_value;
+  counts_value.Set("workspaces", counts.workspaces);
+  counts_value.Set("pinned_pages", counts.pinned_pages);
+  counts_value.Set("folders", counts.folders);
+  counts_value.Set("archive_entries", counts.archive_entries);
+
+  base::DictValue doc;
+  doc.Set("format", kFormat);
+  doc.Set("version", kVersion);
+  doc.Set("exported_at", exported_at);
+  doc.Set("source", source);
+  doc.Set("counts", std::move(counts_value));
+  doc.Set("files", std::move(files));
+  return Json(doc);
+}
+
+ParseResult ParseExport(std::string_view json) {
+  ParseResult result;
+  const auto fail = [&result](std::string error) {
+    result.error = std::move(error);
+    return std::move(result);
+  };
+
+  std::optional<base::DictValue> doc =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!doc) {
+    return fail("The file is not a Helium workspaces export (it is not JSON).");
+  }
+  const std::string* format = doc->FindString("format");
+  if (!format || *format != kFormat) {
+    return fail("The file is not a Helium workspaces export.");
+  }
+  const std::optional<int> version = doc->FindInt("version");
+  if (!version || *version < 1 || *version > kVersion) {
+    return fail(
+        "The file is from a newer version of this export than this browser "
+        "reads.");
+  }
+  const base::DictValue* files = doc->FindDict("files");
+  if (!files) {
+    return fail("The file holds no data.");
+  }
+
+  Export parsed;
+  if (const std::string* at = doc->FindString("exported_at")) {
+    parsed.exported_at = *at;
+  }
+  if (const std::string* source = doc->FindString("source")) {
+    parsed.source = *source;
+  }
+  bool have_prefs = false;
+  for (const auto [name, member] : *files) {
+    if (name != kPrefsMember && name != kPinsMember &&
+        name != kArchiveMember) {
+      return fail("The file holds an item this browser does not know: " +
+                  std::string(name) + ".");
+    }
+    const base::DictValue* meta = member.GetIfDict();
+    const std::string* content = meta ? meta->FindString("content") : nullptr;
+    if (!content) {
+      return fail(std::string(name) + ": the file holds no content for it.");
+    }
+    const std::optional<int> bytes = meta->FindInt("bytes");
+    const std::string* sha256 = meta->FindString("sha256");
+    if (!bytes || !sha256 || *bytes != static_cast<int>(content->size()) ||
+        *sha256 != Sha256Hex(*content)) {
+      return fail(std::string(name) +
+                  ": size or SHA-256 differs from the manifest: the file was "
+                  "changed or damaged.");
+    }
+    std::optional<base::DictValue> value =
+        base::JSONReader::ReadDict(*content, base::JSON_PARSE_RFC);
+    if (!value) {
+      return fail(std::string(name) + " is not JSON.");
+    }
+    if (name == kPrefsMember) {
+      const base::DictValue* prefs = WorkspacePrefsOf(*value);
+      if (!prefs) {
+        return fail("The settings in the file hold no workspaces.");
+      }
+      parsed.prefs = prefs->Clone();
+      have_prefs = true;
+    } else if (name == kPinsMember) {
+      parsed.pins = pins::PinTreeFromValue(*value);
+      if (!parsed.pins) {
+        return fail(
+            "The pinned pages in the file are in a form this browser cannot "
+            "read.");
+      }
+    } else {
+      parsed.archive = archive::ArchiveFromValue(*value);
+      if (!parsed.archive) {
+        return fail(
+            "The Archive in the file is in a form this browser cannot read.");
+      }
+    }
+  }
+  if (!have_prefs) {
+    return fail("The file has no workspace settings.");
+  }
+  parsed.counts = CountsOf(parsed.prefs, parsed.pins ? &*parsed.pins : nullptr,
+                           parsed.archive ? &*parsed.archive : nullptr);
+  result.value = std::move(parsed);
+  return result;
+}
+
+std::string BuildPinsCsv(const base::DictValue& workspace_prefs,
+                         const pins::PinTree& pins) {
+  // guid -> the name the bar shows: the title, else "Home" for the default.
+  std::map<std::string, std::string, std::less<>> names;
+  std::vector<std::string> order;
+  if (const base::ListValue* items = ListItemsOf(workspace_prefs)) {
+    for (const base::Value& item : *items) {
+      const base::DictValue* dict = item.GetIfDict();
+      const std::string* guid = dict ? dict->FindString("guid") : nullptr;
+      if (!guid) {
+        continue;
+      }
+      const std::string* title = dict->FindString("title");
+      names[*guid] = title && !title->empty()
+                         ? *title
+                         : (*guid == "default" ? "Home" : *guid);
+      order.push_back(*guid);
+    }
+  }
+  names.try_emplace("default", "Home");
+  // Workspaces in the list's order that have rows, then any other by guid.
+  std::vector<std::string> guids;
+  for (const std::string& guid : order) {
+    if (pins.contains(guid)) {
+      guids.push_back(guid);
+    }
+  }
+  for (const auto& [guid, rows] : pins) {
+    if (!std::ranges::contains(guids, guid)) {
+      guids.push_back(guid);
+    }
+  }
+
+  std::vector<CsvRow> rows;
+  for (const std::string& guid : guids) {
+    const auto name = names.find(guid);
+    std::vector<std::string> path;
+    AppendRows(name == names.end() ? guid : name->second, pins.at(guid), path,
+               rows);
+  }
+
+  // The byte-order mark, so Excel reads accents and emoji as UTF-8.
+  std::string out = "\xEF\xBB\xBF";
+  out += "workspace,folder,kind,title,url,last_used\r\n";
+  for (const CsvRow& row : rows) {
+    const std::string_view fields[] = {row.workspace, row.folder, row.kind,
+                                       row.title,     row.url,    row.last_used};
+    for (size_t i = 0; i < std::size(fields); ++i) {
+      if (i) {
+        out.push_back(',');
+      }
+      AppendCsvField(out, fields[i]);
+    }
+    out += "\r\n";
+  }
+  return out;
+}
+
