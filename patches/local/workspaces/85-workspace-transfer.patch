+
+TEST(WorkspaceTransferTest, CountsReadTheListThePagesTheFoldersAndTheArchive) {
+  const PinTree tree = Tree();
+  const std::vector<ArchiveEntry> entries = Entries();
+  EXPECT_EQ(CountsOf(Prefs(), &tree, &entries), (Counts{2, 5, 1, 1}));
