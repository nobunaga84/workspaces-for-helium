+TEST(WorkspaceTransferTest, ACsvWithNoPinsIsJustTheHeader) {
+  EXPECT_EQ(BuildPinsCsv(Prefs(), PinTree()),
+            "\xEF\xBB\xBF"
+            "workspace,folder,kind,title,url,last_used\r\n");
+}
