+struct WorkspaceTransferUi::PendingImport {
+  transfer::Export imported;
+  transfer::Counts now;
+};
+
+WorkspaceTransferUi::WorkspaceTransferUi(BrowserWindowInterface* browser)
+    : browser_(browser) {}
+
+WorkspaceTransferUi::~WorkspaceTransferUi() {
+  // A dialog still open must not call back into a destroyed listener.
+  if (dialog_) {
+    dialog_->ListenerDestroyed();
+  }
+}
+
+bool WorkspaceTransferUi::automatic() const {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(kAutoSwitch);
+}
+
+bool WorkspaceTransferUi::StoresReady(std::u16string* reason) const {
+  Profile* const profile = browser_->GetProfile();
+  const PinStore* pins = PinsOf(profile);
+  const ArchiveStore* archive = ArchiveOf(profile);
+  if (!pins->loaded() || !archive->loaded()) {
+    *reason = l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_TRANSFER_LOADING);
+    return false;
+  }
+  if (pins->read_only() || archive->read_only()) {
+    *reason = l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_TRANSFER_READONLY);
+    return false;
+  }
+  return true;
+}
+
+scoped_refptr<ui::SelectFileDialog> WorkspaceTransferUi::MakeDialog() {
+  tabs::TabInterface* const tab = browser_->GetActiveTabInterface();
+  return ui::SelectFileDialog::Create(
+      this, std::make_unique<ChromeSelectFilePolicy>(
+                tab ? tab->GetContents() : nullptr));
+}
+
+void WorkspaceTransferUi::Export(views::View* anchor) {
+  anchor_.SetView(anchor);
+  if (automatic()) {
+    ExportTo(base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+                 kAutoSwitch),
+             /*type_index=*/0);
+    return;
+  }
+  // One dialog at a time: a second press while it is open does nothing.
+  if (dialog_) {
+    return;
+  }
+  mode_ = Mode::kExport;
+  dialog_ = MakeDialog();
+  ui::SelectFileDialog::FileTypeInfo types;
+  types.extensions = {{FILE_PATH_LITERAL("json")}, {FILE_PATH_LITERAL("csv")}};
+  types.extension_description_overrides = {
+      l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_EXPORT_TYPE_JSON),
+      l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_EXPORT_TYPE_CSV)};
+  const std::string day = LocalDay();
+  dialog_->SelectFile(
+      ui::SelectFileDialog::SELECT_SAVEAS_FILE,
+      l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_EXPORT_TITLE),
+      base::FilePath::FromASCII("helium-workspaces-" + day + ".json"), &types,
+      /*file_type_index=*/1, FILE_PATH_LITERAL("json"),
+      browser_->GetWindow()->GetNativeWindow());
+}
+
+void WorkspaceTransferUi::Import(views::View* anchor) {
+  anchor_.SetView(anchor);
+  if (automatic()) {
+    ImportFrom(base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+        kAutoSwitch));
+    return;
+  }
+  if (dialog_) {
+    return;
+  }
+  mode_ = Mode::kImport;
+  dialog_ = MakeDialog();
+  ui::SelectFileDialog::FileTypeInfo types;
+  types.extensions = {{FILE_PATH_LITERAL("json")}};
+  types.extension_description_overrides = {
+      l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_IMPORT_TYPE_JSON)};
+  dialog_->SelectFile(
+      ui::SelectFileDialog::SELECT_OPEN_FILE,
+      l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_IMPORT_TITLE),
+      base::FilePath(), &types, /*file_type_index=*/1,
+      FILE_PATH_LITERAL("json"), browser_->GetWindow()->GetNativeWindow());
+}
+
+void WorkspaceTransferUi::FileSelected(const ui::SelectedFileInfo& file,
+                                       int index) {
+  const Mode mode = std::exchange(mode_, Mode::kNone);
+  dialog_.reset();
+  if (mode == Mode::kExport) {
+    ExportTo(file.path(), index);
+  } else if (mode == Mode::kImport) {
+    ImportFrom(file.path());
+  }
+}
+
+void WorkspaceTransferUi::FileSelectionCanceled() {
+  mode_ = Mode::kNone;
+  dialog_.reset();
+}
+
+void WorkspaceTransferUi::ExportTo(const base::FilePath& path,
+                                   int type_index) {
+  base::FilePath target = path;
+  // A name with no extension takes the one the dialog's list had selected.
+  const bool csv = IsCsv(path) || (path.Extension().empty() && type_index == 2);
+  if (path.Extension().empty()) {
+    target = path.AddExtensionASCII(csv ? "csv" : "json");
+  }
+  transfer::Counts counts;
+  std::optional<std::string> text =
+      BuildFromProfile(browser_->GetProfile(), csv, &counts);
+  if (!text) {
+    LOG(WARNING) << "[workspaces] export: the stores have not loaded yet";
+    ShowMessage(l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_EXPORT_FAILED),
+                l10n_util::GetStringUTF16(
+                    IDS_HELIUM_WORKSPACE_TRANSFER_LOADING));
+    return;
+  }
+  const size_t bytes = text->size();
+  LOG(INFO) << "[workspaces] export: writing " << bytes << " byte(s) as "
+            << (csv ? "csv" : "json") << " to " << target;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&WriteExport, target, std::move(*text)),
+      base::BindOnce(&WorkspaceTransferUi::OnExportWritten,
+                     weak_factory_.GetWeakPtr(), target, csv,
+                     counts.pinned_pages));
+}
+
+void WorkspaceTransferUi::OnExportWritten(const base::FilePath& path,
+                                          bool csv,
+                                          int pages,
+                                          bool ok) {
+  LOG(INFO) << "[workspaces] export: " << (ok ? "wrote " : "could not write ")
+            << path;
+  if (!ok) {
+    ShowMessage(l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_EXPORT_FAILED),
+                l10n_util::GetStringUTF16(
+                    IDS_HELIUM_WORKSPACE_TRANSFER_WRITE_FAILED));
+    return;
+  }
+  ShowMessage(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_EXPORT_DONE),
+      l10n_util::GetStringFUTF16(
+          csv ? IDS_HELIUM_WORKSPACE_EXPORT_DONE_CSV
+              : IDS_HELIUM_WORKSPACE_EXPORT_DONE_BODY,
+          base::FormatNumber(pages), path.LossyDisplayName()));
+}
+
+void WorkspaceTransferUi::ImportFrom(const base::FilePath& path) {
+  LOG(INFO) << "[workspaces] import: reading " << path;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&ReadImport, path),
+      base::BindOnce(&WorkspaceTransferUi::OnImportRead,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void WorkspaceTransferUi::OnImportRead(std::optional<std::string> text) {
+  const auto fail = [this](const std::u16string& reason) {
+    LOG(WARNING) << "[workspaces] import: refused: " << reason;
+    ShowMessage(l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_IMPORT_FAILED),
+                reason);
+  };
+  if (!text) {
+    fail(l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_TRANSFER_READ_FAILED));
+    return;
+  }
+  transfer::ParseResult parsed = transfer::ParseExport(*text);
+  if (!parsed.value) {
+    fail(base::UTF8ToUTF16(parsed.error));
+    return;
+  }
+  std::u16string reason;
+  if (!StoresReady(&reason)) {
+    fail(reason);
+    return;
+  }
+  pending_ = std::make_unique<PendingImport>();
+  pending_->imported = std::move(*parsed.value);
+  Profile* const profile = browser_->GetProfile();
+  pending_->now = transfer::CountsOf(
+      workspaces::prefs::ExportableValues(*profile->GetPrefs()),
+      &PinsOf(profile)->tree(), &ArchiveOf(profile)->entries());
+  LOG(INFO) << "[workspaces] import: the file holds "
+            << pending_->imported.counts.workspaces << " workspace(s), "
+            << pending_->imported.counts.pinned_pages << " pinned page(s), "
+            << pending_->imported.counts.archive_entries
+            << " archive entr(ies)";
+  if (automatic()) {
+    Apply();
+  } else {
+    AskToReplace();
+  }
+}
+
+void WorkspaceTransferUi::AskToReplace() {
+  views::View* const anchor = anchor_.view();
+  if (!anchor || !pending_) {
+    pending_.reset();
+    return;
+  }
+  const transfer::Counts& now = pending_->now;
+  const transfer::Counts& file = pending_->imported.counts;
+  auto model =
+      ui::DialogModel::Builder()
+          .SetTitle(l10n_util::GetStringUTF16(
+              IDS_HELIUM_WORKSPACE_IMPORT_CONFIRM_TITLE))
+          .AddParagraph(ui::DialogModelLabel(l10n_util::GetStringFUTF16(
+              IDS_HELIUM_WORKSPACE_IMPORT_CONFIRM_BODY,
+              {base::FormatNumber(now.workspaces),
+               base::FormatNumber(now.pinned_pages),
+               base::FormatNumber(now.archive_entries),
+               base::FormatNumber(file.workspaces),
+               base::FormatNumber(file.pinned_pages),
+               base::FormatNumber(file.archive_entries)},
+              nullptr)))
+          .AddOkButton(base::BindOnce(&WorkspaceTransferUi::Apply,
+                                      weak_factory_.GetWeakPtr()),
+                       ui::DialogModel::Button::Params().SetLabel(
+                           l10n_util::GetStringUTF16(
+                               IDS_HELIUM_WORKSPACE_IMPORT_REPLACE)))
+          .AddCancelButton(base::BindOnce(
+              [](base::WeakPtr<WorkspaceTransferUi> self) {
+                LOG(INFO) << "[workspaces] import: cancelled";
+                if (self) {
+                  self->pending_.reset();
+                }
+              },
+              weak_factory_.GetWeakPtr()))
+          .Build();
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(model), anchor, views::BubbleBorder::TOP_LEFT);
+  views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET)
+      ->Show();
+}
+
+void WorkspaceTransferUi::Apply() {
+  std::unique_ptr<PendingImport> pending = std::move(pending_);
+  std::u16string reason;
+  if (!pending || !StoresReady(&reason)) {
+    ShowMessage(l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_IMPORT_FAILED),
+                reason);
+    return;
+  }
+  Profile* const profile = browser_->GetProfile();
+  // The profile as it is, kept first: built here, written off the UI thread.
+  if (std::optional<std::string> before =
+          BuildFromProfile(profile, /*csv=*/false, nullptr)) {
+    const std::string stamp = LocalStamp();
+    base::ThreadPool::PostTask(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+        base::BindOnce(&WriteBackup,
+                       profile->GetPath().AppendASCII(kBackupFolder),
+                       "before-import-" + stamp + ".json", std::move(*before)));
+  }
+  // Settings first, so the rail knows the workspaces the rows are kept under;
+  // then the rows and the Archive. Each tells its observers.
+  const workspaces::prefs::ImportedValues settings =
+      workspaces::prefs::ApplyImportedValues(profile->GetPrefs(),
+                                             pending->imported.prefs);
+  const transfer::Counts counts = pending->imported.counts;
+  bool pins_ok = true;
+  bool archive_ok = true;
+  if (pending->imported.pins) {
+    pins_ok = PinsOf(profile)->ReplaceAll(std::move(*pending->imported.pins));
+  }
+  if (pending->imported.archive) {
+    archive_ok =
+        ArchiveOf(profile)->ReplaceAll(std::move(*pending->imported.archive));
+  }
+  LOG(INFO) << "[workspaces] import: applied " << counts.workspaces
+            << " workspace(s), " << counts.pinned_pages << " pinned page(s), "
+            << counts.folders << " folder(s), " << counts.archive_entries
+            << " archive entr(ies); settings: " << settings.set << " set, "
+            << settings.cleared << " cleared, " << settings.skipped
+            << " skipped; pins " << (pins_ok ? "ok" : "REFUSED")
+            << ", archive " << (archive_ok ? "ok" : "REFUSED");
+  if (!pins_ok || !archive_ok) {
+    ShowMessage(l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_IMPORT_FAILED),
+                l10n_util::GetStringUTF16(
+                    IDS_HELIUM_WORKSPACE_TRANSFER_PARTLY));
+    return;
+  }
+  ShowMessage(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_IMPORT_DONE),
+      l10n_util::GetStringFUTF16(IDS_HELIUM_WORKSPACE_IMPORT_DONE_BODY,
+                                 base::FormatNumber(counts.workspaces),
+                                 base::FormatNumber(counts.pinned_pages),
+                                 base::FormatNumber(counts.archive_entries)));
+}
+
+void WorkspaceTransferUi::ShowMessage(const std::u16string& title,
+                                      const std::u16string& body) {
+  views::View* const anchor = anchor_.view();
+  // The hands-free check reads the log; nothing is left open for it.
+  if (!anchor || automatic()) {
+    return;
+  }
+  ui::DialogModel::Builder builder;
+  builder.SetTitle(title);
+  if (!body.empty()) {
+    builder.AddParagraph(ui::DialogModelLabel(body));
+  }
+  builder.AddOkButton(base::DoNothing());
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      builder.Build(), anchor, views::BubbleBorder::TOP_LEFT);
+  views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET)
+      ->Show();
+}
