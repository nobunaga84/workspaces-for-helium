+
+// A page's title is the web's to choose: a cell that starts like a formula is
+// made text, so opening the csv in a spreadsheet runs nothing.
+TEST(WorkspaceTransferTest, TheCsvTurnsFormulaLookingCellsIntoText) {
+  PinTree tree;
+  tree["default"] = {Item("a", "=HYPERLINK(\"http://evil.example\",\"x\")", "https://a.example/"),
+                     Item("b", "+1", "https://b.example/"),
+                     Item("c", "-5 days", "https://c.example/"),
+                     Item("d", "@sum", "https://d.example/"),
+                     Item("e", "fine = fine", "https://e.example/")};
+  const std::string csv = BuildPinsCsv(Prefs(), tree);
+  EXPECT_NE(csv.find(",\"'=HYPERLINK(\"\"http://evil.example\"\",\"\"x\"\")\","), std::string::npos) << csv;
+  EXPECT_NE(csv.find(",'+1,"), std::string::npos) << csv;
+  EXPECT_NE(csv.find(",'-5 days,"), std::string::npos) << csv;
+  EXPECT_NE(csv.find(",'@sum,"), std::string::npos) << csv;
+  // Only a cell that STARTS that way; the rest is left as it is.
+  EXPECT_NE(csv.find(",fine = fine,"), std::string::npos) << csv;
