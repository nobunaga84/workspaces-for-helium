+using workspaces::archive::ArchiveEntry;
+using workspaces::archive::ArchiveStore;
+using workspaces::pins::PinStore;
+using workspaces::pins::PinTree;
+namespace transfer = workspaces::transfer;
+
+constexpr char kAutoSwitch[] = "helium-workspaces-transfer-auto";
+// The most an import file may weigh: a 3,400-page profile is about 2 MB.
+constexpr int64_t kMaxImportBytes = 128 * 1024 * 1024;
+constexpr size_t kKeepBackups = 5;
+constexpr char kBackupFolder[] = "Workspace Backups";
+
+bool IsCsv(const base::FilePath& path) {
+  return path.MatchesExtension(FILE_PATH_LITERAL(".csv"));
+}
+
+// The local date and time as "YYYY-MM-DD" and "YYYYMMDD-HHMMSS" (a file name's).
+std::string LocalDay() {
+  base::Time::Exploded e;
+  base::Time::Now().LocalExplode(&e);
+  return base::StringPrintf("%04d-%02d-%02d", e.year, e.month, e.day_of_month);
+}
+
+std::string LocalStamp() {
+  base::Time::Exploded e;
+  base::Time::Now().LocalExplode(&e);
+  return base::StringPrintf("%04d%02d%02d-%02d%02d%02d", e.year, e.month,
+                            e.day_of_month, e.hour, e.minute, e.second);
+}
+
+std::string ExportedAt() {
+  return base::TimeFormatAsIso8601(base::Time::Now());
+}
+
+// Off the UI thread: the file written whole or not at all.
+bool WriteExport(const base::FilePath& path, std::string text) {
+  return base::ImportantFileWriter::WriteFileAtomically(path, text,
+                                                        "WorkspaceTransfer");
+}
+
+// Off the UI thread: the safety copy, then only the newest kKeepBackups kept.
+void WriteBackup(const base::FilePath& folder,
+                 const std::string& name,
+                 std::string text) {
+  if (!base::CreateDirectory(folder) ||
+      !base::ImportantFileWriter::WriteFileAtomically(folder.AppendASCII(name),
+                                                      text,
+                                                      "WorkspaceTransfer")) {
+    return;
+  }
+  std::vector<base::FilePath> copies;
+  base::FileEnumerator files(folder, /*recursive=*/false,
+                             base::FileEnumerator::FILES,
+                             FILE_PATH_LITERAL("before-import-*.json"));
+  for (base::FilePath f = files.Next(); !f.empty(); f = files.Next()) {
+    copies.push_back(f);
+  }
+  // The names carry their time, so name order is time order.
+  std::ranges::sort(copies);
+  while (copies.size() > kKeepBackups) {
+    base::DeleteFile(copies.front());
+    copies.erase(copies.begin());
+  }
+}
+
+std::optional<std::string> ReadImport(const base::FilePath& path) {
+  std::string text;
+  if (!base::ReadFileToStringWithMaxSize(path, &text, kMaxImportBytes)) {
+    return std::nullopt;
+  }
+  return text;
+}
+
+PinStore* PinsOf(Profile* profile) {
+  return PinStore::GetOrCreate(profile, profile->GetPath());
+}
+
+ArchiveStore* ArchiveOf(Profile* profile) {
+  return ArchiveStore::GetOrCreate(profile, profile->GetPath());
+}
+
+// The profile's workspaces as an export file (or its pinned pages as a csv),
+// from the live preferences and stores. Null, with a reason, when a store has
+// not loaded yet: an export then would be missing rows.
+std::optional<std::string> BuildFromProfile(Profile* profile,
+                                            bool csv,
+                                            transfer::Counts* counts) {
+  const PinStore* pins = PinsOf(profile);
+  const ArchiveStore* archive = ArchiveOf(profile);
+  // A csv holds the pinned pages only: it does not wait for the Archive.
+  if (!pins->loaded() || (!csv && !archive->loaded())) {
+    return std::nullopt;
+  }
+  const base::DictValue prefs =
+      workspaces::prefs::ExportableValues(*profile->GetPrefs());
+  const PinTree& tree = pins->tree();
+  const std::vector<ArchiveEntry>* entries =
+      csv ? nullptr : &archive->entries();
+  if (counts) {
+    *counts = transfer::CountsOf(prefs, &tree, entries);
+  }
+  return csv ? transfer::BuildPinsCsv(prefs, tree)
+             : transfer::BuildExport(prefs, &tree, entries, ExportedAt(),
+                                     "Helium Workspaces");
+}
