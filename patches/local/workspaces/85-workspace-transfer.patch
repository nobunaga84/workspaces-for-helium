+
+ImportedValues ApplyImportedValues(PrefService* prefs,
+                                   const base::DictValue& values) {
+  constexpr std::string_view kPrefix = "helium.workspaces.";
+  // State, not content: an import leaves the profile's own.
+  const auto kept = [](std::string_view key) {
+    return key == "enabled" || key == "arc_imported_at";
+  };
+  const base::DictValue current = ExportableValues(*prefs);
+  ImportedValues result;
+  for (const auto [key, value] : values) {
+    if (kept(key)) {
+      continue;
+    }
+    const std::string path = std::string(kPrefix) + std::string(key);
+    const PrefService::Preference* pref = prefs->FindPreference(path);
+    if (!pref || pref->GetType() != value.type()) {
+      ++result.skipped;
+      continue;
+    }
+    prefs->Set(path, value.Clone());
+    ++result.set;
+  }
+  // The file has no user value: the profile goes back to the default.
+  for (const auto [key, value] : current) {
+    if (!kept(key) && !values.Find(key)) {
+      prefs->ClearPref(std::string(kPrefix) + std::string(key));
+      ++result.cleared;
+    }
+  }
+  return result;
+}
