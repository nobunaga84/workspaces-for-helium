+std::string Sha256Hex(std::string_view data) {
+  return base::HexEncodeLower(crypto::hash::Sha256(data));
+}
+
+std::string Json(const base::DictValue& dict) {
+  return base::WriteJson(dict).value_or(std::string());
+}
+
+const base::DictValue* WorkspacePrefsOf(const base::DictValue& prefs_json) {
+  const base::DictValue* helium = prefs_json.FindDict("helium");
+  return helium ? helium->FindDict("workspaces") : nullptr;
+}
