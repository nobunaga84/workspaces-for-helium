+#ifndef CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_TRANSFER_H_
+#define CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_TRANSFER_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/values.h"
+#include "chrome/browser/ui/tabs/workspaces/workspace_archive.h"
+#include "chrome/browser/ui/tabs/workspaces/workspace_pins.h"
+
+// Export and import of everything that is ours as ONE json file (C19.1, LOCAL.md
+// 103; the first form was local/workspaces-transfer.py's zip, C19): the
+// workspace list and settings (the `helium.workspaces` preferences), every
+// pinned page and folder, and the Archive. The "+" menu's Export / Import
+// workspaces read and write this; local/workspaces-transfer.py reads and
+// writes the very same file, which is how each is tested against the other.
+//
+// //base and //crypto only, no Profile and no view, so all of it is tested in
+// workspaces_unittests (design 3.10). Applying an import to the live stores is
+// not here: ParseExport() only checks and reads.
+//
+// The file:
+//   { "format": "helium-workspaces-export", "version": 1,
+//     "exported_at": "...", "source": "...",
+//     "counts": { "workspaces": N, "pinned_pages": N, "folders": N,
+//                 "archive_entries": N },
+//     "files": { "prefs.json" | "Workspace Pins" | "Workspace Archive":
+//                { "bytes": N, "sha256": "<hex>", "content": "<the member's
+//                  json text>" } } }
+// The checksums are over the exact UTF-8 text of `content`, so neither side
+// needs the other's way of writing json. "prefs.json" is
+// {"helium": {"workspaces": {...}}}; the other two are the store files' own
+// values (PinTreeToValue, ArchiveToValue). A member may be missing except
+// prefs.json.
+namespace workspaces::transfer {
+
+inline constexpr char kFormat[] = "helium-workspaces-export";
+inline constexpr int kVersion = 1;
+
+inline constexpr char kPrefsMember[] = "prefs.json";
+inline constexpr char kPinsMember[] = "Workspace Pins";
+inline constexpr char kArchiveMember[] = "Workspace Archive";
+
+// What a file holds, for the confirmation box and the logs.
+struct Counts {
+  int workspaces = 0;
+  int pinned_pages = 0;
+  int folders = 0;
+  int archive_entries = 0;
+
+  bool operator==(const Counts&) const = default;
+};
+
+// An export file that checked out.
+struct Export {
+  Export();
+  Export(Export&&);
+  Export& operator=(Export&&);
+  ~Export();
+
+  // The `helium.workspaces` subtree.
+  base::DictValue prefs;
+  std::optional<pins::PinTree> pins;
+  std::optional<std::vector<archive::ArchiveEntry>> archive;
+  std::string exported_at;
+  std::string source;
+  Counts counts;
+};
+
+// `workspace_prefs`' workspace list and the two stores' contents, counted: the
+// list's items, the pages and folders of every pinned section (a split is its
+// two pages), the archive's entries. A null store counts as none.
+Counts CountsOf(const base::DictValue& workspace_prefs,
+                const pins::PinTree* pins,
+                const std::vector<archive::ArchiveEntry>* archive);
+
+// The export file's text. `pins` or `archive` null leaves that member out.
+std::string BuildExport(const base::DictValue& workspace_prefs,
+                        const pins::PinTree* pins,
+                        const std::vector<archive::ArchiveEntry>* archive,
+                        std::string_view exported_at,
+                        std::string_view source);
+
+struct ParseResult {
+  ParseResult();
+  ParseResult(ParseResult&&);
+  ParseResult& operator=(ParseResult&&);
+  ~ParseResult();
+
+  // Set when the text is an export this version reads, every checksum held.
+  std::optional<Export> value;
+  // Otherwise, in words for a message box.
+  std::string error;
+};
+
+// Checks and reads an export file's text. Nothing is applied.
+ParseResult ParseExport(std::string_view json);
+
+// The pinned pages as a table a spreadsheet opens (UTF-8 with a byte-order
+// mark, comma separated, quoted as RFC 4180): workspace, folder (the path,
+// " / " between folders), kind (page, split-left, split-right), title (the
+// name the user gave it, else the page's), url, last_used (UTC,
+// "YYYY-MM-DD HH:MM"). Workspaces in the list's order, then any other the pins
+// keep rows for, by guid. EXPORT ONLY: a flat table cannot carry folders'
+// colours and open state, splits, the list or the Archive.
+std::string BuildPinsCsv(const base::DictValue& workspace_prefs,
+                         const pins::PinTree& pins);
+
+}  // namespace workspaces::transfer
+
+#endif  // CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_TRANSFER_H_
