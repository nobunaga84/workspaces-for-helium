+// The "+" menu's Export workspaces... and Import workspaces... (C19.1,
+// LOCAL.md 103): what local/workspaces-transfer.py did (C19), in the browser.
+//
+// Export asks where to save -- a .json with everything, or a .csv list of the
+// pinned pages for a spreadsheet -- and writes it. Import asks which .json,
+// reads and checks it (workspace_transfer.h: every checksum, every version),
+// shows what it would replace -- the counts now and in the file -- and, on
+// "Replace", applies it to the live profile: the settings, the pinned pages
+// and the Archive, every window following. A dated copy of what the profile
+// had is written first, in "Workspace Backups" beside the Preferences file.
+//
+// Everything the user sees is a bubble hung from the view given to Export() /
+// Import() (the "+" button); a result or an error is a short message with OK.
+//
+// Test hook: with --helium-workspaces-transfer-auto=<file> no dialog is shown
+// and nothing is asked or announced: Export writes that file (.json or .csv by
+// its extension), Import reads it and applies it, and the log has the result.
+// It is what the hands-free check drives; a person never needs it.
+class WorkspaceTransferUi : public ui::SelectFileDialog::Listener {
+ public:
+  explicit WorkspaceTransferUi(BrowserWindowInterface* browser);
+  WorkspaceTransferUi(const WorkspaceTransferUi&) = delete;
+  WorkspaceTransferUi& operator=(const WorkspaceTransferUi&) = delete;
+  ~WorkspaceTransferUi() override;
+
+  void Export(views::View* anchor);
+  void Import(views::View* anchor);
+
+  // ui::SelectFileDialog::Listener:
+  void FileSelected(const ui::SelectedFileInfo& file, int index) override;
+  void FileSelectionCanceled() override;
+
+ private:
+  struct PendingImport;
+  enum class Mode { kNone, kExport, kImport };
+
+  // A Save or Open dialog whose file policy is the active tab's.
+  scoped_refptr<ui::SelectFileDialog> MakeDialog();
+  void ExportTo(const base::FilePath& path, int type_index);
+  void OnExportWritten(const base::FilePath& path,
+                       bool csv,
+                       int pages,
+                       bool ok);
+  void ImportFrom(const base::FilePath& path);
+  void OnImportRead(std::optional<std::string> text);
+  void AskToReplace();
+  void Apply();
+  // A short message under the anchor: `title`, then `body` when not empty.
+  void ShowMessage(const std::u16string& title, const std::u16string& body);
+  // Whether the pinned pages and the Archive can be read and replaced now:
