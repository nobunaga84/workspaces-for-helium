+int DaysAgo(base::Time archived_at, base::Time now) {
+  const base::Time day = archived_at.LocalMidnight();
+  const base::Time today = now.LocalMidnight();
+  if (day >= today) {
+    return 0;
+  }
+  // Rounded, not truncated: a span with a clock change in it is an hour short
+  // or long of whole days.
+  return static_cast<int>(std::lround((today - day) / base::Days(1)));
+}
+
+std::u16string SearchTextFor(const ArchiveEntry& entry) {
+  // Newlines, so a query word never matches across two fields: a word holds
+  // no whitespace.
+  return base::i18n::FoldCase(base::UTF8ToUTF16(
+      base::StrCat({entry.custom_title, "\n", entry.title, "\n", entry.url})));
+}
+
+bool MatchesQuery(std::u16string_view search_text, std::u16string_view query) {
+  const std::u16string folded = base::i18n::FoldCase(query);
+  return std::ranges::all_of(
+      base::SplitStringPiece(folded, base::kWhitespaceUTF16,
+                             base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY),
+      [search_text](std::u16string_view word) {
+        return search_text.find(word) != std::u16string_view::npos;
+      });
+}
+
