+// What a row says: the name the user gave the tab, else its title, else its
+// address -- the pinned section's rule (RowText there).
+std::u16string EntryText(const ArchiveEntry& entry) {
+  return base::UTF8ToUTF16(!entry.custom_title.empty() ? entry.custom_title
+                           : !entry.title.empty()      ? entry.title
+                                                       : entry.url);
+}
+
+// "Today", "Yesterday", then the date, over the entries `days` days old.
+std::unique_ptr<views::Label> MakeDayHeader(int days, base::Time time) {
+  auto header = std::make_unique<views::Label>(
+      days == 0   ? l10n_util::GetStringUTF16(IDS_HELIUM_ARCHIVE_TODAY)
+      : days == 1 ? l10n_util::GetStringUTF16(IDS_HELIUM_ARCHIVE_YESTERDAY)
+                  : base::TimeFormatFriendlyDate(time),
+      views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY);
+  header->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  header->SetBorder(views::CreateEmptyBorder(
+      gfx::Insets::TLBR(kSpacing, kRowInset, kSpacing / 2, kRowInset)));
+  header->GetViewAccessibility().SetRole(ax::mojom::Role::kHeading);
+  return header;
+}
