+                             public views::TextfieldController,
+                             public views::ContextMenuController,
+                             public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(WorkspaceArchiveView, views::View)
+
+ public:
+  // Opens the screen for `browser`'s profile and window, anchored to `anchor`
