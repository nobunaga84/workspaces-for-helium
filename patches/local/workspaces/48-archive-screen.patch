+// static
+void WorkspaceArchiveView::Show(BrowserWindowInterface* browser,
+                                views::View* anchor) {
+  const base::ElapsedTimer timer;
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser);
+  if (!service || !service->IsEnabled()) {
+    return;
+  }
+  Profile* const profile = browser->GetProfile();
+  auto view = base::WrapUnique(new WorkspaceArchiveView(
+      browser, workspaces::archive::ArchiveStore::GetOrCreate(
+                   profile, profile->GetPath())));
+  WorkspaceArchiveView* const screen = view.get();
+
+  // No buttons: the rows, Clear all and the close button are the screen's.
+  // The search box takes the focus, so typing filters at once.
+  std::unique_ptr<ui::DialogModel> model =
+      ui::DialogModel::Builder()
+          .SetTitle(l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_ARCHIVE))
+          .AddCustomField(
+              std::make_unique<views::BubbleDialogModelHost::CustomView>(
+                  std::move(view),
+                  views::BubbleDialogModelHost::FieldType::kControl,
+                  screen->search_.get()),
+              kArchiveSearchFieldId)
+          .SetInitiallyFocusedField(kArchiveSearchFieldId)
+          .Build();
+
+  // Anchored to the rail, like its other bubbles.
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(model), anchor, views::BubbleBorder::TOP_LEFT);
+  bubble->set_fixed_width(kWidth);
+  views::Widget* const widget =
+      views::BubbleDialogDelegate::CreateBubbleDeprecated(
+          std::move(bubble),
+          views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET);
+  widget->Show();
+  // Laid out inside the timing, so the number is what the user waited for.
+  widget->LayoutRootViewIfNecessary();
+
+  const auto shown = std::ranges::count_if(
+      screen->rows_, [](const Row& row) { return row.view->GetVisible(); });
+  LOG(INFO) << "[workspaces] archive screen: opened, " << screen->rows_.size()
+            << " entr(ies), " << shown << " shown, in "
+            << timer.Elapsed().InMilliseconds() << " ms";
+}
+
+WorkspaceArchiveView::WorkspaceArchiveView(
+    BrowserWindowInterface* browser,
+    workspaces::archive::ArchiveStore* store)
+    : browser_(browser), store_(store) {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), kSpacing));
+
+  auto* const top = AddChildView(std::make_unique<views::View>());
+  auto* const top_layout =
+      top->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+          kSpacing));
+  top_layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  search_ = top->AddChildView(std::make_unique<views::Textfield>());
+  search_->SetPlaceholderText(
+      l10n_util::GetStringUTF16(IDS_HELIUM_ARCHIVE_SEARCH));
+  search_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_HELIUM_ARCHIVE_SEARCH));
+  search_->set_controller(this);
+  top_layout->SetFlexForView(search_, 1);
+  // Off at every open (the owner, E14d.2). Only each row's text changes on a
+  // toggle, never the rows.
+  all_workspaces_ = top->AddChildView(std::make_unique<views::Checkbox>(
+      l10n_util::GetStringUTF16(IDS_HELIUM_ARCHIVE_ALL_WORKSPACES),
+      base::BindRepeating(
+          [](WorkspaceArchiveView* self) {
+            const base::ElapsedTimer timer;
+            const bool all = self->all_workspaces_->GetChecked();
+            for (const Row& row : self->rows_) {
+              row.view->SetText(all ? row.prefix + row.text : row.text);
+            }
+            const int shown = self->ApplyFilter();
+            // Laid out inside the timing, as a keystroke is: on, every entry
+            // of every workspace can show at once (E14d.2 review).
+            if (views::Widget* const widget = self->GetWidget()) {
+              widget->LayoutRootViewIfNecessary();
+            }
+            LOG(INFO) << "[workspaces] archive screen: all workspaces "
+                      << (all ? "on" : "off") << " -> " << shown
+                      << " shown in " << timer.Elapsed().InMilliseconds()
+                      << " ms";
+          },
+          base::Unretained(this))));
+
+  // Without layers: a label over a layer that is not opaque DCHECKs on
+  // subpixel text (the rail's E9a trap), and scrolling repaints at most
+  // kListMaxHeight of rows, so a layer buys nothing. The bubble's own colour
+  // behind the rows keeps their text on an opaque background.
+  scroll_view_ = AddChildView(std::make_unique<views::ScrollView>(
+      views::ScrollView::ScrollWithLayers::kDisabled));
+  scroll_view_->SetBackgroundColor(ui::kColorBubbleBackground);
+  scroll_view_->SetHorizontalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kDisabled);
+  scroll_view_->ClipHeightTo(0, kListMaxHeight);
+
+  // The footer: "Clear all", or in its place the question. Both built now and
+  // swapped by visibility. A second dialog would take the focus and close
+  // this bubble, so the confirm is inside it.
+  auto* const clear_all_row = AddChildView(std::make_unique<views::View>());
+  clear_all_row->SetLayoutManager(std::make_unique<views::BoxLayout>());
+  clear_all_ =
+      clear_all_row->AddChildView(std::make_unique<views::MdTextButton>(
+          base::BindRepeating(&WorkspaceArchiveView::OnClearAllPressed,
+                              base::Unretained(this)),
+          l10n_util::GetStringUTF16(IDS_HELIUM_ARCHIVE_CLEAR_ALL)));
+
+  confirm_ = AddChildView(std::make_unique<views::View>());
+  confirm_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), kSpacing));
+  confirm_label_ = confirm_->AddChildView(std::make_unique<views::Label>());
+  confirm_label_->SetMultiLine(true);
+  confirm_label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  auto* const confirm_buttons =
+      confirm_->AddChildView(std::make_unique<views::View>());
+  confirm_buttons
+      ->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), kSpacing))
+      ->set_main_axis_alignment(views::BoxLayout::MainAxisAlignment::kEnd);
+  confirm_buttons
+      ->AddChildView(std::make_unique<views::MdTextButton>(
+          base::BindRepeating(&WorkspaceArchiveView::OnClearAllConfirmed,
+                              base::Unretained(this)),
+          l10n_util::GetStringUTF16(IDS_HELIUM_ARCHIVE_CLEAR_ALL_OK)))
+      ->SetStyle(ui::ButtonStyle::kProminent);
+  cancel_ = confirm_buttons->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&WorkspaceArchiveView::OnClearAllCancelled,
+                          base::Unretained(this)),
+      l10n_util::GetStringUTF16(IDS_APP_CANCEL)));
+  confirm_->SetVisible(false);
+
+  // Unretained: the subscription is a member, so it ends with this view.
+  store_changed_subscription_ = store_->RegisterChangedCallback(
+      base::BindRepeating(&WorkspaceArchiveView::OnArchiveChanged,
+                          base::Unretained(this)));
+  Rebuild();
+}
