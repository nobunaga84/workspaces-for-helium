+struct WorkspaceArchiveView::Row {
+  raw_ptr<views::LabelButton> view;
+  // The day header it is drawn under; the rows of one header are adjacent.
+  raw_ptr<views::View> header;
+  std::string id;
+  // The workspace it shows in: ResolveTabGuid, so a deleted workspace's
+  // entries are Home's (design 2.4).
+  std::string guid;
+  // SearchTextFor(), made once here rather than once per keystroke.
+  std::u16string search_text;
+  // Its text, and what "All workspaces" puts before it: the workspace's rail
+  // mark and two spaces.
+  std::u16string text;
+  std::u16string prefix;
+};
