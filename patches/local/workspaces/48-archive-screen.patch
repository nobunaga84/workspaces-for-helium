+void WorkspaceService::EnterWorkspaceForInsert(std::string_view guid) {
+  // Resolved as SetActiveWorkspace() resolves it: a guid that lands on this
+  // workspace is no switch, so the tab the user is on is not one being left.
+  if (!IsEnabled() ||
+      std::string_view(active_guid_) == ResolveTabGuid(guid, known_guids_)) {
+    return;
+  }
+  // SwitchToWorkspace()'s bookkeeping without its activation: coming back by
+  // the rail lands on the tab the restore took the user away from (E14d.2
+  // review). A read of the model, not a mutation (design 2.2).
+  if (tabs::TabInterface* active = tab_strip_->GetActiveTab()) {
+    last_active_[active_guid_] = active->GetHandle();
+  }
+  SetActiveWorkspace(guid);
+}
