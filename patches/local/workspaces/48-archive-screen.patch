+
+// Takes the Recently Closed tab of the restored entry `id` away too, or
+// Ctrl+Shift+T opens the page a second time: E14d.1 takes a reopened close
+// out of the archive, this is the other direction (E14d.2 review). The close
+// left both with the same id (kArchiveIdExtraDataKey, 47). Nothing off the
+// record, which has no Recently Closed.
+//
+// Through DeleteNavigationEntries, the door history deletion uses, matched by
+// the ADDRESS of that tab's current navigation, so exactly one tab goes -- one
+// closed on its own, or one inside a closed window, group or split, whose other
+// tabs stay (DeleteFromTab, tab_restore_service_helper.cc). RemoveEntryById
+// could take only a whole top-level entry, and it never rewrites the saved
+// file, so the close came back at the next start (E14d.2 fix check).
+// ponytail: a split's tab inside a closed WINDOW or GROUP is kept: removing it
+// leaves that entry's split record naming a tab it no longer has, and a
+// reopened split has CHECK-crashed before (LOCAL.md 42). Take it out with its
+// split record if the owner meets it.
+void RemoveRecentlyClosedTab(Profile* profile, const std::string& id) {
+  sessions::TabRestoreService* const service =
+      TabRestoreServiceFactory::GetForProfile(profile);
+  if (!service) {
+    return;
+  }
+  using sessions::tab_restore::Tab;
+  using sessions::tab_restore::Type;
+  const Tab* found = nullptr;
+  bool nested_split = false;
+  for (const std::unique_ptr<sessions::tab_restore::Entry>& entry :
+       service->entries()) {
+    std::vector<const Tab*> tabs;
+    // A window, a group and a split each hold their tabs as `tabs`.
+    const auto add_tabs = [&tabs](const auto& holder) {
+      for (const std::unique_ptr<Tab>& tab : holder.tabs) {
+        tabs.push_back(tab.get());
+      }
+    };
+    switch (entry->type) {
+      case Type::TAB:
+        tabs.push_back(static_cast<const Tab*>(entry.get()));
+        break;
+      case Type::WINDOW:
+        add_tabs(static_cast<const sessions::tab_restore::Window&>(*entry));
+        break;
+      case Type::GROUP:
+        add_tabs(static_cast<const sessions::tab_restore::Group&>(*entry));
+        break;
+      case Type::SPLIT:
+        add_tabs(static_cast<const sessions::tab_restore::Split&>(*entry));
+        break;
+    }
+    for (const Tab* const tab : tabs) {
+      const auto value =
+          tab->extra_data.find(workspaces::kArchiveIdExtraDataKey);
+      if (value != tab->extra_data.end() && value->second == id) {
+        found = tab;
+        nested_split = entry->type != Type::SPLIT && tab->split_id.has_value();
+        break;
+      }
+    }
+    if (found) {
+      break;
+    }
+  }
+  if (!found || nested_split || found->current_navigation_index < 0 ||
+      static_cast<size_t>(found->current_navigation_index) >=
+          found->navigations.size()) {
+    LOG(INFO)
+        << "[workspaces] archive: no Recently Closed tab of its own to remove";
+    return;
+  }
+  // DeleteFromTab drops a tab whose CURRENT navigation the predicate takes;
+  // it hands each navigation by reference, in place, so its address names this
+  // one tab and no other with the same page.
+  const sessions::SerializedNavigationEntry* const current =
+      &found->navigations[found->current_navigation_index];
+  service->DeleteNavigationEntries(base::BindRepeating(
+      [](const sessions::SerializedNavigationEntry* current,
+         const sessions::SerializedNavigationEntry& navigation) {
+        return &navigation == current;
+      },
+      base::Unretained(current)));
+  LOG(INFO) << "[workspaces] archive: its Recently Closed entry left too";
+}
