+// An icon, when one has been set, replaces the first-character label outright.
+std::u16string WorkspaceRailView::ButtonText(
+    const workspaces::prefs::WorkspaceEntry& entry,
+    size_t index) {
+  return entry.icon.empty() ? LabelForWorkspace(DisplayName(entry), index)
+                            : base::UTF8ToUTF16(entry.icon);
+}
