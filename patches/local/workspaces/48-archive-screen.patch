+// One entry: its page's icon -- a globe until one is found -- and its name.
+// PinRow (workspace_pinned_section_view.cc) without folders, drag or buttons.
+class ArchiveRow : public views::LabelButton {
+  METADATA_HEADER(ArchiveRow, views::LabelButton)
+
+ public:
+  ArchiveRow(const std::u16string& text,
+             const std::u16string& tooltip,
+             const GURL& url,
+             Profile* profile,
+             views::Button::PressedCallback callback)
+      : views::LabelButton(std::move(callback), text),
+        url_(url),
+        profile_(profile) {
+    SetTooltipText(tooltip);
+    SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(0, kRowInset)));
+    SetMinSize(
+        gfx::Size(0, GetLayoutConstant(LayoutConstant::kVerticalTabHeight)));
+    // The ink drop draws the row on a layer that is not opaque, and subpixel
+    // text on one DCHECKs (the rail's E9a trap; PinRow does the same).
+    SetTextSubpixelRenderingEnabled(false);
+    // The ring drawn inside: the rows sit in a clipping scroll view (E13).
+    views::FocusRing::Get(this)->SetOutsetFocusRingDisabled(true);
+    ConfigureInkDrop(this);
+    SetImageModel(views::Button::STATE_NORMAL,
+                  ui::ImageModel::FromVectorIcon(vector_icons::kGlobeIcon,
+                                                 ui::kColorIcon,
+                                                 gfx::kFaviconSize));
+  }
+  ArchiveRow(const ArchiveRow&) = delete;
+  ArchiveRow& operator=(const ArchiveRow&) = delete;
+  ~ArchiveRow() override = default;
+
+ protected:
+  // views::Button:
+  //
+  // The icon is asked for at the row's first paint, not when it is built:
+  // every entry is built (1,750 in Arc's archive, design 5) and only those
+  // scrolled to are drawn -- the pinned section's "only a drawn row asks".
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    views::LabelButton::PaintButtonContents(canvas);
+    if (std::exchange(favicon_asked_, true)) {
+      return;
+    }
+    // With fallback_to_host: another page of the same site often has one
+    // (LOCAL.md 43).
+    if (favicon::FaviconService* const favicons =
+            FaviconServiceFactory::GetForProfile(
+                profile_, ServiceAccessType::EXPLICIT_ACCESS)) {
+      favicons->GetRawFaviconForPageURL(
+          url_, {favicon_base::IconType::kFavicon}, gfx::kFaviconSize * 2,
+          /*fallback_to_host=*/true,
+          // Unretained: `favicon_tasks_` is a member, so a row destroyed first
+          // cancels its own request.
+          base::BindOnce(&ArchiveRow::OnFavicon, base::Unretained(this)),
+          &favicon_tasks_);
+    }
+  }
+
+ private:
+  // Asked for at twice the icon size, so it is crisp at 200 %.
+  void OnFavicon(const favicon_base::FaviconRawBitmapResult& result) {
+    if (!result.is_valid()) {
+      return;
+    }
+    const SkBitmap bitmap = gfx::PNGCodec::Decode(
+        base::span<const uint8_t>(*result.bitmap_data));
+    if (bitmap.isNull()) {
+      return;
+    }
+    SetImageModel(
+        views::Button::STATE_NORMAL,
+        ui::ImageModel::FromImageSkia(gfx::ImageSkia::CreateFromBitmap(
+            bitmap, static_cast<float>(bitmap.width()) / gfx::kFaviconSize)));
+  }
+
+  const GURL url_;
+  const raw_ptr<Profile> profile_;
+  bool favicon_asked_ = false;
+  base::CancelableTaskTracker favicon_tasks_;
+};
