+void WorkspaceArchiveView::ContentsChanged(views::Textfield* sender,
+                                           const std::u16string& new_contents) {
+  const base::ElapsedTimer timer;
+  const int shown = ApplyFilter();
+  // Laid out inside the timing: the layout is most of a keystroke's cost.
+  if (views::Widget* const widget = GetWidget()) {
+    widget->LayoutRootViewIfNecessary();
+  }
+  LOG(INFO) << "[workspaces] archive screen: filter of " << new_contents.size()
+            << " char(s) -> " << shown << " shown in "
+            << timer.Elapsed().InMilliseconds() << " ms";
+}
+
+void WorkspaceArchiveView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  context_menu_id_.clear();
+  for (const Row& row : rows_) {
+    if (row.view.get() == source) {
+      context_menu_id_ = row.id;
+      break;
+    }
+  }
+  if (context_menu_id_.empty()) {
+    return;
+  }
+  context_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  context_menu_model_->AddItemWithStringId(kCommandRestore,
+                                           IDS_HELIUM_ARCHIVE_RESTORE);
+  context_menu_model_->AddItemWithStringId(kCommandDelete,
+                                           IDS_HELIUM_ARCHIVE_DELETE);
+  context_menu_runner_ = std::make_unique<views::MenuRunner>(
+      context_menu_model_.get(),
+      views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+  context_menu_runner_->RunMenuAt(
+      source->GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+      views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+void WorkspaceArchiveView::ExecuteCommand(int command_id, int event_flags) {
+  // By id, not by row: a rebuild can replace the rows while the menu is open,
+  // and an id the store no longer has does nothing.
+  if (command_id == kCommandRestore) {
+    RestoreEntry(context_menu_id_);
+  } else if (command_id == kCommandDelete) {
+    DeleteEntry(context_menu_id_);
+  }
+}
+
+void WorkspaceArchiveView::Rebuild() {
+  const base::ElapsedTimer timer;
+  rebuild_posted_ = false;
+  const bool first = !scroll_view_->contents();
+  if (const views::Widget* const widget = GetWidget();
+      widget && widget->IsClosed()) {
+    // A restore closes the screen right after its Remove() posted this.
+    return;
+  }
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service) {
+    return;
+  }
+
+  // A row with the keyboard focus -- Delete on its menu -- hands it to the row
+  // now in its place, so the keyboard stays in the list.
+  std::optional<size_t> focused;
+  if (const views::FocusManager* const focus_manager = GetFocusManager()) {
+    const views::View* const view = focus_manager->GetFocusedView();
+    for (size_t i = 0; view && i < rows_.size(); ++i) {
+      if (rows_[i].view.get() == view) {
+        focused = i;
+        break;
+      }
+    }
+  }
+  const int offset_y = scroll_view_->GetVisibleRect().y();
+
+  // Each workspace's rail mark and name, by guid.
+  std::map<std::string, std::pair<std::u16string, std::u16string>> marks;
+  const std::vector<workspaces::prefs::WorkspaceEntry> workspace_list =
+      service->GetWorkspaces();
+  for (size_t i = 0; i < workspace_list.size(); ++i) {
+    marks[workspace_list[i].guid] = {
+        WorkspaceRailView::ButtonText(workspace_list[i], i),
+        WorkspaceRailView::DisplayName(workspace_list[i])};
+  }
+
+  // Newest first. The store keeps them in the order they were kept, which a
+  // load's merge can leave out of time order.
+  std::vector<const ArchiveEntry*> sorted;
+  sorted.reserve(store_->entries().size());
+  for (const ArchiveEntry& entry : store_->entries()) {
+    sorted.push_back(&entry);
+  }
+  std::ranges::stable_sort(
+      sorted, [](const ArchiveEntry* a, const ArchiveEntry* b) {
+        return a->archived_at > b->archived_at;
+      });
+
+  // Every row built off the widget and attached with ONE SetContents (E15b:
+  // an add under a widget walks the subtree each time). `rows_` and `empty_`
+  // let go first: they point into the contents this replaces.
+  rows_.clear();
+  auto contents = std::make_unique<views::View>();
+  contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+  // The empty-list line is the list's first child, so showing it never changes
+  // the list's height (ApplyFilter's grow-only rule).
+  empty_ = contents->AddChildView(std::make_unique<views::Label>(
+      std::u16string(), views::style::CONTEXT_LABEL,
+      views::style::STYLE_SECONDARY));
+  empty_->SetBorder(
+      views::CreateEmptyBorder(gfx::Insets::VH(kSpacing, kRowInset)));
+  const base::Time now = base::Time::Now();
+  const bool all = all_workspaces_->GetChecked();
+  Profile* const profile = browser_->GetProfile();
+  views::View* header = nullptr;
+  int header_days = 0;
+  for (const ArchiveEntry* const entry : sorted) {
+    const int days = workspaces::archive::DaysAgo(entry->archived_at, now);
+    if (!header || days != header_days) {
+      header = contents->AddChildView(MakeDayHeader(days, entry->archived_at));
+      header_days = days;
+    }
+    Row& row = rows_.emplace_back();
+    row.header = header;
+    row.id = entry->id;
+    row.guid = std::string(
+        workspaces::ResolveTabGuid(entry->workspace, service->known_guids()));
+    row.search_text = workspaces::archive::SearchTextFor(*entry);
+    row.text = EntryText(*entry);
+    const auto mark = marks.find(row.guid);
+    std::u16string workspace_name = base::UTF8ToUTF16(row.guid);
+    if (mark != marks.end()) {
+      row.prefix = mark->second.first + u"  ";
+      workspace_name = mark->second.second;
+    }
+    auto view = std::make_unique<ArchiveRow>(
+        all ? row.prefix + row.text : row.text,
+        base::StrCat({row.text, u"\n", base::UTF8ToUTF16(entry->url), u"\n",
+                      workspace_name}),
+        GURL(entry->url), profile,
+        base::BindRepeating(&WorkspaceArchiveView::RestoreEntry,
+                            base::Unretained(this), entry->id));
+    view->set_context_menu_controller(this);
+    row.view = contents->AddChildView(std::move(view));
+  }
+  scroll_view_->SetContents(std::move(contents));
+  ApplyFilter();
+  clear_all_->SetEnabled(store_->loaded() && !store_->read_only() &&
+                         !store_->entries().empty());
+  // An open Clear all question counts what Delete all would clear NOW: a
+  // close in another window, or a row's Delete, can land while it waits
+  // (E14d.2 review). Said again, as it was when it appeared.
+  if (confirm_->GetVisible()) {
+    const std::u16string question = ClearAllQuestion(store_->entries().size());
+    if (question != confirm_label_->GetText()) {
+      confirm_label_->SetText(question);
+      GetViewAccessibility().AnnouncePolitely(question);
+    }
+  }
+  if (first) {
+    return;
+  }
+
+  // Where the list was, then laid out BEFORE the focus moves (E14d.2 review):
+  // the layout sizes the new rows and clamps the offset to the new length
+  // (ScrollView's ConstrainScrollToBounds). A row focused while still 0x0 at
+  // the top would scroll the list back to the top to show it.
+  scroll_view_->ScrollToOffset(gfx::PointF(0, offset_y));
+  if (views::Widget* const widget = GetWidget()) {
+    widget->LayoutRootViewIfNecessary();
+  }
+  if (focused) {
+    views::View* next = search_;
+    for (size_t i = *focused; i < rows_.size(); ++i) {
+      if (rows_[i].view->GetVisible()) {
+        next = rows_[i].view;
+        break;
+      }
+    }
+    next->RequestFocus();
+  }
+  LOG(INFO) << "[workspaces] archive screen: rebuilt after a change, "
+            << rows_.size() << " entr(ies) in "
+            << timer.Elapsed().InMilliseconds() << " ms";
+}
+
+int WorkspaceArchiveView::ApplyFilter() {
+  // Grow-only while the screen is open (E14d.2 review): the bubble sits above
+  // the rail with its bottom edge fixed, so a list that shrank as rows hide
+  // would move the search box being typed into. A late load or the switch may
+  // still make it taller. Taken before the rows hide: height() is the list as
+  // last laid out (0 before the first layout).
+  list_height_ = std::max(list_height_, scroll_view_->height());
+  scroll_view_->ClipHeightTo(list_height_, kListMaxHeight);
+
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  const std::string_view active = service
+                                      ? std::string_view(service->active_guid())
+                                      : workspaces::kDefaultWorkspaceGuid;
+  const bool all = all_workspaces_->GetChecked();
+  const std::u16string_view query = search_->GetText();
+  int shown = 0;
+  int in_scope = 0;
+  views::View* header = nullptr;
+  bool header_shown = false;
+  for (const Row& row : rows_) {
+    if (row.header != header) {
+      if (header) {
+        header->SetVisible(header_shown);
+      }
+      header = row.header;
+      header_shown = false;
+    }
+    const bool scoped = all || row.guid == active;
+    const bool show =
+        scoped && workspaces::archive::MatchesQuery(row.search_text, query);
+    if (scoped) {
+      ++in_scope;
+    }
+    if (show) {
+      ++shown;
+      header_shown = true;
+    }
+    row.view->SetVisible(show);
+  }
+  if (header) {
+    header->SetVisible(header_shown);
+  }
+  empty_->SetText(l10n_util::GetStringUTF16(
+      in_scope ? IDS_HELIUM_ARCHIVE_NO_MATCHES : IDS_HELIUM_ARCHIVE_EMPTY));
+  empty_->SetVisible(shown == 0);
+  return shown;
+}
+
+void WorkspaceArchiveView::OnArchiveChanged() {
+  // Posted, never run here: Add() calls this from inside TabStripModel's
+  // close (design 2.2). One rebuild however many changes come first.
+  if (rebuild_posted_) {
+    return;
+  }
+  rebuild_posted_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&WorkspaceArchiveView::Rebuild,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void WorkspaceArchiveView::RestoreEntry(const std::string& id) {
+  const auto it =
+      std::ranges::find(store_->entries(), id, &ArchiveEntry::id);
+  if (it == store_->entries().end()) {
+    return;
+  }
+  // A copy: the Remove() below changes the store's vector.
+  const ArchiveEntry entry = *it;
+  const GURL url(entry.url);
+  if (!url.is_valid()) {
+    LOG(WARNING) << "[workspaces] archive: an entry has no address a tab can "
+                    "open";
+    return;
+  }
+  // Not with Workspaces switched off while the screen stays open: the rail,
+  // its door, is gone, and a restore would land at the strip's end with its
+  // entry spent (code review).
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service || !service->IsEnabled()) {
+    return;
+  }
+
+  // Home for a deleted workspace, as the list draws it (design 2.4).
+  const std::string guid(
+      workspaces::ResolveTabGuid(entry.workspace, service->known_guids()));
+  // EnterWorkspaceForInsert, not SwitchToWorkspace: the switch activates a
+  // tab of the workspace -- and spawns a New Tab into an empty one -- when the
+  // page inserted below, selected, is the tab to show. This moves only the
+  // bookkeeping, the tab being left included, so coming back by the rail
+  // lands on it (E14d.2 review), and the top of the list below is then that
+  // workspace's.
+  service->EnterWorkspaceForInsert(guid);
+  // At the top of the list, where a new tab opens (E15c.1); the end when the
+  // workspace has no tab.
+  TabStripModel* const model = browser_->GetTabStripModel();
+  int index = service->TopOfListIndex(nullptr);
+  if (index < 0) {
+    index = model->count();
+  }
+
+  // A pinned item's road (OpenItem, E15c): one history entry, and the tag and
+  // name on the contents BEFORE the insert, so the tab is never drawn in the
+  // wrong workspace. No pin item and no anchor: it comes back an ordinary tab.
+  sessions::SerializedNavigationEntry navigation;
+  navigation.set_index(0);
+  navigation.set_virtual_url(url);
+  navigation.set_title(base::UTF8ToUTF16(entry.title));
+  std::map<std::string, std::string> extra_data;
+  extra_data[workspaces::kWorkspaceExtraDataKey] = guid;
+  if (!entry.custom_title.empty()) {
+    extra_data[workspaces::kCustomTitleExtraDataKey] = entry.custom_title;
+  }
+  chrome::AddRestoredTab(
+      browser_, base::span_from_ref(navigation), index,
+      /*selected_navigation=*/0, /*extension_app_id=*/std::string(),
+      /*group=*/std::nullopt, /*select=*/true, /*pin=*/false,
+      base::TimeTicks::Now(), base::Time::Now(),
+      /*storage_namespace=*/nullptr, sessions::SerializedUserAgentOverride(),
+      extra_data, /*from_session_restore=*/false,
+      /*is_active_browser=*/std::nullopt,
+      chrome::RestoredTabLoadPolicy::kLoadIfVisible);
+  // The page lives in one place, as in Arc: out of the archive now, and out
+  // of Recently Closed.
+  store_->Remove(id);
+  LOG(INFO) << "[workspaces] archive: restored an entry into '" << guid << "'";
+  RemoveRecentlyClosedTab(browser_->GetProfile(), id);
+  GetWidget()->Close();
+}
+
+void WorkspaceArchiveView::DeleteEntry(const std::string& id) {
+  const bool removed = store_->Remove(id);
+  LOG(INFO) << "[workspaces] archive: deleted an entry"
+            << (removed ? "" : " (refused)");
+}
+
+void WorkspaceArchiveView::OnClearAllPressed() {
+  const size_t count = store_->entries().size();
+  confirm_label_->SetText(ClearAllQuestion(count));
+  clear_all_->parent()->SetVisible(false);
+  confirm_->SetVisible(true);
+  // Cancel, not Delete all, under the keyboard: Enter must not clear.
+  cancel_->RequestFocus();
+  // Said aloud: the focus on Cancel reads only "Cancel", never that this
+  // clears every workspace's entries (E14d.2 review).
+  GetViewAccessibility().AnnounceAlert(confirm_label_->GetText());
+  LOG(INFO) << "[workspaces] archive screen: clear all asked (" << count
+            << ")";
+}
+
+void WorkspaceArchiveView::OnClearAllConfirmed() {
+  // Every workspace's entries, whatever the switch shows (the class comment).
+  const size_t cleared = store_->RemoveSince(base::Time());
+  LOG(INFO) << "[workspaces] archive: cleared " << cleared << " entr(ies)";
+  confirm_->SetVisible(false);
+  clear_all_->parent()->SetVisible(true);
+  search_->RequestFocus();
+}
+
+void WorkspaceArchiveView::OnClearAllCancelled() {
+  LOG(INFO) << "[workspaces] archive screen: clear all cancelled";
+  confirm_->SetVisible(false);
+  clear_all_->parent()->SetVisible(true);
+  clear_all_->RequestFocus();
+}
