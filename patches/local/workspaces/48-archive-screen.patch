+// static
+//
+// The default workspace's name lives here rather than in the model on purpose.
+// E7c left its title empty because a user-visible string has to be localised
+// and belongs with the thing that draws it -- this is that thing. Renaming it
+// gives it a real stored title and this fallback stops applying.
+std::u16string WorkspaceRailView::DisplayName(
+    const workspaces::prefs::WorkspaceEntry& entry) {
+  if (!entry.title.empty()) {
+    return base::UTF8ToUTF16(entry.title);
+  }
+  if (entry.guid == workspaces::kDefaultWorkspaceGuid) {
+    return l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_DEFAULT_NAME);
+  }
+  return base::UTF8ToUTF16(entry.guid);
+}
+
+// static
