+// The workspace a new window opens on: the one the user is in -- that of the
+// window of this profile activated last, not the new one itself and not a
+// window without Workspaces (a popup) -- design 1, E15e. Home when there is
+// none, as at startup. A restored window then follows its selected tab (the
+// auto-switch in OnTabStripModelChanged), as before.
+std::string InitialWorkspace(BrowserWindowInterface* window) {
+  std::string guid(kDefaultWorkspaceGuid);
+  if (!window) {
+    return guid;
+  }
+  ProfileBrowserCollection::GetForProfile(window->GetProfile())
+      ->ForEach(
+          [&](BrowserWindowInterface* other) {
+            const WorkspaceService* const service =
+                other == window ? nullptr : WorkspaceService::From(other);
+            if (!service) {
+              return true;
+            }
+            guid = service->active_guid();
+            return false;
+          },
+          BrowserCollection::Order::kActivation);
+  return guid;
+}
+
 }  // namespace
 
 DEFINE_USER_DATA(WorkspaceService);
