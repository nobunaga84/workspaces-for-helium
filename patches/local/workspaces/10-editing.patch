+  // The default workspace cannot be deleted -- ParseWorkspaces() puts it back
+  // on the next read, so the item would report success and change nothing
+  // (workspace_prefs.h). Disabled rather than absent, so the menu has the same
+  // shape everywhere and the reason is visible rather than mysterious.
+  if (command_id == kMenuCommandDelete) {
+    return context_menu_guid_ != workspaces::kDefaultWorkspaceGuid;
+  }
+  return true;
