+void WorkspaceRailView::ExecuteCommand(int command_id, int event_flags) {
+  workspaces::WorkspaceService* service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service || context_menu_guid_.empty()) {
+    return;
+  }
+
+  // Copied, because the bubble below outlives this call and Rebuild() clears
+  // context_menu_guid_'s neighbours out from under any reference to it.
+  const std::string guid = context_menu_guid_;
+
+  switch (command_id) {
+    case kMenuCommandRename: {
+      std::u16string current;
+      for (const workspaces::prefs::WorkspaceEntry& entry :
+           service->GetWorkspaces()) {
+        if (entry.guid == guid) {
+          current = DisplayNameForWorkspace(entry);
+          break;
+        }
+      }
+      ShowNameBubble(
+          this, IDS_HELIUM_WORKSPACE_RENAME, current,
+          base::BindOnce(
+              [](base::WeakPtr<WorkspaceRailView> self, const std::string& guid,
+                 const std::u16string& name) {
+                if (!self) {
+                  return;
+                }
+                if (workspaces::WorkspaceService* service =
+                        workspaces::WorkspaceService::From(self->browser_)) {
+                  service->RenameWorkspace(guid, base::UTF16ToUTF8(name));
+                }
+              },
+              weak_factory_.GetWeakPtr(), guid));
+      break;
+    }
+    case kMenuCommandDelete:
+      // No confirmation step, and design 5 asks for one. Deliberate for now and
+      // recorded in LOCAL.md 18: every tab it closes goes to Recently Closed
+      // with its workspace tag intact, so Ctrl+Shift+T brings them back, and a
+      // modal confirm is a second dialog class for a reversible action. Add one
+      // when a workspace is ever lost that the user wanted.
+      service->DeleteWorkspace(guid);
+      break;
+  }
