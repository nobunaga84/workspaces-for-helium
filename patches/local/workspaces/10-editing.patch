+void WorkspaceService::DeleteWorkspace(std::string_view guid) {
+  if (guid.empty() || guid == kDefaultWorkspaceGuid) {
+    return;
+  }
+
+  // Off the doomed workspace first, so the user is never looking at a strip
+  // belonging to something that no longer exists. Done before the tabs are
+  // closed, because closing them is what makes this window's active workspace
+  // empty, and the removal path would otherwise post EnsureActiveTabVisible and
+  // land the user somewhere arbitrary.
+  if (active_guid_ == guid) {
+    SwitchToWorkspace(
+        RelativeWorkspaceGuid(known_guids_, active_guid_, /*offset=*/-1));
+  }
+
+  // Collected as handles before anything is closed, and re-resolved to an index
+  // on the way past. TabStripModel::CloseTabs() takes the whole set at once but
+  // is private, so these go one at a time through CloseWebContentsAt() -- and
+  // closing a tab renumbers the strip, so an index taken before the first close
+  // means nothing after it. Handles survive that, and they also survive a close
+  // taking more than the tab it was asked for (a split closes as a unit), which
+  // a reverse-order index walk would not.
+  std::vector<tabs::TabHandle> doomed;
+  for (int i = 0; i < tab_strip_->count(); ++i) {
+    tabs::TabInterface* tab = tab_strip_->GetTabAtIndex(i);
+    if (tab && GuidOf(tab) == guid) {
+      doomed.push_back(tab->GetHandle());
+    }
+  }
+
+  LOG(INFO) << "[workspaces] deleting workspace '" << guid << "' with "
+            << doomed.size() << " tab(s) in this window";
+
+  // CLOSE_CREATE_HISTORICAL_TAB so they land in Recently Closed. Each one still
+  // carries the deleted guid in its session data, so reopening one resolves
+  // through the orphan rule into the default workspace rather than into
+  // nothing (workspace_stamping.h).
+  for (const tabs::TabHandle& handle : doomed) {
+    tabs::TabInterface* const tab = handle.Get();
+    if (!tab) {
+      continue;
+    }
+    const int index = tab_strip_->GetIndexOfTab(tab);
+    if (index != TabStripModel::kNoTab) {
+      tab_strip_->CloseWebContentsAt(
+          index, TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+    }
+  }
+
+  prefs::WriteWorkspaces(prefs_,
+                         prefs::RemoveWorkspace(GetWorkspaces(), guid));
+}
