+int WorkspaceService::TopOfListIndex(const tabs::TabInterface* opener) const {
+  if (!IsEnabled()) {
+    return -1;
+  }
+  // The first tab the list draws. Model index 0 would not do: other
+  // workspaces' tabs and open pinned pages share the model.
+  int index = tab_strip_->IndexOfFirstNonPinnedTab();
+  for (; index < tab_strip_->count(); ++index) {
+    const tabs::TabInterface* const tab = tab_strip_->GetTabAtIndex(index);
+    if (IsTabVisible(tab) && !IsDrawnAsPinnedRow(tab)) {
+      break;
+    }
+  }
+  if (index == tab_strip_->count()) {
+    return -1;
+  }
+  // After the pinned page's earlier links, in the order they were opened.
+  while (opener && index < tab_strip_->count() &&
+         tab_strip_->GetOpenerOfTabAt(index) == opener) {
+    ++index;
+  }
+  return index;
+}
+
+bool WorkspaceService::IsTabAtTopOfList(const tabs::TabInterface* tab) const {
+  const int top = TopOfListIndex(/*opener=*/nullptr);
+  return top >= 0 && tab_strip_->GetTabAtIndex(top) == tab;
+}
+
+int WorkspaceService::IndexForNewTab(bool from_link) const {
+  const tabs::TabInterface* const opener =
+      from_link ? tab_strip_->GetActiveTab() : nullptr;
+  if (from_link && !IsDrawnAsPinnedRow(opener)) {
+    return -1;
+  }
+  const int index = TopOfListIndex(opener);
+  if (index < 0) {
+    return -1;
+  }
+  // Measured on testprofile (LOCAL.md 47), logged when the window is free
+  // again: the time follows how many tabs the list DRAWS, not how many follow
+  // in the model -- Home, index 2 of 444 with 1 drawn, 59-100 ms; Canary,
+  // 321 drawn, 100-135 ms -- so the session's rewrite of every tab
+  // after the insert point (3 commands each) is not what costs.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](int index, bool link, base::TimeTicks start) {
+            LOG(INFO) << "[workspaces] new tab at index " << index
+                      << (link ? " (a link from a pinned page)"
+                               : " (the top of the list)")
+                      << ": the window was busy "
+                      << (base::TimeTicks::Now() - start).InMilliseconds()
+                      << " ms";
+          },
+          index, opener != nullptr, base::TimeTicks::Now()));
+  return index;
+}
