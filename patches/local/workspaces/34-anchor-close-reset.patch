+bool BrowserTabStripModelDelegate::IsTabAnchored(
+    const tabs::TabInterface* tab) const {
+  // IsEnabled() because anchors are dormant while Workspaces is off (E10b):
+  // with the feature off, "Close other tabs" is stock again. Not a split
+  // half, to agree with HibernateAnchoredTab: skipping one half would close
+  // the other and break the split.
+  const workspaces::WorkspaceService* service =
+      workspaces::WorkspaceService::From(browser_);
+  return service && service->IsEnabled() && service->IsAnchored(tab) &&
+         !tab->IsSplit();
+}
+
+bool BrowserTabStripModelDelegate::ResetAnchoredTabInsteadOfClosing(
+    tabs::TabInterface* tab,
+    const char* via) {
+  // The one place the discard is handed in: TabManager is out of the
+  // workspaces target's reach (E10a). HibernateAnchoredTab declines a tab that
+  // is not anchored, a split, and everything while the feature is off.
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service ||
+      !service->HibernateAnchoredTab(tab, [](content::WebContents* contents) {
+        return g_browser_process->GetTabManager()->DiscardTabByExtension(
+            contents);
+      })) {
+    return false;
+  }
+  LOG(INFO) << "[workspaces] close of an anchored tab diverted (" << via
+            << ")";
+  return true;
+}
