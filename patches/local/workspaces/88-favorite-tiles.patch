+// The faint card behind a favorite, an Arc top-row tile, in the pinned card's
+// colour (WorkspacePinnedSectionView::CardBackground). Not behind the tab in
+// front: Helium's active fill, painted first, tells it apart. A split favorite
+// never gets here (TabView::OnPaint returns first). Only
+// TabViewVerticalLayout installs it, and only on a TabView.
+class FavoriteCard : public views::Background {
+ public:
+  void Paint(gfx::Canvas* canvas, views::View* view) const override {
+    const auto& tab = static_cast<const TabView&>(*view);
+    const ui::ColorProvider* const provider = view->GetColorProvider();
+    if (!tab.pinned() || tab.IsActive() || !provider) {
+      return;
+    }
+    // The rows' own text colour; light text says the strip is dark. At half
+    // the pinned card's alpha (the owner's try): the card and Helium's
+    // highlight both step away from the strip, so a fainter card is what lets
+    // the favorite in front stand out (12 -> 15 levels light, 9 -> 15 dark).
+    const SkColor text =
+        provider->GetColor(kColorTabForegroundInactiveFrameActive);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(SkColorSetA(
+        text, (color_utils::IsDark(text) ? prefs::kCardAlphaLight
+                                         : prefs::kCardAlphaDark) /
+                  2));
+    gfx::RectF bounds(view->GetLocalBounds());
+    bounds.Inset(0.5f);  // under the tab's 1 px outline
+    canvas->DrawRoundRect(
+        bounds, GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius),
+        flags);
+  }
+};
+
