+int NextVisibleTabIndex(const std::vector<bool>& selectable,
+                        int start,
+                        int delta) {
+  const int size = static_cast<int>(selectable.size());
+  if (size == 0 || start < 0 || start >= size || delta == 0) {
+    return start;
+  }
+
+  // Runs to `size` inclusive rather than `size - 1` so the last candidate is
+  // `start` itself, which is what makes "only the active tab is selectable"
+  // return `start` instead of falling through to the fallback below. Every
+  // index is therefore visited exactly once.
+  for (int step = 1; step <= size; ++step) {
+    // The same modulo-sign trap RelativeWorkspaceGuid documents: in C++ the
+    // sign of a % b follows a, so a negative delta would index off the front
+    // of the vector. Taking the remainder first keeps the offset inside
+    // (-size, size), and adding one more `size` before the second modulo makes
+    // the result non-negative for any delta.
+    const int offset = (delta * step) % size;
+    const int candidate = (start + offset + size) % size;
+    if (selectable[candidate]) {
+      return candidate;
+    }
+  }
+
+  return start;
+}
