+bool BrowserTabStripModelDelegate::IsTabVisibleInActiveWorkspace(
+    const tabs::TabInterface* tab) const {
+  // Pinned tabs sit outside the workspace system, and it is the *container*
+  // that puts them there rather than any predicate: the vertical strip draws
+  // them from PinnedTabContainerView, which the visibility check added in E6a
+  // never reaches, so a pinned tab stays on screen in every workspace whatever
+  // guid it happens to carry.
+  //
+  // Commands have to agree with what is drawn. Without this line Ctrl+3 and
+  // Ctrl+Tab would skip a pinned tab the user is looking at, because
+  // WorkspaceService::IsTabVisible() answers about guids and knows nothing
+  // about which container a tab is rendered from. Clearing the tag on pin
+  // (design 2.5, E7b) does not remove the need for this: an empty guid means
+  // the default workspace, not every workspace.
+  if (tab && tab->IsPinned()) {
+    return true;
+  }
+
+  // Fails open, exactly like the rendering path in
+  // TabStripCollectionController: a window with no service is a window
+  // Workspaces does not apply to, and every such tab is shown.
+  const workspaces::WorkspaceService* service =
+      workspaces::WorkspaceService::From(browser_);
+  return !service || service->IsTabVisible(tab);
+}
