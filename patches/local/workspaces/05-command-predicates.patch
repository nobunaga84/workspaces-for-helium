+// ---------------------------------------------------------------------------
+// NextVisibleTabIndex -- moving between tabs when some of them are hidden.
+// ---------------------------------------------------------------------------
+
+TEST(WorkspaceNextVisibleTabTest, MovesToTheNeighbourWhenEveryTabShows) {
+  const std::vector<bool> all = {true, true, true};
+  EXPECT_EQ(2, NextVisibleTabIndex(all, 1, 1));
+  EXPECT_EQ(0, NextVisibleTabIndex(all, 1, -1));
+}
+
+TEST(WorkspaceNextVisibleTabTest, SkipsTabsOfAnotherWorkspace) {
+  const std::vector<bool> visible = {true, false, false, true};
+  EXPECT_EQ(3, NextVisibleTabIndex(visible, 0, 1));
+  EXPECT_EQ(3, NextVisibleTabIndex(visible, 0, -1));
+}
+
+// The modulo-sign trap RelativeWorkspaceGuid documents, reached from the other
+// direction: stepping backwards off index 0 must wrap to the last tab, not
+// index off the front of the vector.
+TEST(WorkspaceNextVisibleTabTest, BackwardFromTheFirstTabWrapsToTheLast) {
+  const std::vector<bool> all = {true, true, true};
+  EXPECT_EQ(2, NextVisibleTabIndex(all, 0, -1));
+}
+
+TEST(WorkspaceNextVisibleTabTest, ForwardFromTheLastTabWrapsToTheFirst) {
+  const std::vector<bool> all = {true, true, true};
+  EXPECT_EQ(0, NextVisibleTabIndex(all, 2, 1));
+}
+
+// The state this function exists for. Switching workspace does not yet move
+// the active tab (true until E7b), so the active tab can belong to a workspace
+// that is not the active one -- and then nothing at all is selectable. The
+// unbounded loop this replaces would spin here forever, freezing the browser
+// on Ctrl+Tab rather than crashing it.
+TEST(WorkspaceNextVisibleTabTest, NothingSelectableStaysOnTheActiveTab) {
+  const std::vector<bool> none = {false, false, false};
+  EXPECT_EQ(1, NextVisibleTabIndex(none, 1, 1));
+  EXPECT_EQ(1, NextVisibleTabIndex(none, 1, -1));
+}
+
+// Reached by closing every other tab of a workspace: there is nowhere to move
+// to, and the answer is the tab you are already on rather than a hidden one.
+TEST(WorkspaceNextVisibleTabTest, OnlyTheActiveTabSelectableStaysPut) {
+  const std::vector<bool> visible = {false, true, false};
+  EXPECT_EQ(1, NextVisibleTabIndex(visible, 1, 1));
+  EXPECT_EQ(1, NextVisibleTabIndex(visible, 1, -1));
+}
+
+// Every index is visited exactly once, so the one selectable tab is found from
+// any starting point in either direction.
+TEST(WorkspaceNextVisibleTabTest, FindsTheOnlySelectableTabFromAnywhere) {
+  constexpr int kCount = 5;
+  for (int target = 0; target < kCount; ++target) {
+    std::vector<bool> visible(kCount, false);
+    visible[target] = true;
+    for (int start = 0; start < kCount; ++start) {
+      for (int delta : {1, -1}) {
+        EXPECT_EQ(target, NextVisibleTabIndex(visible, start, delta))
+            << "target " << target << " start " << start << " delta " << delta;
+      }
+    }
+  }
+}
+
+// Inputs a caller should never pass, but which must not read out of bounds if
+// one ever does.
+TEST(WorkspaceNextVisibleTabTest, DegenerateInputsReturnStartUnchanged) {
+  const std::vector<bool> empty;
+  const std::vector<bool> two = {true, true};
+  EXPECT_EQ(0, NextVisibleTabIndex(empty, 0, 1));
+  EXPECT_EQ(7, NextVisibleTabIndex(two, 7, 1));
+  EXPECT_EQ(-1, NextVisibleTabIndex(two, -1, 1));
+  EXPECT_EQ(1, NextVisibleTabIndex(two, 1, 0));
+}
+
+// Whatever this lands on must be a tab the rendering predicate then draws. If
+// the two ever disagreed, Ctrl+Tab would activate a tab the user cannot see --
+// the same agreement LandedWorkspaceShowsItsOwnTabs pins for switching.
+TEST(WorkspaceNextVisibleTabTest, LandedTabIsOneTheStripActuallyDraws) {
+  const std::vector<std::string> tags = {"work", "default", "work"};
+  std::vector<bool> visible;
+  for (const std::string& tag : tags) {
+    visible.push_back(IsVisibleWhenEnabled(tag, "work"));
+  }
+
+  for (int delta : {1, -1}) {
+    const int landed = NextVisibleTabIndex(visible, 1, delta);
+    EXPECT_TRUE(IsVisibleWhenEnabled(tags[landed], "work"))
+        << "landed on index " << landed << " with delta " << delta;
+  }
+}
