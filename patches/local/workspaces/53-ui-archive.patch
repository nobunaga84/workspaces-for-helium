+ArchiveBucket BucketFor(base::Time archived_at, base::Time now) {
+  const int days = DaysAgo(archived_at, now);
+  if (days == 0) {
+    return {ArchiveBucketKind::kToday};
+  }
+  if (days == 1) {
+    return {ArchiveBucketKind::kYesterday};
+  }
+  base::Time::Exploded today;
+  now.LocalExplode(&today);
+  // Days since this week's Sunday (weeks start on Sunday, the owner
+  // 2026-10-02): day_of_week is 0 on a Sunday, so a Sunday has no "earlier
+  // this week".
+  const int into_week = today.day_of_week;
+  if (days <= into_week) {
+    return {ArchiveBucketKind::kEarlierThisWeek};
+  }
+  if (days <= into_week + 7) {
+    return {ArchiveBucketKind::kLastWeek};
+  }
+  base::Time::Exploded day;
+  archived_at.LocalExplode(&day);
+  return {ArchiveBucketKind::kMonth, day.year, day.month};
+}
