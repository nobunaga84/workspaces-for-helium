+// C7: a sideways scroll over the sidebar -- a touchpad's two-finger swipe, a
+// mouse's thumb wheel, a tilted wheel -- shows the workspace beside this one
+// on the bar, once per swipe, and stops at either end (the owner's answers).
+// Modelled on Chromium's VerticalTabStripFocusSwipeController (its Windows
+// road), which exists only behind the disabled kTabGroupsFocusing and turns
+// focused tab groups instead: the same 15 units to lock a swipe's direction,
+// 75 to switch, and a swipe ends after 300 ms without a wheel. Its "forward"
+// (a negative offset) is not taken: on Windows a view's wheel keeps
+// WM_MOUSEHWHEEL's sign, positive to the right (events_win_utils.cc; Blink
+// flips it, views do not). A pre-target handler on the region view, so it
+// sees a wheel over any part of the sidebar -- the list, the pinned section,
+// this bar -- before the view under the mouse does.
+class WorkspaceRailView::SwipeSwitch : public ui::EventHandler {
+ public:
+  explicit SwipeSwitch(WorkspaceRailView* rail) : rail_(rail) {}
+  SwipeSwitch(const SwipeSwitch&) = delete;
+  SwipeSwitch& operator=(const SwipeSwitch&) = delete;
+  ~SwipeSwitch() override { Detach(); }
+
+  // Once: the same region again does nothing, so each AddedToWidget() can
+  // ask. Let go when the region goes first, as the glide does (WheelGlide).
+  void Attach(views::View* region) {
+    if (region == region_) {
+      return;
+    }
+    Detach();
+    region_ = region;
+    if (region_) {
+      region_->AddPreTargetHandler(this);
+      tracker_.SetView(region_);
+      tracker_.SetIsDeletingCallback(
+          base::BindOnce(&SwipeSwitch::Detach, base::Unretained(this)));
+    }
+  }
+
+  void Detach() {
+    if (region_) {
+      region_->RemovePreTargetHandler(this);
+      region_ = nullptr;
+      tracker_.SetView(nullptr);
+    }
+  }
+
+  // ui::EventHandler:
+  void OnMouseEvent(ui::MouseEvent* event) override {
+    // Not while a button is held (a tab drag, the edge's resize), nor with a
+    // modifier: Ctrl and Shift change what a wheel means elsewhere.
+    constexpr int kNotWith = ui::EF_LEFT_MOUSE_BUTTON |
+                             ui::EF_MIDDLE_MOUSE_BUTTON |
+                             ui::EF_RIGHT_MOUSE_BUTTON | ui::EF_CONTROL_DOWN |
+                             ui::EF_SHIFT_DOWN | ui::EF_ALT_DOWN;
+    if (!event->IsMouseWheelEvent() || (event->flags() & kNotWith)) {
+      return;
+    }
+    const workspaces::WorkspaceService* const service =
+        workspaces::WorkspaceService::From(rail_->browser_);
+    if (!service || !service->IsEnabled()) {
+      return;
+    }
+
+    // An event not taken comes here again for each view it bubbles up to
+    // (RootView::OnMouseWheel), the same event: counted once, by the time it
+    // was made.
+    const base::TimeTicks now = event->time_stamp();
+    if (now == last_wheel_) {
+      return;
+    }
+    if (now - last_wheel_ > kSwipeEnds) {
+      axis_ = Axis::kNone;
+      total_x_ = 0;
+      total_y_ = 0;
+      switched_ = false;
+    }
+    last_wheel_ = now;
+
+    // The first direction to lead by kLockAt holds for the whole swipe: a
+    // list scroll drifting sideways never switches (wish 2's glide has it),
+    // and a swipe that starts a little diagonal still does.
+    const ui::MouseWheelEvent* const wheel = event->AsMouseWheelEvent();
+    total_x_ += wheel->x_offset();
+    total_y_ += wheel->y_offset();
+    if (axis_ == Axis::kNone) {
+      if (std::abs(total_y_) >= kLockAt &&
+          std::abs(total_y_) > std::abs(total_x_)) {
+        axis_ = Axis::kVertical;
+      } else if (std::abs(total_x_) >= kLockAt &&
+                 std::abs(total_x_) > std::abs(total_y_)) {
+        axis_ = Axis::kSideways;
+      }
+    }
+    if (axis_ != Axis::kSideways) {
+      return;
+    }
+    event->SetHandled();
+    event->StopPropagation();
+    if (switched_ || std::abs(total_x_) < kSwitchAt) {
+      return;
+    }
+    switched_ = true;
+    // Scrolling right, as a wide page would scroll right, is the chip to the
+    // right.
+    rail_->SwitchBeside(total_x_ > 0 ? 1 : -1);
+  }
+
+ private:
+  enum class Axis { kNone, kVertical, kSideways };
+  static constexpr int kLockAt = 15;
+  static constexpr int kSwitchAt = 75;
+  static constexpr base::TimeDelta kSwipeEnds = base::Milliseconds(300);
+
+  const raw_ptr<WorkspaceRailView> rail_;
+  raw_ptr<views::View> region_ = nullptr;
+  views::ViewTracker tracker_;
+  base::TimeTicks last_wheel_;
+  Axis axis_ = Axis::kNone;
+  int total_x_ = 0;
+  int total_y_ = 0;
+  bool switched_ = false;
+};
