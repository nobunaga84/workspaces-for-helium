+void WorkspaceRailView::SwitchBeside(int step) {
+  // Posted out of the wheel event: a switch rebuilds rows, maybe the one
+  // under the mouse that the event is on its way to.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<WorkspaceRailView> self, int step) {
+            workspaces::WorkspaceService* const service =
+                self ? workspaces::WorkspaceService::From(self->browser_)
+                     : nullptr;
+            if (!service) {
+              return;
+            }
+            const std::vector<std::string>& guids = self->guids_;
+            const auto it = std::ranges::find(guids, service->active_guid());
+            if (it == guids.end()) {
+              LOG(INFO) << "[workspaces] swipe " << step << ": '"
+                        << service->active_guid() << "' is not on the bar";
+              return;
+            }
+            const ptrdiff_t to = (it - guids.begin()) + step;
+            if (to < 0 || to >= std::ssize(guids)) {
+              LOG(INFO) << "[workspaces] swipe " << step
+                        << ": no workspace there";
+              return;
+            }
+            LOG(INFO) << "[workspaces] swipe " << step << ": '"
+                      << service->active_guid() << "' -> '" << guids[to]
+                      << "'";
+            // A copy: the switch may rebuild the bar, and guids_ with it.
+            service->SwitchToWorkspace(std::string(guids[to]));
+          },
+          weak_factory_.GetWeakPtr(), step));
+}
