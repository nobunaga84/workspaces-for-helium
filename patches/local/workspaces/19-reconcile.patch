+void WorkspaceService::Reconcile() {
+  // The precondition, re-checked rather than assumed. Both callers post this
+  // only when the window has just stopped filtering -- but POSTING IS NOT
+  // RUNNING, and an off-then-on inside a single message-loop turn would leave
+  // a queued pass that ran with the gate open again. The header's claim that
+  // the auto-switch in OnTabStripModelChanged is unreachable from here rests
+  // on the gate being shut for the whole pass, so it has to be true at the
+  // moment the pass runs, not at the moment it was scheduled.
+  //
+  // Returning is also the right answer on its own terms: the strip is filtered
+  // again, so nothing about the order is visible, and the next exit tidies it.
+  if (IsEnabled()) {
+    return;
+  }
+
+  const int count = tab_strip_->count();
+  const int first = tab_strip_->IndexOfFirstNonPinnedTab();
+  if (first >= count) {
+    return;
+  }
+
+  // True when `index` falls INSIDE a group or a split rather than between two
+  // of them, which is a destination none of the three mutators below survives
+  // -- and each fails differently. MoveWebContentsAt absorbs the moved tab
+  // into the group (GetGroupToAssign); MoveGroupTo silently DESTROYS the split
+  // it would break (RemoveSplitImpl); MoveSplitTo CHECKs, which on a release
+  // build is a browser crash.
+  //
+  // It cannot happen while every unit moves whole and `target` therefore
+  // always lands on a unit boundary, which is the invariant the move loop
+  // maintains from `first` upward. That is the argument; this is the check,
+  // and the argument being wrong is not a cosmetic failure: an absorbed tab
+  // fires TabGroupedStateChanged, which ends in ApplyCollectionGuid rewriting
+  // that tab's workspace tag, which SetTag then writes into the session file.
+  // A silent, persisted membership change is far worse than an untidy strip,
+  // so a bad destination abandons the pass rather than trusting the proof.
+  //
+  // CONSERVATIVE, NOT EXACT. Chromium's own MoveBreaksSplitContiguity() also
+  // weighs the gap the moving unit vacates, so this can pass where that would
+  // still refuse. It is the cheap half of the question; the unit invariant is
+  // what covers the rest.
+  const auto inside_a_collection = [&](int index) {
+    if (index <= 0) {
+      return false;
+    }
+    const std::optional<tab_groups::TabGroupId> group =
+        tab_strip_->GetTabGroupForTab(index);
+    if (group.has_value() &&
+        group == tab_strip_->GetTabGroupForTab(index - 1)) {
+      return true;
+    }
+    const std::optional<split_tabs::SplitTabId> split =
+        tab_strip_->GetSplitForTab(index);
+    return split.has_value() && split == tab_strip_->GetSplitForTab(index - 1);
+  };
+
+  // The pinned boundary has to be a unit boundary too, and that is the one
+  // place the move loop cannot establish for itself: it starts AT `first` and
+  // only ever looks forward, so a group or split straddling the boundary would
+  // be read as beginning there. MoveGroupTo would then move its pinned members
+  // as well, and ConstrainMoveIndex(to_index, /*pinned=*/false) would drop them
+  // into the unpinned region -- silently unpinning tabs the user pinned.
+  //
+  // Chromium does not appear to allow such a collection (a group is all-pinned
+  // or all-unpinned, and an all-pinned one sits entirely below `first`), so
+  // this is an assertion about that rather than a case being handled.
+  if (inside_a_collection(first)) {
+    LOG(ERROR) << "[workspaces] reconcile abandoned: a collection straddles "
+                  "the pinned boundary at index "
+               << first;
+    return;
+  }
+
+  // A unit is a clump of tabs that has to move as one. A group is tested
+  // before a split because a split can live INSIDE a group: taking the split
+  // as the unit there would move it out of its own group.
+  struct Unit {
+    tabs::TabHandle head;
+    int size = 0;
+    std::optional<tab_groups::TabGroupId> group;
+    std::optional<split_tabs::SplitTabId> split;
+  };
+
+  const auto continues_unit = [&](int index, const Unit& unit) {
+    if (unit.group) {
+      return tab_strip_->GetTabGroupForTab(index) == unit.group;
+    }
+    if (unit.split) {
+      return tab_strip_->GetSplitForTab(index) == unit.split;
+    }
+    return false;
+  };
+
+  std::vector<Unit> units;
+  std::vector<std::string> unit_guids;
+  for (int i = first; i < count;) {
+    Unit unit;
+    unit.group = tab_strip_->GetTabGroupForTab(i);
+    if (!unit.group) {
+      unit.split = tab_strip_->GetSplitForTab(i);
+    }
+
+    int end = i + 1;
+    while (end < count && continues_unit(end, unit)) {
+      ++end;
+    }
+
+    tabs::TabInterface* const head = tab_strip_->GetTabAtIndex(i);
+    if (!head) {
+      // Logged, not just returned. A silent abandon leaves a run log with no
+      // "reconcile:" line and no error either, which reads exactly like a pass
+      // that was never posted -- the distinction LOCAL.md 22 was written about,
+      // and the one every row of this chunk's test list keys off.
+      LOG(ERROR) << "[workspaces] reconcile abandoned: no tab at index " << i;
+      return;
+    }
+    unit.head = head->GetHandle();
+    unit.size = end - i;
+
+    // The unit's tag is its head tab's -- the same first-wins rule
+    // ResolveGuidForCollectionJoin applies, and for the same reason: members
+    // can only disagree if some earlier rule already broke the
+    // one-tag-per-collection invariant, and then every answer is equally
+    // arbitrary and a predictable one beats a clever one.
+    unit_guids.push_back(GuidOf(head));
+    units.push_back(std::move(unit));
+    i = end;
+  }
+
+  // known_guids_ rather than a fresh read, and it is the rail's order: it is
+  // refreshed straight from GetWorkspaceGuids(), which mirrors GetWorkspaces()
+  // entry for entry. So moving a workspace up the rail moves its tabs up the
+  // strip at the next exit, with no second ordering to keep in step.
+  const std::vector<size_t> order =
+      ReconciledUnitOrder(unit_guids, known_guids_);
+
+  int target = first;
+  int moves = 0;
+  for (const size_t position : order) {
+    const Unit& unit = units[position];
+
+    // Re-resolved through the handle every time rather than tracked, because
+    // each move renumbers everything between the unit's old place and its new
+    // one. An index taken when the list was built means nothing after the
+    // first move; a handle survives it.
+    tabs::TabInterface* const head = unit.head.Get();
+    if (!head) {
+      continue;
+    }
+    const int current = tab_strip_->GetIndexOfTab(head);
+    if (current == TabStripModel::kNoTab) {
+      continue;
+    }
+
+    if (current != target) {
+      if (inside_a_collection(target)) {
+        LOG(ERROR) << "[workspaces] reconcile abandoned at index " << target
+                   << ": not a unit boundary";
+        return;
+      }
+      if (unit.group) {
+        tab_strip_->MoveGroupTo(*unit.group, target);
+      } else if (unit.split) {
+        tab_strip_->MoveSplitTo(*unit.split, target, /*pinned=*/false,
+                                /*group_id=*/std::nullopt);
+      } else {
+        tab_strip_->MoveWebContentsAt(current, target,
+                                      /*select_after_move=*/false);
+      }
+      ++moves;
+    }
+    target += unit.size;
+  }
+
+  // Both numbers, and printed even when nothing moved. "0 move(s)" over a
+  // strip that was already in order is the only line that can tell a pass
+  // which found nothing to do apart from a pass that never ran -- and 22 was
+  // lost to exactly that distinction going unrecorded.
+  LOG(INFO) << "[workspaces] reconcile: " << units.size() << " unit(s), "
+            << moves << " move(s)";
+}
