+// ReconciledUnitOrder -- E9e.4. The unit of work is a clump of tabs that has to
+// move together, so these read as lists of tags in strip order, one tag per
+// clump, and the expected value is where each clump ends up.
+
+// The list a profile actually has: the default workspace first, because
+// ParseWorkspaces() guarantees it is present, then the rest in rail order.
+std::vector<std::string> TwoWorkspaces() {
+  return {std::string(kDefaultWorkspaceGuid), "work"};
+}
+
+TEST(WorkspaceReconcileTest, PartitionsInterleavedUnitsIntoWorkspaceOrder) {
+  // The state the owner reported: turning the feature off revealed creation
+  // order, with the two workspaces interleaved.
+  const std::vector<std::string> units = {"default", "work", "default", "work",
+                                          "default"};
+
+  EXPECT_EQ(std::vector<size_t>({0, 2, 4, 1, 3}),
+            ReconciledUnitOrder(units, TwoWorkspaces()));
+}
+
+TEST(WorkspaceReconcileTest, PreservesOrderWithinAWorkspace) {
+  // Stability is the property that makes this safe to run on a strip somebody
+  // has arranged by hand, so it gets a test of its own rather than being read
+  // out of the case above. Reversing the tags does not reverse the units.
+  const std::vector<std::string> units = {"work", "work", "default", "default"};
+
+  EXPECT_EQ(std::vector<size_t>({2, 3, 0, 1}),
+            ReconciledUnitOrder(units, TwoWorkspaces()));
+}
+
+TEST(WorkspaceReconcileTest, LeavesAnAlreadyTidyStripAlone) {
+  const std::vector<std::string> units = {"default", "default", "work"};
+
+  EXPECT_EQ(std::vector<size_t>({0, 1, 2}),
+            ReconciledUnitOrder(units, TwoWorkspaces()));
+}
+
+TEST(WorkspaceReconcileTest, WorkspaceOrderIsTheListOrderNotTheTagOrder) {
+  // The rail draws the list in stored order and this has to agree with it, so
+  // the same units with the list the other way round come out the other way
+  // round. Moving a workspace up the rail is therefore enough to change this.
+  const std::vector<std::string> units = {"default", "work", "default"};
+  const std::vector<std::string> work_first = {
+      "work", std::string(kDefaultWorkspaceGuid)};
+
+  EXPECT_EQ(std::vector<size_t>({1, 0, 2}),
+            ReconciledUnitOrder(units, work_first));
+}
+
+TEST(WorkspaceReconcileTest, OrphanTagsLandInTheDefaultWorkspace) {
+  // A tab of a deleted workspace is drawn in the default one by the orphan
+  // rule, so it has to be PARTITIONED into the default one too -- otherwise it
+  // would be laid out among tabs it is not shown beside. An untagged tab is
+  // the same case, and both keep their order relative to real default tabs.
+  const std::vector<std::string> units = {"work", "deleted", "default", ""};
+
+  EXPECT_EQ(std::vector<size_t>({1, 2, 3, 0}),
+            ReconciledUnitOrder(units, TwoWorkspaces()));
+}
+
+TEST(WorkspaceReconcileTest, EmptyStripReordersNothing) {
+  EXPECT_TRUE(ReconciledUnitOrder({}, TwoWorkspaces()).empty());
+}
+
+TEST(WorkspaceReconcileTest, OneWorkspaceIsTheIdentity) {
+  const std::vector<std::string> units = {"default", "default", "default"};
+  const std::vector<std::string> one = {std::string(kDefaultWorkspaceGuid)};
+
+  EXPECT_EQ(std::vector<size_t>({0, 1, 2}), ReconciledUnitOrder(units, one));
+}
+
+TEST(WorkspaceReconcileTest, AnEmptyWorkspaceListReordersNothing) {
+  // "The workspaces are not known here", never "no workspaces exist" -- the
+  // same reading ResolveTabGuid gives it. Moving tabs on that would be acting
+  // on an answer nobody gave.
+  const std::vector<std::string> units = {"work", "default", "work"};
+
+  EXPECT_EQ(std::vector<size_t>({0, 1, 2}), ReconciledUnitOrder(units, {}));
+}
+
+TEST(WorkspaceReconcileTest, RefusesRatherThanDroppingAUnit) {
+  // A list with no default workspace cannot come out of ParseWorkspaces(), so
+  // this guards a future caller. The units tagged "default" resolve to a guid
+  // the list never asks for, and naming only some of the units would move some
+  // tabs and abandon the rest. Nothing moves instead.
+  const std::vector<std::string> units = {"work", "default", "work"};
+  const std::vector<std::string> no_default = {"work"};
+
+  EXPECT_EQ(std::vector<size_t>({0, 1, 2}),
+            ReconciledUnitOrder(units, no_default));
+}
+
+TEST(WorkspaceReconcileTest, AlwaysNamesEveryUnitExactlyOnce) {
+  // The invariant every caller leans on: the result is a permutation. A caller
+  // walks it placing one unit after another, so a repeated position would
+  // place one unit twice and a missing one would leave a gap in the strip.
+  const std::vector<std::string> units = {"work", "deleted", "", "default",
+                                          "work"};
+
+  const std::vector<size_t> order = ReconciledUnitOrder(units, TwoWorkspaces());
+  ASSERT_EQ(units.size(), order.size());
+
+  std::vector<bool> seen(units.size(), false);
+  for (const size_t position : order) {
+    ASSERT_LT(position, units.size());
+    EXPECT_FALSE(seen[position]);
+    seen[position] = true;
+  }
+}
