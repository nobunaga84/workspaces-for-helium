+
+// On is the default: as wide as the window allows (D14).
+TEST(WorkspacePrefsTest, WideSidebarDefaultsToOn) {
+  TestingPrefServiceSimple pref_service;
+  RegisterProfilePrefs(pref_service.registry());
+
+  EXPECT_TRUE(pref_service.GetBoolean(kHeliumWorkspacesWideSidebar));
+}
+
+// The region view's numbers: minimum 160, Helium's maximum 400, the page's
+// minimum 200. On, the window less the page, never below the minimum; off,
+// 400 whatever the window.
+TEST(WorkspacePrefsTest, MaxSidebarWidthFollowsTheSetting) {
+  EXPECT_EQ(800, MaxSidebarWidth(true, 1000, 160, 400, 200));
+  EXPECT_EQ(1720, MaxSidebarWidth(true, 1920, 160, 400, 200));
+  // A window narrower than Helium's 400 plus the page: less than 400, which
+  // is also all the layout would draw.
+  EXPECT_EQ(300, MaxSidebarWidth(true, 500, 160, 400, 200));
+  // Helium's narrowest window, and narrower: the minimum still holds.
+  EXPECT_EQ(200, MaxSidebarWidth(true, 400, 160, 400, 200));
+  EXPECT_EQ(160, MaxSidebarWidth(true, 300, 160, 400, 200));
+  EXPECT_EQ(160, MaxSidebarWidth(true, 0, 160, 400, 200));
+
+  for (int window_width : {0, 500, 1000, 1920}) {
+    EXPECT_EQ(400, MaxSidebarWidth(false, window_width, 160, 400, 200))
+        << window_width;
+  }
+}
