+std::vector<tabs::TabHandle> WorkspaceService::DuplicateTabs(
+    std::string_view guid) const {
+  if (!IsEnabled()) {
+    return {};
+  }
+  // The addresses whose copy stays somewhere else, so that every Today copy
+  // of one closes (D8). First the homes of the workspace's pinned pages, in
+  // any folder or split, open or asleep -- skipped until the pins file has
+  // loaded, which only means fewer closes.
+  std::set<std::string> kept;
+  Profile* const profile = browser_window_->GetProfile();
+  if (const pins::PinStore* const store =
+          pins::PinStore::GetOrCreate(profile, profile->GetPath());
+      store->loaded()) {
+    std::vector<const pins::PinNode*> rows =
+        pins::RootsForWorkspace(store->tree(), guid, known_guids_);
+    while (!rows.empty()) {
+      const pins::PinNode* const row = rows.back();
+      rows.pop_back();
+      if (row->type == pins::PinNode::Type::kItem) {
+        kept.insert(DuplicateKey(GURL(row->url)));
+      }
+      for (const pins::PinNode& child : row->children) {
+        rows.push_back(&child);
+      }
+    }
+  }
+
+  // One walk with the strip's own iterator, never GetTabAtIndex(i): an index
+  // lookup walks the collection tree, and the menu asks this as it opens, in a
+  // window that may hold 3,862 tabs (LOCAL.md 37, C2). The address is read
+  // only of the tabs that need it.
+  const tabs::TabInterface* const active = tab_strip_->GetActiveTab();
+  std::vector<DuplicateCandidate> today;
+  std::vector<tabs::TabHandle> handles;
+  for (tabs::TabInterface* const tab : *tab_strip_) {
+    // A favorite first: it has no tag, and belongs to every workspace.
+    const bool favorite = tab->IsPinned();
+    content::WebContents* const contents = tab->GetContents();
+    if (!contents || (!favorite && !IsTabOfWorkspace(tab, guid))) {
+      continue;
+    }
+    std::string key = DuplicateKey(contents->GetLastCommittedURL());
+    // An open pinned page: the page it shows now, which may have drifted.
+    if (favorite || IsDrawnAsPinnedRow(tab)) {
+      kept.insert(std::move(key));
+      continue;
+    }
+    // D13: it would not reach the Archive, and every one shares an address.
+    if (IsUntouchedNewTabPage(contents)) {
+      continue;
+    }
+    // D12: a tab the user marked is never closed -- a split closes as a unit,
+    // closing a saved group's last tab deletes the group, and the Archive
+    // keeps no anchor -- so it is the copy that stays.
+    if (tab->IsSplit() || tab->GetGroup().has_value() || IsAnchored(tab) ||
+        !CustomTitleForTab(contents).empty()) {
+      kept.insert(std::move(key));
+      continue;
+    }
+    // Never left: a null time, 0 microseconds.
+    today.push_back(
+        {.key = std::move(key),
+         .active = tab == active,
+         .left_at_us =
+             LeftAt(tab).ToDeltaSinceWindowsEpoch().InMicroseconds()});
+    handles.push_back(tab->GetHandle());
+  }
+
+  std::vector<tabs::TabHandle> doomed;
+  for (const size_t i : DuplicatesToClose(today, kept)) {
+    doomed.push_back(handles[i]);
+  }
+  return doomed;
+}
