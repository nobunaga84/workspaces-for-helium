+std::vector<size_t> DuplicatesToClose(
+    const std::vector<DuplicateCandidate>& today,
+    const std::set<std::string>& kept) {
+  // The copy that stays, per key: the first seen, until the active one or one
+  // left later comes along. Views into `today`, which outlives this.
+  std::map<std::string_view, size_t> keeper;
+  for (size_t i = 0; i < today.size(); ++i) {
+    const DuplicateCandidate& tab = today[i];
+    if (kept.contains(tab.key)) {
+      continue;
+    }
+    const auto [it, first] = keeper.try_emplace(tab.key, i);
+    const DuplicateCandidate& best = today[it->second];
+    if (!first && !best.active &&
+        (tab.active || tab.left_at_us > best.left_at_us)) {
+      it->second = i;
+    }
+  }
+
+  std::vector<size_t> doomed;
+  for (size_t i = 0; i < today.size(); ++i) {
+    const std::string& key = today[i].key;
+    if (!key.empty() &&
+        (kept.contains(key) || keeper.find(key)->second != i)) {
+      doomed.push_back(i);
+    }
+  }
+  return doomed;
+}
