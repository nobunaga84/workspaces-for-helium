+int WorkspaceService::CloseDuplicateTabs(
+    std::string_view guid,
+    const std::vector<tabs::TabHandle>& listed) {
+  // D14: only what is still a duplicate. The confirm stayed open while pages
+  // loaded, closed and were used, and a listed tab may now be the copy that
+  // stays; a fresh look never names that one.
+  std::vector<tabs::TabHandle> doomed = DuplicateTabs(guid);
+  std::erase_if(doomed, [&listed](const tabs::TabHandle& handle) {
+    return std::ranges::find(listed, handle) == listed.end();
+  });
+  // A window of nothing but copies keeps the page in front: emptied, the
+  // window would close with them (review).
+  if (doomed.size() == static_cast<size_t>(tab_strip_->count())) {
+    if (const tabs::TabInterface* const active = tab_strip_->GetActiveTab()) {
+      std::erase(doomed, active->GetHandle());
+    }
+  }
+  // CloseWebContentsAt() answers nothing, and a page with a "Leave site?"
+  // handler closes only once the user says so: counted, so the log tells a
+  // tab still open from a close that never ran.
+  int asking = 0;
+  for (const tabs::TabHandle& handle : doomed) {
+    if (const tabs::TabInterface* const tab = handle.Get();
+        tab && AsksBeforeLeaving(tab->GetContents())) {
+      ++asking;
+    }
+  }
+  LOG(INFO) << "[workspaces] duplicates: closing " << doomed.size() << " of "
+            << listed.size() << " listed in workspace '" << guid << "', "
+            << asking << " ask before leaving";
+  return CloseTabs(std::move(doomed));
+}
