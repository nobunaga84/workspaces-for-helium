+TEST(WorkspaceArchiveTest, JsonRoundTripKeepsEveryField) {
+  ArchiveEntry full =
+      Entry("a", "https://a.example/",
+            base::Time::FromSecondsSinceUnixEpoch(1'760'000'000));
+  full.title = "A page";
+  full.custom_title = "My A";
+  full.workspace = "work";
+  full.reason = ArchiveEntry::Reason::kWindow;
+  full.last_active = base::Time::FromSecondsSinceUnixEpoch(1'759'000'000);
+  // No name, no last-shown time, no title, no workspace.
+  ArchiveEntry bare =
+      Entry("b", "https://b.example/",
+            base::Time::FromSecondsSinceUnixEpoch(1'760'000'100));
+  bare.reason = ArchiveEntry::Reason::kAuto;
+  const std::vector<ArchiveEntry> entries = {full, Entry("c", "https://c/"),
+                                             bare};
+
+  const base::DictValue value = ArchiveToValue(entries);
+  EXPECT_EQ(ArchiveFromValue(value), entries);
+
+  // What is empty or null is left out of the file, not written as "".
+  const base::ListValue* list = value.FindList("entries");
+  ASSERT_TRUE(list);
+  ASSERT_EQ(list->size(), 3u);
+  const base::DictValue& written = (*list)[2].GetDict();
+  EXPECT_FALSE(written.Find("custom_title"));
+  EXPECT_FALSE(written.Find("last_active"));
+  EXPECT_EQ(*written.FindString("reason"), "auto");
+}
