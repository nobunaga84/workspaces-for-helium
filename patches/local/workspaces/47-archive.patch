+#include "base/time/time.h"
+#include "base/values.h"
+
+namespace base {
+class SequencedTaskRunner;
+}
+
+// Arc's archive: every tab the user closes, kept per workspace for 60 days in
+// a file of its own, so a close is never the end of a page (design 5, "E14d
+// spec"). E14d.1 records; the screen that finds and restores is E14d.2's.
+//
+// //base only, the file included, like the pins store (39): all of it is
+// tested in workspaces_unittests, and it attaches to its profile as
+// base::SupportsUserData -- no KeyedService, no upstream factory list.
+namespace workspaces::archive {
+
+// One closed tab.
+struct ArchiveEntry {
+  // Why the tab left: closed by the user, with its window while another
+  // window of the profile stayed open, or by the auto-archive (E14d.3).
+  enum class Reason { kManual, kWindow, kAuto };
+
+  // The tab's own id (its helium.archive_id): Ctrl+Shift+T of this close
+  // removes the entry by it, so a page lives in one place, as in Arc.
+  std::string id;
+  // The last committed address -- present on a tab never loaded since a
+  // restore (design 5, E14d spec).
+  std::string url;
+  // The page's title at the close, and the name the user gave the tab (E11),
+  // empty for none.
+  std::string title;
+  std::string custom_title;
+  // The workspace guid the tab was in; kDefaultWorkspaceGuid for an untagged
+  // tab. A deleted workspace's entries show under the default one, as its
+  // tabs do (ResolveTabGuid, design 2.4).
+  std::string workspace;
+  Reason reason = Reason::kManual;
+  base::Time archived_at;
+  // When the page was last shown; null when not known.
+  base::Time last_active;
+
+  bool operator==(const ArchiveEntry&) const = default;
+};
+
+// How long an entry is kept (the owner: Arc's number).
+inline constexpr base::TimeDelta kKeepFor = base::Days(60);
+
+// The file's and the log's word for a reason: "manual", "window", "auto".
+std::string_view ReasonName(ArchiveEntry::Reason reason);
+
+// The file's JSON, and back. std::nullopt when `value` is not an archive this
+// version can read -- an entry with an empty id or url, an unknown reason, a
+// time that does not parse, or an id twice -- and the store then keeps the
+// file aside rather than write over it.
+inline constexpr int kArchiveFileVersion = 1;
+base::DictValue ArchiveToValue(const std::vector<ArchiveEntry>& entries);
+std::optional<std::vector<ArchiveEntry>> ArchiveFromValue(
+    const base::DictValue& value);
+
+// The archive file of one profile, loaded off the UI thread and written
+// through base::ImportantFileWriter, so a crash never leaves half a file. Used
+// on one sequence (the UI thread).
+class ArchiveStore : public base::SupportsUserData::Data,
+                     public base::ImportantFileWriter::DataSerializer {
+ public:
+  static constexpr base::FilePath::CharType kFileName[] =
+      FILE_PATH_LITERAL("Workspace Archive");
+  // The pins store's delay: a crash loses at most this much.
+  static constexpr base::TimeDelta kSaveDelay = base::Milliseconds(2500);
+
+  // The one store of `host` (a Profile), created -- and its load started --
+  // on the first call.
+  static ArchiveStore* GetOrCreate(base::SupportsUserData* host,
+                                   const base::FilePath& profile_dir);
+
+  // Starts loading `file` on `file_task_runner`, which must be BLOCK_SHUTDOWN
+  // so the destructor's last write finishes.
+  ArchiveStore(const base::FilePath& file,
+               scoped_refptr<base::SequencedTaskRunner> file_task_runner);
+  ArchiveStore(const ArchiveStore&) = delete;
+  ArchiveStore& operator=(const ArchiveStore&) = delete;
+  // Writes any change still waiting for kSaveDelay -- and, when the store goes
+  // before the read's reply, merges the closes and reopens made before the
+  // load into the file on the file sequence, after the read (review, LOCAL.md
+  // 52): the browser can quit right after its first close.
+  ~ArchiveStore() override;
+
+  bool loaded() const { return loaded_; }
+  // The file exists but could not be read, or is from a newer version: it is
+  // never written, so nothing in it is lost.
+  bool read_only() const { return read_only_; }
+  // Oldest first, in the order they were kept; none older than kKeepFor at
+  // the load or at the last Add().
+  const std::vector<ArchiveEntry>& entries() const { return entries_; }
+
+  // Keeps `entry`, and drops every entry older than kKeepFor. A close can
+  // come before the file has been read: the entry is then held and joins the
+  // file's entries at the load -- unlike the pins store, which refuses a
+  // change it cannot show yet, the archive must not lose a close. False, and
+  // nothing kept, when read_only() or when `entry` is one ArchiveFromValue()
+  // would refuse, its id already kept included.
+  bool Add(ArchiveEntry entry);
+
+  // Removes the entry with `id` (a reopened close). Before the load the id is
+  // remembered and removed from the file's entries when they arrive. False
+  // when read_only(), and after the load when no entry has `id`.
+  bool Remove(std::string_view id);
+
+ private:
+  struct LoadResult;
+  static LoadResult ReadFile(const base::FilePath& file);
+  // The load's merge, shared by OnLoaded and the destructor: `result`'s
+  // entries lose the `removed` ids, gain the `held` closes whose id they lack,
+  // and are pruned. True when they then differ from the file; false on
+  // kReadOnly, whose entries are empty, the held closes dropped. Logs as the
+  // load does.
+  static bool Merge(const base::FilePath& file,
+                    LoadResult& result,
+                    std::vector<ArchiveEntry> held,
+                    const std::set<std::string, std::less<>>& removed);
+  void OnLoaded(LoadResult result);
+
+  // base::ImportantFileWriter::DataSerializer:
+  std::optional<std::string> SerializeData() override;
+
+  std::vector<ArchiveEntry> entries_;
+  // Remove()'s ids from before the load.
+  std::set<std::string, std::less<>> removed_before_load_;
+  bool loaded_ = false;
+  bool read_only_ = false;
+  // The writer's, kept for the destructor's merge: the writer does not expose
+  // it.
+  scoped_refptr<base::SequencedTaskRunner> file_task_runner_;
+  base::ImportantFileWriter writer_;
+  base::WeakPtrFactory<ArchiveStore> weak_factory_{this};
+};
