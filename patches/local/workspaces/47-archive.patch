+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/workspaces/workspace_archive.h"
+
+#include <algorithm>
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/json/values_util.h"
+#include "base/logging.h"
+#include "base/notreached.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/ui/tabs/workspaces/workspace_pins.h"
+
+namespace workspaces::archive {
+namespace {
+
+constexpr char kVersionKey[] = "version";
+constexpr char kEntriesKey[] = "entries";
+constexpr char kIdKey[] = "id";
+constexpr char kUrlKey[] = "url";
+constexpr char kTitleKey[] = "title";
+constexpr char kCustomTitleKey[] = "custom_title";
+constexpr char kWorkspaceKey[] = "workspace";
+constexpr char kReasonKey[] = "reason";
+constexpr char kArchivedAtKey[] = "archived_at";
+constexpr char kLastActiveKey[] = "last_active";
+
+// Its address is the store's key among its profile's user data.
+constexpr char kUserDataKey[] = "helium_workspace_archive";
+
+base::DictValue EntryToValue(const ArchiveEntry& entry) {
+  base::DictValue dict;
+  dict.Set(kIdKey, entry.id);
+  dict.Set(kUrlKey, entry.url);
+  dict.Set(kTitleKey, entry.title);
+  if (!entry.custom_title.empty()) {
+    dict.Set(kCustomTitleKey, entry.custom_title);
+  }
+  dict.Set(kWorkspaceKey, entry.workspace);
+  dict.Set(kReasonKey, ReasonName(entry.reason));
+  dict.Set(kArchivedAtKey, base::TimeToValue(entry.archived_at));
+  if (!entry.last_active.is_null()) {
+    dict.Set(kLastActiveKey, base::TimeToValue(entry.last_active));
+  }
+  return dict;
+}
+
+std::optional<ArchiveEntry::Reason> ReasonFromName(std::string_view name) {
+  for (ArchiveEntry::Reason reason :
+       {ArchiveEntry::Reason::kManual, ArchiveEntry::Reason::kWindow,
+        ArchiveEntry::Reason::kAuto}) {
+    if (ReasonName(reason) == name) {
+      return reason;
+    }
+  }
+  return std::nullopt;
+}
+
+// Strict about what a restore needs (the id, the address, a reason and a time
+// this version knows), lenient about the names: this file is only ever written
+// by EntryToValue, so anything else means it is not ours to trust, and the
+// whole file is refused rather than written back without the entry -- the
+// pins store's rule (39).
+std::optional<ArchiveEntry> EntryFromValue(const base::Value& value) {
+  const base::DictValue* dict = value.GetIfDict();
+  if (!dict) {
+    return std::nullopt;
+  }
+  const std::string* id = dict->FindString(kIdKey);
+  const std::string* url = dict->FindString(kUrlKey);
+  const std::string* reason_name = dict->FindString(kReasonKey);
+  const base::Value* archived_at = dict->Find(kArchivedAtKey);
+  if (!id || id->empty() || !url || url->empty() || !reason_name ||
+      !archived_at) {
+    return std::nullopt;
+  }
+  std::optional<ArchiveEntry::Reason> reason = ReasonFromName(*reason_name);
+  std::optional<base::Time> archived = base::ValueToTime(*archived_at);
+  if (!reason || !archived) {
+    return std::nullopt;
+  }
+  ArchiveEntry entry;
+  entry.id = *id;
+  entry.url = *url;
+  entry.reason = *reason;
+  entry.archived_at = *archived;
+  if (const std::string* title = dict->FindString(kTitleKey)) {
+    entry.title = *title;
+  }
+  if (const std::string* custom_title = dict->FindString(kCustomTitleKey)) {
+    entry.custom_title = *custom_title;
+  }
+  if (const std::string* workspace = dict->FindString(kWorkspaceKey)) {
+    entry.workspace = *workspace;
+  }
+  if (const base::Value* last_active = dict->Find(kLastActiveKey)) {
+    std::optional<base::Time> time = base::ValueToTime(*last_active);
+    if (!time) {
+      return std::nullopt;
+    }
+    entry.last_active = *time;
+  }
+  return entry;
+}
+
+bool HasId(const std::vector<ArchiveEntry>& entries, std::string_view id) {
+  return std::ranges::any_of(
+      entries, [id](const ArchiveEntry& entry) { return entry.id == id; });
+}
+
+// Drops every entry older than kKeepFor (design 5: at the load and before a
+// write). True when one went.
+bool Prune(std::vector<ArchiveEntry>& entries) {
+  const base::Time oldest = base::Time::Now() - kKeepFor;
+  return std::erase_if(entries, [oldest](const ArchiveEntry& entry) {
+           return entry.archived_at < oldest;
+         }) > 0;
+}
+
+}  // namespace
+
+std::string_view ReasonName(ArchiveEntry::Reason reason) {
+  switch (reason) {
+    case ArchiveEntry::Reason::kManual:
+      return "manual";
+    case ArchiveEntry::Reason::kWindow:
+      return "window";
+    case ArchiveEntry::Reason::kAuto:
+      return "auto";
+  }
+  NOTREACHED();
+}
+
+base::DictValue ArchiveToValue(const std::vector<ArchiveEntry>& entries) {
+  base::ListValue list;
+  for (const ArchiveEntry& entry : entries) {
+    list.Append(EntryToValue(entry));
+  }
+  base::DictValue file;
+  file.Set(kVersionKey, kArchiveFileVersion);
+  file.Set(kEntriesKey, std::move(list));
+  return file;
+}
+
+std::optional<std::vector<ArchiveEntry>> ArchiveFromValue(
+    const base::DictValue& value) {
+  if (value.FindInt(kVersionKey) != kArchiveFileVersion) {
+    return std::nullopt;
+  }
+  const base::ListValue* list = value.FindList(kEntriesKey);
+  if (!list) {
+    return std::nullopt;
+  }
+  std::vector<ArchiveEntry> entries;
+  entries.reserve(list->size());
+  // A reopen removes an entry by id, so two may never share one.
+  std::set<std::string, std::less<>> ids;
+  for (const base::Value& value_entry : *list) {
+    std::optional<ArchiveEntry> entry = EntryFromValue(value_entry);
+    if (!entry || !ids.insert(entry->id).second) {
+      return std::nullopt;
+    }
+    entries.push_back(std::move(*entry));
+  }
+  return entries;
+}
+
+struct ArchiveStore::LoadResult {
+  pins::FileRead status = pins::FileRead::kMissing;
+  std::vector<ArchiveEntry> entries;
+};
+
+// static
+ArchiveStore* ArchiveStore::GetOrCreate(base::SupportsUserData* host,
+                                        const base::FilePath& profile_dir) {
+  if (auto* store =
+          static_cast<ArchiveStore*>(host->GetUserData(kUserDataKey))) {
+    return store;
+  }
+  auto owned = std::make_unique<ArchiveStore>(
+      profile_dir.Append(kFileName),
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN}));
+  ArchiveStore* store = owned.get();
+  host->SetUserData(kUserDataKey, std::move(owned));
+  return store;
+}
+
+ArchiveStore::ArchiveStore(
+    const base::FilePath& file,
+    scoped_refptr<base::SequencedTaskRunner> file_task_runner)
+    : file_task_runner_(std::move(file_task_runner)),
+      writer_(file, file_task_runner_, kSaveDelay) {
+  // The same sequence as the writer's, so the read always runs before any
+  // write -- and no write is scheduled before the read's reply anyway.
+  file_task_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&ArchiveStore::ReadFile, file),
+      base::BindOnce(&ArchiveStore::OnLoaded, weak_factory_.GetWeakPtr()));
+}
+
+ArchiveStore::~ArchiveStore() {
+  // As the pins store: ImportantFileWriter DCHECKs a pending write in its
+  // destructor, and this saves the last 2.5 s of closes at shutdown.
+  if (writer_.HasPendingWrite()) {
+    writer_.DoScheduledWrite();
+  }
+  // Gone before the read's reply -- the browser quit right after its first
+  // close, which is always held (review, LOCAL.md 52). The file sequence runs
+  // this after the read, and is BLOCK_SHUTDOWN, so it runs; it reads again and
+  // merges as OnLoaded would, without touching `this`.
+  if (!loaded_ && (!entries_.empty() || !removed_before_load_.empty())) {
+    LOG(INFO) << "[workspaces] archive: the store went before its load; "
+              << entries_.size() << " close(s) and "
+              << removed_before_load_.size()
+              << " reopen(s) made before it are merged into the file";
+    file_task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](const base::FilePath& file, std::vector<ArchiveEntry> held,
+               const std::set<std::string, std::less<>>& removed) {
+              LoadResult result = ReadFile(file);
+              if (!Merge(file, result, std::move(held), removed)) {
+                return;
+              }
+              std::optional<std::string> json =
+                  base::WriteJson(ArchiveToValue(result.entries));
+              if (!json ||
+                  !base::ImportantFileWriter::WriteFileAtomically(file,
+                                                                  *json)) {
+                LOG(WARNING) << "[workspaces] archive: could not write "
+                             << file;
+              }
+            },
+            writer_.path(), std::move(entries_),
+            std::move(removed_before_load_)));
+  }
+}
+
+bool ArchiveStore::Add(ArchiveEntry entry) {
+  if (read_only_ || entry.id.empty() || entry.url.empty() ||
+      HasId(entries_, entry.id)) {
+    return false;
+  }
+  Prune(entries_);
+  entries_.push_back(std::move(entry));
+  // Before the load the entry is held, and OnLoaded writes it.
+  if (loaded_) {
+    writer_.ScheduleWrite(this);
+  }
+  return true;
+}
+
+bool ArchiveStore::Remove(std::string_view id) {
+  if (read_only_) {
+    return false;
+  }
+  const bool erased = std::erase_if(entries_, [id](const ArchiveEntry& entry) {
+                        return entry.id == id;
+                      }) > 0;
+  if (!loaded_) {
+    removed_before_load_.emplace(id);
+    return true;
+  }
+  if (!erased) {
+    return false;
+  }
+  writer_.ScheduleWrite(this);
+  return true;
+}
+
+// static
+ArchiveStore::LoadResult ArchiveStore::ReadFile(const base::FilePath& file) {
+  LoadResult result;
+  result.status = pins::ReadStoreFile(
+      file, kArchiveFileVersion, [&result](const base::DictValue& dict) {
+        std::optional<std::vector<ArchiveEntry>> entries =
+            ArchiveFromValue(dict);
+        if (entries) {
+          result.entries = std::move(*entries);
+        }
+        return entries.has_value();
+      });
+  return result;
+}
+
+// static
+bool ArchiveStore::Merge(const base::FilePath& file,
+                         LoadResult& result,
+                         std::vector<ArchiveEntry> held,
+                         const std::set<std::string, std::less<>>& removed) {
+  bool changed = !held.empty();
+  switch (result.status) {
+    case pins::FileRead::kMissing:
+      LOG(INFO) << "[workspaces] archive: no file yet at " << file;
+      break;
+    case pins::FileRead::kLoaded: {
+      const size_t in_file = result.entries.size();
+      changed |= std::erase_if(result.entries,
+                               [&removed](const ArchiveEntry& entry) {
+                                 return removed.contains(entry.id);
+                               }) > 0;
+      LOG(INFO) << "[workspaces] archive: loaded " << in_file
+                << " entr(ies) from " << file;
+      break;
+    }
+    case pins::FileRead::kMovedAside:
+      LOG(WARNING) << "[workspaces] archive: " << file
+                   << " is not an archive file; kept as .bad, starting empty";
+      break;
+    case pins::FileRead::kReadOnly:
+      // Nothing may be written over a file that could not be read, and there
+      // is nowhere else to keep the closes made before the load: they go, and
+      // the log says how many.
+      LOG(WARNING) << "[workspaces] archive: " << file
+                   << " could not be read, is from a newer version, or could "
+                      "not be moved aside; it will not be written, and "
+                   << held.size() << " close(s) made before the load are lost";
+      return false;
+  }
+  if (!held.empty()) {
+    LOG(INFO) << "[workspaces] archive: " << held.size()
+              << " close(s) held before the load joined it";
+  }
+  for (ArchiveEntry& entry : held) {
+    if (!HasId(result.entries, entry.id)) {
+      result.entries.push_back(std::move(entry));
+    }
+  }
+  changed |= Prune(result.entries);
+  return changed;
+}
+
+void ArchiveStore::OnLoaded(LoadResult result) {
+  loaded_ = true;
+  read_only_ = result.status == pins::FileRead::kReadOnly;
+  // The closes made before the file was read.
+  const bool changed = Merge(writer_.path(), result,
+                             std::exchange(entries_, {}), removed_before_load_);
+  entries_ = std::move(result.entries);
+  removed_before_load_.clear();
+  if (changed) {
+    writer_.ScheduleWrite(this);
+  }
+}
+
+std::optional<std::string> ArchiveStore::SerializeData() {
+  // Compact, not pretty as the pins file: at Arc's rate the file is ~0.5 MB,
+  // rewritten whole on every close (design 5, E14d spec).
+  return base::WriteJson(ArchiveToValue(entries_));
+}
+
