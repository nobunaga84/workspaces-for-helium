+TEST(WorkspaceArchiveTest, RefusesFilesItDidNotWrite) {
+  // The least a file may hold: no title, name, workspace or last time.
+  const std::optional<base::DictValue> smallest = base::JSONReader::ReadDict(
+      R"({"version":1,"entries":[{"id":"a","url":"https://a/","reason":"manual","archived_at":"1"}]})",
+      base::JSON_PARSE_RFC);
+  ASSERT_TRUE(smallest);
+  EXPECT_TRUE(ArchiveFromValue(*smallest).has_value());
+
+  for (std::string_view json : {
+           R"({"entries":[]})",
+           R"({"version":2,"entries":[]})",
+           R"({"version":1})",
+           R"({"version":1,"entries":{}})",
+           R"({"version":1,"entries":["a"]})",
+           R"({"version":1,"entries":[{"url":"https://a/","reason":"manual","archived_at":"1"}]})",
+           R"({"version":1,"entries":[{"id":"","url":"https://a/","reason":"manual","archived_at":"1"}]})",
+           R"({"version":1,"entries":[{"id":"a","reason":"manual","archived_at":"1"}]})",
