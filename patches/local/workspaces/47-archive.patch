+TEST_F(ArchiveStoreTest, NoFileLoadsEmptyAndWritable) {
+  std::unique_ptr<ArchiveStore> store = LoadedStore();
+  EXPECT_TRUE(store->loaded());
+  EXPECT_FALSE(store->read_only());
+  EXPECT_TRUE(store->entries().empty());
