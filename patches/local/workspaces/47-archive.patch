+FileRead ReadStoreFile(const base::FilePath& file,
+                       int version,
+                       base::FunctionRef<bool(const base::DictValue&)> parse) {
+  if (!base::PathExists(file)) {
+    return FileRead::kMissing;
+  }
+  std::string contents;
+  if (!base::ReadFileToString(file, &contents)) {
+    return FileRead::kReadOnly;
+  }
+  if (std::optional<base::DictValue> dict =
+          base::JSONReader::ReadDict(contents, base::JSON_PARSE_RFC)) {
+    std::optional<int> file_version = dict->FindInt(kVersionKey);
+    if (file_version && *file_version > version) {
+      return FileRead::kReadOnly;
+    }
+    if (parse(*dict)) {
+      return FileRead::kLoaded;
+    }
+  }
+  // Kept, never written over: the next write starts a new file. A second bad
+  // file gets "<file> (1).bad", never the first one's name. An empty unique
+  // path (100 taken) fails the move, and the store stays read-only.
+  return base::Move(file, base::GetUniquePath(
+                              file.AddExtension(FILE_PATH_LITERAL(".bad"))))
+             ? FileRead::kMovedAside
+             : FileRead::kReadOnly;
+}
