+#define CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_ARCHIVE_H_
+
+#include <functional>
+#include <optional>
+#include <set>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/important_file_writer.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
