+  ASSERT_TRUE(store->Add(Entry("b", "https://b.example/")));
+
+  task_environment_.FastForwardBy(ArchiveStore::kSaveDelay / 2);
+  EXPECT_FALSE(base::PathExists(file()));
+  task_environment_.FastForwardBy(ArchiveStore::kSaveDelay);
+  task_environment_.RunUntilIdle();
