+    // of every workspace -- a hidden one's would come back at the old height.
+    const int tabs = InvalidateTabViews(*scroll_view->parent());
+    tabs_row_height_ = height;
+    LOG(INFO) << "[workspaces] tab style: " << tabs
+              << " tab view(s) invalidated in "
+              << timer.Elapsed().InMilliseconds() << " ms";
