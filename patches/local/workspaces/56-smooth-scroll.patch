+// The mouse wheel's glide (E18, design 5 "E18 spec" 3). Chromium moves the
+// list a whole wheel step at once (ScrollBar::OnMouseWheel); this moves it to
+// the same place over a short ease-out, frame by frame.
+//
+// It stands in front of the list's scroll view as a pre-target handler: every
+// wheel event over a row, a tab or the scroll bar comes here before Chromium
+// sees it, and one taken here goes no further. The scroll view does not own
+// its handlers, so this one is taken off again -- when the section leaves its
+// widget, and when it goes. The section lives in that scroll view's contents,
+// made and deleted with them, so the scroll view is there for every frame.
+//
+// Each frame first checks the list is still where the glide last put it.
+// Anything else that moved it -- a drag's auto-scroll, the active tab brought
+// into view, the keyboard, the scroll bar -- wins, and the glide stops there.
+class WorkspacePinnedSectionView::WheelGlide
+    : public ui::EventHandler,
+      public views::AnimationDelegateViews {
+ public:
+  // The animation ticks with `section`'s widget's frames. `prefs` are the
+  // profile's, which outlive every window's views.
+  WheelGlide(views::View* section, const PrefService* prefs)
+      : views::AnimationDelegateViews(section), prefs_(prefs) {}
+  WheelGlide(const WheelGlide&) = delete;
+  WheelGlide& operator=(const WheelGlide&) = delete;
+  ~WheelGlide() override { Detach(); }
+
+  // Glides `scroll_view`'s wheel from now on. Once: the same one again does
+  // nothing, so each Rebuild() can ask.
+  void Attach(views::ScrollView* scroll_view) {
+    if (scroll_view == scroll_view_) {
+      return;
+    }
+    Detach();
+    scroll_view_ = scroll_view;
+    if (scroll_view_) {
+      scroll_view_->AddPreTargetHandler(this);
+      // Let go just before the scroll view goes, whatever goes first when a
+      // window closes: the favorites' scroll view is no ancestor of the
+      // section, so the section's own leaving may come too late for it.
+      tracker_.SetView(scroll_view_);
+      tracker_.SetIsDeletingCallback(
+          base::BindOnce(&WheelGlide::Detach, base::Unretained(this)));
+    }
+  }
+
+  // Stops where the list is, and lets go of the scroll view.
+  void Detach() {
+    animation_.Stop();
+    if (scroll_view_) {
+      scroll_view_->RemovePreTargetHandler(this);
+      scroll_view_ = nullptr;
+      tracker_.SetView(nullptr);
+    }
+  }
+
+  // ui::EventHandler:
+  void OnMouseEvent(ui::MouseEvent* event) override {
+    // Not taken: the event goes on to Chromium's own jump, and comes here
+    // again for each view it bubbles up to -- so nothing is kept from it.
+    // Off with the setting, and with Windows' animation effects (D13).
+    if (event->type() != ui::EventType::kMousewheel || !scroll_view_ ||
+        !scroll_view_->contents() ||
+        !prefs_->GetBoolean(
+            workspaces::prefs::kHeliumWorkspacesSmoothScrolling) ||
+        !gfx::Animation::ShouldRenderRichAnimation() ||
+        event->IsControlDown() || event->IsShiftDown()) {
+      return;
+    }
+    const ui::MouseWheelEvent* const wheel = event->AsMouseWheelEvent();
+    // Sideways is not the list's; and a list that fits has nowhere to go.
+    if (wheel->x_offset() != 0 || wheel->y_offset() == 0 ||
+        !scroll_view_->IsVerticalContentOverflowing()) {
+      return;
+    }
+    // Every step glides, a whole notch or a smoothing mouse's small one
+    // (D13). Counted from where a running glide is headed, so quick steps
+    // add up; never past either end, or a spin there would pile up and the
+    // way back would seem stuck.
+    const int bottom = scroll_view_->contents()->height() -
+                       scroll_view_->GetVisibleRect().height();
+    // A running glide is carried on only if the list is still where its last
+    // frame left it; if something else moved it since, this step starts anew
+    // from where the list is.
+    const bool carry_on = animation_.is_animating() && Offset() == written_;
+    const int from = carry_on ? target_ : Offset();
+    target_ = std::clamp(from - wheel->y_offset(), 0, bottom);
+    start_ = Offset();
+    written_ = start_;
+    if (!carry_on) {
+      glide_from_ = start_;
+    }
+    const int step = std::min(std::abs(wheel->y_offset()),
+                              ui::MouseWheelEvent::kWheelDelta);
+    duration_ = kGlideShortest + (kGlideLongest - kGlideShortest) * step /
+                                     ui::MouseWheelEvent::kWheelDelta;
+    // A running glide starts its ease again from here: a new duration
+    // restarts it, where Start() alone would do nothing.
+    animation_.SetDuration(duration_);
+    animation_.Start();
+    event->SetHandled();
+  }
+
+  // gfx::AnimationDelegate:
+  void AnimationProgressed(const gfx::Animation* animation) override {
+    if (Offset() != written_) {
+      animation_.Stop();
+      return;
+    }
+    const double y = gfx::Tween::DoubleValueBetween(
+        gfx::Tween::CalculateValue(gfx::Tween::EASE_OUT,
+                                   animation_.GetCurrentValue()),
+        start_, target_);
+    scroll_view_->ScrollToPosition(scroll_view_->vertical_scroll_bar(),
+                                   base::ClampRound(y));
+    // Read back, not assumed: ScrollToPosition clamps, and the list may have
+    // grown shorter since the step.
+    written_ = Offset();
+  }
+  void AnimationEnded(const gfx::Animation* animation) override {
+    LOG(INFO) << "[workspaces] glide: " << glide_from_ << " -> " << written_
+              << " (" << duration_.InMilliseconds() << " ms)";
+  }
+
+ private:
+  // How far the list is scrolled down, in whole DIP.
+  int Offset() const {
+    return base::ClampRound(scroll_view_->CurrentOffset().y());
+  }
+
+  const raw_ptr<const PrefService> prefs_;
+  raw_ptr<views::ScrollView> scroll_view_ = nullptr;
+  views::ViewTracker tracker_;
+  gfx::LinearAnimation animation_{this};
+  // Where the glide began, for the log; where the current ease starts and is
+  // headed; where the last frame left the list; and the current ease's length.
+  int glide_from_ = 0;
+  int start_ = 0;
+  int target_ = 0;
+  int written_ = 0;
+  base::TimeDelta duration_;
+};
