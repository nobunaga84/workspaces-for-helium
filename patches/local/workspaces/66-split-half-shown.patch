+  // a tab and joins it at once, before the tab is stamped with this window's
+  // workspace: hidden as a row for that moment, it stayed an empty half.
+  // TabGroupView::DetachChildView does the same for a collapsed group's tabs.
+  collection_node->set_detach_child_from_node(base::BindRepeating(
+      [](views::View* host, views::View* child) {
