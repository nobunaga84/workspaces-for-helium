+      : contents_(contents) {}
+
+  void OnAccepted() {
+    ui::DialogModelTextfield* const field =
+        dialog_model()->GetTextfieldByUniqueId(kTabTitleFieldId);
+    tabs::TabInterface* const tab =
+        contents_ ? tabs::TabInterface::MaybeGetFromContents(contents_.get())
+                  : nullptr;
+    workspaces::WorkspaceService* const service =
+        tab ? workspaces::WorkspaceService::From(
+                  tab->GetBrowserWindowInterface())
+            : nullptr;
