+void WorkspaceService::SetCustomTitle(tabs::TabInterface* tab,
+                                      const std::string& title) {
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return;
+  }
+  WorkspaceTabData::GetOrCreateForWebContents(contents)->set_custom_title(title);
+  PersistTag(contents);
+  // Nothing about the page changed, so nothing would repaint the tab on its
+  // own -- the same lesson as the hibernated anchor's title (LOCAL.md 30).
+  contents->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TITLE);
+  LOG(INFO) << "[workspaces] custom title at index "
+            << tab_strip_->GetIndexOfTab(tab) << " -> '" << title << "'";
+}
