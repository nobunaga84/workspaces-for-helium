+// The rail's one-textfield bubble, as a tab-modal dialog: this file is not a
+// view and cannot anchor a bubble, and ShowWebModal takes the DialogModel as
+// is. Empty text restores the page's own title.
+void ShowRenameTabDialog(tabs::TabInterface* tab) {
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return;
+  }
+  auto delegate =
+      std::make_unique<TabTitleDialogDelegate>(contents->GetWeakPtr());
+  TabTitleDialogDelegate* const delegate_ptr = delegate.get();
+  constrained_window::ShowWebModal(
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_RENAME_TAB))
+          .AddOkButton(base::BindOnce(&TabTitleDialogDelegate::OnAccepted,
+                                      base::Unretained(delegate_ptr)))
+          .AddCancelButton(base::DoNothing())
+          .AddTextfield(
+              kTabTitleFieldId,
+              l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_TAB_TITLE_LABEL),
+              base::UTF8ToUTF16(workspaces::CustomTitleForTab(contents)),
+              ui::DialogModelTextfield::Params())
+          .SetInitiallyFocusedField(kTabTitleFieldId)
+          .Build(),
+      contents);
+}
