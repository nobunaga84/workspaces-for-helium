+    bool is_restoring_group_or_window,
+    sessions::tab_restore::Type original_session_type) {
+  WorkspaceService* const workspace_service = WorkspaceService::From(browser);
+  if (!workspace_service || !group_id || !is_restoring_group_or_window) {
+    return;
+  }
+  workspace_service->ExpectClosedTabData(*group_id);
+  if (original_session_type == sessions::tab_restore::Type::GROUP &&
+      workspace_service->IsEnabled()) {
