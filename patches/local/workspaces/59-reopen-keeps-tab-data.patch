+void WorkspaceService::ExpectClosedTabData(tab_groups::TabGroupId group) {
+  if (!tab_strip_->group_model() ||
+      !tab_strip_->group_model()->ContainsTabGroup(group)) {
+    return;
+  }
+  const gfx::Range range =
+      tab_strip_->group_model()->GetTabGroup(group)->ListTabs();
+  for (size_t i = range.start(); i < range.end(); ++i) {
+    if (tabs::TabInterface* const tab =
+            tab_strip_->GetTabAtIndex(static_cast<int>(i))) {
+      rebuilt_tabs_.insert(tab->GetHandle().raw_value());
+    }
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<WorkspaceService> service) {
+                       if (service) {
+                         service->rebuilt_tabs_.clear();
+                       }
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
+
+void WorkspaceService::ApplyClosedTabData(
+    tabs::TabInterface* tab,
+    const std::map<std::string, std::string>& extra_data) {
+  if (!tab || !tab->GetContents() ||
+      !rebuilt_tabs_.erase(tab->GetHandle().raw_value())) {
+    return;
+  }
+  std::map<std::string, std::string> carried;
+  for (const char* key : kCarriedOnReopenKeys) {
+    const auto it = extra_data.find(key);
+    if (it != extra_data.end() && !it->second.empty()) {
+      carried.insert(*it);
+    }
+  }
+  if (carried.empty()) {
+    return;
+  }
+  // As a restart restores them (RestoreWorkspaceFromExtraData, which also logs
+  // "restored custom title"), then saved and drawn as SetAnchored() and
+  // SetCustomTitle() do: the tab is already in the strip.
+  content::WebContents* const contents = tab->GetContents();
+  RestoreWorkspaceFromExtraData(contents, carried);
+  PersistTag(contents);
+  contents->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TITLE);
+  workspace_changed_callbacks_.Notify();
+  LOG(INFO) << "[workspaces] restore: a rebuilt tab took its closed tab's"
+            << (carried.contains(kAnchorUrlExtraDataKey) ? " anchor" : "")
+            << (carried.contains(kCustomTitleExtraDataKey) ? " name" : "");
+}
