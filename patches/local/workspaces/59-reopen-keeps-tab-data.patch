+void PopulateSavedTabExtraData(Profile* profile,
+                               tabs::TabInterface* tab,
+                               std::map<std::string, std::string>* extra_data) {
+  // ponytail: one SavedTabGroup copy per closed grouped tab (GetGroup returns
+  // a copy), O(n^2) for a big group's close; cache per close if one slows.
+  tab_groups::TabGroupSyncService* const sync =
+      tab && tab->GetGroup()
+          ? tab_groups::TabGroupSyncServiceFactory::GetForProfile(profile)
+          : nullptr;
+  const std::optional<tab_groups::SavedTabGroup> saved_group =
+      sync ? sync->GetGroup(*tab->GetGroup()) : std::nullopt;
+  if (const tab_groups::SavedTabGroupTab* const saved_tab =
+          saved_group ? saved_group->GetTab(tab->GetHandle().raw_value())
+                      : nullptr) {
