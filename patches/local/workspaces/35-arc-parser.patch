+#ifndef CHROME_BROWSER_UI_TABS_WORKSPACES_ARC_IMPORT_PLAN_H_
+#define CHROME_BROWSER_UI_TABS_WORKSPACES_ARC_IMPORT_PLAN_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/time/time.h"
+
+// Arc's StorableSidebar.json turned into plain values: what "Import from
+// Arc..." will create, in the order it will create it (design 5, E14 spec).
+//
+// No Browser, no TabStripModel, no GURL: //base only, so all of it is tested in
+// workspaces_unittests (design 3.10). The file is someone else's undocumented
+// format, read from outside the profile, so nothing here trusts it: a missing
+// key skips the item, a cycle or an absurd depth is refused, and a file that
+// does not look like a sidebar at all is std::nullopt rather than an empty plan.
+namespace workspaces::arc_import {
+
+struct ArcTab {
+  std::string arc_id;
+  // Arc's savedURL. Only http(s) survives the parse (anchors are http(s) only,
+  // LOCAL.md 31); everything else is counted in ArcImportPlan::skipped.
+  std::string url;
+  // The page's own title as Arc saved it.
+  std::string title;
+  // The name typed in Arc, and ONLY where it differs from `title`: 3,175 of
+  // the owner's 3,181 "renamed" tabs carry a copy of the page title, and a
+  // custom title would stop those ever showing the real one (LOCAL.md 37).
+  std::string custom_title;
+  // From a space's pinned container: becomes an anchored tab.
+  bool anchored = false;
+  // timeLastActiveAt, else createdAt -- 40% of Today tabs have no
+  // timeLastActiveAt. Seeds auto-archive's countdown.
+  base::Time last_active;
+  // createdAt, which every Arc item has. What a re-import filters on.
+  base::Time created;
+
+  bool operator==(const ArcTab&) const = default;
+};
+
+// One thing the strip moves as a whole below group level: a tab, or a split
+// view's two tabs in Arc's order.
+struct ArcItem {
+  std::vector<ArcTab> tabs;
+
+  bool operator==(const ArcItem&) const = default;
+};
+
+// A run of consecutive items. With a title it is one Arc folder and becomes one
+// collapsed tab group; without, the items are loose tabs.
+struct ArcUnit {
+  // "A > B" for folder B inside folder A: tab groups cannot nest.
+  std::string group_title;
+  std::vector<ArcItem> items;
+
+  bool operator==(const ArcUnit&) const = default;
+};
+
+struct ArcWorkspace {
+  std::string arc_space_id;
+  std::string title;
+  // Arc's emoji as UTF-8, or empty.
+  std::string icon;
+  // The space's pinned tabs (anchored), then its Today tabs.
+  std::vector<ArcUnit> pinned;
+  std::vector<ArcUnit> today;
+
+  bool operator==(const ArcWorkspace&) const = default;
+};
+
+struct ArcImportPlan {
+  // Arc's favorites, shared by every space: become Chrome-pinned tabs.
+  std::vector<ArcTab> favorites;
+  std::vector<ArcWorkspace> workspaces;
+  // Tabs left out: no URL, not http(s), or reached through a cycle.
+  int skipped = 0;
+
+  bool operator==(const ArcImportPlan&) const = default;
+};
+
+// std::nullopt when `json` is not JSON or holds no main sidebar. Little Arc
+// windows, which the file lists beside the main sidebar and sometimes before
+// it, are ignored.
+std::optional<ArcImportPlan> ParseArcSidebarJson(std::string_view json);
+
+// Arc stamps seconds since 2001-01-01 UTC.
+base::Time FromArcSeconds(double seconds);
+
+// `plan` without the tabs created at or before `last_import`, for a re-run:
+// a tab closed or archived here since then stays gone. A null time keeps
+// everything. A split left with one tab stays as a plain tab; emptied items
+// and units are dropped, workspaces are kept.
+ArcImportPlan KeepCreatedAfter(ArcImportPlan plan, base::Time last_import);
+
+}  // namespace workspaces::arc_import
+
+#endif  // CHROME_BROWSER_UI_TABS_WORKSPACES_ARC_IMPORT_PLAN_H_
