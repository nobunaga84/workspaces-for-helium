+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/workspaces/arc_import_plan.h"
+
+#include <map>
+#include <set>
+#include <utility>
+
+#include "base/json/json_reader.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversion_utils.h"
+#include "base/values.h"
+
+namespace workspaces::arc_import {
+namespace {
+
+// 2001-01-01 UTC in seconds since 1970: Arc stamps Apple reference dates.
+constexpr double kArcEpochOffsetSeconds = 978307200.0;
+
+// The owner's folders nest 5 deep. The visited set already stops a cycle; this
+// stops a hostile file from recursing the stack away with one long chain.
+constexpr int kMaxDepth = 64;
+
+// Keyed by views into the parsed tree, which outlives every index.
+using ItemIndex = std::map<std::string_view, const base::DictValue*>;
+
+bool IsWebUrl(std::string_view url) {
+  return base::StartsWith(url, "http://",
+                          base::CompareCase::INSENSITIVE_ASCII) ||
+         base::StartsWith(url, "https://",
+                          base::CompareCase::INSENSITIVE_ASCII);
+}
+
+std::string StringOr(const base::DictValue& dict,
+                     std::string_view key,
+                     std::string_view fallback) {
+  const std::string* const value = dict.FindString(key);
+  return std::string(value && !value->empty() ? *value : fallback);
+}
+
+// The main sidebar, never a Little Arc window. `containers` alternates a key
+// dict -- {"global":{}} or {"littleBrowser":{...}} -- and the container it
+// names, and a Little Arc pair can come first: "the first container that has
+// spaces", which E12's script takes, is a mini window in 2 of Arc's own 24
+// snapshots (LOCAL.md 37).
+const base::DictValue* MainContainer(const base::DictValue& root) {
+  const base::DictValue* const sidebar = root.FindDict("sidebar");
+  const base::ListValue* const containers =
+      sidebar ? sidebar->FindList("containers") : nullptr;
+  if (!containers) {
+    return nullptr;
+  }
+  for (size_t i = 0; i + 1 < containers->size(); ++i) {
+    const base::DictValue* const key = (*containers)[i].GetIfDict();
+    if (key && key->contains("global")) {
+      return (*containers)[i + 1].GetIfDict();
+    }
+  }
+  return nullptr;
+}
+
+// `items` and `spaces` both alternate an id string and a dict that carries the
+// same id itself, so the strings are skipped rather than paired up.
+ItemIndex IndexById(const base::ListValue* list) {
+  ItemIndex index;
+  if (!list) {
+    return index;
+  }
+  for (const base::Value& element : *list) {
+    const base::DictValue* const dict = element.GetIfDict();
+    const std::string* const id = dict ? dict->FindString("id") : nullptr;
+    if (id) {
+      index.emplace(*id, dict);
+    }
+  }
+  return index;
+}
+
+class Walker {
+ public:
+  explicit Walker(const ItemIndex& items) : items_(items) {}
+
+  int skipped() const { return skipped_; }
+
+  // The tree under a space's root container, flattened into strip order. Root
+  // level keeps Arc's order, loose tabs and folders interleaved.
+  std::vector<ArcUnit> Units(std::string_view container_id, bool anchored) {
+    std::vector<ArcUnit> out;
+    if (const base::DictValue* const root = Visit(container_id)) {
+      ArcUnit loose;
+      for (const base::DictValue* child : Children(*root)) {
+        if (!IsFolder(*child)) {
+          AppendItem(*child, anchored, loose);
+          continue;
+        }
+        Flush(loose, out);
+        WalkFolder(*child, StringOr(*child, "title", "Folder"), anchored,
+                   /*depth=*/1, out);
+      }
+      Flush(loose, out);
+    }
+    return out;
+  }
+
+  // Favorites: every tab under the container, in order, nothing grouped.
+  std::vector<ArcTab> Tabs(std::string_view container_id) {
+    std::vector<ArcTab> out;
+    for (ArcUnit& unit : Units(container_id, /*anchored=*/false)) {
+      for (ArcItem& item : unit.items) {
+        for (ArcTab& tab : item.tabs) {
+          out.push_back(std::move(tab));
+        }
+      }
+    }
+    return out;
+  }
+
+ private:
+  static bool IsFolder(const base::DictValue& item) {
+    const base::DictValue* const data = item.FindDict("data");
+    return data && data->contains("list");
+  }
+
+  static void Flush(ArcUnit& unit, std::vector<ArcUnit>& out) {
+    if (!unit.items.empty()) {
+      out.push_back(std::move(unit));
+    }
+    unit = ArcUnit();
+  }
+
+  // The item with this id, the first time it is asked for. A second visit is
+  // a cycle or a shared child; either way the file is lying and it is skipped.
+  const base::DictValue* Visit(std::string_view id) {
+    const auto found = items_.find(id);
+    if (found == items_.end()) {
+      return nullptr;
+    }
+    if (!visited_.insert(found->first).second) {
+      ++skipped_;
+      return nullptr;
+    }
+    return found->second;
+  }
+
+  std::vector<const base::DictValue*> Children(const base::DictValue& parent) {
+    std::vector<const base::DictValue*> children;
+    if (const base::ListValue* const ids = parent.FindList("childrenIds")) {
+      for (const base::Value& id : *ids) {
+        const base::DictValue* const child =
+            id.is_string() ? Visit(id.GetString()) : nullptr;
+        if (child) {
+          children.push_back(child);
+        }
+      }
+    }
+    return children;
+  }
+
+  // A folder's own tabs become one unit, then each subfolder its own: groups
+  // cannot nest, and a group has to be contiguous, so a folder's loose tabs
+  // are hoisted above its subfolders (owner, 2026-09-22; 5 of 28 folders).
+  void WalkFolder(const base::DictValue& folder,
+                  const std::string& path,
+                  bool anchored,
+                  int depth,
+                  std::vector<ArcUnit>& out) {
+    if (depth > kMaxDepth) {
+      ++skipped_;
+      return;
+    }
+    const std::vector<const base::DictValue*> children = Children(folder);
+    ArcUnit own;
+    own.group_title = path;
+    for (const base::DictValue* child : children) {
+      if (!IsFolder(*child)) {
+        AppendItem(*child, anchored, own);
+      }
+    }
+    Flush(own, out);
+    for (const base::DictValue* child : children) {
+      if (IsFolder(*child)) {
+        WalkFolder(*child, path + " > " + StringOr(*child, "title", "Folder"),
+                   anchored, depth + 1, out);
+      }
+    }
+  }
+
+  // A tab, or a split view as one item. Anything else Arc may hold is ignored.
+  void AppendItem(const base::DictValue& item, bool anchored, ArcUnit& unit) {
+    const base::DictValue* const data = item.FindDict("data");
+    if (!data) {
+      return;
+    }
+    if (data->contains("tab")) {
+      if (std::optional<ArcTab> tab = ToTab(item, anchored)) {
+        unit.items.push_back(ArcItem{{*std::move(tab)}});
+      }
+      return;
+    }
+    if (!data->contains("splitView")) {
+      return;
+    }
+    ArcItem split;
+    for (const base::DictValue* child : Children(item)) {
+      if (std::optional<ArcTab> tab = ToTab(*child, anchored)) {
+        split.tabs.push_back(*std::move(tab));
+      }
+    }
+    // A split here is exactly two tabs. Anything else arrives as plain tabs.
+    if (split.tabs.size() == 2) {
+      unit.items.push_back(std::move(split));
+      return;
+    }
+    for (ArcTab& tab : split.tabs) {
+      unit.items.push_back(ArcItem{{std::move(tab)}});
+    }
+  }
+
+  std::optional<ArcTab> ToTab(const base::DictValue& item, bool anchored) {
+    const base::DictValue* const data = item.FindDict("data");
+    const base::DictValue* const saved = data ? data->FindDict("tab") : nullptr;
+    if (!saved) {
+      return std::nullopt;
+    }
+    const std::string* const url = saved->FindString("savedURL");
+    if (!url || !IsWebUrl(*url)) {
+      ++skipped_;
+      return std::nullopt;
+    }
+    ArcTab tab;
+    tab.arc_id = StringOr(item, "id", "");
+    tab.url = *url;
+    tab.title = StringOr(*saved, "savedTitle", "");
+    const std::string typed = StringOr(item, "title", "");
+    if (typed != tab.title) {
+      tab.custom_title = typed;
+    }
+    tab.anchored = anchored;
+    // FindDouble also reads an integer, should Arc ever write a whole second.
+    if (const std::optional<double> created = item.FindDouble("createdAt")) {
+      tab.created = FromArcSeconds(*created);
+    }
+    const std::optional<double> active = saved->FindDouble("timeLastActiveAt");
+    tab.last_active = active ? FromArcSeconds(*active) : tab.created;
+    return tab;
+  }
+
+  const ItemIndex& items_;
+  std::set<std::string_view> visited_;
+  int skipped_ = 0;
+};
+
+// A space names its two root containers as [tag, id, tag, id], the tag a
+// string in `containerIDs` and a one-key dict in the newer `newContainerIDs`.
+std::string RootContainer(const base::DictValue& space, std::string_view tag) {
+  for (const char* key : {"containerIDs", "newContainerIDs"}) {
+    const base::ListValue* const list = space.FindList(key);
+    for (size_t i = 0; list && i + 1 < list->size(); i += 2) {
+      const base::Value& name = (*list)[i];
+      const bool matches =
+          name.is_string() ? name.GetString() == tag
+                           : name.is_dict() && name.GetDict().contains(tag);
+      if (matches && (*list)[i + 1].is_string()) {
+        return (*list)[i + 1].GetString();
+      }
+    }
+  }
+  return std::string();
+}
+
+std::string SpaceIcon(const base::DictValue& space) {
+  const base::DictValue* const info = space.FindDict("customInfo");
+  const base::DictValue* const icon = info ? info->FindDict("iconType") : nullptr;
+  if (!icon) {
+    return std::string();
+  }
+  // emoji_v2 is the whole emoji, joiners included; `emoji` is one code point.
+  if (const std::string* const emoji = icon->FindString("emoji_v2")) {
+    return *emoji;
+  }
+  std::string utf8;
+  const std::optional<int> code_point = icon->FindInt("emoji");
+  if (code_point && base::IsValidCharacter(*code_point)) {
+    base::WriteUnicodeCharacter(*code_point, &utf8);
+  }
+  return utf8;
+}
+
+}  // namespace
+
+std::optional<ArcImportPlan> ParseArcSidebarJson(std::string_view json) {
+  const std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  const base::DictValue* const container = root ? MainContainer(*root) : nullptr;
+  if (!container) {
+    return std::nullopt;
+  }
+  const ItemIndex items = IndexById(container->FindList("items"));
+  Walker walker(items);
+  ArcImportPlan plan;
+
+  // [profile key, container id, ...]: only the ids matter.
+  if (const base::ListValue* const favorites =
+          container->FindList("topAppsContainerIDs")) {
+    for (const base::Value& element : *favorites) {
+      if (element.is_string()) {
+        for (ArcTab& tab : walker.Tabs(element.GetString())) {
+          plan.favorites.push_back(std::move(tab));
+        }
+      }
+    }
+  }
+
+  if (const base::ListValue* const spaces = container->FindList("spaces")) {
+    for (const base::Value& element : *spaces) {
+      const base::DictValue* const space = element.GetIfDict();
+      if (!space) {
+        continue;
+      }
+      ArcWorkspace workspace;
+      workspace.arc_space_id = StringOr(*space, "id", "");
+      workspace.title = StringOr(*space, "title", "Space");
+      workspace.icon = SpaceIcon(*space);
+      workspace.pinned =
+          walker.Units(RootContainer(*space, "pinned"), /*anchored=*/true);
+      workspace.today =
+          walker.Units(RootContainer(*space, "unpinned"), /*anchored=*/false);
+      plan.workspaces.push_back(std::move(workspace));
+    }
+  }
+
+  plan.skipped = walker.skipped();
+  return plan;
+}
+
+base::Time FromArcSeconds(double seconds) {
+  return base::Time::FromSecondsSinceUnixEpoch(seconds +
+                                               kArcEpochOffsetSeconds);
+}
+
+ArcImportPlan KeepCreatedAfter(ArcImportPlan plan, base::Time last_import) {
+  if (last_import.is_null()) {
+    return plan;
+  }
+  // A tab with no createdAt has a null time and so counts as old.
+  const auto is_old = [last_import](const ArcTab& tab) {
+    return tab.created <= last_import;
+  };
+  std::erase_if(plan.favorites, is_old);
+  for (ArcWorkspace& workspace : plan.workspaces) {
+    for (std::vector<ArcUnit>* units : {&workspace.pinned, &workspace.today}) {
+      for (ArcUnit& unit : *units) {
+        for (ArcItem& item : unit.items) {
+          std::erase_if(item.tabs, is_old);
+        }
+        std::erase_if(unit.items,
+                      [](const ArcItem& item) { return item.tabs.empty(); });
+      }
+      std::erase_if(*units,
+                    [](const ArcUnit& unit) { return unit.items.empty(); });
+    }
+  }
+  return plan;
+}
+
+}  // namespace workspaces::arc_import
