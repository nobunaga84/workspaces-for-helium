+TEST(ArcImportPlanTest, AFolderChainDeeperThanTheCapIsCutOff) {
+  // 70 nested folders with one tab at the bottom: refused, not followed.
+  std::string items = Parent("p", "itemContainer", R"(["f0"])");
+  for (int i = 0; i < 70; ++i) {
+    const std::string child = i < 69 ? base::StrCat({"f", base::NumberToString(i + 1)})
+                                     : std::string("deep");
+    base::StrAppend(&items,
+                    {",", Parent(base::StrCat({"f", base::NumberToString(i)}),
+                                 "list", base::StrCat({"[\"", child, "\"]"}),
+                                 "F")});
+  }
+  base::StrAppend(&items,
+                  {",", Tab("deep", "https://deep.example/", "Deep", 10)});
+  const std::optional<ArcImportPlan> plan =
+      ParseArcSidebarJson(Sidebar(items, Space("s1", "S", kOneSpace)));
+
+  ASSERT_TRUE(plan);
+  EXPECT_EQ(Shape(plan->workspaces[0].pinned), "");
+  EXPECT_EQ(plan->skipped, 1);
+}
