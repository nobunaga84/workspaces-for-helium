+TEST(ArcImportPlanTest, AReimportKeepsOnlyWhatArcGainedSince) {
+  const std::optional<ArcImportPlan> plan = ParseArcSidebarJson(Sidebar(
+      base::StrCat({Parent("fav", "itemContainer", R"(["f1","f2"])"), ",",
+                    Tab("f1", "https://f1.example/", "F1", 10), ",",
+                    Tab("f2", "https://f2.example/", "F2", 500), ",",
+                    Parent("p", "itemContainer", R"(["A","sp","t3"])"), ",",
+                    Parent("A", "list", R"(["t1"])", "A"), ",",
+                    Tab("t1", "https://one.example/", "One", 10), ",",
+                    Parent("sp", "splitView", R"(["t4","t5"])"), ",",
+                    Tab("t4", "https://four.example/", "Four", 10), ",",
+                    Tab("t5", "https://five.example/", "Five", 500), ",",
+                    Tab("t3", "https://three.example/", "Three", 100)}),
+      Space("s1", "S", kOneSpace), R"([{"default":true},"fav"])"));
+  ASSERT_TRUE(plan);
+  ASSERT_EQ(Shape(plan->workspaces[0].pinned), "A[t1] [t4+t5 t3]");
+
+  // First import: nothing to compare against, everything stays.
+  EXPECT_EQ(KeepCreatedAfter(*plan, base::Time()), *plan);
+
+  // Imported at second 100: `t3` was created AT that second and is old.
+  const ArcImportPlan later = KeepCreatedAfter(*plan, FromArcSeconds(100));
+  ASSERT_EQ(later.favorites.size(), 1u);
+  EXPECT_EQ(later.favorites[0].arc_id, "f2");
+  ASSERT_EQ(later.workspaces.size(), 1u);  // kept even when it empties
+  // Folder A is gone with its only tab; the split is down to its new half.
+  EXPECT_EQ(Shape(later.workspaces[0].pinned), "[t5]");
+
+  const ArcImportPlan nothing = KeepCreatedAfter(*plan, FromArcSeconds(9999));
+  EXPECT_TRUE(nothing.favorites.empty());
+  EXPECT_EQ(Shape(nothing.workspaces[0].pinned), "");
+}
