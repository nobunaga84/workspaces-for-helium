+
+#include "chrome/browser/ui/tabs/workspaces/arc_import_plan.h"
+
+#include <iostream>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/environment.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/time/time.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace workspaces::arc_import {
+namespace {
+
+// The pieces of Arc's file, as JSON text. `children` is a JSON array of ids.
+std::string Tab(std::string_view id,
+                std::string_view url,
+                std::string_view saved_title,
+                int created,
+                std::string_view more_item = "",
+                std::string_view more_tab = "") {
+  return base::StrCat({R"({"id":")", id, R"(","createdAt":)",
+                       base::NumberToString(created), more_item,
+                       R"(,"data":{"tab":{"savedURL":")", url,
+                       R"(","savedTitle":")", saved_title, "\"", more_tab,
+                       "}}}"});
+}
+
+std::string Parent(std::string_view id,
+                   std::string_view kind,
+                   std::string_view children,
+                   std::string_view title = "") {
+  return base::StrCat({R"({"id":")", id, R"(","title":")", title,
+                       R"(","childrenIds":)", children, R"(,"data":{")", kind,
+                       R"(":{}}})"});
+}
+
+std::string Space(std::string_view id,
+                  std::string_view title,
+                  std::string_view container_ids,
+                  std::string_view more = "") {
+  return base::StrCat({R"({"id":")", id, R"(","title":")", title, "\",",
+                       container_ids, more, "}"});
+}
+
+// `before_global` is where a Little Arc pair goes when it comes first.
+std::string Sidebar(std::string_view items,
+                    std::string_view spaces,
+                    std::string_view favorites = "[]",
+                    std::string_view before_global = "") {
+  return base::StrCat({R"({"sidebar":{"containers":[)", before_global,
+                       R"({"global":{}},{"items":[)", items, R"(],"spaces":[)",
+                       spaces, R"(],"topAppsContainerIDs":)", favorites,
+                       "}]}}"});
+}
+
+// "A[t2] A > B[t3 t5+t6]": units by title, items by id, a split joined by +.
+std::string Shape(const std::vector<ArcUnit>& units) {
+  std::string out;
+  for (const ArcUnit& unit : units) {
+    base::StrAppend(&out, {out.empty() ? "" : " ", unit.group_title, "["});
+    for (size_t i = 0; i < unit.items.size(); ++i) {
+      out += i ? " " : "";
+      for (size_t j = 0; j < unit.items[i].tabs.size(); ++j) {
+        base::StrAppend(&out, {j ? "+" : "", unit.items[i].tabs[j].arc_id});
+      }
+    }
+    out += "]";
+  }
+  return out;
+}
+
+constexpr char kOneSpace[] =
+    R"("containerIDs":["unpinned","u","pinned","p"])";
+
+TEST(ArcImportPlanTest, WalksSpacesFoldersSplitsAndFavorites) {
+  // Arc's real lists alternate an id string and the dict; kept here once.
+  const std::string items = base::StrCat(
+      {R"("fav",)", Parent("fav", "itemContainer", R"(["f1"])"), ",",
+       Tab("f1", "https://fav.example/", "Fav", 100), ",",
+       // Root: a loose tab, folder A, a loose tab, a split. Arc's order stays.
+       Parent("p", "itemContainer", R"(["t1","A","t4","sp"])"), ",",
+       Tab("t1", "https://one.example/", "One", 10), ",",
+       // A lists its subfolder BEFORE its own tab: the tab is hoisted.
+       Parent("A", "list", R"(["B","t2"])", "A"), ",",
+       Parent("B", "list", R"(["t3","spB"])", "B"), ",",
+       Tab("t2", "https://two.example/", "Two", 10), ",",
+       Tab("t3", "https://three.example/", "Three", 10), ",",
+       Parent("spB", "splitView", R"(["t5","t6"])"), ",",
+       Tab("t5", "https://five.example/", "Five", 10), ",",
+       Tab("t6", "https://six.example/", "Six", 10), ",",
+       Tab("t4", "https://four.example/", "Four", 10), ",",
+       // One half is not a web page: the split arrives as a plain tab.
+       Parent("sp", "splitView", R"(["t7","t8"])"), ",",
+       Tab("t7", "https://seven.example/", "Seven", 10), ",",
+       Tab("t8", "chrome://settings/", "Settings", 10), ",",
+       Parent("u", "itemContainer", R"(["u1"])"), ",",
+       Tab("u1", "https://today.example/", "Today", 10), ",",
+       Parent("p2", "itemContainer", "[]"), ",",
+       Parent("u2", "itemContainer", R"(["v1"])"), ",",
+       Tab("v1", "HTTP://upper.example/", "Upper", 10)});
+  const std::string spaces = base::StrCat(
+      {R"("s1",)",
+       Space("s1", "First", kOneSpace,
+             R"(,"customInfo":{"iconType":{"emoji":1,"emoji_v2":"\ud83d\ude80"}})"),
+       ",",
+       // The newer key only, and a bare code point for the icon.
+       Space("s2", "",
+             R"("newContainerIDs":[{"unpinned":{}},"u2",{"pinned":{}},"p2"])",
+             R"(,"customInfo":{"iconType":{"emoji":128640}})")});
+  const std::optional<ArcImportPlan> plan = ParseArcSidebarJson(
+      Sidebar(items, spaces, R"([{"default":true},"fav"])"));
+
+  ASSERT_TRUE(plan);
+  ASSERT_EQ(plan->favorites.size(), 1u);
+  EXPECT_EQ(plan->favorites[0].arc_id, "f1");
+  EXPECT_FALSE(plan->favorites[0].anchored);
+
+  ASSERT_EQ(plan->workspaces.size(), 2u);
+  const ArcWorkspace& first = plan->workspaces[0];
+  EXPECT_EQ(first.arc_space_id, "s1");
+  EXPECT_EQ(first.title, "First");
+  EXPECT_EQ(first.icon, "\xF0\x9F\x9A\x80");
+  EXPECT_EQ(Shape(first.pinned), "[t1] A[t2] A > B[t3 t5+t6] [t4 t7]");
+  EXPECT_EQ(Shape(first.today), "[u1]");
+  EXPECT_TRUE(first.pinned[0].items[0].tabs[0].anchored);
+  EXPECT_FALSE(first.today[0].items[0].tabs[0].anchored);
+
+  const ArcWorkspace& second = plan->workspaces[1];
+  EXPECT_EQ(second.title, "Space");
+  EXPECT_EQ(second.icon, "\xF0\x9F\x9A\x80");
+  EXPECT_EQ(Shape(second.pinned), "");
+  EXPECT_EQ(Shape(second.today), "[v1]");
+
+  EXPECT_EQ(plan->skipped, 1);  // t8
+}
