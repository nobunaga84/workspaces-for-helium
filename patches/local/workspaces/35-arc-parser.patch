+// Not a test of the code above but of my reading of Arc's format: every
+// fixture in this file is a belief, and the real file is the only thing that
+// can contradict one. Skipped unless HELIUM_ARC_SIDEBAR names a file; prints
+// counts only, never a URL, a title or a name.
+TEST(ArcImportPlanTest, CountsFromARealSidebarWhenPointedAtOne) {
+  std::optional<std::string> path =
+      base::Environment::Create()->GetVar("HELIUM_ARC_SIDEBAR");
+  if (!path) {
+    GTEST_SKIP() << "set HELIUM_ARC_SIDEBAR to a StorableSidebar.json";
+  }
+  std::string json;
+  ASSERT_TRUE(base::ReadFileToString(base::FilePath::FromUTF8Unsafe(*path),
+                                     &json));
+  const std::optional<ArcImportPlan> plan = ParseArcSidebarJson(json);
+  ASSERT_TRUE(plan);
+
+  std::cout << "ARC favorites=" << plan->favorites.size()
+            << " workspaces=" << plan->workspaces.size()
+            << " skipped=" << plan->skipped << "\n";
+  int index = 0;
+  for (const ArcWorkspace& workspace : plan->workspaces) {
+    int tabs[2] = {0, 0}, groups = 0, splits = 0, renamed = 0;
+    const std::vector<ArcUnit>* const halves[2] = {&workspace.pinned,
+                                                   &workspace.today};
+    for (int half = 0; half < 2; ++half) {
+      for (const ArcUnit& unit : *halves[half]) {
+        groups += unit.group_title.empty() ? 0 : 1;
+        for (const ArcItem& item : unit.items) {
+          splits += item.tabs.size() == 2 ? 1 : 0;
+          tabs[half] += static_cast<int>(item.tabs.size());
+          for (const ArcTab& tab : item.tabs) {
+            renamed += tab.custom_title.empty() ? 0 : 1;
+          }
+        }
+      }
+    }
+    std::cout << "ARC space " << ++index << ": pinned=" << tabs[0]
+              << " today=" << tabs[1] << " groups=" << groups
+              << " splits=" << splits << " renamed=" << renamed
+              << " icon_bytes=" << workspace.icon.size() << "\n";
+  }
+}
