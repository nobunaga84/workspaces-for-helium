+std::vector<content::WebContents*> WorkspaceService::SelectedMovableTabs()
+    const {
+  std::vector<content::WebContents*> tabs;
+  for (tabs::TabInterface* tab : tab_strip_->selection_model().selected_tabs()) {
+    // A pinned tab has no workspace -- it is drawn in all of them (design 2.5)
+    // -- so moving one would give it a guid and hide it everywhere but the
+    // destination. Skipped rather than refusing the whole move: a selection
+    // that happens to include a pinned tab should still move the others, and
+    // the count the menu shows has to agree with what actually happens.
+    if (tab && tab->GetContents() && !tab->IsPinned()) {
+      tabs.push_back(tab->GetContents());
+    }
+  }
+  return tabs;
+}
+
+int WorkspaceService::SelectedMovableTabCount() const {
+  return static_cast<int>(SelectedMovableTabs().size());
+}
+
+int WorkspaceService::MoveSelectedTabsToWorkspace(std::string_view guid) {
+  if (!IsEnabled()) {
+    return 0;
+  }
+
+  // Refuse a workspace that does not exist rather than tagging tabs for it.
+  // Every other guid entry point resolves; this one rejects, because a move is
+  // the user naming a destination and silently sending the tabs somewhere else
+  // would be worse than doing nothing.
+  if (ResolveTabGuid(guid, known_guids_) != guid) {
+    return 0;
+  }
+
+  const std::vector<content::WebContents*> moving = SelectedMovableTabs();
+
+  for (content::WebContents* contents : moving) {
+    SetTag(contents, std::string(guid));
+  }
+
+  if (moving.empty()) {
+    return 0;
+  }
+
+  LOG(INFO) << "[workspaces] moved " << moving.size() << " tab(s) -> workspace '"
+            << guid << "'";
+
+  // Nothing else would repaint. SetTag writes the tag and persists it, and the
+  // only thing that fires workspace_changed_callbacks_ is a change of ACTIVE
+  // workspace -- so without this a tab moved out of the workspace on screen
+  // stays drawn until something unrelated invalidates the layout.
+  workspace_changed_callbacks_.Notify();
+
+  // The user may have just sent away the tab they were looking at. Legal to
+  // call directly rather than posted: this runs from a menu handler, outside
+  // the observer scope design 2.2 forbids mutating from.
+  EnsureActiveTabVisible();
+
+  return static_cast<int>(moving.size());
+}
