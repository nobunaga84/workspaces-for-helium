+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/workspaces/workspace_stamping.h"
+
+#include <string>
+#include <string_view>
+
+namespace workspaces {
+
+std::string ResolveGuidForInsertedTab(std::string_view existing_guid,
+                                      std::string_view opener_guid,
+                                      std::string_view active_guid) {
+  if (!existing_guid.empty()) {
+    return std::string(existing_guid);
+  }
+  if (!opener_guid.empty()) {
+    return std::string(opener_guid);
+  }
+  if (!active_guid.empty()) {
+    return std::string(active_guid);
+  }
+  return std::string(kDefaultWorkspaceGuid);
+}
+
+}  // namespace workspaces
