+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/workspaces/workspace_service.h"
+
+#include <string>
+
+#include "base/logging.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/workspaces/workspace_stamping.h"
+#include "chrome/browser/ui/tabs/workspaces/workspace_tab_data.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+
+namespace workspaces {
+
+DEFINE_USER_DATA(WorkspaceService);
+
+WorkspaceService::WorkspaceService(
+    TabStripModel& tab_strip_model,
+    ui::UnownedUserDataHost& unowned_user_data_host)
+    : tab_strip_(tab_strip_model),
+      active_guid_(kDefaultWorkspaceGuid),
+      scoped_data_holder_(unowned_user_data_host, *this) {
+  tab_strip_->AddObserver(this);
+}
+
+WorkspaceService::~WorkspaceService() {
+  tab_strip_->RemoveObserver(this);
+}
+
+// static
+WorkspaceService* WorkspaceService::From(BrowserWindowInterface* browser) {
+  return browser ? Get(browser->GetUnownedUserDataHost()) : nullptr;
+}
+
+void WorkspaceService::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (change.type() != TabStripModelChange::kInserted) {
+    return;
+  }
+
+  for (const auto& inserted : change.GetInsert()->contents) {
+    tabs::TabInterface* tab = inserted.tab.get();
+    if (!tab) {
+      continue;
+    }
+    content::WebContents* contents = tab->GetContents();
+    if (!contents) {
+      continue;
+    }
+
+    WorkspaceTabData* tab_data =
+        WorkspaceTabData::GetOrCreateForWebContents(contents);
+
+    // The opener's workspace is not consulted yet -- reading it needs the
+    // opener lookup that arrives with the rest of the stamping table. Passing
+    // empty here makes ResolveGuidForInsertedTab fall through to the active
+    // workspace, which is the right answer for every tab a user opens directly.
+    tab_data->set_guid(ResolveGuidForInsertedTab(
+        tab_data->guid(), /*opener_guid=*/std::string_view(), active_guid_));
+
+    // Temporary: the visible proof that the service is wired into a real
+    // window and observing a real tab strip. Replaced when rendering starts
+    // reading these tags.
+    LOG(INFO) << "[workspaces] tab inserted at index " << inserted.index
+              << " -> workspace '" << tab_data->guid() << "'";
+  }
+}
+
+}  // namespace workspaces
