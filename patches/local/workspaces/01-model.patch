+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_STAMPING_H_
+#define CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_STAMPING_H_
+
+#include <string>
+#include <string_view>
+
+// The rules deciding which workspace a tab belongs to.
+//
+// Everything here is a free function over plain values -- no Profile, no
+// TabStripModel, no WebContents. That is deliberate and load-bearing: it is
+// what lets these rules be tested in workspaces_unittests, which does not link
+// //chrome/test:test_support and therefore builds at all in this fork
+// (LOCAL.md 8). The TabStripModelObserver stays a thin adapter that reads
+// values off the model and calls in here.
+//
+// Keep it that way. A rule that needs a live Chromium object is a rule nobody
+// can test.
+namespace workspaces {
+
+// The workspace an untagged tab belongs to. An implicit default workspace
+// always exists and cannot be deleted while it is the only one, so an untagged
+// tab is never orphaned -- that covers first run, enabling the feature on a
+// profile with 200 open tabs, and a tab restored into a deleted workspace
+// (design 2.4).
+inline constexpr std::string_view kDefaultWorkspaceGuid = "default";
+
+// Which workspace a tab joins when it is inserted into a tab strip. Applied in
+// order (design 2.5):
+//
+//  1. A tab that already carries a tag keeps it. This is the case that makes
+//     dragging a tab between windows and restoring a session work at all: the
+//     tag travels on the tab, so the receiving window must not overwrite it.
+//  2. Otherwise it joins its opener's workspace, so a link opened from a tab
+//     lands beside the tab it came from.
+//  3. Otherwise it joins whatever workspace is active in this window.
+//
+// Never returns empty; falls back to kDefaultWorkspaceGuid.
+std::string ResolveGuidForInsertedTab(std::string_view existing_guid,
+                                      std::string_view opener_guid,
+                                      std::string_view active_guid);
+
+}  // namespace workspaces
+
+#endif  // CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_STAMPING_H_
