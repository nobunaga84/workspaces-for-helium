+++ b/chrome/browser/ui/tabs/workspaces/workspace_stamping_unittest.cc
@@ -0,0 +1,47 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/workspaces/workspace_stamping.h"
+
+#include <string>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace workspaces {
+namespace {
+
+// Rule 1 -- an existing tag always wins. This is the rule that makes dragging a
+// tab between windows and restoring a session work: the tag travels on the tab,
+// so the receiving window must not restamp it with its own active workspace.
+TEST(WorkspaceStampingTest, ExistingGuidIsKept) {
+  EXPECT_EQ("work", ResolveGuidForInsertedTab("work", "personal", "personal"));
+}
+
+// Rule 2 -- a link opened from a tab lands beside the tab it came from, even
+// when that tab is not in the active workspace.
+TEST(WorkspaceStampingTest, OpenerGuidUsedWhenUntagged) {
+  EXPECT_EQ("work", ResolveGuidForInsertedTab("", "work", "personal"));
+}
+
+// Rule 3 -- a plain new tab joins the workspace you are looking at.
+TEST(WorkspaceStampingTest, ActiveGuidUsedWithoutOpener) {
+  EXPECT_EQ("personal", ResolveGuidForInsertedTab("", "", "personal"));
+}
+
+// The result is never empty: an untagged tab belongs to the implicit default
+// workspace rather than to nothing (design 2.4).
+TEST(WorkspaceStampingTest, FallsBackToDefaultWorkspace) {
+  EXPECT_EQ(kDefaultWorkspaceGuid, ResolveGuidForInsertedTab("", "", ""));
+}
+
+// Precedence is existing > opener > active, checked as one chain rather than
+// relying on the three tests above to imply it.
+TEST(WorkspaceStampingTest, PrecedenceIsExistingThenOpenerThenActive) {
+  EXPECT_EQ("a", ResolveGuidForInsertedTab("a", "b", "c"));
+  EXPECT_EQ("b", ResolveGuidForInsertedTab("", "b", "c"));
+  EXPECT_EQ("c", ResolveGuidForInsertedTab("", "", "c"));
+}
+
+}  // namespace
+}  // namespace workspaces
