+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_SERVICE_H_
+#define CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_SERVICE_H_
+
+#include <string>
+
+#include "base/memory/raw_ref.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+
+class BrowserWindowInterface;
+class TabStripModel;
+
+namespace workspaces {
+
+// One per browser window. Owns which workspace that window is showing, and
+// stamps membership onto tabs as they arrive.
+//
+// Lifetime is managed by BrowserWindowFeatures; this object registers itself as
+// unowned user data on the window so production code can reach it with
+// WorkspaceService::From(browser) without BrowserWindowInterface growing a
+// method for it (see ui/base/unowned_user_data/README.md).
+//
+// THE RULE THAT KEEPS THIS FROM CRASHING (design 2.2): TabStripModel is not
+// re-entrant and enforces it with a CHECK, and observers are notified from
+// inside that guarded scope. So no method here may ever call a TabStripModel
+// mutator -- not AddTab, MoveWebContentsAt, ActivateTab, SetTabPinned or
+// CloseWebContentsAt. This observer stamps bookkeeping and nothing else.
+// Anything that has to move, activate or insert belongs in a posted task or a
+// command handler.
+class WorkspaceService : public TabStripModelObserver {
+ public:
+  DECLARE_USER_DATA(WorkspaceService);
+
+  WorkspaceService(TabStripModel& tab_strip_model,
+                   ui::UnownedUserDataHost& unowned_user_data_host);
+  WorkspaceService(const WorkspaceService&) = delete;
+  WorkspaceService& operator=(const WorkspaceService&) = delete;
+  ~WorkspaceService() override;
+
+  // Null if the window has no service (for example a window type Workspaces
+  // does not apply to).
+  static WorkspaceService* From(BrowserWindowInterface* browser);
+
+  // The workspace this window is currently showing. Per window and in memory
+  // only: two windows can show different workspaces, and nothing per-window is
+  // ever written to a pref (design 2.4).
+  const std::string& active_guid() const { return active_guid_; }
+
+ private:
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+  const raw_ref<TabStripModel> tab_strip_;
+  std::string active_guid_;
+
+  // Must be last: it publishes `this` to the window, so everything else has to
+  // be initialised before it, and it must be torn down first.
+  ui::ScopedUnownedUserData<WorkspaceService> scoped_data_holder_;
+};
+
+}  // namespace workspaces
+
+#endif  // CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_SERVICE_H_
