+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_TAB_DATA_H_
+#define CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_TAB_DATA_H_
+
+#include <string>
+
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace workspaces {
+
+// Which workspace a tab belongs to, stored on the tab itself.
+//
+// This is the source of truth for membership, and it is a tag rather than a
+// position (design 2.1). Rendering filters by tag, so a tab sitting at an
+// awkward index is still drawn in the right workspace, and none of the
+// index-range bookkeeping that sank the first design is needed.
+//
+// Living on the WebContents is what makes the tag survive the things that move
+// a tab around: dragging it into another window, moving it between tab strips,
+// and being restored from a session all carry this object along with the tab.
+//
+// Stage 5 adds anchor fields here; keep it a plain data holder with no
+// behaviour of its own.
+class WorkspaceTabData : public content::WebContentsUserData<WorkspaceTabData> {
+ public:
+  WorkspaceTabData(const WorkspaceTabData&) = delete;
+  WorkspaceTabData& operator=(const WorkspaceTabData&) = delete;
+  ~WorkspaceTabData() override;
+
+  // Empty until the tab has been stamped. An empty guid means "belongs to the
+  // implicit default workspace", never "belongs to nothing".
+  const std::string& guid() const { return guid_; }
+  void set_guid(std::string guid) { guid_ = std::move(guid); }
+
+ private:
+  friend class content::WebContentsUserData<WorkspaceTabData>;
+
+  explicit WorkspaceTabData(content::WebContents* web_contents);
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+
+  std::string guid_;
+};
+
+}  // namespace workspaces
+
+#endif  // CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_TAB_DATA_H_
