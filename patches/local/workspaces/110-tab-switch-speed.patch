+gfx::Size UnpinnedTabContainerViewLayout::GetPreferredSize(
+    const views::View* host,
+    const views::SizeBounds& available_size) const {
+  const auto* const list = views::AsViewClass<UnpinnedTabContainerView>(host);
+  if (orientation_ == TabStripOrientation::kVertical && list) {
+    if (const views::ProposedLayout* const layout =
+            RememberedVerticalLayout(list, available_size)) {
+      return layout->host_size;  // no copy of every child's entry
+    }
+  }
+  return LayoutManagerBase::GetPreferredSize(host, available_size);
+}
+
+const views::ProposedLayout*
+UnpinnedTabContainerViewLayout::RememberedVerticalLayout(
+    const UnpinnedTabContainerView* list,
+    const views::SizeBounds& size_bounds) const {
+  // Helium Workspaces (I1): LayoutManagerBase never caches a bounded width, and
+  // the vertical strip asks this list its size 30-40 times per layout --
+  // FlexLayout, TabStripViewLayout, the ScrollView up to four times, the box --
+  // and the animating manager recomputes its target twice per change
+  // (OnLayoutChanged, LayoutImpl), each a walk over every tab view, the other
+  // workspaces' too: ~340 ms of a tab switch at 3,240 tabs. Remembered until
+  // anything in the list changes (OnLayoutChanged), as WorkspacePinnedSectionView
+  // remembers its rows' height. Not while a drag runs or a group is focused:
+  // what those draw moves without an invalidation -- the drag is why LayoutImpl
+  // recomputes at all (its TODO).
+  if (list->IsHandlingDrag() || GetFocusedGroupId(list)) {
+    layouts_.clear();
+    return nullptr;
+  }
+  for (const auto& [bounds, layout] : layouts_) {
+    if (bounds == size_bounds) {
+      return &layout;
+    }
+  }
+  if (layouts_.size() == 8) {  // a window being resized asks each width
+    layouts_.erase(layouts_.begin());
+  }
+  layouts_.emplace_back(size_bounds, CalculateVerticalLayout(list, size_bounds));
+  return &layouts_.back().second;
+}
+
+void UnpinnedTabContainerViewLayout::OnLayoutChanged() {
+  layouts_.clear();
+  LayoutManagerBase::OnLayoutChanged();
+}
