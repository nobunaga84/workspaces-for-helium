+std::string_view SweepVerdictName(SweepVerdict verdict) {
+  switch (verdict) {
+    case SweepVerdict::kDue:
+      return "due";
+    case SweepVerdict::kNotDue:
+      return "not due";
+    case SweepVerdict::kActive:
+      return "active";
+    case SweepVerdict::kFavorite:
+      return "favorite";
+    case SweepVerdict::kPinnedItem:
+      return "pinned item";
+    case SweepVerdict::kAnchored:
+      return "anchored";
+    case SweepVerdict::kSplit:
+      return "split";
+    case SweepVerdict::kGrouped:
+      return "group";
+    case SweepVerdict::kNoAddress:
+      return "no address";
+    case SweepVerdict::kAudible:
+      return "audible";
+    case SweepVerdict::kCaptured:
+      return "captured";
+    case SweepVerdict::kDevice:
+      return "device";
+    case SweepVerdict::kDevTools:
+      return "devtools";
+    case SweepVerdict::kPictureInPicture:
+      return "picture-in-picture";
+    case SweepVerdict::kAsksBeforeLeaving:
+      return "leave site";
+    case SweepVerdict::kUnsavedWork:
+      return "unsaved work";
+  }
+  NOTREACHED();
+}
+
+base::Time SweepClock(const SweepFacts& facts) {
+  // A null time is the smallest, so the other one wins when only one is set.
+  const base::Time clock = std::max(facts.last_shown, facts.left_at);
+  return clock.is_null() ? clock : std::max(clock, facts.not_before);
+}
+
+bool IsDueForArchive(base::Time clock, base::Time now, base::TimeDelta after) {
+  // A clock after `now` is a negative age, under any positive `after`.
+  return after.is_positive() && !clock.is_null() && now - clock >= after;
+}
+
+SweepVerdict JudgeForSweep(const SweepFacts& facts,
+                           base::Time now,
+                           base::TimeDelta after) {
+  if (!IsDueForArchive(SweepClock(facts), now, after)) {
+    return SweepVerdict::kNotDue;
+  }
+  // The enum's order, so the first flag that holds names the verdict and the
+  // log's "kept" counts add up to the tabs kept (the header).
+  const std::pair<bool, SweepVerdict> never_list[] = {
+      {facts.active, SweepVerdict::kActive},
+      {facts.favorite, SweepVerdict::kFavorite},
+      {facts.pinned_item, SweepVerdict::kPinnedItem},
+      {facts.anchored, SweepVerdict::kAnchored},
+      {facts.split, SweepVerdict::kSplit},
+      {facts.grouped, SweepVerdict::kGrouped},
+      {facts.no_address, SweepVerdict::kNoAddress},
+      {facts.audible, SweepVerdict::kAudible},
+      {facts.captured, SweepVerdict::kCaptured},
+      {facts.device, SweepVerdict::kDevice},
+      {facts.devtools, SweepVerdict::kDevTools},
+      {facts.picture_in_picture, SweepVerdict::kPictureInPicture},
+      {facts.asks_before_leaving, SweepVerdict::kAsksBeforeLeaving},
+      {facts.unsaved_work, SweepVerdict::kUnsavedWork},
+  };
+  for (const auto& [holds, verdict] : never_list) {
+    if (holds) {
+      return verdict;
+    }
+  }
+  return SweepVerdict::kDue;
+}
+
+base::TimeDelta SweepInterval(base::TimeDelta after) {
+  if (!after.is_positive()) {
+    return base::TimeDelta();
+  }
+  return std::max(std::min(kSweepEvery, after / 2), base::Seconds(30));
+}
+
