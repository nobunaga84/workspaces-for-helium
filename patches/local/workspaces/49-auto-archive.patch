+// ------------------------------------------------ the auto-archive (E14d.3)
+
+constexpr base::TimeDelta kDay = base::Days(1);
+
+base::Time SweepNow() {
+  return base::Time::FromSecondsSinceUnixEpoch(1'760'000'000);
+}
+
+// A tab shown `age` ago, with none of the never-list's flags.
+SweepFacts ShownAgo(base::TimeDelta age) {
+  SweepFacts facts;
+  facts.last_shown = SweepNow() - age;
+  return facts;
+}
+
+// Never is 0, and a hand-edited negative value is Never too: the timer never
+// guesses.
+TEST(WorkspaceAutoArchiveTest, NeverArchivesAtZeroOrBelow) {
+  const base::Time long_ago = SweepNow() - base::Days(365);
+  EXPECT_FALSE(IsDueForArchive(long_ago, SweepNow(), base::TimeDelta()));
+  EXPECT_FALSE(IsDueForArchive(long_ago, SweepNow(), -kDay));
+}
+
+TEST(WorkspaceAutoArchiveTest, ANullOrFutureClockIsNeverDue) {
+  EXPECT_FALSE(IsDueForArchive(base::Time(), SweepNow(), kDay));
+  // The clock went back.
+  EXPECT_FALSE(IsDueForArchive(SweepNow() + base::Minutes(1), SweepNow(),
+                               base::Minutes(1)));
+}
+
+// "At least": exactly `after` is due, a second less is not.
+TEST(WorkspaceAutoArchiveTest, DueAtExactlyTheSetting) {
+  EXPECT_TRUE(IsDueForArchive(SweepNow() - kDay, SweepNow(), kDay));
+  EXPECT_FALSE(IsDueForArchive(SweepNow() - kDay + base::Seconds(1),
+                               SweepNow(), kDay));
+  EXPECT_TRUE(IsDueForArchive(SweepNow() - kDay - base::Seconds(1),
+                              SweepNow(), kDay));
+}
+
+// A tab sat on for hours is as old as its last_shown the moment it is left:
+// the later of the two counts, whichever it is.
+TEST(WorkspaceAutoArchiveTest, TheClockIsTheLaterOfShownAndLeft) {
+  SweepFacts facts;
+  EXPECT_TRUE(SweepClock(facts).is_null());
+
+  facts.last_shown = SweepNow() - base::Hours(13);
+  EXPECT_EQ(SweepClock(facts), facts.last_shown);
+  facts.left_at = SweepNow() - base::Minutes(5);
+  EXPECT_EQ(SweepClock(facts), facts.left_at);
+
+  facts.last_shown = SweepNow() - base::Minutes(1);
+  EXPECT_EQ(SweepClock(facts), facts.last_shown);
+
+  facts.last_shown = base::Time();
+  EXPECT_EQ(SweepClock(facts), facts.left_at);
+}
+
+// The last Arc import only ever delays: a tab imported by an older build
+// still carries Arc's last-used time, and its clock starts at the import.
+TEST(WorkspaceAutoArchiveTest, NotBeforeOnlyEverDelays) {
+  SweepFacts facts = ShownAgo(base::Days(3));
+  facts.left_at = SweepNow() - base::Days(2);
+  EXPECT_EQ(JudgeForSweep(facts, SweepNow(), kDay), SweepVerdict::kDue);
+
+  facts.not_before = SweepNow() - base::Hours(1);
+  EXPECT_EQ(SweepClock(facts), facts.not_before);
+  EXPECT_EQ(JudgeForSweep(facts, SweepNow(), kDay), SweepVerdict::kNotDue);
+
+  facts.not_before = SweepNow() - base::Days(5);
+  EXPECT_EQ(SweepClock(facts), facts.left_at);
+  EXPECT_EQ(JudgeForSweep(facts, SweepNow(), kDay), SweepVerdict::kDue);
+
+  // Never a clock for a tab that has none of its own.
+  SweepFacts no_clock;
+  no_clock.not_before = SweepNow() - base::Days(5);
+  EXPECT_TRUE(SweepClock(no_clock).is_null());
+  EXPECT_EQ(JudgeForSweep(no_clock, SweepNow(), kDay), SweepVerdict::kNotDue);
+}
+
+// Age first: a tab not due is kNotDue whatever else holds, so the log's kept
+// counts name only tabs the timer would otherwise have closed.
+TEST(WorkspaceAutoArchiveTest, AgeIsJudgedBeforeTheNeverList) {
+  SweepFacts young = ShownAgo(base::Hours(1));
+  young.audible = true;
+  young.active = true;
+  EXPECT_EQ(JudgeForSweep(young, SweepNow(), kDay), SweepVerdict::kNotDue);
+
+  // Never, even for a tab with nothing to keep it.
+  EXPECT_EQ(JudgeForSweep(ShownAgo(base::Days(365)), SweepNow(),
+                          base::TimeDelta()),
+            SweepVerdict::kNotDue);
+}
+
+TEST(WorkspaceAutoArchiveTest, TheNeverListIsJudgedInTheEnumsOrder) {
+  SweepFacts facts = ShownAgo(base::Days(2));
+  facts.active = true;
+  facts.favorite = true;
+  EXPECT_EQ(JudgeForSweep(facts, SweepNow(), kDay), SweepVerdict::kActive);
+
+  // Every pinned item's page is anchored too: the log must say which.
+  SweepFacts pinned = ShownAgo(base::Days(2));
+  pinned.pinned_item = true;
+  pinned.anchored = true;
+  EXPECT_EQ(JudgeForSweep(pinned, SweepNow(), kDay),
+            SweepVerdict::kPinnedItem);
+
+  // The E14d.3 review's neighbours, each pair with the earlier one winning.
+  struct Neighbours {
+    bool SweepFacts::* first;
+    bool SweepFacts::* second;
+    SweepVerdict verdict;
+  };
+  const Neighbours neighbours[] = {
+      {&SweepFacts::split, &SweepFacts::grouped, SweepVerdict::kSplit},
+      {&SweepFacts::grouped, &SweepFacts::no_address, SweepVerdict::kGrouped},
+      {&SweepFacts::captured, &SweepFacts::device, SweepVerdict::kCaptured},
+      {&SweepFacts::device, &SweepFacts::devtools, SweepVerdict::kDevice},
+  };
+  for (const auto& [first, second, verdict] : neighbours) {
+    SCOPED_TRACE(SweepVerdictName(verdict));
+    SweepFacts both = ShownAgo(base::Days(2));
+    both.*first = true;
+    both.*second = true;
+    EXPECT_EQ(JudgeForSweep(both, SweepNow(), kDay), verdict);
+  }
+}
+
+// Each flag alone keeps a due tab, under its own verdict.
+TEST(WorkspaceAutoArchiveTest, EachNeverListFlagAloneKeepsADueTab) {
+  EXPECT_EQ(JudgeForSweep(ShownAgo(base::Days(2)), SweepNow(), kDay),
+            SweepVerdict::kDue);
+
+  const std::pair<bool SweepFacts::*, SweepVerdict> flags[] = {
+      {&SweepFacts::active, SweepVerdict::kActive},
+      {&SweepFacts::favorite, SweepVerdict::kFavorite},
+      {&SweepFacts::pinned_item, SweepVerdict::kPinnedItem},
+      {&SweepFacts::anchored, SweepVerdict::kAnchored},
+      {&SweepFacts::split, SweepVerdict::kSplit},
+      {&SweepFacts::grouped, SweepVerdict::kGrouped},
+      {&SweepFacts::no_address, SweepVerdict::kNoAddress},
+      {&SweepFacts::audible, SweepVerdict::kAudible},
+      {&SweepFacts::captured, SweepVerdict::kCaptured},
+      {&SweepFacts::device, SweepVerdict::kDevice},
+      {&SweepFacts::devtools, SweepVerdict::kDevTools},
+      {&SweepFacts::picture_in_picture, SweepVerdict::kPictureInPicture},
+      {&SweepFacts::asks_before_leaving, SweepVerdict::kAsksBeforeLeaving},
+      {&SweepFacts::unsaved_work, SweepVerdict::kUnsavedWork},
+  };
+  for (const auto& [flag, verdict] : flags) {
+    SCOPED_TRACE(SweepVerdictName(verdict));
+    SweepFacts facts = ShownAgo(base::Days(2));
+    facts.*flag = true;
+    EXPECT_EQ(JudgeForSweep(facts, SweepNow(), kDay), verdict);
+  }
+}
+
+// Half the setting, capped at kSweepEvery, floored at 30 seconds; no timer
+// for Never.
+TEST(WorkspaceAutoArchiveTest, SweepInterval) {
+  EXPECT_EQ(SweepInterval(base::Minutes(2)), base::Seconds(60));
+  EXPECT_EQ(SweepInterval(kDay), kSweepEvery);
+  EXPECT_EQ(SweepInterval(base::Seconds(40)), base::Seconds(30));
+  EXPECT_EQ(SweepInterval(base::TimeDelta()), base::TimeDelta());
+  EXPECT_EQ(SweepInterval(-kDay), base::TimeDelta());
+}
+
+// The log reads them back: each distinct, none empty.
+TEST(WorkspaceAutoArchiveTest, EveryVerdictHasItsOwnName) {
+  std::set<std::string_view> names;
+  for (int i = 0; i <= static_cast<int>(SweepVerdict::kMaxValue); ++i) {
+    const std::string_view name =
+        SweepVerdictName(static_cast<SweepVerdict>(i));
+    EXPECT_FALSE(name.empty()) << i;
+    EXPECT_TRUE(names.insert(name).second) << name;
+  }
+  EXPECT_EQ(SweepVerdictName(SweepVerdict::kDue), "due");
+  EXPECT_EQ(SweepVerdictName(SweepVerdict::kAsksBeforeLeaving), "leave site");
+  EXPECT_EQ(SweepVerdictName(SweepVerdict::kGrouped), "group");
+  EXPECT_EQ(SweepVerdictName(SweepVerdict::kDevice), "device");
+}
+
