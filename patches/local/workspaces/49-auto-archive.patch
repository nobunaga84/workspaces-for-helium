+// The auto-archive's rules (E14d.3, design 5 "Auto-archive"), free functions
+// over plain values so workspaces_unittests reaches them. The sweep itself --
+// the timer, the tabs, the close -- is WorkspaceService's.
+
+// The longest a window waits between sweeps. A shorter setting sweeps at
+// half its length (SweepInterval), so a test's 2 minutes is watched within 3.
+inline constexpr base::TimeDelta kSweepEvery = base::Minutes(5);
+// A tab that went quiet less than this long ago is still audible to the
+// sweep: a background music tab is silent for the seconds between two tracks
+// (SweepFacts::audible).
+inline constexpr base::TimeDelta kRecentlyAudibleFor = base::Minutes(1);
+// At most this many tabs leave one window per sweep: each close costs about
+// 3n session commands at n = 3,900 tabs (design 5, the E14 table).
+inline constexpr size_t kMaxPerSweep = 25;
+
+// One tab as the sweep sees it. The live signals (audible down to
+// unsaved_work) are false for a tab that is asleep -- discarded, or never
+// loaded since a restore: it has no document, and its age alone decides.
+struct SweepFacts {
+  // WebContents::GetLastActiveTime(): stamped when the tab is SHOWN, never
+  // when it is hidden (web_contents_impl.cc), and saved with the session.
+  base::Time last_shown;
+  // When the user last left the tab in this run (WorkspaceTabData::left_at);
+  // null when not since the start. A tab sat on for 13 hours is 13 hours old
+  // by last_shown the moment it is left, so the later of the two counts.
+  base::Time left_at;
+  // When the last Arc import started (kHeliumWorkspacesArcImportedAt); null
+  // when never. An imported tab's clock starts on its import day (the owner),
+  // and this also covers an import by an older build (36-48), whose tabs
+  // still carry Arc's last-used time. It can only ever delay an archive.
+  base::Time not_before;
+  // The window's active tab.
+  bool active = false;
+  // A Chromium-pinned tab (a favorite): never archived (E14d.2).
+  bool favorite = false;
+  // A pinned item's page (E15c). Judged before `anchored`, which every
+  // pinned item's page also is, so the log tells the two apart.
+  bool pinned_item = false;
+  // The anchor tag (WorkspaceTabData::anchored).
+  bool anchored = false;
+  // A split member (v1: a split closes as a unit).
+  bool split = false;
+  // In a tab group: closing a saved group's last tab deletes the saved group,
+  // which the archive cannot bring back.
+  bool grouped = false;
+  // Nothing the archive could give back: no last committed address, one a
+  // restore cannot open (anything but http, https, file and chrome: blob:,
+  // data:, about:, filesystem:), or an untouched New Tab page. Stricter than
+  // ArchiveClosingTab's rule, which the user's own close keeps.
+  bool no_address = false;
+  // Playing sound now, or stopped less than kRecentlyAudibleFor ago
+  // (WebContents::IsCurrentlyAudible; performance_manager's PageNode::
+  // IsAudible() and GetTimeSinceLastAudibleChange()).
+  bool audible = false;
+  // Being captured (WebContents::IsBeingCaptured), or capturing the camera,
+  // the microphone, a window or the display, or being mirrored
+  // (performance_manager's PageLiveStateDecorator).
+  bool captured = false;
+  // Connected to a USB, Bluetooth, HID or serial device
+  // (PageLiveStateDecorator).
+  bool device = false;
+  // DevTools attached to it.
+  bool devtools = false;
+  // Showing a picture-in-picture video or document.
+  bool picture_in_picture = false;
+  // A live frame has a beforeunload handler: a timer must never raise a
+  // "Leave site?" out of nowhere (design 5, the E14 table).
+  bool asks_before_leaving = false;
+  // The user typed into the page: performance_manager's
+  // PageNode::HadFormInteraction() or HadUserEdits(). The archive keeps the
+  // address, never what was typed.
+  bool unsaved_work = false;
+};
+
+// What the sweep decides for one tab. kDue is the only verdict that closes;
+// every verdict after kNotDue is a tab old enough that the sweep KEPT, so the
+// log's "kept" counts name only tabs the timer would otherwise have closed.
+// JudgeForSweep checks them, and the log lists them, in this order: the tab's
+// place (active down to a group), then what it can give back, then what it
+// is doing (audible down to unsaved work).
+enum class SweepVerdict {
+  kDue,
+  kNotDue,
+  kActive,
+  kFavorite,
+  kPinnedItem,
+  kAnchored,
+  kSplit,
+  kGrouped,
+  kNoAddress,
+  kAudible,
+  kCaptured,
+  kDevice,
+  kDevTools,
+  kPictureInPicture,
+  kAsksBeforeLeaving,
+  kUnsavedWork,
+  kMaxValue = kUnsavedWork,
+};
+
+// The log's word for a verdict: "due", "not due", "active", "favorite",
+// "pinned item", "anchored", "split", "group", "no address", "audible",
+// "captured", "device", "devtools", "picture-in-picture", "leave site",
+// "unsaved work".
+std::string_view SweepVerdictName(SweepVerdict verdict);
+
+// The time a tab's age counts from: the latest of last_shown, left_at and
+// not_before; null only when last_shown and left_at both are -- not_before
+// never gives a tab a clock it lacks.
+base::Time SweepClock(const SweepFacts& facts);
+
+// Whether a tab whose clock is `clock` has been left alone for at least
+// `after` at `now`. False for `after` <= 0 (Never), a null clock, and a clock
+// after `now` (the clock went back): the timer never guesses.
+bool IsDueForArchive(base::Time clock, base::Time now, base::TimeDelta after);
+
+// The verdict for one tab, checked in this order: its age first
+// (IsDueForArchive(SweepClock(facts), ...), else kNotDue), then the
+// never-list in the enum's order, active down to unsaved_work -- the first
+// that holds is the verdict -- else kDue.
+SweepVerdict JudgeForSweep(const SweepFacts& facts,
+                           base::Time now,
+                           base::TimeDelta after);
+
+// How often a window sweeps for the setting `after`: the smaller of
+// kSweepEvery and half of `after`, never under 30 seconds; TimeDelta() -- no
+// timer -- for `after` <= 0 (Never).
+base::TimeDelta SweepInterval(base::TimeDelta after);
+
