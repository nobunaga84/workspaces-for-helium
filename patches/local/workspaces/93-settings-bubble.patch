+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_WORKSPACE_SETTINGS_BUBBLE_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_WORKSPACE_SETTINGS_BUBBLE_VIEW_H_
+
+class BrowserWindowInterface;
+
+namespace views {
+class View;
+}  // namespace views
+
+// "Workspace settings..." on the rail's "+" menu (the slim chunk, patch 93):
+// the four settings that left chrome://settings, so the Settings page keeps
+// only Workspaces on/off and the little window (upstream-slim.md, the owner's
+// rule of 2026-10-25).
+//
+//   Workspace settings
+//   Archive tabs after                         [ Never      v ]
+//   Tabs you haven't looked at for this long move to the Archive, ...
+//   Tab style                                  [ Default    v ]
+//   Smooth scrolling in the tab list                     (o  )
+//   The tab list glides when you roll the mouse wheel
+//   Allow a wider sidebar                                (o  )
+//   Drag the sidebar's edge as wide as the window allows. ...
+//
+// - The same prefs the Settings rows wrote, so today's values carry over; each
+//   control writes as it changes, as the Settings page did, so there are no
+//   buttons. They are the profile's (the original one from an incognito
+//   window, as chrome://settings is).
+// - A dropdown shows blank for a value it does not offer (a test's 2 minutes,
+//   a hand-edited 38 px), and leaves it as it is until an item is picked.
+// - Nothing is watched while open. Import workspaces... also writes these
+//   prefs, but it is on the "+" menu, and opening that closes the bubble.
+// - Reachable only while Workspaces is on, as the rail is; Tab style and the
+//   wider sidebar act even when it is off (upstream-slim.md D-S2).
+//
+// Logs: "[workspaces] settings: opened",
+//       "[workspaces] settings: <pref> -> <value>".
+//
+// Anchored to the rail, never to the "+" button, as the edit bubble is.
+void ShowWorkspaceSettingsBubble(BrowserWindowInterface* browser,
+                                 views::View* anchor);
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_WORKSPACE_SETTINGS_BUBBLE_VIEW_H_
