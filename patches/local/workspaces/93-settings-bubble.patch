+
+// Wider than the edit bubble's 300, so a note wraps to two lines at most.
+constexpr int kWidth = 360;
+
+// The Settings rows' options (appearance_page.html.ts before the slim chunk),
+// item for item: the string, and the value written.
+constexpr int kArchiveAfterIds[] = {
+    IDS_SETTINGS_WORKSPACES_ARCHIVE_AFTER_NEVER,
+    IDS_SETTINGS_WORKSPACES_ARCHIVE_AFTER_1_DAY,
+    IDS_SETTINGS_WORKSPACES_ARCHIVE_AFTER_7_DAYS,
+    IDS_SETTINGS_WORKSPACES_ARCHIVE_AFTER_30_DAYS};
+constexpr int kArchiveAfterMinutes[] = {0, 1440, 10080, 43200};
+constexpr int kTabStyleIds[] = {
+    IDS_SETTINGS_TAB_STYLE_DEFAULT, IDS_SETTINGS_TAB_STYLE_ROOMY_36,
+    IDS_SETTINGS_TAB_STYLE_ROOMY_40, IDS_SETTINGS_TAB_STYLE_ROOMY_42};
+constexpr int kTabStyleHeights[] = {workspaces::prefs::kCompactTabRowHeight, 36,
+                                    40, 42};
+
+// "Title   [control]" with its note under it, the whole width: a
+// chrome://settings row. `note_id` 0 for none. Returns the control, named for
+// a screen reader by the title.
+template <typename T>
+T* AddRow(views::View* parent,
+          int title_id,
+          int note_id,
+          std::unique_ptr<T> control) {
+  auto* const group = parent->AddChildView(std::make_unique<views::View>());
+  group->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+  auto* const row = group->AddChildView(std::make_unique<views::View>());
+  auto* const row_layout =
+      row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+          views::LayoutProvider::Get()->GetDistanceMetric(
+              views::DISTANCE_RELATED_LABEL_HORIZONTAL)));
+  row_layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+
+  const std::u16string title = l10n_util::GetStringUTF16(title_id);
+  auto* const label = row->AddChildView(std::make_unique<views::Label>(title));
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  row_layout->SetFlexForView(label, 1);
+  T* const added = row->AddChildView(std::move(control));
+  added->GetViewAccessibility().SetName(title);
+
+  if (note_id) {
+    auto* const note = group->AddChildView(std::make_unique<views::Label>(
+        l10n_util::GetStringUTF16(note_id), views::style::CONTEXT_LABEL,
+        views::style::STYLE_SECONDARY));
+    note->SetMultiLine(true);
+    note->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  }
+  return added;
+}
+
+// A dropdown over `values`, writing the picked one to the integer `pref`.
+views::Combobox* AddDropdown(views::View* parent,
+                             PrefService* prefs,
+                             const char* pref,
+                             int title_id,
+                             int note_id,
+                             base::span<const int> ids,
+                             base::span<const int> values) {
+  std::vector<ui::SimpleComboboxModel::Item> items;
+  for (const int id : ids) {
+    items.emplace_back(l10n_util::GetStringUTF16(id));
+  }
+  views::Combobox* const box = AddRow(
+      parent, title_id, note_id,
+      std::make_unique<views::Combobox>(
+          std::make_unique<ui::SimpleComboboxModel>(std::move(items))));
+  const auto it = std::ranges::find(values, prefs->GetInteger(pref));
+  box->SetSelectedIndex(
+      it == values.end()
+          ? std::nullopt
+          : std::optional<size_t>(static_cast<size_t>(it - values.begin())));
+  box->SetCallback(base::BindRepeating(
+      [](PrefService* prefs, const char* pref, base::span<const int> values,
+         views::Combobox* box) {
+        const std::optional<size_t> index = box->GetSelectedIndex();
+        if (!index) {
+          return;
+        }
+        prefs->SetInteger(pref, values[*index]);
+        LOG(INFO) << "[workspaces] settings: " << pref << " -> "
+                  << values[*index];
+      },
+      base::Unretained(prefs), pref, values, base::Unretained(box)));
+  return box;
+}
+
+// A switch writing the boolean `pref`.
+void AddSwitch(views::View* parent,
+               PrefService* prefs,
+               const char* pref,
+               int title_id,
+               int note_id) {
+  views::ToggleButton* const toggle =
+      AddRow(parent, title_id, note_id, std::make_unique<views::ToggleButton>());
+  toggle->SetIsOn(prefs->GetBoolean(pref));
+  toggle->SetCallback(base::BindRepeating(
+      [](PrefService* prefs, const char* pref, views::ToggleButton* toggle) {
+        prefs->SetBoolean(pref, toggle->GetIsOn());
+        LOG(INFO) << "[workspaces] settings: " << pref << " -> "
+                  << toggle->GetIsOn();
+      },
+      base::Unretained(prefs), pref, base::Unretained(toggle)));
+}
+
+}  // namespace
+
+void ShowWorkspaceSettingsBubble(BrowserWindowInterface* browser,
+                                 views::View* anchor) {
+  PrefService* const prefs =
+      browser->GetProfile()->GetOriginalProfile()->GetPrefs();
+  auto contents = std::make_unique<views::View>();
+  contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(),
+      views::LayoutProvider::Get()->GetDistanceMetric(
+          views::DISTANCE_UNRELATED_CONTROL_VERTICAL)));
+  namespace p = workspaces::prefs;
+  views::Combobox* const first = AddDropdown(
+      contents.get(), prefs, p::kHeliumWorkspacesArchiveAfterMinutes,
+      IDS_SETTINGS_WORKSPACES_ARCHIVE_AFTER,
+      IDS_SETTINGS_WORKSPACES_ARCHIVE_AFTER_DESCRIPTION, kArchiveAfterIds,
+      kArchiveAfterMinutes);
+  AddDropdown(contents.get(), prefs, p::kHeliumWorkspacesTabRowHeight,
+              IDS_SETTINGS_TAB_STYLE, 0, kTabStyleIds, kTabStyleHeights);
+  AddSwitch(contents.get(), prefs, p::kHeliumWorkspacesSmoothScrolling,
+            IDS_SETTINGS_SMOOTH_TAB_LIST_SCROLLING,
+            IDS_SETTINGS_SMOOTH_TAB_LIST_SCROLLING_DESCRIPTION);
+  AddSwitch(contents.get(), prefs, p::kHeliumWorkspacesWideSidebar,
+            IDS_SETTINGS_WIDE_SIDEBAR, IDS_SETTINGS_WIDE_SIDEBAR_DESCRIPTION);
+
+  // No buttons: every control applies as it changes. The first dropdown takes
+  // the focus, so the keyboard starts in the bubble.
+  std::unique_ptr<ui::DialogModel> model =
+      ui::DialogModel::Builder()
+          .SetTitle(
+              l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_SETTINGS_TITLE))
+          .AddCustomField(
+              std::make_unique<views::BubbleDialogModelHost::CustomView>(
+                  std::move(contents),
+                  views::BubbleDialogModelHost::FieldType::kControl, first),
+              kSettingsFieldId)
+          .SetInitiallyFocusedField(kSettingsFieldId)
+          .Build();
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(model), anchor, views::BubbleBorder::BOTTOM_LEFT);
+  bubble->set_fixed_width(kWidth);
+  views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET)
+      ->Show();
+  LOG(INFO) << "[workspaces] settings: opened";
+}
