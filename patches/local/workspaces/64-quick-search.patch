+struct WorkspaceQuickSearchView::Candidate {
+  ResultKind kind = ResultKind::kTab;
+  // A pinned page's or an Archive entry's id; empty for a tab.
+  std::string id;
+  // A tab's; for a pinned page, its open page in THIS window, null when it
