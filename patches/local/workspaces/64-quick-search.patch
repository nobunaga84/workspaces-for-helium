+// static
+bool WorkspacePinnedSectionView::ShowItem(BrowserWindowInterface* browser,
+                                          std::string_view id) {
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser);
+  if (!service || !service->IsEnabled()) {
+    return false;
+  }
+  Profile* const profile = browser->GetProfile();
+  workspaces::pins::PinStore* const store =
+      workspaces::pins::PinStore::GetOrCreate(profile, profile->GetPath());
+  std::string key;
+  const PinNode* const found = FindItem(store->tree(), id, key);
+  if (!found) {
+    return false;
+  }
+  // A copy: entering a workspace below runs its observers, and nothing reads
+  // the store's rows after anything changed.
+  const PinNode item = *found;
+  // Checked before any workspace is entered: a refusal changes nothing (C1).
+  if (!GURL(item.url).is_valid()) {
+    LOG(WARNING) << "[workspaces] pins: item '" << item.id
+                 << "' has no address a tab can open";
+    return false;
+  }
+  if (tabs::TabInterface* const tab =
+          LinkedTab(browser->GetTabStripModel(), id)) {
+    return ShowTab(browser, *tab);
+  }
+  // One place: an item open in another window of this profile is shown
+  // there, not opened a second time here.
+  for (BrowserWindowInterface* const window : WindowsOf(profile)) {
+    if (tabs::TabInterface* const tab =
+            LinkedTab(window->GetTabStripModel(), id)) {
+      ShowTab(browser, *tab);
+      LOG(INFO) << "[workspaces] pins: item '" << item.id
+                << "' is open in another window; showed it there";
+      return true;
+    }
+  }
+  // Home for a deleted workspace, as the section draws its rows (design 2.4).
+  const std::string guid(
+      workspaces::ResolveTabGuid(key, service->known_guids()));
+  service->EnterWorkspaceForInsert(guid);
+  OpenItem(browser, item, guid);
+  return true;
+}
+
+// static
+bool WorkspacePinnedSectionView::ShowTab(BrowserWindowInterface* browser,
+                                         tabs::TabInterface& tab) {
+  BrowserWindowInterface* const window = tab.GetBrowserWindowInterface();
+  TabStripModel* const model = window ? window->GetTabStripModel() : nullptr;
+  const int index = model ? model->GetIndexOfTab(&tab) : TabStripModel::kNoTab;
+  if (index == TabStripModel::kNoTab) {
+    return false;
+  }
+  if (!tab.IsPinned()) {
+    if (workspaces::WorkspaceService* const service =
+            workspaces::WorkspaceService::From(window)) {
+      const std::string tag =
+          workspaces::WorkspaceGuidForTab(tab.GetContents());
+      service->EnterWorkspaceForInsert(
+          workspaces::ResolveTabGuid(tag, service->known_guids()));
+    }
+  }
+  model->ActivateTabAt(index,
+                       TabStripUserGestureDetails(
+                           TabStripUserGestureDetails::GestureType::kOther));
+  if (window != browser) {
+    window->GetWindow()->Activate();
+  }
+  return true;
+}
