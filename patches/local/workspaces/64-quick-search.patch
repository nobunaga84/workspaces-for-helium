+// Calls `add` for every item under `rows`, all the way down, with the names
+// of the folders it is in, joined by newlines (C1: a pinned page matches by
+// its folders' names too, the owner).
+void ForEachItem(
+    const std::vector<PinNode>& rows,
+    const std::string& folders,
+    base::FunctionRef<void(const PinNode&, const std::string&)> add) {
+  for (const PinNode& row : rows) {
+    if (row.type == PinNode::Type::kItem) {
+      add(row, folders);
+    } else {
+      ForEachItem(row.children,
+                  folders.empty() ? row.title
+                                  : base::StrCat({folders, "\n", row.title}),
+                  add);
+    }
+  }
+}
