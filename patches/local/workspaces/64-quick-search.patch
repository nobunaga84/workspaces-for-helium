+  // empty for a favorite.
+  std::string guid;
+  // What the row says (ShownTitle), and what it is matched by, case-folded:
+  // the custom name and the title; the address (D18) and a pinned page's
+  // folder names.
+  std::u16string name;
+  std::u16string folded_name;
+  std::u16string folded_rest;
+  GURL url;
+  MruKey recency;
+  // A tab drawn in this window now, a favorite included (D7); a pinned page
+  // or an entry of the workspace this window shows.
+  bool on_screen = false;
+  // MatchScore() for the text in the field, set by each ApplyQuery().
+  int score = 0;
+  // Its workspace's rail mark and two spaces (the row's accessible name
+  // starts with it), its name and its colour; empty and -1 for a favorite.
+  std::u16string mark;
+  std::u16string workspace_name;
+  int color = -1;
+};
+
+// static
+void WorkspaceQuickSearchView::ShowOverPage(BrowserWindowInterface* browser) {
+  const base::ElapsedTimer timer;
+  LOG(INFO) << "[workspaces] shortcut: quick search";
+  // The gate before anything else: no store is made for a window that has
+  // Workspaces off.
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser);
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser);
+  if (!service || !service->IsEnabled() || !browser_view) {
+    LOG(INFO) << "[workspaces] quick search: off in this window";
+    return;
+  }
+  // D12: the key closes this window's box when it is open. Pressed in the
+  // box, the box hears it first (AcceleratorPressed); this is the rest.
+  if (const auto open = OpenBoxes().find(browser); open != OpenBoxes().end()) {
+    // A box already closing (Enter posted its widget's close) does not count:
+    // the press opens a new one (code review).
+    if (WorkspaceQuickSearchView* const box = open->second.get();
+        box && box->GetWidget() && !box->GetWidget()->IsClosed()) {
+      box->ToggleClosed();
+      return;
+    }
+    OpenBoxes().erase(open);
+  }
+
+  auto view = base::WrapUnique(new WorkspaceQuickSearchView(browser));
+  WorkspaceQuickSearchView* const box = view.get();
+  // A bare box (the owner): no title on screen -- it is the box's accessible
+  // title only -- no x, no buttons. Escape is the bubble's own; the field
+  // takes the focus, so typing searches at once.
+  std::unique_ptr<ui::DialogModel> model =
+      ui::DialogModel::Builder()
+          .SetAccessibleTitle(
+              l10n_util::GetStringUTF16(IDS_HELIUM_QUICK_SEARCH))
+          .OverrideShowCloseButton(false)
+          .AddCustomField(
+              std::make_unique<views::BubbleDialogModelHost::CustomView>(
+                  std::move(view),
+                  views::BubbleDialogModelHost::FieldType::kControl,
+                  box->search_.get()),
+              kQuickSearchFieldId)
+          .SetInitiallyFocusedField(kQuickSearchFieldId)
+          .Build();
+
+  // Centred over the page, as the Archive's shortcut (C22): zen mode usually
+  // hides the bar.
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(model), browser_view->contents_container(),
+      views::BubbleBorder::FLOAT);
+  bubble->set_fixed_width(kWidth);
+  bubble->set_corner_radius(kBubbleRadius);
+  views::Widget* const widget =
+      views::BubbleDialogDelegate::CreateBubbleDeprecated(
+          std::move(bubble),
+          views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET);
+  OpenBoxes()[browser] = box->weak_factory_.GetWeakPtr();
+  widget->Show();
+  // Laid out inside the timing, so the number is what the user waited for.
+  widget->LayoutRootViewIfNecessary();
+
+  const auto count = [box](ResultKind kind) {
+    return std::ranges::count(box->candidates_, kind, &Candidate::kind);
+  };
+  LOG(INFO) << "[workspaces] quick search: opened, " << count(ResultKind::kTab)
+            << " tab(s) " << count(ResultKind::kPin) << " pinned "
+            << count(ResultKind::kArchive) << " archived in "
+            << timer.Elapsed().InMilliseconds() << " ms";
+  LOG(INFO) << "[workspaces] quick search: recent, " << box->shown_.size()
+            << " shown";
+}
+
+WorkspaceQuickSearchView::WorkspaceQuickSearchView(
+    BrowserWindowInterface* browser)
+    : browser_(browser),
+      pins_(PinStore::GetOrCreate(browser->GetProfile(),
+                                  browser->GetProfile()->GetPath())),
+      archive_(ArchiveStore::GetOrCreate(browser->GetProfile(),
+                                         browser->GetProfile()->GetPath())) {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), kSpacing));
+
+  // The Archive's search field (E17c): its icon inside the field's own
+  // border, so the field keeps Chromium's outline and focus ring.
+  // ponytail: placed for left-to-right text, as the Archive's.
+  search_ = AddChildView(std::make_unique<views::Textfield>());
+  search_->SetPlaceholderText(
+      l10n_util::GetStringUTF16(IDS_HELIUM_QUICK_SEARCH));
+  search_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_HELIUM_QUICK_SEARCH));
+  search_->set_controller(this);
+  search_->SetExtraInsets(gfx::Insets::TLBR(0, kIconSize + kSpacing, 0, 0));
+  search_->SetPreferredSize(gfx::Size(0, kSearchHeight));
+  auto* const search_icon = search_->AddChildView(
+      std::make_unique<views::ImageView>(ui::ImageModel::FromVectorIcon(
+          vector_icons::kSearchIcon, ui::kColorIcon, kIconSize)));
+  search_icon->SetBounds(views::LayoutProvider::Get()->GetDistanceMetric(
+                             views::DISTANCE_TEXTFIELD_HORIZONTAL_TEXT_PADDING),
+                         (kSearchHeight - kIconSize) / 2, kIconSize, kIconSize);
+  search_icon->SetCanProcessEventsWithinSubtree(false);
+  search_icon->GetViewAccessibility().SetIsIgnored(true);
+
+  // D12: the shortcut, as the browser has it, closes the box.
+  if (const BrowserView* const browser_view =
+          BrowserView::GetBrowserViewForBrowser(browser)) {
+    ui::Accelerator accelerator;
+    if (browser_view->GetAccelerator(IDC_HELIUM_QUICK_SEARCH, &accelerator)) {
+      AddAccelerator(accelerator);
+    }
+  }
+
+  // Without layers, as the Archive's list: a label over a layer that is not
+  // opaque DCHECKs on subpixel text, and the bubble's own colour behind the
+  // rows keeps their text on an opaque background.
+  scroll_view_ = AddChildView(std::make_unique<views::ScrollView>(
+      views::ScrollView::ScrollWithLayers::kDisabled));
+  scroll_view_->SetBackgroundColor(ui::kColorBubbleBackground);
+  scroll_view_->SetHorizontalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kDisabled);
+  scroll_view_->ClipHeightTo(kListHeight, kListHeight);
+
+  // The pool, made here, off the widget, and attached with one SetContents
+  // (the class comment).
+  auto list = std::make_unique<views::View>();
+  list->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+  list->GetViewAccessibility().SetRole(ax::mojom::Role::kListBox);
+  empty_ = list->AddChildView(std::make_unique<views::Label>(
+      std::u16string(), views::style::CONTEXT_LABEL,
+      views::style::STYLE_SECONDARY));
+  empty_->SetMultiLine(true);
+  empty_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  empty_->SetBorder(
+      views::CreateEmptyBorder(gfx::Insets::VH(kSpacing, kRowInset)));
+  empty_->SetVisible(false);
+  for (size_t group = 0; group < kGroupCount; ++group) {
+    auto* const heading = list->AddChildView(std::make_unique<views::Label>(
+        l10n_util::GetStringUTF16(kGroupHeadings[group]),
+        views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+    heading->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    heading->SetBorder(views::CreateEmptyBorder(
+        gfx::Insets::TLBR(kSpacing, kRowInset, kSpacing / 2, kRowInset)));
+    heading->GetViewAccessibility().SetRole(ax::mojom::Role::kHeading);
+    heading->SetVisible(false);
+    headings_.push_back(heading);
+    for (size_t row = 0; row < kMaxRows; ++row) {
+      const size_t slot = rows_.size();
+      rows_.push_back(
+          list->AddChildView(std::make_unique<WorkspaceQuickSearchRow>(
+              base::BindRepeating(&WorkspaceQuickSearchView::OnRowPressed,
+                                  base::Unretained(this), slot))));
+    }
+  }
+  scroll_view_->SetContents(std::move(list));
+
+  pins_observation_.Observe(pins_.get());
+  // Unretained: the subscription is a member, so it ends with this view.
+  archive_changed_subscription_ =
+      archive_->RegisterChangedCallback(base::BindRepeating(
+          &WorkspaceQuickSearchView::PostRefresh, base::Unretained(this)));
+  Collect();
+  ApplyQuery();
+}
+
+WorkspaceQuickSearchView::~WorkspaceQuickSearchView() {
+  // The toggle's entry for this window goes with its box.
+  if (const auto open = OpenBoxes().find(browser_.get());
+      open != OpenBoxes().end() &&
+      (!open->second || open->second.get() == this)) {
+    OpenBoxes().erase(open);
+  }
+}
+
+bool WorkspaceQuickSearchView::AcceleratorPressed(
+    const ui::Accelerator& accelerator) {
+  ToggleClosed();
+  return true;
+}
+
+void WorkspaceQuickSearchView::ContentsChanged(
+    views::Textfield* sender,
+    const std::u16string& new_contents) {
+  const base::ElapsedTimer timer;
+  const bool recent = ApplyQuery();
+  // Back to the top, where the first row -- highlighted -- and its heading
+  // are; laid out inside the timing, the layout being most of a keystroke.
+  scroll_view_->ScrollToOffset(gfx::PointF());
+  if (views::Widget* const widget = GetWidget()) {
+    widget->LayoutRootViewIfNecessary();
+  }
+  if (recent) {
+    LOG(INFO) << "[workspaces] quick search: recent, " << shown_.size()
+              << " shown";
+    return;
+  }
+  LOG(INFO) << "[workspaces] quick search: filter of " << new_contents.size()
+            << " char(s) -> " << ShownInGroup(0) << "/" << ShownInGroup(1)
+            << "/" << ShownInGroup(2) << " shown in "
+            << timer.Elapsed().InMilliseconds() << " ms";
+}
+
+bool WorkspaceQuickSearchView::HandleKeyEvent(views::Textfield* sender,
+                                              const ui::KeyEvent& key_event) {
+  // A key an input method is composing with is the method's.
+  if (key_event.type() != ui::EventType::kKeyPressed ||
+      sender->IsIMEComposing()) {
+    return false;
+  }
+  switch (key_event.key_code()) {
+    case ui::VKEY_UP:
+      MoveHighlight(-1);
+      return true;
+    case ui::VKEY_DOWN:
+      MoveHighlight(1);
+      return true;
+    case ui::VKEY_RETURN:
+      if (!highlighted_) {
+        return false;
+      }
+      Open(highlighted_->candidate());
+      return true;
+    default:
+      return false;
+  }
+}
+
+void WorkspaceQuickSearchView::OnPinsChanged() {
+  PostRefresh();
+}
+
+void WorkspaceQuickSearchView::Collect() {
+  candidates_.clear();
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service) {
+    return;
+  }
+  const std::string& active = service->active_guid();
+  const std::vector<std::string>& known = service->known_guids();
+
+  // Each workspace's rail mark, name and colour (the bar's, E17a), by guid:
+  // the Archive's Rebuild.
+  struct Mark {
+    std::u16string text;
+    std::u16string name;
+    int color;
+  };
+  std::map<std::string, Mark, std::less<>> marks;
+  const std::vector<workspaces::prefs::WorkspaceEntry> workspace_list =
+      service->GetWorkspaces();
+  const std::vector<int> colors =
+      workspaces::prefs::EffectiveColors(workspace_list);
+  for (size_t i = 0; i < workspace_list.size(); ++i) {
+    marks[workspace_list[i].guid] = {
+        WorkspaceRailView::ButtonText(workspace_list[i], i),
+        WorkspaceRailView::DisplayName(workspace_list[i]), colors[i]};
+  }
+
+  // A new candidate with its texts and its workspace's look. The reference
+  // lasts until the next one is added.
+  const auto add = [&](ResultKind kind, std::string_view guid,
+                       std::string_view custom, std::string_view title,
+                       std::string_view url,
+                       std::string_view folders) -> Candidate& {
+    Candidate& candidate = candidates_.emplace_back();
+    candidate.kind = kind;
+    candidate.guid = std::string(guid);
+    candidate.name = workspaces::archive::ShownTitle(custom, title, url);
+    candidate.folded_name = base::i18n::FoldCase(
+        base::UTF8ToUTF16(base::StrCat({custom, "\n", title})));
+    candidate.folded_rest = base::i18n::FoldCase(base::UTF8ToUTF16(
+        folders.empty() ? std::string(WithoutScheme(url))
+                        : base::StrCat({WithoutScheme(url), "\n", folders})));
+    candidate.url = GURL(url);
+    if (const auto mark = marks.find(candidate.guid); mark != marks.end()) {
+      candidate.mark = mark->second.text + u"  ";
+      candidate.workspace_name = mark->second.name;
+      candidate.color = mark->second.color;
+    }
+    return candidate;
+  };
+
+  // The tabs of every window of this profile that has Workspaces (D6), each
+  // by its own window's service. An open pinned page is listed once, under
+  // "Pinned pages" (D8): here only this window's are noted, by item id, for
+  // its row's handle (M3).
+  Profile* const profile = browser_->GetProfile();
+  std::map<std::string, tabs::TabHandle, std::less<>> open_pages;
+  for (BrowserWindowInterface* const window : GetAllBrowserWindowInterfaces()) {
+    const workspaces::WorkspaceService* const window_service =
+        window->GetProfile() == profile
+            ? workspaces::WorkspaceService::From(window)
+            : nullptr;
+    TabStripModel* const model = window->GetTabStripModel();
+    if (!window_service || !model) {
+      continue;
+    }
+    const bool here = window == browser_;
+    for (int i = 0; i < model->count(); ++i) {
+      tabs::TabInterface* const tab = model->GetTabAtIndex(i);
+      content::WebContents* const contents = tab->GetContents();
+      if (!contents) {
+        continue;
+      }
+      if (window_service->IsPinItemTab(tab)) {
+        if (here) {
+          open_pages.emplace(workspaces::PinItemForTab(contents),
+                             tab->GetHandle());
+        }
+        continue;
+      }
+      // A favorite is drawn in every workspace: no workspace of its own (D7).
+      const std::string tag = tab->IsPinned()
+                                  ? std::string()
+                                  : workspaces::WorkspaceGuidForTab(contents);
+      Candidate& candidate = add(
+          ResultKind::kTab,
+          tab->IsPinned()
+              ? std::string_view()
+              : workspaces::ResolveTabGuid(tag, window_service->known_guids()),
+          workspaces::CustomTitleForTab(contents),
+          base::UTF16ToUTF8(contents->GetTitle()),
+          contents->GetLastCommittedURL().spec(), {});
+      candidate.tab = tab->GetHandle();
+      candidate.recency = TabClock(contents);
+      candidate.on_screen = here && window_service->IsTabOnScreen(tab);
+    }
+  }
+
+  // Every pinned page of every workspace, with its folders' names; one open
+  // here carries its page's handle and clock.
+  for (const auto& [key, roots] : pins_->tree()) {
+    const std::string_view guid = workspaces::ResolveTabGuid(key, known);
+    ForEachItem(roots, std::string(),
+                [&](const PinNode& item, const std::string& folders) {
+                  Candidate& candidate =
+                      add(ResultKind::kPin, guid, item.custom_title, item.title,
+                          item.url, folders);
+                  candidate.id = item.id;
+                  candidate.on_screen = guid == active;
+                  const auto page = open_pages.find(item.id);
+                  tabs::TabInterface* const tab =
+                      page != open_pages.end() ? page->second.Get() : nullptr;
+                  if (tab) {
+                    candidate.tab = tab->GetHandle();
+                    candidate.recency = TabClock(tab->GetContents());
+                  } else {
+                    candidate.recency = {false, item.last_active};
+                  }
+                });
+  }
+
+  // Every Archive entry.
+  for (const ArchiveEntry& entry : archive_->entries()) {
+    const std::string_view guid =
+        workspaces::ResolveTabGuid(entry.workspace, known);
+    Candidate& candidate = add(ResultKind::kArchive, guid, entry.custom_title,
+                               entry.title, entry.url, {});
+    candidate.id = entry.id;
+    candidate.recency = {false, entry.archived_at};
+    candidate.on_screen = guid == active;
+  }
+}
+
+bool WorkspaceQuickSearchView::ApplyQuery() {
+  const std::vector<std::u16string> words =
+      workspaces::archive::QueryWords(search_->GetText());
+  const bool recent = words.empty();
+  // Candidate indices per group, best first, at most kMaxRows.
+  std::array<std::vector<size_t>, kGroupCount> picked;
+  const auto keep_best = [](std::vector<size_t>& indices, auto better) {
+    const size_t count = std::min(indices.size(), kMaxRows);
+    std::partial_sort(indices.begin(), indices.begin() + count, indices.end(),
+                      better);
+    indices.resize(count);
+  };
+  if (recent) {
+    // D16 as M3 revised it: this window's on-screen tabs and open pinned
+    // pages, the active tab left out, most recent first, all under the first
+    // heading.
+    const tabs::TabInterface* const active =
+        browser_->GetTabStripModel()->GetActiveTab();
+    for (size_t i = 0; i < candidates_.size(); ++i) {
+      const Candidate& candidate = candidates_[i];
+      const tabs::TabInterface* const tab = candidate.tab.Get();
+      if (candidate.kind != ResultKind::kArchive && candidate.on_screen &&
+          tab && tab != active) {
+        picked[0].push_back(i);
+      }
+    }
+    keep_best(picked[0], [this](size_t a, size_t b) {
+      return candidates_[a].recency > candidates_[b].recency;
+    });
+  } else {
+    for (size_t i = 0; i < candidates_.size(); ++i) {
+      Candidate& candidate = candidates_[i];
+      candidate.score = workspaces::archive::MatchScore(
+          candidate.folded_name, candidate.folded_rest, words);
+      if (candidate.score > 0) {
+        picked[static_cast<size_t>(candidate.kind)].push_back(i);
+      }
+    }
+    // Inside a group: the workspace on screen first, then the best match,
+    // then the most recent (the owner). The time alone (D10), not the empty
+    // box's MRU key: its "left" flag would rank any page left once above a
+    // page used later but never left (code review QS-1).
+    for (std::vector<size_t>& group : picked) {
+      keep_best(group, [this](size_t a, size_t b) {
+        const Candidate& x = candidates_[a];
+        const Candidate& y = candidates_[b];
+        return std::tie(x.on_screen, x.score, x.recency.second) >
+               std::tie(y.on_screen, y.score, y.recency.second);
+      });
+    }
+  }
+
+  // The pool re-labelled and shown or hidden; nothing added or removed.
+  shown_.clear();
+  for (size_t group = 0; group < kGroupCount; ++group) {
+    headings_[group]->SetText(l10n_util::GetStringUTF16(
+        recent && group == 0 ? IDS_HELIUM_QUICK_SEARCH_RECENT
+                             : kGroupHeadings[group]));
+    headings_[group]->SetVisible(!picked[group].empty());
+    for (size_t slot = 0; slot < kMaxRows; ++slot) {
+      WorkspaceQuickSearchRow* const row = rows_[group * kMaxRows + slot];
+      const bool show = slot < picked[group].size();
+      if (show) {
+        ShowCandidate(*row, picked[group][slot]);
+        shown_.push_back(row);
+      }
+      row->SetVisible(show);
+    }
+  }
+  empty_->SetText(l10n_util::GetStringUTF16(
+      recent ? IDS_HELIUM_QUICK_SEARCH_NONE : IDS_HELIUM_ARCHIVE_NO_MATCHES));
+  empty_->SetVisible(shown_.empty());
+  SetHighlight(shown_.empty() ? nullptr : shown_.front().get());
+  return recent;
+}
+
+void WorkspaceQuickSearchView::ShowCandidate(WorkspaceQuickSearchRow& row,
+                                             size_t index) {
+  const Candidate& candidate = candidates_[index];
+  row.Set(
+      index, candidate.name,
+      base::StrCat({candidate.name, u"\n",
+                    base::UTF8ToUTF16(candidate.url.possibly_invalid_spec())}),
+      candidate.mark + candidate.name, candidate.workspace_name,
+      candidate.color);
+  row.favicon_tasks().TryCancelAll();
+  // A tab's own icon, as its tab draws it (TabData: TabUIHelper's favicon).
+  if (candidate.kind == ResultKind::kTab) {
+    tabs::TabInterface* const tab = candidate.tab.Get();
+    row.SetIcon(tab ? tabs::TabData::FromTabInterface(tab).favicon
+                    : ui::ImageModel());
+    return;
+  }
+  if (const auto known = favicons_.find(candidate.url);
+      known != favicons_.end()) {
+    row.SetIcon(known->second);
+    return;
+  }
+  row.SetIcon(ui::ImageModel());
+  // A pinned page or an entry: asked as the Archive's row asks, with
+  // fallback_to_host -- another page of the same site often has one
+  // (LOCAL.md 43).
+  favicon::FaviconService* const favicons =
+      candidate.url.is_valid()
+          ? FaviconServiceFactory::GetForProfile(
+                browser_->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS)
+          : nullptr;
+  if (!favicons) {
+    return;
+  }
+  favicons->GetRawFaviconForPageURL(
+      candidate.url, {favicon_base::IconType::kFavicon}, gfx::kFaviconSize * 2,
+      /*fallback_to_host=*/true,
+      // The row's tracker cancels it at the row's next re-label, or with the
+      // row; the row lives as long as the box.
+      base::BindOnce(&WorkspaceQuickSearchView::OnFavicon,
+                     weak_factory_.GetWeakPtr(), base::Unretained(&row),
+                     candidate.url),
+      &row.favicon_tasks());
+}
+
+void WorkspaceQuickSearchView::OnFavicon(
+    WorkspaceQuickSearchRow* row,
+    const GURL& url,
+    const favicon_base::FaviconRawBitmapResult& result) {
+  // Asked for at twice the icon size, so it is crisp at 200 %.
+  ui::ImageModel icon;
+  if (result.is_valid()) {
+    const SkBitmap bitmap =
+        gfx::PNGCodec::Decode(base::span<const uint8_t>(*result.bitmap_data));
+    if (!bitmap.isNull()) {
+      icon = ui::ImageModel::FromImageSkia(gfx::ImageSkia::CreateFromBitmap(
+          bitmap, static_cast<float>(bitmap.width()) / gfx::kFaviconSize));
+    }
+  }
+  favicons_[url] = icon;
+  row->SetIcon(icon);
+}
+
+int WorkspaceQuickSearchView::ShownInGroup(size_t group) const {
+  return static_cast<int>(std::ranges::count_if(
+      shown_, [this, group](const WorkspaceQuickSearchRow* row) {
+        return static_cast<size_t>(candidates_[row->candidate()].kind) == group;
+      }));
+}
+
+void WorkspaceQuickSearchView::SetHighlight(WorkspaceQuickSearchRow* row) {
+  if (highlighted_) {
+    highlighted_->SetHighlighted(false);
+  }
+  highlighted_ = row;
+  if (!row) {
+    search_->GetViewAccessibility().ClearActiveDescendant();
+    return;
+  }
+  row->SetHighlighted(true);
+  search_->GetViewAccessibility().SetActiveDescendant(*row);
+}
+
+void WorkspaceQuickSearchView::MoveHighlight(int delta) {
+  if (shown_.empty()) {
+    return;
+  }
+  // D13: no wrap; the ends hold.
+  const auto at = std::ranges::find(shown_, highlighted_);
+  const int from = at == shown_.end()
+                       ? 0
+                       : static_cast<int>(std::distance(shown_.begin(), at));
+  const size_t to = static_cast<size_t>(
+      std::clamp(from + delta, 0, static_cast<int>(shown_.size()) - 1));
+  SetHighlight(shown_[to]);
+  shown_[to]->ScrollViewToVisible();
+}
+
+void WorkspaceQuickSearchView::OnRowPressed(size_t slot) {
+  if (rows_[slot]->GetVisible()) {
+    Open(rows_[slot]->candidate());
+  }
+}
+
+void WorkspaceQuickSearchView::Open(size_t index) {
+  // Not with Workspaces switched off while the box stays open (the Archive's
+  // restore, code review).
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service || !service->IsEnabled() || index >= candidates_.size()) {
+    return;
+  }
+  const Candidate& candidate = candidates_[index];
+
+  // D19: checked while the box is still open, so a result that went -- its
+  // tab closed, its entry restored in another window -- leaves the box, made
+  // again, where it was (D14).
+  bool there = false;
+  switch (candidate.kind) {
+    case ResultKind::kTab: {
+      tabs::TabInterface* const tab = candidate.tab.Get();
+      BrowserWindowInterface* const window =
+          tab ? tab->GetBrowserWindowInterface() : nullptr;
+      TabStripModel* const model =
+          window ? window->GetTabStripModel() : nullptr;
+      there = model && model->GetIndexOfTab(tab) != TabStripModel::kNoTab;
+      break;
+    }
+    case ResultKind::kPin: {
+      const PinNode* const item = pins_->Find(candidate.id);
+      there = item && item->type == PinNode::Type::kItem &&
+              GURL(item->url).is_valid();
+      break;
+    }
+    case ResultKind::kArchive: {
+      const auto entry = std::ranges::find(archive_->entries(), candidate.id,
+                                           &ArchiveEntry::id);
+      there = entry != archive_->entries().end() && GURL(entry->url).is_valid();
+      break;
+    }
+  }
+  if (!there) {
+    LOG(INFO) << "[workspaces] quick search: result gone";
+    PostRefresh();
+    return;
+  }
+
+  // Copies, then the box closes, then the result opens from them: opening
+  // can activate another window, after which nothing of this box is touched.
+  BrowserWindowInterface* const browser = browser_;
+  const ResultKind kind = candidate.kind;
+  const std::string id = candidate.id;
+  const std::string guid = candidate.guid;
+  const tabs::TabHandle tab = candidate.tab;
+  GetWidget()->Close();
+  OpenResult(browser, kind, id, guid, tab);
+}
+
+void WorkspaceQuickSearchView::ToggleClosed() {
+  LOG(INFO) << "[workspaces] quick search: toggled closed";
+  if (views::Widget* const widget = GetWidget();
+      widget && !widget->IsClosed()) {
+    widget->Close();
+  }
+}
+
+void WorkspaceQuickSearchView::PostRefresh() {
+  // Posted, never run here: the Archive's Add() calls this from inside
+  // TabStripModel's close (design 2.2). One refresh however many changes
+  // come first.
+  if (std::exchange(refresh_posted_, true)) {
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&WorkspaceQuickSearchView::Refresh,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void WorkspaceQuickSearchView::Refresh() {
+  refresh_posted_ = false;
+  views::Widget* const widget = GetWidget();
+  // An open result closes the box right after its change posted this.
+  if (!widget || widget->IsClosed()) {
+    return;
+  }
+  // D20: the highlight follows its result -- a tab by its handle, a pinned
+  // page or an entry by its id -- else the first row.
+  const auto identity = [](const Candidate& candidate) {
+    return Identity(
+        candidate.kind, candidate.id,
+        candidate.kind == ResultKind::kTab ? candidate.tab : tabs::TabHandle());
+  };
+  std::optional<Identity> kept;
+  if (highlighted_) {
+    kept = identity(candidates_[highlighted_->candidate()]);
+  }
+  Collect();
+  ApplyQuery();
+  if (kept) {
+    for (WorkspaceQuickSearchRow* const row : shown_) {
+      if (identity(candidates_[row->candidate()]) == *kept) {
+        SetHighlight(row);
+        break;
+      }
+    }
+  }
+  widget->LayoutRootViewIfNecessary();
+  if (highlighted_) {
+    highlighted_->ScrollViewToVisible();
+  }
+  LOG(INFO) << "[workspaces] quick search: refreshed after a change";
+}
+
+BEGIN_METADATA(WorkspaceQuickSearchView)
+END_METADATA
