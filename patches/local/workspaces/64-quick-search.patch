+// Find tabs and pages (C1, Arc's command bar; c2-progress.md "The view"):
+// Shift+Alt+F opens a bare box centred over the page -- a text field and the
+// results, no title, no x -- that finds open tabs, pinned pages and Archive
+// entries of EVERY workspace as it is typed. Escape closes it, and so does
+// Shift+Alt+F again (D12).
+//
+//   [ (search) Find tabs and pages                     ]
+//   Open tabs
+//     (icon) A page                       (dot) Work
+//   Pinned pages
+//     (icon) Another page                 (dot) Home
+//   Archived
+//     (icon) A closed page                (dot) Work
+//
+// - Empty, the box lists this window's on-screen open tabs and open pinned
+//   pages, most recent first by C2's clock (the time the user LEFT a tab, then
+//   the time it was last shown), the active tab left out, under "Recent tabs"
+//   (D16 as the design review's M3 revised it); with none, one line says so.
+// - Typed, the text is split into words and every candidate scored
+//   (workspaces::archive::MatchScore: a word starting a word of the name beats
+//   one inside it, which beats one only in the address or a pinned page's
+//   folder names -- the address without "http://", "https://" and "www.",
+//   D18). Grouped by kind, in the owner's order: open tabs (of every window of
+//   this profile that has Workspaces, favorites counted as the workspace on
+//   screen, D6, D7), then pinned pages (an open one listed here once, D8),
+//   then Archive entries; inside a group the workspace on screen first, then
+//   the best match, then the most recent; at most 20 rows a group (D9).
+// - Each row: the page's icon, its name (ShownTitle: the name the user gave,
+//   else the title, else the address) and, at the right, its workspace's name
+//   after a dot of its colour (D11); a favorite has neither.
+// - The list has a FIXED height, about ten rows, and scrolls (D9), so the box
+//   never moves while typing. Its rows are a pool made before the box is in a
+//   widget -- 3 headings and 3 x 20 rows, all hidden -- and a keystroke only
+//   re-labels and shows or hides them, never adds a view (E15b: an add under
+//   a widget walks the whole subtree).
+// - The keyboard stays in the text field: Up / Down move the highlight over
+//   the shown rows and stop at the ends, the first row is highlighted after
+//   each keystroke, Enter opens the highlighted row, and a click opens a row
+//   (D13). The highlight is the text field's active descendant.
+// - A result is checked before the box closes (D19): a tab still there, a
+//   pinned page still in the pins file, an Archive entry still in the
+//   Archive, each with an address a tab can open. Gone: nothing happens, the
+//   list is made again, and the box stays (D14). Else the box closes, then a
+//   tab is activated in its window -- that window entering its workspace
+//   first, unless it is a favorite, and coming to the front -- a pinned page
+//   is shown through WorkspacePinnedSectionView::ShowItem, and an Archive
+//   entry restored through WorkspaceArchiveView::Restore.
+// - A change of the pins or of the Archive while the box is open (a close in
+//   any window, the files' load) posts ONE refresh, never runs it inside the
+//   store's callback, which can be inside TabStripModel's close: the
+//   candidates are collected again, the text filtered again, and the
+//   highlight follows the result it was on (D20).
+//
+// Logs, never a title, an address or the search text (47's rule):
+//   "[workspaces] shortcut: quick search"
+//   "[workspaces] quick search: off in this window" (Workspaces is off)
+//   "[workspaces] quick search: opened, T tab(s) P pinned A archived in N ms"
+//   "[workspaces] quick search: recent, n shown"
+//   "[workspaces] quick search: filter of L char(s) -> t/p/a shown in N ms"
+//   "[workspaces] quick search: opened a tab in '<guid>'" / "... opened a
+//   pinned page in '<guid>'" / "... opened an archived tab in '<guid>'" (a
+//   favorite: "in ''")
+//   "[workspaces] quick search: toggled closed"
+//   "[workspaces] quick search: result gone"
+//   "[workspaces] quick search: refreshed after a change"
+//
+// Accessible names the hands-free test reads (MSAA): the box's title and the
+// text field "Find tabs and pages"; the headings "Recent tabs", "Open tabs",
+// "Pinned pages", "Archived"; each row, a list box option,
+// "<rail mark>  <name>" (WorkspaceRailView::ButtonText of its workspace, two
+// spaces, the name; a favorite: the name alone), selected while highlighted;
+// "No matches"; and
+// "No open tabs. Type to find pinned pages and archived tabs." The rows kept
+// hidden are INVISIBLE there, not gone.
+//
+// A plain view in a views::BubbleDialogModelHost, the Archive's kind of
+// bubble (its constructors are private to an upstream friend list,
+// workspace_archive_view.h).
+class WorkspaceQuickSearchView : public views::View,
+                                 public views::TextfieldController,
+                                 public workspaces::pins::PinStore::Observer {
+  METADATA_HEADER(WorkspaceQuickSearchView, views::View)
+
+ public:
+  // The shortcut's (IDC_HELIUM_QUICK_SEARCH): opens the box for `browser`'s
+  // profile and window, centred over the page, or closes this window's box
+  // if it is open. Does nothing while Workspaces is off in `browser`.
+  static void ShowOverPage(BrowserWindowInterface* browser);
+
+  WorkspaceQuickSearchView(const WorkspaceQuickSearchView&) = delete;
+  WorkspaceQuickSearchView& operator=(const WorkspaceQuickSearchView&) = delete;
+  ~WorkspaceQuickSearchView() override;
+
+  // views::View: the shortcut, pressed while the box has the keyboard,
+  // closes it (D12): the box's widget hears it, not the browser's.
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override;
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override;
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override;
+
+  // workspaces::pins::PinStore::Observer:
+  void OnPinsChanged() override;
+
+ private:
+  // One thing the box can find (the .cc): ids and handles only, never a
+  // pointer into a store or a tab strip.
+  struct Candidate;
+
+  explicit WorkspaceQuickSearchView(BrowserWindowInterface* browser);
+
+  // Collects every candidate again, from every window's tabs, the pins file
+  // and the Archive.
+  void Collect();
+
+  // Shows the rows for the text in the field: the recent list when it is
+  // empty, the best matches per group otherwise; highlights the first row.
+  // Answers whether it showed the recent list.
+  bool ApplyQuery();
+
+  // Labels `row` with candidate `index`: its text, names, dot and icon.
+  void ShowCandidate(WorkspaceQuickSearchRow& row, size_t index);
+  void OnFavicon(WorkspaceQuickSearchRow* row,
+                 const GURL& url,
+                 const favicon_base::FaviconRawBitmapResult& result);
+
+  // How many shown rows are of the group at `group` (the log's t/p/a).
+  int ShownInGroup(size_t group) const;
+
+  // The highlight (null: none), and Up / Down over the shown rows.
+  void SetHighlight(WorkspaceQuickSearchRow* row);
+  void MoveHighlight(int delta);
+
+  // A click on the pool's row `slot`, and opening candidate `index`.
+  void OnRowPressed(size_t slot);
+  void Open(size_t index);
+
+  // Closes the box from the shortcut (D12).
+  void ToggleClosed();
+
+  // The stores' change callbacks: one refresh, posted and coalesced.
+  void PostRefresh();
+  void Refresh();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  // The profile's; they outlive every window's views.
+  const raw_ptr<workspaces::pins::PinStore> pins_;
+  const raw_ptr<workspaces::archive::ArchiveStore> archive_;
+
+  raw_ptr<views::Textfield> search_ = nullptr;
+  raw_ptr<views::ScrollView> scroll_view_ = nullptr;
+  // "No matches", or the recent list's line when nothing is recent: the
+  // list's first child.
+  raw_ptr<views::Label> empty_ = nullptr;
+  // The pool (the class comment): a heading per group, and kMaxRows rows per
+  // group, group by group, in drawn order.
+  std::vector<raw_ptr<views::Label>> headings_;
+  std::vector<raw_ptr<WorkspaceQuickSearchRow>> rows_;
+  // The rows shown now, in drawn order -- what Up / Down walk.
+  std::vector<raw_ptr<WorkspaceQuickSearchRow>> shown_;
+  raw_ptr<WorkspaceQuickSearchRow> highlighted_ = nullptr;
+
+  std::vector<Candidate> candidates_;
+  // Every icon the favicon service answered for a pinned page or an Archive
+  // entry, by address, for the box's life: a row re-labelled to a page asked
+  // for before shows its icon at once, never a globe first. An empty image:
+  // none was found.
+  std::map<GURL, ui::ImageModel> favicons_;
+
+  bool refresh_posted_ = false;
+  base::ScopedObservation<workspaces::pins::PinStore,
+                          workspaces::pins::PinStore::Observer>
+      pins_observation_{this};
+  base::CallbackListSubscription archive_changed_subscription_;
+  base::WeakPtrFactory<WorkspaceQuickSearchView> weak_factory_{this};
+};
