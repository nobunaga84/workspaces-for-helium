+// D18: the address a candidate is matched by, without a leading "http://" or
+// "https://" and then "www.": every pinned page starts with them, and one
+// letter "h" or "w" would match everything through its address.
+std::string_view WithoutScheme(std::string_view url) {
+  for (const std::string_view prefix : {"https://", "http://"}) {
+    if (url.starts_with(prefix)) {
+      url.remove_prefix(prefix.size());
+      break;
+    }
+  }
+  if (constexpr std::string_view kWww = "www."; url.starts_with(kWww)) {
+    url.remove_prefix(kWww.size());
+  }
+  return url;
+}
