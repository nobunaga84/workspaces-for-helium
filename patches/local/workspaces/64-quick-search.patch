+// C2's clock (c2-progress.md D2), as a key that sorts: a tab the user LEFT
+// (WorkspaceTabData::left_at) above one never left since the start, each by
+// its time -- the leave, else when it was last shown. A pinned page that is
+// not open and an Archive entry are never "left": their time is when the page
+// was last used, or closed.
+using MruKey = std::pair<bool, base::Time>;
+
+// What the highlight follows across a refresh (D20): the kind, then a pinned
+// page's or an entry's id, or a tab's handle (null for the other two, whose
+// open page may come and go).
+using Identity = std::tuple<ResultKind, std::string, tabs::TabHandle>;
+
+MruKey TabClock(content::WebContents* contents) {
+  if (!contents) {
+    return {};
+  }
+  if (const workspaces::WorkspaceTabData* const data =
+          workspaces::WorkspaceTabData::FromWebContents(contents);
+      data && !data->left_at().is_null()) {
+    return {true, data->left_at()};
+  }
+  return {false, contents->GetLastActiveTime()};
+}
