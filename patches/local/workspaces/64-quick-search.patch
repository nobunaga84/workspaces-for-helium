+// Whether `word` occurs in `text` at a word's start: at index 0, or right
+// after a character that is not an ASCII letter or digit.
+// ponytail: ASCII only -- an accented letter before the match counts as a
+// break; use ICU's u_isalnum if a non-English name ranks oddly.
+bool FindsAtWordStart(std::u16string_view text, std::u16string_view word) {
+  for (size_t at = text.find(word); at != std::u16string_view::npos;
+       at = text.find(word, at + 1)) {
+    if (at == 0 || !base::IsAsciiAlphaNumeric(text[at - 1])) {
+      return true;
+    }
+  }
+  return false;
+}
