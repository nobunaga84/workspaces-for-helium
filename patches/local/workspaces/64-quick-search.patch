+OpenBoxes() {
+  static base::NoDestructor<base::flat_map<
+      const BrowserWindowInterface*, base::WeakPtr<WorkspaceQuickSearchView>>>
+      boxes;
+  return *boxes;
+}
+
+// Opens a result AFTER the box has closed, from copies: nothing here touches
+// the box, whose window may no longer be the active one. A pinned page -- a
+// recent one too -- goes through the pinned section's road, an Archive entry
+// through the Archive's.
+void OpenResult(BrowserWindowInterface* browser,
+                ResultKind kind,
+                const std::string& id,
+                const std::string& guid,
+                tabs::TabHandle handle) {
+  bool opened = false;
+  switch (kind) {
+    case ResultKind::kTab:
+      if (tabs::TabInterface* const tab = handle.Get()) {
+        opened = WorkspacePinnedSectionView::ShowTab(browser, *tab);
+      }
+      break;
+    case ResultKind::kPin:
+      opened = WorkspacePinnedSectionView::ShowItem(browser, id);
+      break;
+    case ResultKind::kArchive:
+      opened = WorkspaceArchiveView::Restore(browser, id);
+      break;
+  }
+  if (!opened) {
+    LOG(INFO) << "[workspaces] quick search: result gone";
+    return;
+  }
+  LOG(INFO) << "[workspaces] quick search: opened "
+            << kOpenedNames[static_cast<size_t>(kind)] << " in '" << guid
+            << "'";
+}
