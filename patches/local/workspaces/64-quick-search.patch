+               const std::vector<std::u16string>& words) {
+  if (words.empty()) {
+    return 0;
+  }
+  int score = 0;
+  for (const std::u16string& word : words) {
+    // The best place only: a word at a name's word start that also sits in
+    // the address scores 3, not 3 + 1.
+    if (FindsAtWordStart(folded_name, word)) {
+      score += 3;
+    } else if (folded_name.find(word) != std::u16string_view::npos) {
+      score += 2;
+    } else if (folded_rest.find(word) != std::u16string_view::npos) {
+      score += 1;
+    } else {
+      return 0;  // Every word must match somewhere (MatchesQuery's rule).
+    }
+  }
+  return score;
