+// word of the name, 2 when it is only inside the name, 1 when it is only in
+// the rest; 0 for the whole item when any word is in neither text.
+constexpr std::u16string_view kName = u"github pull requests";
+constexpr std::u16string_view kRest = u"https://example.com/hub";
+
+TEST(WorkspaceQuickSearchTest, AWordStartingTheNameScoresThree) {
+  EXPECT_EQ(MatchScore(kName, kRest, {u"git"}), 3);
+  EXPECT_EQ(MatchScore(kName, kRest, {u"pull"}), 3);
+  EXPECT_EQ(MatchScore(kName, kRest, {u"req"}), 3);
+}
+
+TEST(WorkspaceQuickSearchTest, AWordInsideTheNameScoresTwo) {
+  // Also in the rest ("/hub"): the name wins.
+  EXPECT_EQ(MatchScore(kName, kRest, {u"hub"}), 2);
+  EXPECT_EQ(MatchScore(kName, kRest, {u"ull"}), 2);
+}
+
+TEST(WorkspaceQuickSearchTest, AWordOnlyInTheRestScoresOne) {
+  EXPECT_EQ(MatchScore(kName, kRest, {u"example"}), 1);
+  // A folder's name is part of the rest, after a newline.
+  EXPECT_EQ(MatchScore(kName, u"https://a.example/\nwork", {u"work"}), 1);
