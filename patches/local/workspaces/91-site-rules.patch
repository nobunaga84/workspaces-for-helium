+// static
+std::string WorkspaceService::SiteOf(tabs::TabInterface* tab) {
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return std::string();
+  }
+  const GURL& committed = contents->GetLastCommittedURL();
+  const GURL& url =
+      committed.is_valid() ? committed : contents->GetVisibleURL();
+  return url.SchemeIsHTTPOrHTTPS() && !url.host().empty()
+             ? SiteFromHost(url.host())
+             : std::string();
+}
+
+void WorkspaceService::SetSiteWorkspace(std::string_view site,
+                                        std::string_view guid) {
+  // Checked here, not only by the pref edit, so the log never reports a
+  // write that changed nothing.
+  if (site.empty() || !std::ranges::contains(known_guids_, guid)) {
+    return;
+  }
+  prefs::WriteWorkspaces(
+      prefs_, prefs::SetSiteWorkspace(GetWorkspaces(), site, guid));
+  LOG(INFO) << "[workspaces] site '" << site << "' -> workspace '" << guid
+            << "'";
+}
+
+void WorkspaceService::RemoveSite(std::string_view site) {
+  // As SetSiteWorkspace: the log never reports a write that changed nothing.
+  if (WorkspaceOfSite(site).empty()) {
+    return;
+  }
+  prefs::WriteWorkspaces(prefs_, prefs::RemoveSite(GetWorkspaces(), site));
+  LOG(INFO) << "[workspaces] site '" << site << "' removed";
+}
+
+std::string WorkspaceService::WorkspaceOfSite(std::string_view site) const {
+  const auto rule = std::ranges::find(site_rules_, site, &SiteRule::site);
+  return rule != site_rules_.end() ? rule->guid : std::string();
+}
+
+std::string WorkspaceService::RuleSiteOf(tabs::TabInterface* tab) const {
+  const std::string site = SiteOf(tab);
+  const SiteRule* const rule = RuleForHost(site, site_rules_);
+  return rule ? rule->site : site;
+}
+
+std::string WorkspaceService::RuleWorkspaceForHost(
+    std::string_view host) const {
+  std::string guid = WorkspaceForHost(host, site_rules_);
+  return std::ranges::contains(known_guids_, guid) ? guid : std::string();
+}
+
+void WorkspaceService::ToggleSiteRule(tabs::TabInterface* tab) {
+  const std::string site = RuleSiteOf(tab);
+  if (site.empty()) {
+    return;
+  }
+  if (WorkspaceOfSite(site) == active_guid_) {
+    RemoveSite(site);
+  } else {
+    SetSiteWorkspace(site, active_guid_);
+  }
+}
