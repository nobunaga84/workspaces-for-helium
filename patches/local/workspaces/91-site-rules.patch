+bool IsFreshOpen(const FreshOpenFacts& facts) {
+  return facts.untagged && !facts.rebuilding && facts.enabled &&
+         !facts.pinned && facts.pending && !facts.restored &&
+         facts.http_or_https && facts.link_bookmark_or_app;
+}
