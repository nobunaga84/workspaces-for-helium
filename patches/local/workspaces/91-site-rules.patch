+std::vector<WorkspaceEntry> SetSiteWorkspace(
+    std::vector<WorkspaceEntry> entries,
+    std::string_view site,
+    std::string_view guid) {
+  if (site.empty() || !ContainsGuid(entries, guid)) {
+    return entries;
+  }
+  for (WorkspaceEntry& entry : entries) {
+    if (entry.guid != guid) {
+      std::erase(entry.sites, site);
+    } else if (!std::ranges::contains(entry.sites, site)) {
+      entry.sites.emplace_back(site);
+    }
+  }
+  return entries;
+}
+
+std::vector<WorkspaceEntry> RemoveSite(std::vector<WorkspaceEntry> entries,
+                                       std::string_view site) {
+  for (WorkspaceEntry& entry : entries) {
+    std::erase(entry.sites, site);
+  }
+  return entries;
+}
+
+std::vector<SiteRule> SiteRules(const std::vector<WorkspaceEntry>& entries) {
+  std::vector<SiteRule> rules;
+  for (const WorkspaceEntry& entry : entries) {
+    for (const std::string& site : entry.sites) {
+      rules.push_back({site, entry.guid});
+    }
+  }
+  return rules;
+}
