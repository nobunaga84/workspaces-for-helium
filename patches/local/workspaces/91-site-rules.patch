+std::string SiteFromHost(std::string_view host) {
+  constexpr std::string_view kWww = "www.";
+  if (host.starts_with(kWww) &&
+      host.substr(kWww.size()).find('.') != std::string_view::npos) {
+    host.remove_prefix(kWww.size());
+  }
+  return std::string(host);
+}
+
+bool HostMatchesSite(std::string_view host, std::string_view site) {
+  // D1: the site itself, or a host ending in "." + site -- the dot is what
+  // keeps notgithub.com out of github.com's. An empty site covers nothing: it
+  // would take every link.
+  if (site.empty()) {
+    return false;
+  }
+  if (host.ends_with('.')) {
+    host.remove_suffix(1);
+  }
+  return host == site ||
+         (host.size() > site.size() && host.ends_with(site) &&
+          host[host.size() - site.size() - 1] == '.');
+}
+
+const SiteRule* RuleForHost(std::string_view host,
+                            const std::vector<SiteRule>& rules) {
+  const SiteRule* best = nullptr;
+  for (const SiteRule& rule : rules) {
+    if (HostMatchesSite(host, rule.site) &&
+        (!best || rule.site.size() > best->site.size())) {
+      best = &rule;
+    }
+  }
+  return best;
+}
+
+std::string WorkspaceForHost(std::string_view host,
+                             const std::vector<SiteRule>& rules) {
+  const SiteRule* const rule = RuleForHost(host, rules);
+  return rule ? rule->guid : std::string();
+}
