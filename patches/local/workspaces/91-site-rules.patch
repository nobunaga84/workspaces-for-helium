+std::string WorkspaceService::SiteRuleGuidFor(tabs::TabInterface* tab) {
+  // Cheapest first: with no rule at all, nothing else is asked of an insert.
+  if (site_rules_.empty()) {
+    return std::string();
+  }
+  // Navigate() starts the load before it inserts the tab (browser_navigator.cc
+  // "Perform the actual navigation", then AddTab), so a fresh open's address
+  // is its pending entry. A restored entry is a session's, a reopen's or a
+  // pinned page's, never a fresh open.
+  const content::NavigationEntry* const entry =
+      tab->GetContents()->GetController().GetPendingEntry();
+  FreshOpenFacts facts;
+  facts.untagged = GuidOf(tab).empty();
+  facts.rebuilding = !stamp_inserted_for_.empty();
+  facts.enabled = IsEnabled();
+  facts.pinned =
+      tab->IsPinned() || !PinItemForTab(tab->GetContents()).empty();
+  facts.pending = entry != nullptr;
+  if (entry) {
+    facts.restored = entry->IsRestored();
+    facts.http_or_https = entry->GetURL().SchemeIsHTTPOrHTTPS();
+    // A link (also a link opened in a new tab, and an extension's new tab), a
+    // bookmark, or a link from another app: AUTO_TOPLEVEL is what
+    // StartupBrowserCreatorImpl::OpenTabsInBrowser opens a command-line URL
+    // with.
+    const ui::PageTransition transition = entry->GetTransitionType();
+    facts.link_bookmark_or_app =
+        ui::PageTransitionCoreTypeIs(transition, ui::PAGE_TRANSITION_LINK) ||
+        ui::PageTransitionCoreTypeIs(transition,
+                                     ui::PAGE_TRANSITION_AUTO_BOOKMARK) ||
+        ui::PageTransitionCoreTypeIs(transition,
+                                     ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  }
+  if (!IsFreshOpen(facts)) {
+    return std::string();
+  }
+  const std::string_view host = entry->GetURL().host();
+  std::string guid = RuleWorkspaceForHost(host);
+  if (guid.empty() || guid == active_guid_) {
+    return std::string();
+  }
+  LOG(INFO) << "[workspaces] site rule: '" << host << "' -> workspace '"
+            << guid << "' (active '" << active_guid_ << "')";
+  return guid;
+}
+
+void WorkspaceService::MoveRuledTab(tabs::TabHandle handle,
+                                    const std::string& guid,
+                                    const std::string& last_before) {
+  tabs::TabInterface* const tab = handle.Get();
+  // Closed, gone to another window, pinned or the workspace deleted since.
+  if (tab_strip_->GetIndexOfTab(tab) == TabStripModel::kNoTab ||
+      tab->IsPinned() || !IsEnabled() ||
+      ResolveTabGuid(guid, known_guids_) != guid) {
+    return;
+  }
+  // "Open link in split view" paired it with the tab it came from, each
+  // keeping its tag (OnSplitTabChanged), and activated it, so the window
+  // followed it here. The split is what the user asked for: the tab takes
+  // its partner's workspace, and the window goes back with it.
+  if (const std::optional<split_tabs::SplitTabId> split = tab->GetSplit()) {
+    for (tabs::TabInterface* const half :
+         tab_strip_->GetSplitData(*split)->ListTabs()) {
+      if (half != tab) {
+        SetTag(tab->GetContents(), GuidOf(half));
+      }
+    }
+    if (active_guid_ == guid) {
+      SetActiveWorkspace(GuidOf(tab));
+      // The rule's switch and this one cancel out: "back" (C13) stays where
+      // it was before the link.
+      last_guid_ = last_before;
+    }
+    LOG(INFO) << "[workspaces] site rule: undone, the tab opened in a split "
+                 "view";
+    return;
+  }
+  // Legal here, posted out of the observer (design 2.2). A leave keeps the
+  // tag the group's rule gave it, so it is stamped again after.
+  const bool grouped = tab->GetGroup().has_value();
+  if (grouped) {
+    tab_strip_->RemoveFromGroup({tab_strip_->GetIndexOfTab(tab)});
+  }
+  SetTag(tab->GetContents(), guid);
+  // C4's place. The tab is one of `guid`'s Today tabs now, so the anchor is
+  // never below it: it is the anchor when it is already the top one.
+  const int at = TopOfTodayAnchor(guid);
+  const int from = tab_strip_->GetIndexOfTab(tab);
+  const bool placed = !InsideACollection(at);
+  if (placed && at >= 0 && at < from) {
+    // A move changes no active tab: the observer neither switches nor
+    // stamps a left tab.
+    tab_strip_->MoveWebContentsAt(from, at, /*select_after_move=*/false);
+  }
+  LOG(INFO) << "[workspaces] site rule: to the top of '" << guid << "'"
+            << (grouped ? ", out of its group" : "")
+            << (placed ? "" : ", not placed");
+}
+
 bool WorkspaceService::IsAnchored(const tabs::TabInterface* tab) const {
   return tab && !AnchorUrlForTab(tab->GetContents()).empty();
 }
