+
+bool WorkspaceService::SetFolderOpen(std::string_view id, bool open) {
+  Profile* const profile = browser_window_->GetProfile();
+  pins::PinStore* const store =
+      pins::PinStore::GetOrCreate(profile, profile->GetPath());
+  const pins::PinNode* const folder = store->Find(id);
+  if (!folder || folder->type != pins::PinNode::Type::kFolder) {
+    return false;
+  }
+  const std::string key(id);
+  const bool was = folder->open;
+  // D11: a window with no word of its own shows the file, which is about to
+  // change -- so it is given the file's value first, and keeps it.
+  int kept = 0;
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [&](BrowserWindowInterface* other) {
+        WorkspaceService* const service =
+            other == browser_window_ ? nullptr : From(other);
+        if (service && service->folders_.states.try_emplace(key, was).second) {
+          service->PersistFolders();
+          ++kept;
+        }
+        return true;
+      });
+  folders_.states.insert_or_assign(key, open);
+  PersistFolders();
+  // The last change made anywhere, which a new window starts from. Refused
+  // while the file is read-only, and silent when it already holds `open`:
+  // this window's word stands either way.
+  store->SetFolderOpen(key, open);
+  LOG(INFO) << "[workspaces] folder '" << key << "' "
+            << (open ? "open" : "closed") << " in this window (" << kept
+            << " other window(s) keep theirs)";
+  return true;
+}
