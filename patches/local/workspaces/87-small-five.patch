+ui::ImageModel EmojiFavicon(const std::string& emoji) {
+  // ponytail: one image per distinct emoji set in this run, never dropped;
+  // a few kilobytes each. Prune it if the owner ever types hundreds.
+  static base::NoDestructor<std::map<std::string, ui::ImageModel>> cache;
