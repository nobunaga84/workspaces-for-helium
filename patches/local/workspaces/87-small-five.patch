+std::string FirstGrapheme(std::u16string_view text) {
+  const std::u16string_view trimmed =
+      base::TrimWhitespace(text, base::TRIM_ALL);
+  if (trimmed.empty()) {
+    return std::string();
+  }
+  // tab_group_header.cc's idiom: one Advance() is one grapheme, so a flag's
+  // two code points or a family's ZWJ sequence come out whole.
+  base::i18n::BreakIterator graphemes(
+      trimmed, base::i18n::BreakIterator::BREAK_CHARACTER);
+  if (!graphemes.Init() || !graphemes.Advance()) {
+    return std::string();
+  }
+  return base::UTF16ToUTF8(graphemes.GetString());
+}
+
+std::string FolderStatesToString(const FolderStates& states) {
+  base::DictValue dict;
+  for (const auto& [id, open] : states) {
+    dict.Set(id, open);
+  }
+  return base::WriteJson(dict).value_or(std::string());
+}
+
+FolderStates FolderStatesFromString(std::string_view json) {
+  FolderStates states;
+  if (std::optional<base::DictValue> dict =
+          base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC)) {
+    for (const auto [id, open] : *dict) {
+      if (open.is_bool()) {
+        states.emplace(id, open.GetBool());
+      }
+    }
+  }
+  return states;
+}
