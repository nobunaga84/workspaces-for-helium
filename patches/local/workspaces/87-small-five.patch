+// D4: the folder box's corner, and how far the emoji sits inside it -- 12 px
+// of the 16.
+constexpr float kBoxRadius = 3.0f;
+constexpr int kBoxInset = 2;
+// Under the box's outline: faint enough that the emoji's own colours read.
+constexpr SkAlpha kBoxFillAlpha = 0x33;
+
+class EmojiSource : public gfx::CanvasImageSource {
+ public:
+  EmojiSource(std::u16string emoji, std::optional<SkColor> box)
+      : gfx::CanvasImageSource(
+            gfx::Size(gfx::kFaviconSize, gfx::kFaviconSize)),
+        emoji_(std::move(emoji)),
+        box_(box) {}
+
+  // gfx::CanvasImageSource:
+  void Draw(gfx::Canvas* canvas) override {
+    gfx::Rect rect(size());
+    if (box_) {
+      // A 1 px line on the pixel grid, not smeared across two.
+      gfx::RectF square(rect);
+      square.Inset(0.5f);
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setColor(SkColorSetA(*box_, kBoxFillAlpha));
+      canvas->DrawRoundRect(square, kBoxRadius, flags);
+      flags.setStyle(cc::PaintFlags::kStroke_Style);
+      flags.setStrokeWidth(1);
+      flags.setColor(*box_);
+      canvas->DrawRoundRect(square, kBoxRadius, flags);
+      rect.Inset(kBoxInset);
+    }
+    // A colour emoji ignores the colour. ponytail: a text-style glyph (a
+    // plain star) is grey outside a box, as TabUIHelper has no ColorProvider
+    // to ask; pass a theme colour in if the owner meets one.
+    //
+    // Sized by the glyph, about one em: a font one pixel under the space
+    // fills it (Segoe UI Emoji's box is ~1.06 em). DeriveWithHeightUpperBound
+    // fits the whole LINE and drew ~11 px of 16 (review). ponytail: the 1 is
+    // the knob, judged by eye at 100% and 150%.
