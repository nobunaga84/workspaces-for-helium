+// C11b: the profile's bookmarks once they and the pins file have loaded, null
+// before -- a save never does half its work.
+bookmarks::BookmarkModel* LoadedBookmarkModel(Profile* profile) {
+  bookmarks::BookmarkModel* const model =
+      BookmarkModelFactory::GetForBrowserContext(profile);
+  return model && model->loaded() &&
+                 workspaces::pins::PinStore::GetOrCreate(profile,
+                                                         profile->GetPath())
+                     ->loaded()
+             ? model
+             : nullptr;
+}
+
+// C11b: pinned row `row` as bookmarks at the end of `parent` -- a folder as a
+// folder, a split as its two pages, a page at its pinned address under the
+// name its row shows. Answers how many pages it saved: an address no bookmark
+// can hold is left out (AddURL DCHECKs it).
+int AddPinBookmarks(bookmarks::BookmarkModel& model,
+                    const bookmarks::BookmarkNode* parent,
+                    const workspaces::pins::PinNode& row) {
+  using Type = workspaces::pins::PinNode::Type;
+  if (row.type != Type::kItem) {
+    const bookmarks::BookmarkNode* const into =
+        row.type == Type::kFolder
+            ? model.AddFolder(parent, parent->children().size(),
+                              base::UTF8ToUTF16(row.title))
+            : parent;
+    int saved = 0;
+    for (const workspaces::pins::PinNode& child : row.children) {
+      saved += AddPinBookmarks(model, into, child);
+    }
+    return saved;
+  }
+  const GURL url(row.url);
+  if (!url.is_valid()) {
+    return 0;
+  }
+  model.AddNewURL(parent, parent->children().size(),
+                  workspaces::archive::ShownTitle(row.custom_title, row.title,
+                                                  row.url),
+                  url);
+  return 1;
+}
