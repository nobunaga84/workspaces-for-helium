+void WorkspaceService::MakeGroupAWorkspace(
+    tabs::TabInterface* tab,
+    const std::string& untitled) {
+  const std::optional<tab_groups::TabGroupId> group =
+      tab ? tab->GetGroup() : std::nullopt;
+  const std::vector<tabs::TabInterface*> members =
+      (IsEnabled() && group) ? WholeGroupTabs(*group)
+                             : std::vector<tabs::TabInterface*>();
+  // Also refused when `tab` left this window while the menu was open: its
+  // group is then another window's.
+  if (!std::ranges::contains(members, tab)) {
+    return;
+  }
+  const tab_groups::TabGroupVisualData* const visual =
+      tab_strip_->group_model()->GetTabGroup(*group)->visual_data();
+  const std::string title = visual->title().empty()
+                                ? untitled
+                                : base::UTF16ToUTF8(visual->title());
+  const std::string guid = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  // ONE write, named and coloured -- a TabGroupColorId is the 0-8 a workspace
+  // colour stores -- so the list observers run once and know the guid before
+  // the first tab is tagged with it (see CreateWorkspace()). Not
+  // EnsureWorkspaceForImport(): it hands back a workspace of the same title.
+  prefs::WriteWorkspaces(
+      prefs_, prefs::SetWorkspaceColor(
+                  prefs::AddWorkspace(GetWorkspaces(), guid, title), guid,
+                  static_cast<int>(visual->color())));
+  // Retagged where they stand, still grouped: a group is drawn by its tabs'
+  // tag. Not MoveTabsToWorkspace(), whose EnsureActiveTabVisible() would spawn
+  // a New Tab in the workspace the group leaves, before the switch.
+  for (tabs::TabInterface* const member : members) {
+    SetTag(member->GetContents(), guid);
+  }
+  const tabs::TabInterface* const active = tab_strip_->GetActiveTab();
+  last_active_[guid] =
+      (std::ranges::contains(members, active) ? active : tab)->GetHandle();
+  // From a menu handler, outside every observer (design 2.2).
+  SwitchToWorkspace(guid);
+  LOG(INFO) << "[workspaces] group -> new workspace '" << guid << "', "
+            << members.size() << " tab(s)";
+}
