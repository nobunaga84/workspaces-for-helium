+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_COMMON_WORKSPACE_VIEW_HOOKS_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_COMMON_WORKSPACE_VIEW_HOOKS_H_
+
+#include <stddef.h>
+
+class TabCollectionNode;
+
+// Helium Workspaces: the bodies of the fork's hooks in the vertical tab
+// strip's views (views/tabs/common). Each is asked in one line, so a rebase
+// that rewrites Chromium's layout code moves a line, never a block (the hook
+// shrink, part 4). Built in those views' own target, so these reach what they
+// reach.
+namespace workspaces {
+
+// UnpinnedTabContainerViewLayout's vertical layout and minimum size: whether
+// the direct child at `child_index` of `parent` -- the container's collection
+// node, whose children GetDirectChildren() returns in the same order -- is
+// drawn, given the workspace its window shows. A group or split is drawn when
+// its first tab is (design 2.7). Fails open like GetFocusedGroupId: with no
+// node, no controller, or a collection holding no tabs, the child is shown.
+bool IsChildDrawnForWorkspace(const TabCollectionNode* parent,
+                              size_t child_index);
+
+}  // namespace workspaces
