+#include "chrome/browser/ui/views/tabs/common/workspace_view_hooks.h"
+
+#include <variant>
+
+#include "chrome/browser/ui/views/tabs/common/tab_collection_node.h"
+#include "chrome/browser/ui/views/tabs/common/tab_strip_collection_controller.h"
+
+namespace workspaces {
+
+namespace {
+
+// The first tab at or below `node`, or null if it contains none.
+//
+// Used to give a whole collection a workspace: a group or split is drawn when
+// its first tab is (design 2.7). Deliberately recursive rather than a switch on
+// node type -- the direct children of an unpinned container are TAB, GROUP and
+// SPLIT, and the layout's focused-group code hides anything it fails to
+// classify, so a switch that forgot SPLIT would make every ungrouped split view
+// silently vanish. Recursion cannot forget a case.
+const tabs::TabInterface* FirstDescendantTab(const TabCollectionNode* node) {
+  if (!node) {
+    return nullptr;
+  }
+  if (node->type() == TabCollectionNode::Type::TAB) {
+    const tabs::ConstChildPtr node_data = node->GetNodeData();
+    // M153 made the variant hold raw_ptr<const TabInterface> rather than a
+    // bare pointer, and tab_collection_node.cc reads it the same way.
+    const tabs::ConstDanglingUntriagedTabInterface* tab =
+        std::get_if<tabs::ConstDanglingUntriagedTabInterface>(&node_data);
+    return tab ? tab->get() : nullptr;
+  }
+  for (const auto& child : node->children()) {
+    if (const tabs::TabInterface* tab = FirstDescendantTab(child.get())) {
+      return tab;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+bool IsChildDrawnForWorkspace(const TabCollectionNode* parent,
+                              size_t child_index) {
+  if (!parent || !parent->GetController()) {
+    return true;
+  }
+  const TabCollectionNode::NodeChildren& nodes = parent->children();
+  if (child_index >= nodes.size()) {
+    return true;
+  }
+  const tabs::TabInterface* tab = FirstDescendantTab(nodes[child_index].get());
+  return !tab || parent->GetController()->IsTabVisibleForWorkspace(tab);
+}
+
+}  // namespace workspaces
