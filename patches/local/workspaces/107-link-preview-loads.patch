+// C20: what the link preview knows about a download its page asks for (the
+// card's page is no tab, so the download never runs in it). Plain values, so
+// the rule below is tested here.
+struct PreviewDownloadFacts {
+  bool get = false;            // a GET; a POST would be sent twice
+  bool card_may_load = false;  // the web, or a file from a file page
+  bool blob = false;           // the page's own blob: data
+  bool sent = false;           // the card already sent one to a tab
+};
+
+// C20 (review 2, R2-18): whether the download goes to a new tab of the
+// window, where it downloads as any link does. The page picks the address
+// and needs no click, and the tab's load is the browser's, which Chromium's
+// download limit and its block on a page's own data: loads never see: so
+// once per card, and never a data: or filesystem: address.
+bool ShouldSendPreviewDownloadToTab(const PreviewDownloadFacts& facts);
+
