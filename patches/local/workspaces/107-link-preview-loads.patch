+// C20 (review 2, R2-18): a web download the link preview's page asks for.
+constexpr PreviewDownloadFacts kWebDownload = {.get = true,
+                                               .card_may_load = true,
+                                               .blob = false,
+                                               .sent = false};
+
+TEST(WorkspacePreviewDownloadTest, AWebOrBlobDownloadGoesToATab) {
+  EXPECT_TRUE(ShouldSendPreviewDownloadToTab(kWebDownload));
+  PreviewDownloadFacts blob = kWebDownload;
+  blob.card_may_load = false;
+  blob.blob = true;
+  EXPECT_TRUE(ShouldSendPreviewDownloadToTab(blob));
+}
+
+TEST(WorkspacePreviewDownloadTest, EachConditionAloneKeepsItFromATab) {
+  // Each flipped alone: a POST sent twice, a data: page opened with no
+  // click, a tab per request of a page that asks again and again.
+  for (bool PreviewDownloadFacts::*field :
+       {&PreviewDownloadFacts::get, &PreviewDownloadFacts::card_may_load,
+        &PreviewDownloadFacts::sent}) {
+    PreviewDownloadFacts facts = kWebDownload;
+    facts.*field = !(facts.*field);
+    EXPECT_FALSE(ShouldSendPreviewDownloadToTab(facts));
+  }
+}
