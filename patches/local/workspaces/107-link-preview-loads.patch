+// Where a load the browser starts for the card may go, the renderer's own
+// checks of the address never having run on it: the web, or a file from a
+// file.
+bool MayLoad(const GURL& url, const GURL& from) {
+  return url.SchemeIsHTTPOrHTTPS() ||
+         (url.SchemeIsFile() && from.SchemeIsFile());
+}
+
+// A link's load the browser starts for the card, with the link's referrer
+// and initiator: the site sees the click it was, not a typed visit (review
+// 2, R2-18, R2-23).
+content::OpenURLParams LinkParams(const GURL& url,
+                                  const content::Referrer& referrer,
+                                  const std::optional<url::Origin>& initiator,
+                                  WindowOpenDisposition disposition) {
+  content::OpenURLParams params(url, referrer, disposition,
+                                ui::PAGE_TRANSITION_LINK,
+                                /*is_renderer_initiated=*/false);
+  params.initiator_origin = initiator;
+  return params;
+}
