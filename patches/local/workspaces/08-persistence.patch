+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_SESSION_DATA_H_
+#define CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_SESSION_DATA_H_
+
+#include <map>
+#include <string>
+
+namespace content {
+class WebContents;
+}
+
+// How a workspace tag survives a restart, and how it gets back onto the tab
+// afterwards (design 2.6).
+//
+// Chromium already carries an arbitrary per-tab string map through both of its
+// restore paths, and this rides on it rather than inventing a file:
+//
+//   restart          SessionService::AddTabExtraData(...)  [command 33]
+//                      -> SessionTab::extra_data
+//                      -> chrome::AddRestoredTab(..., extra_data, ...)
+//   Ctrl+Shift+T     LiveTabContext::GetExtraDataForTab()  [captured at close]
+//                      -> tab_restore::Entry::extra_data   [Tabs-file cmd 14]
+//                      -> ReplaceRestoredTab(..., extra_data, ...)
+//
+// Both ends of both paths meet in chrome::CreateRestoredTab, which is where
+// RestoreWorkspaceFromExtraData() below is called from. The in-tree consumer
+// this copies is glic_tab_restore_helper.{h,cc}; send_tab_to_self uses the
+// same shape one line further down the same function.
+//
+// WHY THIS IS NOT IN workspace_service.h. The three hook sites live in
+// //chrome/browser/ui and //chrome/browser/sessions, and the sessions one must
+// not be made to depend on the window service (which drags in TabStripModel
+// and //chrome/browser/ui/tabs, and is how a GN cycle gets built by accident --
+// design 3.1). Everything here is free functions over a WebContents and a
+// string map, in the leaf ":tab_data" target, so a hook site pays for the tag
+// and nothing else.
+namespace workspaces {
+
+// The key the guid is stored under, in Helium's helium.<area> convention and
+// matching the WorkspaceTabData it mirrors.
+//
+// CHOSEN ONCE. Unlike a pref name, this string is written into session files
+// that outlive the build that wrote them, so renaming it does not migrate
+// anything -- it silently orphans every tag in every profile's Current
+// Session, Last Session and Tabs files, and the feature looks like it forgot
+// everything exactly once, on the build that renamed it.
+inline constexpr char kWorkspaceExtraDataKey[] = "helium.workspace";
+
+// The workspace `contents` is tagged for, or empty for a tab that has never
+// been stamped, a pinned tab (pinning clears the tag), or a null argument.
+// Empty means the implicit default workspace, never "no workspace".
+std::string WorkspaceGuidForTab(content::WebContents* contents);
+
+// Adds the tag to the map the tab-restore service captures when a tab is
+// closed, so reopening it with Ctrl+Shift+T puts it back in its workspace.
+//
+// An empty guid writes nothing. That is safe here and NOT safe on the session
+// path, which is the one asymmetry in this file worth remembering: this map is
+// built from scratch at the moment of the close, so an absent key and an empty
+// value already mean the same thing. The session file instead accumulates
+// commands across the whole run, so there an empty guid has to be written to
+// overwrite an older non-empty one (see WorkspaceService::PersistTag).
+void PopulateWorkspaceExtraData(
+    content::WebContents* contents,
+    std::map<std::string, std::string>* extra_data);
+
+// Puts a restored tab back in its workspace, by re-attaching the tag to the
+// contents before anything else sees the tab.
+//
+// THIS RUNS BEFORE THE TAB IS IN A TAB STRIP, which is what makes it work
+// rather than a problem to solve. chrome::CreateRestoredTab builds the
+// WebContents, and only the caller afterwards inserts it -- so by the time
+// WorkspaceService's observer sees the insert, the tag is already on the tab,
+// and ResolveGuidForInsertedTab's first rule ("a tab that already carries a
+// tag keeps it") leaves it alone. Nothing has to be queued and consumed later.
+//
+// A missing key leaves the tab untagged rather than stamping it with anything:
+// that is every tab saved before this build existed, and untagged already
+// means the default workspace.
+void RestoreWorkspaceFromExtraData(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data);
+
+}  // namespace workspaces
+
+#endif  // CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_SESSION_DATA_H_
