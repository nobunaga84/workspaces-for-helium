+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/workspaces/workspace_session_data.h"
+
+#include <map>
+#include <string>
+
+#include "chrome/browser/ui/tabs/workspaces/workspace_tab_data.h"
+#include "content/public/browser/web_contents.h"
+
+namespace workspaces {
+
+std::string WorkspaceGuidForTab(content::WebContents* contents) {
+  if (!contents) {
+    return std::string();
+  }
+  const WorkspaceTabData* tab_data =
+      WorkspaceTabData::FromWebContents(contents);
+  return tab_data ? tab_data->guid() : std::string();
+}
+
+void PopulateWorkspaceExtraData(
+    content::WebContents* contents,
+    std::map<std::string, std::string>* extra_data) {
+  if (!extra_data) {
+    return;
+  }
+  std::string guid = WorkspaceGuidForTab(contents);
+  if (guid.empty()) {
+    return;
+  }
+  (*extra_data)[kWorkspaceExtraDataKey] = std::move(guid);
+}
+
+void RestoreWorkspaceFromExtraData(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data) {
+  if (!contents) {
+    return;
+  }
+  const auto it = extra_data.find(kWorkspaceExtraDataKey);
+  if (it == extra_data.end()) {
+    return;
+  }
+
+  // Set even when the stored value is empty. An empty tag is a real state --
+  // it is what pinning a tab leaves behind -- and the session file records it
+  // by writing the key with an empty value over the older one, so honouring it
+  // here is what makes unpin-then-restart agree with unpin-then-reopen.
+  WorkspaceTabData::GetOrCreateForWebContents(contents)->set_guid(it->second);
+}
+
+}  // namespace workspaces
