+
+int WorkspaceService::TargetTabIndexForActiveWorkspace() const {
+  // The tab the user was last on here, if it still exists and still belongs.
+  // Both have to be re-checked: the handle answers null once the tab is
+  // closed, GetIndexOfTab answers kNoTab once it has been dragged into another
+  // window, and IsTabVisible answers false if it was re-tagged while away.
+  const auto it = last_active_.find(active_guid_);
+  if (it != last_active_.end()) {
+    if (tabs::TabInterface* remembered = it->second.Get()) {
+      const int index = tab_strip_->GetIndexOfTab(remembered);
+      if (index != TabStripModel::kNoTab && IsTabOnScreen(remembered)) {
+        return index;
+      }
+    }
+  }
+
+  // Falling back to any tab that is on screen, which includes a pinned tab.
+  // Landing on a pinned tab is a real answer rather than a near miss: it is
+  // drawn in this workspace, so the user can see where they were put.
+  for (int i = 0; i < tab_strip_->count(); ++i) {
+    if (IsTabOnScreen(tab_strip_->GetTabAtIndex(i))) {
+      return i;
+    }
+  }
+  return TabStripModel::kNoTab;
+}
+
+void WorkspaceService::EnsureActiveTabVisible() {
+  if (!IsEnabled()) {
+    return;
+  }
+
+  // An empty strip means this window is on its way out. Adding a tab here
+  // would resurrect a window the user just closed.
+  if (tab_strip_->empty()) {
+    return;
+  }
+
+  if (IsTabOnScreen(tab_strip_->GetActiveTab())) {
+    return;
+  }
+
+  const int target = TargetTabIndexForActiveWorkspace();
+  if (target != TabStripModel::kNoTab) {
+    tab_strip_->ActivateTabAt(target);
+    return;
+  }
+  tab_strip_->delegate()->AddTabAt(GURL(), /*index=*/-1, /*foreground=*/true);
 }
 
