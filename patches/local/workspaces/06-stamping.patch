+void WorkspaceService::SwitchToWorkspace(std::string_view guid) {
+  if (!IsEnabled()) {
+    return;
+  }
+
+  // Remember the tab being left behind before active_guid_ moves, so coming
+  // back lands on it rather than on the top of the strip.
+  if (tabs::TabInterface* active = tab_strip_->GetActiveTab()) {
+    last_active_[active_guid_] = active->GetHandle();
+  }
+
+  const std::string previous = active_guid_;
+
+  // THE ORDER OF THESE TWO STEPS IS LOAD-BEARING, and getting it wrong is
+  // silent. ActivateTabAt() below notifies observers synchronously and this
+  // object is one of them, so the auto-switch branch in OnTabStripModelChanged
+  // runs inside that call. If active_guid_ had not moved yet, that branch
+  // would read the old guid, decide the newly activated tab is foreign, and
+  // switch straight back -- and the symptom is a shortcut that appears to do
+  // nothing at all, a long way from the line that caused it.
+  SetActiveWorkspace(guid);
+  if (active_guid_ == previous) {
+    return;
+  }
+
+  // Mutating the model is legal here and nowhere else in this class: this runs
+  // from BrowserCommandController, outside the observer scope design 2.2
+  // forbids mutating from.
+  const int target = TargetTabIndexForActiveWorkspace();
+  if (target != TabStripModel::kNoTab) {
+    tab_strip_->ActivateTabAt(target);
+    return;
+  }
+
+  // The workspace has no tabs. Leaving the user on a blank strip while a
+  // foreign page is still showing underneath is the same broken state the
+  // removal path repairs, so give the workspace a tab instead. This is why a
+  // workspace is never seen empty, which is also what Arc does.
+  //
+  // AddTabAt goes through TabStripModelDelegate rather than chrome::NewTab
+  // because this target must not depend on //chrome/browser/ui (design 3.1),
+  // and the delegate is an interface //chrome/browser/ui/tabs already owns.
+  // The new tab is stamped into this workspace by the insert path, since
+  // active_guid_ has already moved.
+  tab_strip_->delegate()->AddTabAt(GURL(), /*index=*/-1, /*foreground=*/true);
+}
