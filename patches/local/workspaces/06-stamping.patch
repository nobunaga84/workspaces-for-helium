+void WorkspaceService::OnTabPinnedStateChanged(tabs::TabInterface* tab,
+                                               int index) {
+  if (!tab || !tab->GetContents()) {
+    return;
+  }
+
+  // Pinning clears the tag and unpinning joins the workspace on screen: a
+  // pinned tab is a global Favorite rather than a member of one workspace
+  // (design 2.5).
+  //
+  // Clearing does NOT make the tab visible everywhere, and the difference
+  // matters. An empty guid means the *default* workspace, not every
+  // workspace, so on its own this would hide a pinned tab from every other
+  // one. What actually draws pinned tabs everywhere is that they render from
+  // a container the E6a predicate never reaches, plus the short-circuit in
+  // BrowserTabStripModelDelegate::IsTabVisibleInActiveWorkspace. Neither is
+  // replaced by this line (LOCAL.md 13).
+  // Asked of the tab rather than of the model at `index`, so this does not
+  // depend on the index being the post-move one. Pinning reorders the strip,
+  // and TabStripModel fires this notification after the move with the final
+  // index -- true today, but not something this needs to rely on.
+  WorkspaceTabData::GetOrCreateForWebContents(tab->GetContents())
+      ->set_guid(tab->IsPinned() ? std::string() : active_guid_);
+}
+
+void WorkspaceService::TabGroupedStateChanged(
+    TabStripModel* tab_strip_model,
+    std::optional<tab_groups::TabGroupId> old_group,
+    std::optional<tab_groups::TabGroupId> new_group,
+    tabs::TabInterface* tab,
+    int index) {
+  // Leaving a group is not a workspace change: the tab keeps the tag it had.
+  // Design 2.5 defines no rule for it, and inventing one would mean a tab
+  // silently changing workspace on an ungroup.
+  if (!new_group.has_value()) {
+    return;
+  }
+
+  // The arriving tab is excluded by identity rather than by `index`, so this
+  // does not depend on which index the notification carried -- joining a group
+  // can move the tab.
+  std::vector<std::string> member_guids;
+  for (int i = 0; i < tab_strip_->count(); ++i) {
+    tabs::TabInterface* member = tab_strip_->GetTabAtIndex(i);
+    if (member != tab && tab_strip_->GetTabGroupForTab(i) == new_group) {
+      member_guids.push_back(GuidOf(member));
+    }
+  }
+  ApplyCollectionGuid(tab, member_guids);
+}
