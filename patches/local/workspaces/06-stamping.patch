+void WorkspaceService::CarryTagAcrossReplacement(
+    const TabStripModelChange::Replace* replace) {
+  if (!replace || !replace->old_contents || !replace->new_contents) {
+    return;
   }
+  const WorkspaceTabData* old_data =
+      WorkspaceTabData::FromWebContents(replace->old_contents);
+  if (!old_data || old_data->guid().empty()) {
+    return;
+  }
+
+  WorkspaceTabData::GetOrCreateForWebContents(replace->new_contents)
+      ->set_guid(old_data->guid());
+
+  // Logged because this is otherwise completely invisible: nothing about a
+  // discard is user-initiated, so a silent failure here would surface days
+  // later as "workspaces forgets tabs sometimes".
+  LOG(INFO) << "[workspaces] tab contents replaced at index " << replace->index
+            << " -> carried workspace '" << old_data->guid() << "'";
+}
+
+std::string WorkspaceService::GuidOf(tabs::TabInterface* tab) const {
+  if (!tab || !tab->GetContents()) {
+    return std::string();
+  }
+  const WorkspaceTabData* tab_data =
+      WorkspaceTabData::FromWebContents(tab->GetContents());
+  return tab_data ? tab_data->guid() : std::string();
+}
+
+void WorkspaceService::ApplyCollectionGuid(
+    tabs::TabInterface* tab,
+    const std::vector<std::string>& member_guids) {
+  if (!tab || !tab->GetContents()) {
+    return;
+  }
+  WorkspaceTabData* tab_data =
+      WorkspaceTabData::GetOrCreateForWebContents(tab->GetContents());
+  tab_data->set_guid(
+      ResolveGuidForCollectionJoin(member_guids, tab_data->guid()));
+}
+
+void WorkspaceService::StampInsertedTab(tabs::TabInterface* tab) {
+  if (!tab || !tab->GetContents()) {
+    return;
+  }
+  WorkspaceTabData* tab_data =
+      WorkspaceTabData::GetOrCreateForWebContents(tab->GetContents());
+
+  // The opener is deliberately not consulted. It is whichever tab was active
+  // at insertion rather than the tab that spawned this one, so honouring it
+  // stamps a tab opened in an empty workspace for the workspace being left --
+  // see the comment on ResolveGuidForInsertedTab, and do not reinstate it.
+  tab_data->set_guid(
+      ResolveGuidForInsertedTab(tab_data->guid(), active_guid_));
+
+  // active_guid_ is in the line because without it this log cannot answer the
+  // question it exists for. "-> workspace 'default'" is the same text whether
+  // the tab joined the workspace on screen or was stamped for a different one,
+  // and telling those apart by eye is what a browser session was spent on.
+  LOG(INFO) << "[workspaces] tab inserted at index "
+            << tab_strip_->GetIndexOfTab(tab) << " -> workspace '"
+            << tab_data->guid() << "' (active '" << active_guid_ << "')";
 }
 
