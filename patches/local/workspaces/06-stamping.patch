+void WorkspaceService::OnSplitTabChanged(const SplitTabChange& change) {
+  if (change.type != SplitTabChange::Type::kAdded) {
+    return;
+  }
+  const SplitTabChange::AddedChange* added = change.GetAddedChange();
+  if (!added) {
+    return;
+  }
+
+  // Worth being honest about the value of this rule: today it can only ever be
+  // a no-op. A split is formed from tabs the user can see, so its members
+  // already share the active workspace, and the commands that could have
+  // reached a hidden tab were scoped in E7a. It is here because it is eight
+  // lines and because the split is the one collection design 2.7 warns is easy
+  // to forget -- not because a case is known to reach it.
+  //
+  // Membership is read from the model rather than from added->tabs(), because
+  // an AddedChange with reason kSplitTabUpdated carries only the tab that
+  // joined and not the split it joined. Resolved once for the whole set so two
+  // tabs entering a brand new split cannot each adopt the other's tag and swap.
+  std::vector<std::string> member_guids;
+  for (int i = 0; i < tab_strip_->count(); ++i) {
+    tabs::TabInterface* candidate = tab_strip_->GetTabAtIndex(i);
+    if (tab_strip_->GetSplitForTab(i) != change.split_id) {
       continue;
     }
+    const bool is_joining =
+        std::ranges::any_of(added->tabs(), [candidate](const auto& entry) {
+          return entry.first == candidate;
+        });
+    if (!is_joining) {
+      member_guids.push_back(GuidOf(candidate));
+    }
+  }
+
+  for (const auto& entry : added->tabs()) {
+    ApplyCollectionGuid(entry.first, member_guids);
+  }
+}
 
