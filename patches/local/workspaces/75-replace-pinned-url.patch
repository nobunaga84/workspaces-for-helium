+// C31, "Replace pinned URL with current": an item -- a split's page too --
+// takes the address and title of the page in front; the user's own name and
+// last_active stay, and a page with no title keeps the old one. A folder, a
+// split row, an unknown id or an empty url change nothing.
+TEST_F(PinStoreTest, SetUrlGivesAnItemTheAddressShown) {
+  const PinTree tree = SampleTree();
+  std::unique_ptr<PinStore> store = LoadedStore();
+  ASSERT_TRUE(store->SetRoots("default", tree.at("default")));
+  ASSERT_TRUE(store->SetRoots(
+      "work", {Split("s", {Item("l", "https://l.example/"),
+                           Item("r", "https://r.example/")})}));
+  CountingObserver observer;
+  store->AddObserver(&observer);
+
+  EXPECT_TRUE(store->SetUrl("c", "https://new.example/", "New page"));
+  EXPECT_EQ(observer.calls, 1);
+  EXPECT_TRUE(store->SetUrl("c", "https://newer.example/", ""));
+  EXPECT_TRUE(store->SetUrl("r", "https://r2.example/", "R2"));
+  EXPECT_FALSE(store->SetUrl("s", "https://x.example/", "X"));
+  EXPECT_FALSE(store->SetUrl("f1", "https://x.example/", "X"));
+  EXPECT_FALSE(store->SetUrl("nope", "https://x.example/", "X"));
+  EXPECT_FALSE(store->SetUrl("b", "", "X"));
+  EXPECT_EQ(observer.calls, 3);
+  store->RemoveObserver(&observer);
+
+  store.reset();
+  task_environment_.RunUntilIdle();
+  // Not before the reload's load has finished.
+  const std::unique_ptr<PinStore> again = NewStore();
+  EXPECT_FALSE(again->SetUrl("a", "https://x.example/", "X"));
+  task_environment_.RunUntilIdle();
+  const PinNode* const c = again->Find("c");
+  ASSERT_TRUE(c && again->Find("r") && again->Find("b") && again->Find("a"));
+  EXPECT_EQ(c->url, "https://newer.example/");
+  EXPECT_EQ(c->title, "New page");
+  EXPECT_EQ(c->custom_title, "Renamed C");
+  EXPECT_EQ(c->last_active,
+            base::Time::FromSecondsSinceUnixEpoch(1'758'000'000));
+  EXPECT_EQ(again->Find("r")->url, "https://r2.example/");
+  EXPECT_EQ(again->Find("r")->title, "R2");
+  EXPECT_EQ(again->Find("b")->url, "https://b.example/");
+  EXPECT_EQ(again->Find("a")->url, "https://a.example/");
+}
