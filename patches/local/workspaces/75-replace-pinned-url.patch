+bool PinStore::SetUrl(std::string_view id, std::string url, std::string title) {
+  if (!loaded_ || read_only_ || url.empty()) {
+    return false;
+  }
+  for (auto& [guid, roots] : tree_) {
+    if (PinNode* node = FindNode(roots, id)) {
+      if (node->type != PinNode::Type::kItem) {
+        return false;
+      }
+      node->url = std::move(url);
+      // A page that set no title keeps the one the row already shows (C31).
+      if (!title.empty()) {
+        node->title = std::move(title);
+      }
+      Changed();
+      return true;
+    }
+  }
+  return false;
+}
