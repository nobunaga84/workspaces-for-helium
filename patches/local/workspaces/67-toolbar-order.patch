+#define CHROME_BROWSER_UI_WEBUI_SIDE_PANEL_CUSTOMIZE_CHROME_CUSTOMIZE_TOOLBAR_WORKSPACE_TOOLBAR_ROWS_H_
+
+#include <optional>
+#include <vector>
+
+#include "base/functional/callback_forward.h"
+#include "chrome/browser/ui/webui/side_panel/customize_chrome/customize_toolbar/customize_toolbar.mojom.h"
+#include "ui/actions/action_id.h"
+#include "ui/color/color_id.h"
+
+class BrowserWindowInterface;
+class PinnedToolbarActionsModel;
+class PrefChangeRegistrar;
+class PrefService;
+
+namespace ui {
+class ColorProvider;
+}  // namespace ui
+
+// Helium Workspaces (wish 6): the bodies of CustomizeToolbarHandler's hooks
+// for Settings' Toolbar list, which shows the toolbar in its saved order, left
+// to right, with the address bar a row of its own (workspace_toolbar_list.ts
+// draws it). Each is asked in one line, so a rebase of Chromium's handler
+// moves a line, never a block (the hook shrink, part 5). Built in the
+// handler's own target.
+namespace workspaces {
+
+// The handler's map from a row to Chrome's action, for the rows
+// actions::ActionIdMap names (its ChromeActionForMojoAction).
+using ChromeActionFor = std::optional<actions::ActionId> (*)(
+    side_panel::customize_chrome::mojom::ActionId);
+
+// Redraws the list when the order is saved -- by this list or by another
+// window's.
+void WatchToolbarOrder(PrefChangeRegistrar& registrar,
+                       base::RepeatingClosure redraw);
+
+// ListActions: adds the address bar's row and sorts every row into the
+// toolbar's order. With vertical tabs on the right Helium keeps Collapse
+// right after the menu, whatever the order says; the list shows it there.
+void ArrangeToolbarRows(
+    std::vector<side_panel::customize_chrome::mojom::ActionPtr>& actions,
+    BrowserWindowInterface* browser,
+    const PrefService& pref_service,
+    const PinnedToolbarActionsModel& model,
+    const ui::ColorProvider& provider,
+    ui::ColorId icon_color_id,
+    float scale_factor,
+    ChromeActionFor chrome_action_for);
+
+// GetIsCustomized and ResetToDefault: an order is saved; forget it.
+bool IsToolbarOrderSaved(const PrefService& pref_service);
+void ClearToolbarOrder(PrefService& pref_service);
+
+// SetToolbarOrder: saves `order` and gives the pinned buttons the same
+// relative order. An order without the address bar, or with a row twice, is
+// a bad message. Off the record nothing is saved: `client` redraws the list.
+void SaveToolbarOrder(
+    const std::vector<side_panel::customize_chrome::mojom::ActionId>& order,
+    PrefService& pref_service,
+    PinnedToolbarActionsModel& model,
+    bool off_the_record,
+    ChromeActionFor chrome_action_for,
+    side_panel::customize_chrome::mojom::CustomizeToolbarClient* client);
+
+}  // namespace workspaces
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SIDE_PANEL_CUSTOMIZE_CHROME_CUSTOMIZE_TOOLBAR_WORKSPACE_TOOLBAR_ROWS_H_
