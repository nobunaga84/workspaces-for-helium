+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_TABS_WORKSPACES_TOOLBAR_ORDER_H_
+#define CHROME_BROWSER_UI_TABS_WORKSPACES_TOOLBAR_ORDER_H_
+
+#include <string>
+#include <vector>
+
+#include "base/values.h"
+
+// The toolbar's buttons in an order the user chose, either side of the address
+// bar (wish 6). One saved list of names, read by the Customize Chrome side
+// panel's Toolbar list and by the toolbar itself, so the two cannot disagree.
+//
+// //base only, so every rule here is tested in workspaces_unittests. Names are
+// actions::ActionIdMap strings ("kActionBack", "kActionShowDownloads", ...) --
+// the same strings toolbar.pinned_actions already stores -- plus kAddressBar.
+namespace workspaces::toolbar_order {
+
+// The address bar's place in the list. Not an action name: it has none.
+inline constexpr char kAddressBar[] = "location_bar";
+
+// Helium's own toolbar buttons -- the ones that are direct children of the
+// toolbar, not Chrome's pinned buttons -- and the address bar.
+inline constexpr char kCollapse[] = "kActionToggleCollapseVertical";
+inline constexpr char kBack[] = "kActionBack";
+inline constexpr char kForward[] = "kActionForward";
+inline constexpr char kReload[] = "kActionReload";
+inline constexpr char kHome[] = "kActionHome";
+inline constexpr char kSplit[] = "kActionSplitTab";
+inline constexpr char kNewTab[] = "kActionNewTab";
+inline constexpr char kExtensions[] = "kActionExtensions";
+inline constexpr char kMedia[] = "kActionMediaControls";
+inline constexpr char kAvatar[] = "kActionAvatar";
+inline constexpr char kMenu[] = "kActionShowAppMenu";
+
+// Whether `name` is one of the names above (kAddressBar included). Every other
+// name is one of Chrome's pinnable buttons.
+bool IsOwnButton(const std::string& name);
+
+// Today's toolbar, left to right -- what an empty saved list means. `pinned`
+// (Chrome's pinned buttons, in their saved order) and then `others` (Chrome
+// buttons that could be pinned but are not) sit between Extensions and Media,
+// where the pinned box is drawn.
+std::vector<std::string> DefaultOrder(const std::vector<std::string>& pinned,
+                                      const std::vector<std::string>& others);
+
+// `saved` made complete against `known`. Names in both keep their saved order
+// (the first of a repeated name wins); a name of `known` that `saved` lacks goes
+// right after the name before it in `known` -- a newly pinned button lands next
+// to its usual neighbour -- or first when it is first in `known`. Names that
+// `known` lacks are dropped.
+std::vector<std::string> Resolve(const std::vector<std::string>& saved,
+                                 const std::vector<std::string>& known);
+
+// The order the side panel lists and the toolbar draws: `saved` resolved
+// against DefaultOrder(pinned, others), with Chrome's pinned buttons as ONE
+// run, in `pinned` order, where pinned.front() is saved. The pinned box is one
+// rectangle that keeps its own order -- a drag inside it changes it -- so the
+// list shows what the toolbar can draw (wish 6a; 6b places them one by one).
+// A newly pinned button is appended to `pinned`, so it joins the run rather
+// than moving it to the place it had while it was off.
+std::vector<std::string> Arrange(const std::vector<std::string>& saved,
+                                 const std::vector<std::string>& pinned,
+                                 const std::vector<std::string>& others);
+
+// The names in the saved pref's list; anything that is not a string is skipped.
+std::vector<std::string> FromList(const base::ListValue& list);
+
+// Whether `order` can be saved: no name twice, kAddressBar exactly once.
+bool IsValid(const std::vector<std::string>& order);
+
+}  // namespace workspaces::toolbar_order
+
+#endif  // CHROME_BROWSER_UI_TABS_WORKSPACES_TOOLBAR_ORDER_H_
