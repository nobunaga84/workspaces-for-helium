+
+#ifndef CHROME_BROWSER_UI_VIEWS_TOOLBAR_WORKSPACE_TOOLBAR_ORDER_H_
+#define CHROME_BROWSER_UI_VIEWS_TOOLBAR_WORKSPACE_TOOLBAR_ORDER_H_
+
+class ToolbarView;
+
+namespace workspaces {
+
+// Puts the toolbar's own buttons, the extensions and the pinned Chrome buttons
+// (as one group) in the user's saved order, either side of the address bar
+// (wish 6). Called at the end of Helium's own reorder in
+// ToolbarView::UpdateToolbarLayout, and again by itself whenever the saved order
+// or the pinned buttons change. Nothing saved means Helium's own order (what
+// Init built, so nothing moves -- unless a reset just cleared the order); a
+// window that is not a normal browser window is left alone.
+void ApplyToolbarOrder(ToolbarView* toolbar);
+
+}  // namespace workspaces
