+#include <functional>
+#include <iterator>
+#include <string>
+#include <utility>
+
+#include "base/check.h"
+#include "base/values.h"
+#include "chrome/browser/ui/helium/helium_layout_state_controller.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/browser/ui/tabs/workspaces/toolbar_order.h"
+#include "chrome/browser/ui/tabs/workspaces/workspace_prefs.h"
