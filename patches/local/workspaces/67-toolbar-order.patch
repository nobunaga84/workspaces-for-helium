+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/workspaces/toolbar_order.h"
+
+#include <algorithm>
+#include <functional>
+#include <iterator>
+#include <set>
+
+#include "base/no_destructor.h"
+
+namespace workspaces::toolbar_order {
+
+bool IsOwnButton(const std::string& name) {
+  // With nothing pinned and no others, the default order is exactly these.
+  static const base::NoDestructor<std::vector<std::string>> kOwn(
+      DefaultOrder({}, {}));
+  return std::ranges::contains(*kOwn, name);
+}
+
+std::vector<std::string> DefaultOrder(const std::vector<std::string>& pinned,
+                                      const std::vector<std::string>& others) {
+  // ToolbarView::Init's order, with Collapse where Helium's UpdateToolbarLayout
+  // puts it (first) and the address bar between Split and New tab.
+  std::vector<std::string> order = {kCollapse, kBack,   kForward,   kReload,
+                                    kHome,     kSplit,  kAddressBar, kNewTab,
+                                    kExtensions};
+  order.insert(order.end(), pinned.begin(), pinned.end());
+  for (const std::string& name : others) {
+    if (!std::ranges::contains(pinned, name)) {
+      order.push_back(name);
+    }
+  }
+  order.insert(order.end(), {kMedia, kAvatar, kMenu});
+  return order;
+}
+
+std::vector<std::string> Resolve(const std::vector<std::string>& saved,
+                                 const std::vector<std::string>& known) {
+  std::vector<std::string> order;
+  for (const std::string& name : saved) {
+    if (std::ranges::contains(known, name) &&
+        !std::ranges::contains(order, name)) {
+      order.push_back(name);
+    }
+  }
+  // known[i - 1] is always placed by the time known[i] is looked at: it was
+  // saved, or it was inserted on the previous turn.
+  for (size_t i = 0; i < known.size(); ++i) {
+    if (std::ranges::contains(order, known[i])) {
+      continue;
+    }
+    auto at = order.begin();
+    if (i > 0) {
+      at = std::next(std::ranges::find(order, known[i - 1]));
+    }
+    order.insert(at, known[i]);
+  }
+  return order;
+}
+
+std::vector<std::string> Arrange(const std::vector<std::string>& saved,
+                                 const std::vector<std::string>& pinned,
+                                 const std::vector<std::string>& others) {
+  std::vector<std::string> order = Resolve(saved, DefaultOrder(pinned, others));
+  if (pinned.empty()) {
+    return order;
+  }
+  const auto is_pinned = [&pinned](const std::string& name) {
+    return std::ranges::contains(pinned, name);
+  };
+  // The run goes where pinned.front() is, counted among the names that stay.
+  const auto anchor = std::ranges::find(order, pinned.front());
+  const auto at = std::count_if(order.begin(), anchor, std::not_fn(is_pinned));
+  std::erase_if(order, is_pinned);
+  order.insert(order.begin() + at, pinned.begin(), pinned.end());
+  return order;
+}
+
+std::vector<std::string> FromList(const base::ListValue& list) {
+  std::vector<std::string> names;
+  for (const base::Value& name : list) {
+    if (name.is_string()) {
+      names.push_back(name.GetString());
+    }
+  }
+  return names;
+}
+
+bool IsValid(const std::vector<std::string>& order) {
+  const std::set<std::string> unique(order.begin(), order.end());
+  return unique.size() == order.size() &&
+         std::ranges::count(order, std::string(kAddressBar)) == 1;
+}
+
+}  // namespace workspaces::toolbar_order
