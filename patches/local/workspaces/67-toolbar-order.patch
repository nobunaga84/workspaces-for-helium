+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+:host {
+  display: block;
+}
+
+/* Helium Workspaces (wish 6): the list is the toolbar, in order. The rows
+ * themselves are toolbar.css's (WorkspaceToolbarListElement's styles). */
+.address-bar-row {
+  background-color: var(--color-sys-tonal-container);
+  border-radius: 8px;
+  cursor: grab;
+  margin: 4px 8px;
+  padding: 8px;
+}
+
+.address-bar-row:focus-visible {
+  outline: 2px solid var(--cr-focus-outline-color);
+}
+
+.drop-before {
+  box-shadow: inset 0 2px 0 var(--cr-focus-outline-color);
+}
+
+.drop-after {
+  box-shadow: inset 0 -2px 0 var(--cr-focus-outline-color);
+}
+
+.toggle-icon {
+  -webkit-user-drag: none;
+}
+
+/* A click on a button's row selects it, to move it; only its switch pins. */
+.toggle-container:hover {
+  cursor: grab;
+}
