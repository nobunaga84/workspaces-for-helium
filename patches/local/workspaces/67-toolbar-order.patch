+namespace workspaces::toolbar_order {
+namespace {
+
+using Names = std::vector<std::string>;
+
+TEST(ToolbarOrderTest, DefaultIsTodaysToolbar) {
+  EXPECT_EQ(DefaultOrder({"kActionShowDownloads", "kActionDevTools"},
+                         {"kActionPrint", "kActionDevTools"}),
+            (Names{kCollapse, kBack, kForward, kReload, kHome, kSplit,
+                   kAddressBar, kNewTab, kExtensions, "kActionShowDownloads",
+                   "kActionDevTools", "kActionPrint", kMedia, kAvatar, kMenu}));
+}
+
+TEST(ToolbarOrderTest, EmptySavedIsKnown) {
+  const Names known = DefaultOrder({}, {});
+  EXPECT_EQ(Resolve({}, known), known);
+}
+
+TEST(ToolbarOrderTest, SavedOrderWinsAcrossTheAddressBar) {
+  const Names known = {kBack, kAddressBar, "kActionShowDownloads", kMenu};
+  EXPECT_EQ(Resolve({"kActionShowDownloads", kBack, kMenu, kAddressBar}, known),
+            (Names{"kActionShowDownloads", kBack, kMenu, kAddressBar}));
+}
+
+TEST(ToolbarOrderTest, MissingNameFollowsItsUsualNeighbour) {
+  const Names known = {kBack, kForward, kAddressBar, "kActionPrint", kMenu};
+  // Forward was never saved: it follows Back wherever Back went.
+  EXPECT_EQ(Resolve({kAddressBar, kBack, "kActionPrint", kMenu}, known),
+            (Names{kAddressBar, kBack, kForward, "kActionPrint", kMenu}));
+  // A newly pinned button lands after the one before it in `known`.
+  EXPECT_EQ(Resolve({kMenu, kBack, kForward, kAddressBar}, known),
+            (Names{kMenu, kBack, kForward, kAddressBar, "kActionPrint"}));
+}
+
+TEST(ToolbarOrderTest, MissingFirstNameGoesFirst) {
+  const Names known = {kCollapse, kBack, kAddressBar};
+  EXPECT_EQ(Resolve({kAddressBar, kBack}, known),
+            (Names{kCollapse, kAddressBar, kBack}));
+}
+
+TEST(ToolbarOrderTest, UnknownAndRepeatedNamesDropped) {
+  const Names known = {kBack, kAddressBar};
+  EXPECT_EQ(Resolve({"kActionGone", kAddressBar, kBack, kAddressBar}, known),
+            (Names{kAddressBar, kBack}));
+}
+
+TEST(ToolbarOrderTest, PinnedButtonsAreOneRunWhereTheBoxsFirstIs) {
+  // Saved (the whole list, as the side panel writes it): Downloads first, Dev
+  // tools after Print. The box's own order is Dev tools, Downloads (a drag
+  // inside the box): both go where Dev tools is saved, in the box's order.
+  const Names saved = {"kActionShowDownloads", kCollapse, kBack, kForward,
+                       kReload, kHome, kSplit, kAddressBar, kNewTab,
+                       kExtensions, "kActionPrint", "kActionDevTools", kMedia,
+                       kAvatar, kMenu};
+  EXPECT_EQ(Arrange(saved, {"kActionDevTools", "kActionShowDownloads"},
+                    {"kActionPrint"}),
+            (Names{kCollapse, kBack, kForward, kReload, kHome, kSplit,
+                   kAddressBar, kNewTab, kExtensions, "kActionPrint",
+                   "kActionDevTools", "kActionShowDownloads", kMedia, kAvatar,
+                   kMenu}));
+}
+
+TEST(ToolbarOrderTest, NewlyPinnedButtonJoinsTheRun) {
+  // The group was moved left of the address bar; Print, saved while it was
+  // off at the right, is now pinned (the box appends it): it joins the group.
+  const Names saved = {"kActionShowDownloads", kAddressBar, "kActionPrint",
+                       kMenu};
+  EXPECT_EQ(Arrange(saved, {"kActionShowDownloads", "kActionPrint"}, {}),
+            (Names{kCollapse, kBack, kForward, kReload, kHome, kSplit,
+                   "kActionShowDownloads", "kActionPrint", kAddressBar,
+                   kNewTab, kExtensions, kMedia, kAvatar, kMenu}));
+}
+
+TEST(ToolbarOrderTest, NothingPinnedLeavesTheResolvedOrder) {
+  const Names known = DefaultOrder({}, {"kActionPrint"});
+  EXPECT_EQ(Arrange({}, {}, {"kActionPrint"}), known);
+}
+
+TEST(ToolbarOrderTest, Valid) {
+  EXPECT_TRUE(IsValid({kBack, kAddressBar, kMenu}));
+  EXPECT_FALSE(IsValid({kBack, kMenu}));
+  EXPECT_FALSE(IsValid({kAddressBar, kBack, kAddressBar}));
+  EXPECT_FALSE(IsValid({kBack, kAddressBar, kBack}));
+}
+
+TEST(ToolbarOrderTest, FromListSkipsNonStrings) {
+  base::ListValue list;
+  list.Append(kBack);
+  list.Append(3);
+  list.Append(kAddressBar);
+  EXPECT_EQ(FromList(list), (Names{kBack, kAddressBar}));
+}
+
+TEST(ToolbarOrderTest, OwnButtons) {
+  EXPECT_TRUE(IsOwnButton(kAddressBar));
+  EXPECT_TRUE(IsOwnButton(kExtensions));
+  EXPECT_FALSE(IsOwnButton("kActionShowDownloads"));
+}
