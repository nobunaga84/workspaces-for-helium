+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/models/image_model.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/image/image_skia.h"
+#include "url/gurl.h"
+
+namespace workspaces {
+
+namespace {
+
+using side_panel::customize_chrome::mojom::ActionId;
+
+// A row's name in the saved toolbar order. Helium's own buttons are named
+// here: actions::ActionIdMap knows only the pinnable ones, and Back, Reload,
+// New tab, the menu and Collapse are not.
+std::optional<std::string> OrderName(ActionId action_id,
+                                     ChromeActionFor chrome_action_for) {
+  namespace order = toolbar_order;
+  switch (action_id) {
+    case ActionId::kAddressBar:
+      return order::kAddressBar;
+    case ActionId::kVerticalTabsCollapse:
+      return order::kCollapse;
+    case ActionId::kBack:
+      return order::kBack;
+    case ActionId::kForward:
+      return order::kForward;
+    case ActionId::kReload:
+      return order::kReload;
+    case ActionId::kHome:
+      return order::kHome;
+    case ActionId::kSplitTab:
+      return order::kSplit;
+    case ActionId::kDynamicNewTab:
+      return order::kNewTab;
+    case ActionId::kExtensions:
+      return order::kExtensions;
+    case ActionId::kMediaControls:
+      return order::kMedia;
+    case ActionId::kAvatar:
+      return order::kAvatar;
+    case ActionId::kMenu:
+      return order::kMenu;
+    default:
+      break;
+  }
+  const std::optional<actions::ActionId> chrome_action =
+      chrome_action_for(action_id);
+  return chrome_action ? actions::ActionIdMap::ActionIdToString(*chrome_action)
+                       : std::nullopt;
+}
+
+}  // namespace
+
+void WatchToolbarOrder(PrefChangeRegistrar& registrar,
+                       base::RepeatingClosure redraw) {
+  registrar.Add(prefs::kHeliumWorkspacesToolbarOrder, std::move(redraw));
+}
+
+void ArrangeToolbarRows(
+    std::vector<side_panel::customize_chrome::mojom::ActionPtr>& actions,
+    BrowserWindowInterface* browser,
+    const PrefService& pref_service,
+    const PinnedToolbarActionsModel& model,
+    const ui::ColorProvider& provider,
+    ui::ColorId icon_color_id,
+    float scale_factor,
+    ChromeActionFor chrome_action_for) {
+  // One list in the toolbar's order, left to right, with the address bar a
+  // row of its own between the two sides.
+  actions.push_back(side_panel::customize_chrome::mojom::Action::New(
+      ActionId::kAddressBar, l10n_util::GetStringUTF8(IDS_ACCNAME_LOCATION),
+      /*pinned=*/true, false,
+      side_panel::customize_chrome::mojom::CategoryId::kNavigation,
+      GURL(webui::EncodePNGAndMakeDataURI(
+          ui::ImageModel::FromVectorIcon(vector_icons::kSearchIcon,
+                                         icon_color_id)
+              .Rasterize(&provider),
+          scale_factor))));
+  std::vector<std::string> pinned;
+  for (const actions::ActionId id : model.PinnedActionIds()) {
+    if (std::optional<std::string> name =
+            actions::ActionIdMap::ActionIdToString(id)) {
+      pinned.push_back(*name);
+    }
+  }
+  std::vector<std::string> tools;
+  for (const auto& action : actions) {
+    if (std::optional<std::string> name =
+            OrderName(action->id, chrome_action_for);
+        name && !toolbar_order::IsOwnButton(*name)) {
+      tools.push_back(*name);
+    }
+  }
+  std::vector<std::string> order = toolbar_order::Arrange(
+      toolbar_order::FromList(
+          pref_service.GetList(prefs::kHeliumWorkspacesToolbarOrder)),
+      pinned, tools);
+  // With vertical tabs on the right Helium keeps Collapse right after the menu,
+  // next to the sidebar it folds, whatever the order says: list it there.
+  const auto* layout = HeliumLayoutStateController::From(browser);
+  const auto* tab_strip = tabs::VerticalTabStripStateController::From(browser);
+  if (layout && layout->IsVerticalLayout() && tab_strip &&
+      tab_strip->IsTabStripRightAligned()) {
+    std::erase(order, toolbar_order::kCollapse);
+    order.insert(std::next(std::ranges::find(order, toolbar_order::kMenu)),
+                 toolbar_order::kCollapse);
+  }
+  std::ranges::stable_sort(
+      actions, std::less<>(),
+      [&order, chrome_action_for](
+          const side_panel::customize_chrome::mojom::ActionPtr& action) {
+        const std::optional<std::string> name =
+            OrderName(action->id, chrome_action_for);
+        return name ? static_cast<size_t>(std::ranges::find(order, *name) -
+                                          order.begin())
+                    : order.size();
+      });
+}
+
+bool IsToolbarOrderSaved(const PrefService& pref_service) {
+  return !pref_service.GetList(prefs::kHeliumWorkspacesToolbarOrder).empty();
+}
+
+void ClearToolbarOrder(PrefService& pref_service) {
+  pref_service.ClearPref(prefs::kHeliumWorkspacesToolbarOrder);
+}
+
+void SaveToolbarOrder(
+    const std::vector<ActionId>& order,
+    PrefService& pref_service,
+    PinnedToolbarActionsModel& model,
+    bool off_the_record,
+    ChromeActionFor chrome_action_for,
+    side_panel::customize_chrome::mojom::CustomizeToolbarClient* client) {
+  std::vector<std::string> names;
+  for (const ActionId action_id : order) {
+    // Mojo has already refused ids outside the enum, so a name missing here is
+    // this file's own gap (a row added upstream): skip it, keep the page.
+    std::optional<std::string> name = OrderName(action_id, chrome_action_for);
+    DCHECK(name) << "no toolbar order name for row " << action_id;
+    if (name) {
+      names.push_back(*std::move(name));
+    }
+  }
+  if (!toolbar_order::IsValid(names)) {
+    mojo::ReportBadMessage("SetToolbarOrder called with an invalid order.");
+    return;
+  }
+  // Off the record the toolbar follows the order but cannot change it, as
+  // with Chrome's own pinning (PinnedToolbarActionsModel::CanUpdate).
+  if (off_the_record) {
+    client->NotifyActionsUpdated();
+    return;
+  }
+
+  base::ListValue list;
+  for (const std::string& name : names) {
+    list.Append(name);
+  }
+  pref_service.SetList(prefs::kHeliumWorkspacesToolbarOrder, std::move(list));
+
+  // The pinned box draws its buttons in its own order: give it the list's, so
+  // the two read the same (toolbar_order::Arrange).
+  int index = 0;
+  for (const std::string& name : names) {
+    const std::optional<actions::ActionId> id =
+        actions::ActionIdMap::StringToActionId(name);
+    if (id && model.Contains(*id)) {
+      model.MovePinnedAction(*id, index++);
+    }
+  }
+}
+
+}  // namespace workspaces
