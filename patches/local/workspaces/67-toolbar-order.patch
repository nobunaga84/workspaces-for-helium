+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// Helium Workspaces (wish 6): Settings' Toolbar list as the toolbar, mounted
+// by one line in toolbar.html.ts in place of Chromium's list by category (the
+// hook shrink, part 5). The browser side is workspace_toolbar_rows.h.
+
+import 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+
+import {WebUiListenerMixinLit} from 'chrome://resources/cr_elements/web_ui_listener_mixin_lit.js';
+import {assert} from 'chrome://resources/js/assert.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {Action} from '../customize_toolbar.mojom-webui.js';
+import {ActionId, CategoryId} from '../customize_toolbar.mojom-webui.js';
+
+import {CustomizeToolbarApiProxy} from './customize_toolbar_api_proxy.js';
+import {getCss as getToolbarCss} from './toolbar.css.js';
+import {getCss} from './workspace_toolbar_list.css.js';
+import {getHtml} from './workspace_toolbar_list.html.js';
+
+const WorkspaceToolbarListElementBase = WebUiListenerMixinLit(CrLitElement);
+
+// Where a dragged row would land: in front of (or after) the row at `index`.
+interface DropTarget {
+  index: number;
+  after: boolean;
+}
+
+export class WorkspaceToolbarListElement extends
+    WorkspaceToolbarListElementBase {
+  static get is() {
+    return 'customize-chrome-workspace-toolbar-list';
+  }
+
+  static override get styles() {
+    // The rows look as the page's own did (toolbar.css), then the list's own.
+    return [getToolbarCss(), getCss()];
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      actions_: {type: Array},
+      dropTarget_: {type: Object},
+    };
+  }
+
+  private apiProxy_: CustomizeToolbarApiProxy =
+      CustomizeToolbarApiProxy.getInstance();
+  private listenerIds_: number[] = [];
+
+  protected accessor actions_: Action[] = [];
+  protected accessor dropTarget_: DropTarget|null = null;
+  private dragIndex_: number = -1;
+  // The row a keyboard move left the focus on, refocused after each redraw.
+  private focusedId_: number|null = null;
+  // Counts this list's own moves: a list asked for before the latest move is
+  // older than what is on screen (a held Alt+Up outruns the browser's redraw).
+  private moves_: number = 0;
+
+  constructor() {
+    super();
+    this.populateUi_();
+  }
+
+  override connectedCallback() {
+    super.connectedCallback();
+
+    this.listenerIds_ = [
+      this.apiProxy_.callbackRouter.setActionPinned.addListener(
+          this.setActionPinned_.bind(this)),
+      this.apiProxy_.callbackRouter.notifyActionsUpdated.addListener(
+          this.populateUi_.bind(this)),
+    ];
+
+    // The page asks for theme changes (observeThemeChanges); the icons follow.
+    this.addWebUiListener('theme-changed', this.populateUi_.bind(this));
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+
+    this.listenerIds_.forEach(
+        id => this.apiProxy_.callbackRouter.removeListener(id));
+    this.listenerIds_ = [];
+  }
+
+  protected getActionToggleHandler_(actionId: number, nextValue: boolean) {
+    return (_event: CustomEvent<boolean>) => {
+      // The flip may re-sort the list (an unpinned button leaves the toolbar's
+      // order): the redraw keeps the focus on this button (populateUi_).
+      this.focusedId_ = actionId;
+      this.apiProxy_.handler.pinAction(actionId, nextValue);
+    };
+  }
+
+  // Helium Workspaces (wish 6): the list is the toolbar, left to right, and
+  // its rows are dragged (or moved with Alt+Up / Alt+Down) into a new order.
+  // The address bar is a row of its own: what is above it is left of it.
+  protected isAddressBar_(action: Action): boolean {
+    return action.id === ActionId.kAddressBar;
+  }
+
+  protected dropClass_(index: number): string {
+    const target = this.dropTarget_;
+    if (!target || target.index !== index) {
+      return '';
+    }
+    return target.after ? 'drop-after' : 'drop-before';
+  }
+
+  protected onRowDragstart_(e: DragEvent) {
+    const row = this.rowOf_(e);
+    // Never from a switch: cr-toggle drags sideways to flip itself.
+    if (!row || e.composedPath().some(
+                    el => el instanceof HTMLElement &&
+                        el.tagName === 'CR-TOGGLE')) {
+      e.preventDefault();
+      return;
+    }
+    this.dragIndex_ = Number(row.dataset['index']);
+    this.focusedId_ = null;
+    e.dataTransfer!.effectAllowed = 'move';
+  }
+
+  protected onRowDragover_(e: DragEvent) {
+    if (this.dragIndex_ < 0) {
+      return;
+    }
+    // Between rows (a margin) the last drop line stays and still counts.
+    e.preventDefault();
+    const row = this.rowOf_(e);
+    if (!row) {
+      return;
+    }
+    const rect = row.getBoundingClientRect();
+    const index = Number(row.dataset['index']);
+    const after = e.clientY > rect.top + rect.height / 2;
+    const target = this.dropTarget_;
+    if (!target || target.index !== index || target.after !== after) {
+      this.dropTarget_ = {index, after};
+    }
+  }
+
+  protected onRowDrop_(e: DragEvent) {
+    e.preventDefault();
+    if (this.dragIndex_ >= 0 && this.dropTarget_) {
+      const from = this.dragIndex_;
+      let to = this.dropTarget_.index + (this.dropTarget_.after ? 1 : 0);
+      const [first, last] = this.blockOf_(from);
+      if (first < last && to >= first && to <= last + 1) {
+        // Within Chrome's own group: reorder inside it.
+        this.moveRows_(from, from, to);
+      } else {
+        // Anywhere else the group moves whole, and nothing lands inside it.
+        const [groupFirst, groupLast] =
+            this.isGrouped_(to) && this.isGrouped_(to - 1) ? this.blockOf_(to) :
+                                                             [to, to];
+        if (to > groupFirst && to <= groupLast) {
+          to = to - groupFirst <= groupLast + 1 - to ? groupFirst :
+                                                       groupLast + 1;
+        }
+        this.moveRows_(first, last, to);
+      }
+    }
+    this.onRowDragend_();
+  }
+
+  protected onRowDragend_() {
+    this.dragIndex_ = -1;
+    this.dropTarget_ = null;
+  }
+
+  // A click focuses a button's row (tabindex -1: Tab stops on its switch).
+  protected onRowKeydown_(e: KeyboardEvent) {
+    const row = this.rowOf_(e);
+    if (!row || !e.altKey || (e.key !== 'ArrowUp' && e.key !== 'ArrowDown')) {
+      return;
+    }
+    e.preventDefault();
+    const up = e.key === 'ArrowUp';
+    const from = Number(row.dataset['index']);
+    // One step: past the neighbouring row, or past Chrome's whole group; a
+    // row of the group steps inside it, or takes the group along at its edge.
+    const inside =
+        this.isGrouped_(from) && this.isGrouped_(up ? from - 1 : from + 1);
+    const [first, last] = inside ? [from, from] : this.blockOf_(from);
+    const neighbour = up ? first - 1 : last + 1;
+    if (neighbour < 0 || neighbour >= this.actions_.length) {
+      return;
+    }
+    const [nextFirst, nextLast] =
+        inside ? [neighbour, neighbour] : this.blockOf_(neighbour);
+    this.focusedId_ = this.actions_[from]!.id;
+    this.moveRows_(first, last, up ? nextFirst : nextLast + 1);
+    this.refocus_();
+  }
+
+  // Chrome's pinned buttons are ONE group in the toolbar (wish 6a): their rows
+  // move as one block.
+  private isGrouped_(index: number): boolean {
+    const action = this.actions_[index];
+    return !!action && action.category === CategoryId.kTools && action.pinned;
+  }
+
+  // [first, last] of the block the row at `index` moves in: the group, or the
+  // row alone.
+  private blockOf_(index: number): [number, number] {
+    let first = index;
+    let last = index;
+    if (this.isGrouped_(index)) {
+      while (this.isGrouped_(first - 1)) {
+        first--;
+      }
+      while (this.isGrouped_(last + 1)) {
+        last++;
+      }
+    }
+    return [first, last];
+  }
+
+  private refocus_(fromServer = false) {
+    const id = this.focusedId_;
+    const moves = this.moves_;
+    this.updateComplete.then(() => {
+      const index = this.actions_.findIndex(action => action.id === id);
+      const row = this.shadowRoot.querySelector<HTMLElement>(
+          `[data-index="${index}"]`);
+      (row?.querySelector<HTMLElement>('cr-toggle') ?? row)?.focus();
+      // After the browser's redraw of this move, the user's focus is theirs.
+      if (this.moves_ === moves && this.focusedId_ === id && fromServer) {
+        this.focusedId_ = null;
+      }
+    });
+  }
+
+  private rowOf_(e: Event): HTMLElement|null {
+    return (e.target as HTMLElement).closest<HTMLElement>('[data-index]');
+  }
+
+  // Moves rows `first`..`last` in front of the row now at `to` (`to` may be
+  // the list's length: the end) and saves the new order.
+  private moveRows_(first: number, last: number, to: number) {
+    if (to >= first && to <= last + 1) {
+      return;
+    }
+    const actions = [...this.actions_];
+    const moved = actions.splice(first, last - first + 1);
+    actions.splice(to > last ? to - moved.length : to, 0, ...moved);
+    this.actions_ = actions;
+    this.moves_++;
+    this.apiProxy_.handler.setToolbarOrder(actions.map(action => action.id));
+  }
+
+  private setActionPinned_(actionId: number, pinned: boolean) {
+    this.actions_ = this.actions_.map((action) => {
+      if (action.id === actionId) {
+        action.pinned = pinned;
+      }
+
+      return action;
+    });
+  }
+
+  private populateUi_() {
+    const moves = this.moves_;
+    this.apiProxy_.handler.listActions().then(({actions}) => {
+      if (moves !== this.moves_) {
+        return;
+      }
+      this.actions_ = actions;
+      // Rows are drawn by index: keep the focus on the row a keyboard move
+      // left it on, not on whatever row now sits at that index.
+      if (this.focusedId_ !== null &&
+          this.shadowRoot.activeElement !== null) {
+        this.refocus_(/*fromServer=*/ true);
+      }
+      assert(this.actions_.every(action => action.iconUrl.startsWith('data:')));
+    });
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'customize-chrome-workspace-toolbar-list': WorkspaceToolbarListElement;
+  }
+}
+
+customElements.define(
+    WorkspaceToolbarListElement.is, WorkspaceToolbarListElement);
