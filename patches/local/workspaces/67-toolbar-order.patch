+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/toolbar/workspace_toolbar_order.h"
+
+#include <algorithm>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_element_identifiers.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/workspaces/toolbar_order.h"
+#include "chrome/browser/ui/tabs/workspaces/workspace_prefs.h"
+#include "chrome/browser/ui/toolbar/pinned_toolbar/pinned_toolbar_actions_model.h"
+#include "chrome/browser/ui/toolbar/toolbar_pref_names.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_view.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_service.h"
+#include "ui/actions/actions.h"
+#include "ui/base/class_property.h"
+#include "ui/base/interaction/element_identifier.h"
+#include "ui/views/view_class_properties.h"
+
+namespace workspaces {
+
+// Lays the toolbar out again when the saved order or the pinned buttons'
+// order changes -- in this window and, through the profile's prefs, in every
+// other. Owned by the toolbar as a class property, so it cannot outlive it.
+class ToolbarOrderWatcher {
+ public:
+  ToolbarOrderWatcher(ToolbarView* toolbar, PrefService* prefs) {
+    registrar_.Init(prefs);
+    // UpdateToolbarLayout, not ApplyToolbarOrder: Helium's own Collapse move
+    // runs first there, so the saved order always has the last word.
+    const base::RepeatingClosure relayout = base::BindRepeating(
+        &ToolbarView::UpdateToolbarLayout, base::Unretained(toolbar));
+    registrar_.Add(prefs::kHeliumWorkspacesToolbarOrder, relayout);
+    registrar_.Add(::prefs::kPinnedActions, relayout);
+  }
+
+ private:
+  PrefChangeRegistrar registrar_;
+};
+
+}  // namespace workspaces
+
+DEFINE_UI_CLASS_PROPERTY_TYPE(workspaces::ToolbarOrderWatcher*)
+
+namespace workspaces {
+
+namespace {
+
+DEFINE_OWNED_UI_CLASS_PROPERTY_KEY(ToolbarOrderWatcher,
+                                   kToolbarOrderWatcherKey)
+
+// The toolbar's children the saved order names, by the element identifier each
+// already carries. The pinned box is named apart: it stands for its first
+// pinned button.
+std::optional<std::string> OwnButtonName(ui::ElementIdentifier id) {
+  const std::pair<ui::ElementIdentifier, const char*> kNamed[] = {
+      {kToolbarVerticalTabsCollapseButtonElementId, toolbar_order::kCollapse},
+      {kToolbarBackButtonElementId, toolbar_order::kBack},
+      {kToolbarForwardButtonElementId, toolbar_order::kForward},
+      {kReloadButtonElementId, toolbar_order::kReload},
+      {kToolbarHomeButtonElementId, toolbar_order::kHome},
+      {kToolbarSplitTabsToolbarButtonElementId, toolbar_order::kSplit},
+      {kLocationBarElementId, toolbar_order::kAddressBar},
+      {kToolbarDynamicNewTabButtonElementId, toolbar_order::kNewTab},
+      {kToolbarExtensionsContainerElementId, toolbar_order::kExtensions},
+      {kToolbarMediaButtonElementId, toolbar_order::kMedia},
+      {kToolbarAvatarButtonElementId, toolbar_order::kAvatar},
+      {kToolbarAppMenuButtonElementId, toolbar_order::kMenu},
+  };
+  for (const auto& [named_id, name] : kNamed) {
+    if (named_id == id) {
+      return name;
+    }
+  }
+  return std::nullopt;
+}
+
+// The first view in `list` carrying `id`, or list.end().
+template <typename List>
+auto FindById(const List& list, ui::ElementIdentifier id) {
+  return std::ranges::find_if(list, [id](views::View* view) {
+    return view->GetProperty(views::kElementIdentifierKey) == id;
+  });
+}
+
+}  // namespace
+
+void ApplyToolbarOrder(ToolbarView* toolbar) {
+  BrowserWindowInterface* const browser = toolbar->browser();
+  if (!browser || browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return;
+  }
+  Profile* const profile = browser->GetProfile();
+  // The regular profile's prefs, also for an incognito window: the order is
+  // saved there, and its changes reach this window's watcher directly.
+  PrefService* const pref_service = profile->GetOriginalProfile()->GetPrefs();
+  const bool first_layout = !toolbar->GetProperty(kToolbarOrderWatcherKey);
+  if (first_layout) {
+    toolbar->SetProperty(
+        kToolbarOrderWatcherKey,
+        std::make_unique<ToolbarOrderWatcher>(toolbar, pref_service));
+  }
+
+  const std::vector<std::string> saved = toolbar_order::FromList(
+      pref_service->GetList(prefs::kHeliumWorkspacesToolbarOrder));
+
+  std::vector<std::string> pinned;
+  for (const actions::ActionId id :
+       PinnedToolbarActionsModel::Get(profile)->PinnedActionIds()) {
+    if (std::optional<std::string> name =
+            actions::ActionIdMap::ActionIdToString(id)) {
+      pinned.push_back(*name);
+    }
+  }
+  std::vector<std::string> order =
+      saved.empty() ? toolbar_order::DefaultOrder(pinned, /*others=*/{})
+                    : toolbar_order::Arrange(saved, pinned, /*others=*/{});
+  // Helium's UpdateToolbarLayout has just put Collapse first, or right after
+  // the menu when vertical tabs are on the right -- next to the sidebar it
+  // folds. Unnamed, it rides behind the menu there; with nothing saved, first
+  // is where it already is.
+  if (saved.empty() ||
+      FindById(toolbar->children(),
+               kToolbarVerticalTabsCollapseButtonElementId) >
+          FindById(toolbar->children(), kToolbarAppMenuButtonElementId)) {
+    std::erase(order, toolbar_order::kCollapse);
+  }
+
+  // The pinned box stands for its first button: the order keeps the box's
+  // buttons one run that starts there. With nothing pinned it is named nothing
+  // and rides like any unnamed child.
+  const std::optional<std::string> pinned_box_name =
+      pinned.empty() ? std::nullopt : std::optional(pinned.front());
+
+  // Each named child, with the unnamed ones that follow it today (battery
+  // saver, glic, the compact tab strip after the address bar, ...): they keep
+  // riding behind it wherever it goes. Unnamed children before any named one
+  // stay first.
+  std::map<std::string, std::vector<views::View*>> runs;
+  std::vector<views::View*> leading;
+  views::View* overflow = nullptr;
+  std::string previous;
+  for (views::View* child : toolbar->children()) {
+    const ui::ElementIdentifier id =
+        child->GetProperty(views::kElementIdentifierKey);
+    if (id == kToolbarOverflowButtonElementId) {
+      overflow = child;
+      continue;
+    }
+    std::optional<std::string> name =
+        id == kPinnedToolbarActionsContainerElementId ? pinned_box_name
+                                                      : OwnButtonName(id);
+    if (name && !runs.contains(*name) && std::ranges::contains(order, *name)) {
+      runs[*name].push_back(child);
+      previous = *name;
+    } else if (previous.empty()) {
+      leading.push_back(child);
+    } else {
+      runs[previous].push_back(child);
+    }
+  }
+
+  std::vector<views::View*> wanted = std::move(leading);
+  for (const std::string& name : order) {
+    if (auto run = runs.find(name); run != runs.end()) {
+      wanted.insert(wanted.end(), run->second.begin(), run->second.end());
+    }
+  }
+  // The >> button just before the menu, where Init puts it; last when the
+  // menu was moved left of the address bar.
+  if (overflow) {
+    const auto menu = FindById(wanted, kToolbarAppMenuButtonElementId);
+    const bool menu_right =
+        menu != wanted.end() && FindById(wanted, kLocationBarElementId) < menu;
+    wanted.insert(menu_right ? menu : wanted.end(), overflow);
+  }
+
+  // Every child exactly once by construction; if that ever breaks, leave the
+  // toolbar as it is rather than crash the window over a button's place.
+  DCHECK_EQ(wanted.size(), toolbar->children().size());
+  if (wanted.size() != toolbar->children().size()) {
+    return;
+  }
+  // DefaultOrder copies ToolbarView::Init by hand: if a rebase changes Init,
+  // the first layout of a toolbar with nothing saved would move buttons.
+  DCHECK(!first_layout || !saved.empty() ||
+         std::equal(wanted.begin(), wanted.end(), toolbar->children().begin(),
+                    toolbar->children().end()))
+      << "toolbar_order::DefaultOrder no longer matches ToolbarView::Init";
+  for (size_t i = 0; i < wanted.size(); ++i) {
+    if (toolbar->children()[i] != wanted[i]) {
+      toolbar->ReorderChildView(wanted[i], i);
+    }
+  }
+}
+
+}  // namespace workspaces
