+// Transfer F8: a script, or a file on another computer -- Windows would
+// connect to it. Every other address is one this browser keeps itself (the
+// Archive takes any valid address, Replace pinned URL any page), so a file
+// it exported always comes back in.
+bool IsForeignAddress(std::string_view url) {
+  constexpr auto kInsensitive = base::CompareCase::INSENSITIVE_ASCII;
+  return base::StartsWith(url, "javascript:", kInsensitive) ||
+         (base::StartsWith(url, "file://", kInsensitive) &&
+          !base::StartsWith(url, "file:///", kInsensitive));
+}
+
+// The first address in `nodes`, at any depth, IsForeignAddress names.
+const std::string* ForeignAddress(const std::vector<PinNode>& nodes) {
+  for (const PinNode& node : nodes) {
+    if (node.type == PinNode::Type::kItem && IsForeignAddress(node.url)) {
+      return &node.url;
+    }
+    if (const std::string* inner = ForeignAddress(node.children)) {
+      return inner;
+    }
+  }
+  return nullptr;
+}
+
+std::string ForeignAddressError(std::string_view url) {
+  return "The file holds an address this browser does not import: " +
+         std::string(url.substr(0, 40));
+}
