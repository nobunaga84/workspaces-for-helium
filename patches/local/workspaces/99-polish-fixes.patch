+  const auto archive = [](std::string_view url) {
+    return Craft(
+        {{kPrefsMember, kPrefsText},
+         {kArchiveMember,
+          base::StrCat({R"({"version":1,"entries":[{"id":"x","url":")", url,
+                        R"(","title":"t","workspace":"default","reason":"manual",)"
+                        R"("archived_at":"13437074330809987",)"
+                        R"("last_active":"13437074330809987"}]})"})}});
+  };
+  for (const std::string_view ok :
+       {"https://a.example/", "http://a.example/", "chrome://settings/",
+        "file:///C:/Docs/a.pdf", "HTTPS://A.EXAMPLE/",
+        "chrome-extension://abc/dashboard.html", "about:blank",
+        "data:text/html,x", "view-source:https://a.example/",
+        "ftp://a.example/"}) {
+    EXPECT_TRUE(ParseExport(pins(item(ok))).value) << ok;
+    EXPECT_TRUE(ParseExport(archive(ok)).value) << ok;
+  }
+  for (const std::string_view bad :
+       {"javascript:alert(1)", "JavaScript:x", "file://host/share/x.html",
+        "FILE://host/x"}) {
+    const ParseResult result = ParseExport(pins(item(bad)));
+    EXPECT_FALSE(result.value) << bad;
+    EXPECT_NE(result.error.find("address"), std::string::npos) << result.error;
+    EXPECT_FALSE(ParseExport(archive(bad)).value) << bad;
+  }
+  // Inside a folder, and one half of a split.
+  EXPECT_FALSE(ParseExport(pins(base::StrCat(
+                               {R"({"type":"folder","id":"f","title":"F",)"
+                                R"("children":[)",
+                                item("javascript:x"), "]}"})))
+                   .value);
+  EXPECT_FALSE(
+      ParseExport(pins(base::StrCat(
+                      {R"({"type":"split","id":"s","title":"","children":[)",
+                       R"({"type":"item","id":"l","title":"L",)"
+                       R"("url":"https://l.example/"},)"
+                       R"({"type":"item","id":"r","title":"R",)"
+                       R"("url":"file://host/r"}]})"})))
