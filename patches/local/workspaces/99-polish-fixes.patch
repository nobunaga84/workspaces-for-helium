+// Transfer F9: a workspace list of another schema would import, then read as
+// Home alone (ParseWorkspaces) -- and the next list edit would save that. A
+// list without a version is read as before (the fixtures above, the script's).
+TEST(WorkspaceTransferTest, AWorkspaceListOfAnotherVersionIsRefused) {
+  const auto with = [](std::string_view list) {
+    return Craft({{kPrefsMember,
+                   base::StrCat(
+                       {R"({"helium":{"workspaces":{"list":)", list, "}}}"})}});
+  };
+  EXPECT_TRUE(ParseExport(with(R"({"schema_version":1,"items":[]})")).value);
+  EXPECT_TRUE(ParseExport(with(R"({"items":[]})")).value);
+  const ParseResult newer =
+      ParseExport(with(R"({"schema_version":2,"items":[]})"));
+  EXPECT_FALSE(newer.value);
+  EXPECT_NE(newer.error.find("newer"), std::string::npos) << newer.error;
+  const ParseResult zero =
+      ParseExport(with(R"({"schema_version":0,"items":[]})"));
+  EXPECT_FALSE(zero.value);
+  EXPECT_EQ(zero.error.find("newer"), std::string::npos) << zero.error;
+  // ParseWorkspaces reads an int: a 1.0 or a "1" is no version to it.
+  EXPECT_FALSE(ParseExport(with(R"({"schema_version":1.0,"items":[]})")).value);
+  EXPECT_FALSE(ParseExport(with(R"({"schema_version":"1","items":[]})")).value);
