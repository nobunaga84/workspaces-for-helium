+bool WorkspaceService::InsideACollection(int index) const {
+  // True when `index` falls INSIDE a group or a split rather than between two
+  // of them, which is a destination none of the three mutators Reconcile()
+  // and MoveTabsToWorkspace() use survives -- and each fails differently.
+  // MoveWebContentsAt absorbs the moved tab into the group (GetGroupToAssign);
+  // MoveGroupTo silently DESTROYS the split it would break (RemoveSplitImpl);
+  // MoveSplitTo CHECKs, which on a release build is a browser crash.
+  //
+  // It cannot happen while every unit moves whole and its destination
+  // therefore always lands on a unit boundary, which is the invariant both
+  // move loops maintain. That is the argument; this is the check, and the
+  // argument being wrong is not a cosmetic failure: an absorbed tab fires
+  // TabGroupedStateChanged, which ends in ApplyCollectionGuid rewriting that
+  // tab's workspace tag, which SetTag then writes into the session file. A
+  // silent, persisted membership change is far worse than an untidy strip, so
+  // a bad destination abandons the move rather than trusting the proof.
+  //
+  // CONSERVATIVE, NOT EXACT. Chromium's own MoveBreaksSplitContiguity() also
+  // weighs the gap the moving unit vacates, so this can pass where that would
+  // still refuse. It is the cheap half of the question; the unit invariant is
+  // what covers the rest.
+  if (index <= 0) {
+    return false;
+  }
+  const std::optional<tab_groups::TabGroupId> group =
+      tab_strip_->GetTabGroupForTab(index);
+  if (group.has_value() && group == tab_strip_->GetTabGroupForTab(index - 1)) {
+    return true;
+  }
+  const std::optional<split_tabs::SplitTabId> split =
+      tab_strip_->GetSplitForTab(index);
+  return split.has_value() && split == tab_strip_->GetSplitForTab(index - 1);
+}
