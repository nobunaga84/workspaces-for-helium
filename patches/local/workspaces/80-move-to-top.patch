+int WorkspaceService::FirstTodayIndexOf(std::string_view guid) const {
+  // The strip's own iterator and a counter, never GetTabAtIndex(i): an index
+  // lookup walks the collection tree, and every new tab asks this through
+  // TopOfListIndex, in a window that may hold 3,862 tabs (LOCAL.md 37, C2).
+  const int first = tab_strip_->IndexOfFirstNonPinnedTab();
+  int index = 0;
+  for (tabs::TabInterface* const tab : *tab_strip_) {
+    const int i = index++;
+    if (i >= first && IsTabOfWorkspace(tab, guid) && !IsDrawnAsPinnedRow(tab)) {
+      return i;
+    }
+  }
+  return -1;
+}
