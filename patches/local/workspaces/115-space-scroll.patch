+void WorkspacePinnedSectionView::RestoreScroll() {
+  if (!std::exchange(restore_scroll_, false) || drawn_guid_.empty()) {
+    return;
+  }
+  views::ScrollView* const scroll_view = GetScrollView();
+  views::Widget* const widget = GetWidget();
+  if (!scroll_view || !widget) {
+    return;
+  }
+  const auto saved = scroll_by_guid_.find(drawn_guid_);
+  if (saved != scroll_by_guid_.end()) {
+    // The new rows laid out first: an offset is held to the list's height as
+    // it is (ScrollView::ScrollToPosition), and it was the old workspace's.
+    // Only here: a workspace's first visit has nothing to put back, and the
+    // fit below needs no forced layout.
+    widget->LayoutRootViewIfNecessary();
+    scroll_view->ScrollToPosition(scroll_view->vertical_scroll_bar(),
+                                  saved->second);
+  }
+  // Then the active tab in view, the least scroll that shows it (the owner's
+  // pick): Chromium's own fit. Without it the activation's fit, made against
+  // the OLD workspace's pinned rows, is the last word -- that was the jump.
+  // A pinned item's page is skipped there; its row scrolls itself into view
+  // in UpdateRowStates(). The fit runs at the scroll view's next layout,
+  // before the next frame paints -- not forced here, which would lay the
+  // whole window out a second time per switch (review).
+  if (auto* const strip =
+          views::AsViewClass<TabStripView>(scroll_view->parent())) {
+    strip->ScrollToFitTabs(browser_->GetTabStripModel()->GetActiveTab(),
+                           nullptr);
+    scroll_view->InvalidateLayout();
+  }
+  // The place restored, before that fit.
+  LOG(INFO) << "[workspaces] pins: scroll '" << drawn_guid_ << "' -> "
+            << base::ClampRound(scroll_view->CurrentOffset().y())
+            << " px (saved "
+            << (saved != scroll_by_guid_.end()
+                    ? base::NumberToString(saved->second)
+                    : std::string("none"))
+            << ")";
+}
