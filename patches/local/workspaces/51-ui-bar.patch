+// "Edit workspace..." on a workspace's menu (E17a, design 5 "E17 spec" 5): one
+// bubble for what Rename and the Change icon submenu did apart, since a native
+// menu cannot show colour swatches.
+//
+//   Name    [ Work                    ]
+//   Colour  (o) ( ) ( ) ( ) ( ) ( ) ( ) ( ) ( )
+//   Icon    [h] [w] [s] [p] [s] [m]
+//           [c] [t] [f] [l] [s] [p]
+//   [ Custom emoji... ]
+//
+// - Colour and Icon apply as they are clicked (WorkspaceService's
+//   SetWorkspaceColor / SetWorkspaceSymbol), and the bubble moves its own
+//   ring and fill: the write rebuilds the rail, never this bubble.
+// - The name applies when the bubble closes -- Enter, Escape, a click away --
+//   if it was changed and is not empty: per keystroke would rebuild the rail
+//   on every letter, and an empty name keeps the old one.
+// - "Custom emoji..." closes this bubble and opens today's emoji prompt (E11,
+//   WorkspaceRailView::ShowNameBubble) on the same anchor.
+// - What is shown as current is what the rail draws: prefs::EffectiveColors
+//   and prefs::EffectiveSymbol, so Home's grey and house show as chosen.
+//
+// Anchored to the rail, never to a chip: every write here runs the rail's
+// Rebuild(), which deletes and remakes the chips.
+//
+// Logs, never a name (47's rule: a log is pasted when asking for help):
+//   "[workspaces] edit workspace: opened '<guid>'"
+//   "[workspaces] edit workspace: colour -> N"
+//   "[workspaces] edit workspace: symbol -> <preset>"
+//   "[workspaces] edit workspace: name changed"
+//
+// Accessible names: the text field "Name", each swatch its tab-group colour
+// name (Chromium's), each preset its word ("Home", "Work", ...), both said as
+// radio buttons, checked when current; the button "Custom emoji..." (U+2026).
+//
+// A plain view inside the rail's kind of bubble (a ui::DialogModel in a
+// views::BubbleDialogModelHost, its one custom field), as the Archive screen
+// is and for its reason: BubbleDialogDelegateView's constructors are private
+// to a friend list upstream (E14d.2).
+class WorkspaceEditBubbleView : public views::View,
+                                public views::TextfieldController {
+  METADATA_HEADER(WorkspaceEditBubbleView, views::View)
+
+ public:
+  // The "Edit workspace..." bubble for `guid`, anchored to `anchor` -- the
+  // RAIL, never a chip (every write rebuilds the chips). `rename` is run with
+  // the new name, posted, when the bubble closes with a changed, non-empty
+  // name; bind it to a WeakPtr. Does nothing while Workspaces is off in
+  // `browser` or when `guid` is not a workspace.
+  static void Show(BrowserWindowInterface* browser,
+                   views::View* anchor,
+                   const std::string& guid,
+                   base::OnceCallback<void(const std::u16string&)> rename);
+
+  WorkspaceEditBubbleView(const WorkspaceEditBubbleView&) = delete;
+  WorkspaceEditBubbleView& operator=(const WorkspaceEditBubbleView&) = delete;
+  ~WorkspaceEditBubbleView() override;
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override;
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override;
+
+  // views::View:
+  void OnThemeChanged() override;
+
+ private:
+  WorkspaceEditBubbleView(BrowserWindowInterface* browser,
+                          views::View* anchor,
+                          const workspaces::prefs::WorkspaceEntry& entry,
+                          int color);
+
+  void OnColorPressed(int color);
+  void OnSymbolPressed(size_t index);
+  void OnCustomEmojiPressed();
+
+  // Paints the swatches and the presets in this theme's colours and marks
+  // the current colour and preset. Does nothing before there is a provider.
+  void UpdateChoices();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  // The rail: where "Custom emoji..." opens its prompt, if it is still there.
+  views::ViewTracker anchor_;
+  const std::string guid_;
+  // The emoji, the prompt's starting text; a preset clears it, as the store
+  // does (prefs::SetWorkspaceSymbol).
+  std::string icon_;
+  // The current colour (0-8) and preset ("" for none), effective values.
+  int color_;
+  std::string symbol_;
+
+  // The name as the bubble opened, and what the close applies: the typed
+  // name when it differs and is not empty, else empty. Shared with the
+  // dialog's destroying callback, which runs as the bubble closes and must
+  // not reach into this view.
+  const std::u16string initial_name_;
+  const scoped_refptr<base::RefCountedData<std::u16string>> name_;
+
+  raw_ptr<views::Textfield> name_field_ = nullptr;
+  // Index for index: the colour ids 0-8, and prefs::kWorkspaceSymbols.
+  std::vector<raw_ptr<WorkspaceEditChoice>> swatches_;
+  std::vector<raw_ptr<WorkspaceEditChoice>> symbols_;
+};
