+const gfx::VectorIcon* WorkspaceRailView::SymbolIcon(std::string_view symbol) {
+  const std::pair<std::string_view, const gfx::VectorIcon*> kSymbolIcons[] = {
+      {"home", &vector_icons::kHomeIcon},
+      {"work", &vector_icons::kWorkIcon},
+      {"study", &vector_icons::kScienceIcon},
+      {"play", &vector_icons::kVideogameAssetIcon},
+      {"shopping", &vector_icons::kShoppingBagIcon},
+      {"music", &kQueueMusicIcon},
+      {"code", &vector_icons::kCodeIcon},
+      {"travel", &kTravelExploreIcon},
+      {"flight", &vector_icons::kFlightIcon},
+      {"launch", &kRocketLaunchIcon},
+      {"star", &kStarIcon},
+      {"pets", &vector_icons::kPetsIcon},
+  };
+  // A preset added to :prefs without an icon here would draw as a letter.
+  static_assert(std::extent_v<decltype(kSymbolIcons)> ==
+                workspaces::prefs::kWorkspaceSymbols.size());
+  for (const auto& [name, icon] : kSymbolIcons) {
+    if (name == symbol) {
+      return icon;
+    }
+  }
+  return nullptr;
