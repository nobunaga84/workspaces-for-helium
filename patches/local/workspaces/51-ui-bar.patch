+// static
+void WorkspaceEditBubbleView::Show(
+    BrowserWindowInterface* browser,
+    views::View* anchor,
+    const std::string& guid,
+    base::OnceCallback<void(const std::u16string&)> rename) {
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser);
+  if (!service || !service->IsEnabled()) {
+    return;
+  }
+  const std::vector<workspaces::prefs::WorkspaceEntry> entries =
+      service->GetWorkspaces();
+  const auto entry = std::ranges::find(
+      entries, guid, &workspaces::prefs::WorkspaceEntry::guid);
+  if (entry == entries.end()) {
+    return;
+  }
+  const size_t index =
+      static_cast<size_t>(std::distance(entries.begin(), entry));
+  auto view = base::WrapUnique(new WorkspaceEditBubbleView(
+      browser, anchor, *entry,
+      workspaces::prefs::EffectiveColors(entries)[index]));
+  WorkspaceEditBubbleView* const editor = view.get();
+
+  // No buttons: the choices apply as they are clicked, and the name as the
+  // bubble closes. The name field takes the focus, so typing renames at once.
+  std::unique_ptr<ui::DialogModel> model =
+      ui::DialogModel::Builder()
+          .SetTitle(l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_EDIT_TITLE))
+          .AddCustomField(
+              std::make_unique<views::BubbleDialogModelHost::CustomView>(
+                  std::move(view),
+                  views::BubbleDialogModelHost::FieldType::kControl,
+                  editor->name_field_.get()),
+              kEditNameFieldId)
+          .SetInitiallyFocusedField(kEditNameFieldId)
+          .SetDialogDestroyingCallback(
+              base::BindOnce(&ApplyName, editor->name_, std::move(rename)))
+          .Build();
+
+  // Anchored to the rail at the bottom of the strip, so it rises above it.
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(model), anchor, views::BubbleBorder::BOTTOM_LEFT);
+  bubble->set_fixed_width(kWidth);
+  views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET)
+      ->Show();
+  LOG(INFO) << "[workspaces] edit workspace: opened '" << guid << "'";
+}
+
+WorkspaceEditBubbleView::WorkspaceEditBubbleView(
+    BrowserWindowInterface* browser,
+    views::View* anchor,
+    const workspaces::prefs::WorkspaceEntry& entry,
+    int color)
+    : browser_(browser),
+      anchor_(anchor),
+      guid_(entry.guid),
+      icon_(entry.icon),
+      color_(color),
+      symbol_(workspaces::prefs::EffectiveSymbol(entry)),
+      initial_name_(WorkspaceRailView::DisplayName(entry)),
+      name_(base::MakeRefCounted<base::RefCountedData<std::u16string>>()) {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), kSpacing));
+
+  AddHeading(this, IDS_HELIUM_WORKSPACE_NAME_LABEL, 0);
+  name_field_ = AddChildView(std::make_unique<views::Textfield>());
+  name_field_->SetText(initial_name_);
+  // Selected, so typing replaces the name: the host selects only its own
+  // DialogModelTextfields, and this one is a custom field's.
+  name_field_->SelectAll(/*reversed=*/false);
+  name_field_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_NAME_LABEL));
+  name_field_->set_controller(this);
+
+  // Colours resolve in OnThemeChanged(): there is no provider yet.
+  AddHeading(this, IDS_HELIUM_WORKSPACE_EDIT_COLOR, kSectionSpacing);
+  views::View* const colors = AddRow(this, 0);
+  for (int i = 0; i < workspaces::prefs::kWorkspaceColorCount; ++i) {
+    auto* const swatch =
+        colors->AddChildView(std::make_unique<WorkspaceEditChoice>(
+            base::BindRepeating(&WorkspaceEditBubbleView::OnColorPressed,
+                                base::Unretained(this), i),
+            tab_groups::GetTabGroupColorLabelMap().at(
+                static_cast<tab_groups::TabGroupColorId>(i))));
+    views::InstallCircleHighlightPathGenerator(swatch);
+    swatches_.push_back(swatch);
+  }
+
+  AddHeading(this, IDS_HELIUM_WORKSPACE_EDIT_ICON, kSectionSpacing);
+  views::View* row = nullptr;
+  for (size_t i = 0; i < kWorkspaceSymbols.size(); ++i) {
+    if (i % kSymbolColumns == 0) {
+      row = AddRow(this, kSpacing);
+    }
+    auto* const preset =
+        row->AddChildView(std::make_unique<WorkspaceEditChoice>(
+            base::BindRepeating(&WorkspaceEditBubbleView::OnSymbolPressed,
+                                base::Unretained(this), i),
+            l10n_util::GetStringUTF16(kSymbolNames[i])));
+    views::InstallRoundRectHighlightPathGenerator(
+        preset, gfx::Insets(),
+        gfx::RoundedCornersF(WorkspaceRailView::kChipRadius));
+    symbols_.push_back(preset);
+  }
+
+  views::View* const custom = AddRow(this, 0);
+  custom->SetProperty(views::kMarginsKey,
+                      gfx::Insets::TLBR(kSectionSpacing, 0, 0, 0));
+  custom->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&WorkspaceEditBubbleView::OnCustomEmojiPressed,
+                          base::Unretained(this)),
+      l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_ICON_CUSTOM_EMOJI)));
+}
+
+WorkspaceEditBubbleView::~WorkspaceEditBubbleView() = default;
+
+void WorkspaceEditBubbleView::ContentsChanged(
+    views::Textfield* sender,
+    const std::u16string& new_contents) {
+  name_->data = new_contents == initial_name_ ? std::u16string() : new_contents;
+}
+
+bool WorkspaceEditBubbleView::HandleKeyEvent(views::Textfield* sender,
+                                             const ui::KeyEvent& key_event) {
+  // Enter closes, and the close applies the name (ApplyName): one road for
+  // every way the bubble ends, so a name is never applied twice.
+  if (key_event.type() != ui::EventType::kKeyPressed ||
+      key_event.key_code() != ui::VKEY_RETURN) {
+    return false;
+  }
+  GetWidget()->Close();
+  return true;
+}
+
+void WorkspaceEditBubbleView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  UpdateChoices();
+}
+
+// Both writes below run inside a swatch's or a preset's own click, which is
+// safe here and only here: the write rebuilds the rail's chips, and these
+// buttons are this bubble's, which the rebuild never touches.
+void WorkspaceEditBubbleView::OnColorPressed(int color) {
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service) {
+    return;
+  }
+  LOG(INFO) << "[workspaces] edit workspace: colour -> " << color;
+  color_ = color;
+  service->SetWorkspaceColor(guid_, color);
+  UpdateChoices();
+}
+
+void WorkspaceEditBubbleView::OnSymbolPressed(size_t index) {
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service) {
+    return;
+  }
+  symbol_ = std::string(kWorkspaceSymbols[index]);
+  LOG(INFO) << "[workspaces] edit workspace: symbol -> " << symbol_;
+  icon_.clear();
+  service->SetWorkspaceSymbol(guid_, symbol_);
+  UpdateChoices();
+}
+
+void WorkspaceEditBubbleView::OnCustomEmojiPressed() {
+  // Everything the prompt needs is copied before the close, and the prompt
+  // opens only after it: one opened now would take the focus from a bubble
+  // still standing. The tracker answers whether the anchor lived that long.
+  base::OnceClosure prompt = base::BindOnce(
+      &ShowEmojiPrompt, std::make_unique<views::ViewTracker>(anchor_.view()),
+      browser_->GetWeakPtr(), guid_, base::UTF8ToUTF16(icon_));
+  GetWidget()->Close();
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                           std::move(prompt));
+}
+
+void WorkspaceEditBubbleView::UpdateChoices() {
+  const ui::ColorProvider* const provider = GetColorProvider();
+  if (!provider) {
+    return;
+  }
+  const SkColor ring = provider->GetColor(ui::kColorLabelForeground);
+  for (size_t i = 0; i < swatches_.size(); ++i) {
+    WorkspaceEditChoice* const swatch = swatches_[i];
+    swatch->SetSwatch(
+        WorkspaceRailView::WorkspaceColor(*provider, static_cast<int>(i),
+                                          /*active_frame=*/true),
+        ring);
+    swatch->SetSelected(static_cast<int>(i) == color_);
+  }
+
+  // Every preset in the workspace's colour, so the grid previews the chip.
+  const SkColor color = WorkspaceRailView::WorkspaceColor(
+      *provider, color_, /*active_frame=*/true);
+  for (size_t i = 0; i < symbols_.size(); ++i) {
+    WorkspaceEditChoice* const preset = symbols_[i];
+    const bool current = kWorkspaceSymbols[i] == symbol_;
+    if (const gfx::VectorIcon* const icon =
+            WorkspaceRailView::SymbolIcon(kWorkspaceSymbols[i])) {
+      preset->SetImageModel(
+          views::Button::STATE_NORMAL,
+          ui::ImageModel::FromVectorIcon(*icon, color, kIconSize));
+    }
+    preset->SetBackground(
+        current ? WorkspaceRailView::CurrentFill(*provider, color) : nullptr);
+    preset->SetSelected(current);
+  }
+}
