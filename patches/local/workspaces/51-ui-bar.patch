+void WorkspaceRailView::ShowArrowsOnOverflow() {
+  // Measured on the rail, the room between Archive and + with no arrows, so
+  // the answer depends on nothing the arrows change: neither their own width
+  // nor the scroller's, which is pushed to zero while the rail is under its
+  // minimum. SetVisible only on a change, since each change lays the bar out
+  // and posts this again.
+  const int room = width() - GetInsets().width() - archive_button_->width() -
+                   add_button_->width();
+  const bool show =
+      GetOrientation() == views::LayoutOrientation::kHorizontal &&
+      scroll_contents_->GetPreferredSize().width() > room;
+  if (back_button_->GetVisible() == show) {
+    return;
+  }
+  back_button_->SetVisible(show);
+  forward_button_->SetVisible(show);
+}
