+// 2.7) -- writing to the window's service if the window is.
+void ShowEmojiPrompt(std::unique_ptr<views::ViewTracker> anchor,
+                     base::WeakPtr<BrowserWindowInterface> browser,
+                     const std::string& guid,
+                     const std::u16string& icon) {
+  if (!anchor->view() || !browser) {
+    return;
+  }
+  WorkspaceRailView::ShowNameBubble(
+      anchor->view(), IDS_HELIUM_WORKSPACE_CHANGE_ICON,
+      IDS_HELIUM_WORKSPACE_ICON_LABEL, icon,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserWindowInterface> browser,
+             const std::string& guid, const std::u16string& icon) {
+            if (!browser) {
+              return;
+            }
+            if (workspaces::WorkspaceService* const service =
+                    workspaces::WorkspaceService::From(browser.get())) {
+              service->SetWorkspaceIcon(guid, base::UTF16ToUTF8(icon));
+            }
+          },
+          std::move(browser), guid));
+}
+
+}  // namespace
+
+// One colour or one preset: a 28 px square said as a radio button, checked
+// while it is the workspace's current one -- Chromium's tab-group colour
+// picker does the same. A swatch paints its own circle; a preset is the
+// button's image on a background (WorkspaceEditBubbleView::UpdateChoices).
+// Outside the anonymous namespace only so the header can name it in
+// `swatches_` and `symbols_`.
+class WorkspaceEditChoice : public views::ImageButton {
+  METADATA_HEADER(WorkspaceEditChoice, views::ImageButton)
+
+ public:
+  WorkspaceEditChoice(PressedCallback callback, const std::u16string& name)
+      : views::ImageButton(std::move(callback)) {
+    SetTooltipText(name);
+    GetViewAccessibility().SetName(name);
+    GetViewAccessibility().SetRole(ax::mojom::Role::kRadioButton);
+    SetPreferredSize(gfx::Size(kChoiceSize, kChoiceSize));
+    SetImageHorizontalAlignment(ALIGN_CENTER);
+    SetImageVerticalAlignment(ALIGN_MIDDLE);
+    UpdateAccessibleCheckedState();
+  }
+  WorkspaceEditChoice(const WorkspaceEditChoice&) = delete;
+  WorkspaceEditChoice& operator=(const WorkspaceEditChoice&) = delete;
+  ~WorkspaceEditChoice() override = default;
+
+  void SetSelected(bool selected) {
+    selected_ = selected;
+    UpdateAccessibleCheckedState();
+    SchedulePaint();
+  }
+
+  // Makes this a swatch: a `fill` circle, ringed in `ring` while selected.
+  void SetSwatch(SkColor fill, SkColor ring) {
+    swatch_ = fill;
+    ring_ = ring;
+    SchedulePaint();
+  }
+
+ protected:
+  // views::Button:
+  //
+  // The checked state is the selection's. Button's own would set it from the
+  // pressed state, and clear it on every hover.
+  void UpdateAccessibleCheckedState() override {
+    GetViewAccessibility().SetCheckedState(
+        selected_ ? ax::mojom::CheckedState::kTrue
+                  : ax::mojom::CheckedState::kFalse);
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    if (!swatch_) {
+      views::ImageButton::PaintButtonContents(canvas);
+      return;
+    }
+    const gfx::PointF center = gfx::RectF(GetContentsBounds()).CenterPoint();
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(*swatch_);
+    canvas->DrawCircle(
+        center, selected_ ? kSwatchRadius - kRingWidth : kSwatchRadius, flags);
+    if (!selected_) {
+      return;
+    }
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(kRingWidth);
+    flags.setColor(ring_);
+    canvas->DrawCircle(center, kSwatchRadius + kRingWidth / 2, flags);
+  }
+
+ private:
+  bool selected_ = false;
+  std::optional<SkColor> swatch_;
+  SkColor ring_ = SK_ColorTRANSPARENT;
+};
