+std::optional<int> WorkspaceService::LastUsedTabIndex(
+    const gfx::Range& excluded) const {
+  // D3: Workspaces off is stock, as anchors are dormant while off.
+  if (!IsEnabled()) {
+    return std::nullopt;
+  }
+  // The strip's own iterator and a counter, never GetTabAtIndex(i): an index
+  // lookup walks the collection tree, and this runs on every close of the
+  // active tab in a window that may hold 3,862 tabs (LOCAL.md 37, C2). The
+  // cheap questions first; the group's, only of a tab that would win (A5).
+  int best = TabStripModel::kNoTab;
+  base::Time best_left;
+  int index = 0;
+  for (tabs::TabInterface* const tab : *tab_strip_) {
+    const int i = index++;
+    if (excluded.Contains(gfx::Range(i, i + 1))) {
+      continue;
+    }
+    const base::Time left = LeftAt(tab);
+    if (left.is_null() || left <= best_left || !IsTabOnScreen(tab)) {
+      continue;
+    }
+    // Chromium's own exclusion (D1): a tab folded away is not landed on.
+    if (const std::optional<tab_groups::TabGroupId> group = tab->GetGroup();
+        group && tab_strip_->IsGroupCollapsed(*group)) {
+      continue;
+    }
+    best = i;
+    best_left = left;
+  }
+  // ponytail: one of Chromium's batch closes (a group, "Close tabs below")
+  // whose pick is another tab of the batch walks again for that one -- k
+  // walks of ~0.1 ms at 3,862 tabs, k log lines; the fork's own bulk closes
+  // close the active tab last instead. Pass the whole batch if it shows.
+  if (best == TabStripModel::kNoTab) {
+    return std::nullopt;
+  }
+  LOG(INFO) << "[workspaces] last used tab -> index " << best;
+  return best;
+}
