+namespace workspaces {
+
+bool MaybeOpenLittleWindow(Profile* profile, const GURL& url) {
+  // An .htm file from Explorer comes the same way (one ProgID serves http,
+  // https, .htm and .html), and stays a tab (D12).
+  if (!profile || !profile->IsRegularProfile() ||
+      !url.SchemeIsHTTPOrHTTPS() ||
+      !profile->GetPrefs()->GetBoolean(prefs::kHeliumWorkspacesLittleWindow) ||
+      GetBrowserWindowCreationStatusForProfile(*profile) !=
+          BrowserWindowInterface::CreationStatus::kOk) {
+    return false;
+  }
+
+  const gfx::Rect work =
+      display::Screen::Get()->GetDisplayForNewWindows().work_area();
+  const prefs::LittleWindowRect rect = prefs::LittleWindowBounds(
+      work.x(), work.y(), work.width(), work.height());
+  // No app_name and no user_title: the window keeps the browser's taskbar id,
+  // so it groups with the main window (browser_window_property_manager_win).
+  // A pop-up's bounds are its page's: the frame and the address row come on
+  // top (BrowserView::GetSavedWindowPlacement). The window is given the
+  // rectangle again before it shows (below), so the whole window is it.
+  BrowserWindowCreateParams params(BrowserWindowInterface::TYPE_POPUP,
+                                   *profile, /*from_user_gesture=*/true);
+  const gfx::Rect initial(rect.x, rect.y, rect.width, rect.height);
+  params.initial_bounds = initial;
+  params.initial_origin_specified =
+      BrowserWindowCreateParams::ValueSpecified::kSpecified;
+  // Never restored, and never written: a little window is thrown away.
+  params.omit_from_session_restore = true;
+  BrowserWindowInterface* const popup = CreateBrowserWindow(std::move(params));
+  if (!popup) {
+    return false;
+  }
+
+  // At the right end of the address row: a pop-up's slim toolbar is the
+  // address bar and the pinned actions in a row (ToolbarView::Init, run while
+  // the window was made), and a child added now comes after them.
+  if (BrowserView* const view = BrowserView::GetBrowserViewForBrowser(popup);
+      view && view->toolbar()) {
+    auto button = std::make_unique<ToolbarButton>(base::BindRepeating(
+        [](BrowserWindowInterface* browser) {
+          chrome::ExecuteCommand(browser, IDC_SHOW_AS_TAB);
+        },
+        base::Unretained(popup)));
+    const std::u16string name =
+        l10n_util::GetStringUTF16(IDS_HELIUM_LITTLE_WINDOW_OPEN);
+    button->SetVectorIcon(kOpenInBrowserIcon);
+    button->SetTooltipText(name);
+    button->GetViewAccessibility().SetName(name);
+    view->toolbar()->AddChildView(std::move(button));
+  }
+
+  chrome::AddSelectedTabWithURL(popup, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  popup->GetWindow()->SetBounds(initial);
+  popup->GetWindow()->Show();
+  LOG(INFO) << "[workspaces] little window: opened window "
+            << popup->GetSessionID().id() << " at " << rect.x << ","
+            << rect.y << " " << rect.width << "x" << rect.height;
+  return true;
+}
+
+bool MoveToMainWindow(BrowserWindowInterface* popup) {
+  TabStripModel* const from = popup->GetTabStripModel();
+  if (from->empty()) {
+    return false;
+  }
+
+  // The main window first, as Chromium does: the pop-up emptied below must
+  // never be the last window, or its close starts a shutdown.
+  Profile* const profile = popup->GetProfile();
+  BrowserWindowInterface* target =
+      ProfileBrowserCollection::GetForProfile(profile)->FindTabbedBrowser();
+  if (!target) {
+    if (GetBrowserWindowCreationStatusForProfile(*profile) !=
+        BrowserWindowInterface::CreationStatus::kOk) {
+      return false;
+    }
+    target = CreateBrowserWindow(
+        BrowserWindowCreateParams(*profile, /*from_user_gesture=*/true));
+    if (!target) {
+      return false;
+    }
+  }
+
+  // The live page moves -- its history, its state, no reload -- to the top
+  // of Today, as the link preview's "Open as tab"; a little window saved no
+  // history of its own (omit_from_session_restore), InsertMovedPage does.
+  const int index = InsertMovedPage(
+      target, from->DetachWebContentsAtForInsertion(from->active_index()));
+  target->GetWindow()->Show();
+  // The pop-up's strip is empty now: Browser::TabStripEmpty closes it.
+  LOG(INFO) << "[workspaces] little window: moved into window "
+            << target->GetSessionID().id() << " at index " << index;
+  return true;
+}
+
