+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_WORKSPACE_LITTLE_WINDOW_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_WORKSPACE_LITTLE_WINDOW_H_
+
+class BrowserWindowInterface;
+class GURL;
+class Profile;
+
+// The little window (C6, Arc's Little Arc): a link from another app opens in
+// a small window of its own while the browser runs, not as a tab.
+//
+//   ( example.org                          [Open in main window] )
+//   |                                                            |
+//   |                      the linked page                       |
+//   |                                                            |
+//
+// - It is a plain pop-up (TYPE_POPUP): the read-only address row, no tab
+//   strip, never restored by the session, never in Recently Closed or the
+//   Archive. Closing it throws the page away.
+// - "Open in main window" (the button, Shift+Alt+O, the title bar's "Show as
+//   tab") moves the SAME page, no reload, to the top of Today in the main
+//   window. That road serves every pop-up, sign-in pop-ups too.
+// - The setting "Open links from other apps in a small window"
+//   (kHeliumWorkspacesLittleWindow) turns it off.
+//
+// Logs, ids and numbers only, never a title or an address:
+//   "[workspaces] little window: opened window <id> at <x>,<y> <w>x<h>"
+//   "[workspaces] little window: moved into window <id> at index <i>"
+//
+// Forward declarations only: two upstream files call these, one of them
+// (startup_browser_creator.cc) by a declaration of its own.
+namespace workspaces {
+
+// A link handed over by Windows to the running browser: opens `url` in a
+// little window and answers true, or answers false -- not a regular profile,
+// not http(s), the setting off, no window can open -- and the caller opens it
+// as it always did.
+bool MaybeOpenLittleWindow(Profile* profile, const GURL& url);
+
+// "Show as tab" on any pop-up: its page moves into the profile's main window
+// (made first when there is none) at the top of Today, selected, and the
+// emptied pop-up closes. False when there is nothing to move or no window can
+// open; the caller then does what Chromium does.
+bool MoveToMainWindow(BrowserWindowInterface* popup);
+
+}  // namespace workspaces
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_WORKSPACE_LITTLE_WINDOW_H_
