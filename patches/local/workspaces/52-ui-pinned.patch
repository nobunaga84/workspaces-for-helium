+void WorkspacePinnedSectionView::ShowFolderPages(const std::string& id,
+                                                 const ui::Event& event) {
+  const PinNode* const folder = store_ ? store_->Find(id) : nullptr;
+  const views::View* const row = RowFor(id);
+  if (!folder || !row) {
+    return;
+  }
+  // Every page under it, sub-folders' included, by its title only: the
+  // favicons would be one lookup each, for a menu that can hold a thousand.
+  // ponytail: one flat, unbounded menu; submenus per sub-folder if a long one
+  // is hard to use.
+  std::vector<const PinNode*> items;
+  CollectItems(*folder, items);
+  LOG(INFO) << "[workspaces] pins: folder '" << id << "' lists "
+            << items.size() << " page(s)";
+  if (items.empty()) {
+    return;
+  }
+  menu_page_ids_.clear();
+  context_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  for (const PinNode* const item : items) {
+    context_menu_model_->AddItem(
+        kCommandFirstPage + static_cast<int>(menu_page_ids_.size()),
+        RowText(*item));
+    // A menu item's accessible name drops "&" even under NO_FLAGS: give it the
+    // page's whole title, so "Q&A" is found as itself (E17b review).
+    context_menu_model_->SetAccessibleNameAt(menu_page_ids_.size(),
+                                             RowText(*item));
+    menu_page_ids_.push_back(item->id);
+  }
+  context_menu_runner_ = std::make_unique<views::MenuRunner>(
+      context_menu_model_.get(), views::MenuRunner::NO_FLAGS);
+  // Beside the column, level with the folder, so it covers no other icon.
+  // The icon's own controller (AddRow gives every collapsed folder one):
+  // with it the menu knows a click on the icon closes it.
+  const views::Button* const button = views::AsViewClass<views::Button>(row);
+  context_menu_runner_->RunMenuAt(
+      GetWidget(),
+      button ? static_cast<views::MenuButtonController*>(
+                   button->button_controller())
+             : nullptr,
+      gfx::Rect(row->GetBoundsInScreen().top_right(), gfx::Size()),
+      views::MenuAnchorPosition::kTopLeft,
+      ui::GetMenuSourceTypeForEvent(event));
+}
