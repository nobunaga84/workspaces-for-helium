+// The alert a chip shows for `tab` (C14, D8), or nullopt: screen, tab or
+// camera / microphone capture, or sound -- sound only while it is heard, as a
+// muted tab that plays holds kAudioMuting AND kAudioPlaying (B3). The top one
+// by Chromium's own order, CompareAlerts, which ranks capture above sound.
+// IsAlertActive per alert rather than GetAllActiveAlerts, which copies a
+// vector, since every kAll of every tab in the window asks.
+//
+// A discarded tab -- an anchor put away playing -- shows nothing: the
+// controller keeps the old contents' alerts across a discard and nothing
+// clears them (review C14-1), and a sleeping page cannot play or record. For
+// the same stale flag after it wakes, sound also needs the contents' own
+// recently-audible state, the one Chromium's speaker follows.
+std::optional<tabs::TabAlert> BadgeAlertFor(const tabs::TabInterface* tab) {
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  const tabs::TabAlertController* const controller =
+      contents && !contents->WasDiscarded()
+          ? tabs::TabAlertController::From(tab)
+          : nullptr;
+  if (!controller) {
+    return std::nullopt;
+  }
+  const RecentlyAudibleHelper* const audible =
+      RecentlyAudibleHelper::FromWebContents(contents);
+  const bool heard = audible && audible->WasRecentlyAudible();
+  std::optional<tabs::TabAlert> top;
+  for (const tabs::TabAlert alert :
+       {tabs::TabAlert::kDesktopCapturing, tabs::TabAlert::kTabCapturing,
+        tabs::TabAlert::kMediaRecording, tabs::TabAlert::kAudioRecording,
+        tabs::TabAlert::kVideoRecording, tabs::TabAlert::kAudioPlaying}) {
+    if (!controller->IsAlertActive(alert) ||
+        (alert == tabs::TabAlert::kAudioPlaying &&
+         (!heard ||
+          controller->IsAlertActive(tabs::TabAlert::kAudioMuting)))) {
+      continue;
+    }
+    if (!top || tabs::CompareAlerts()(alert, *top)) {
+      top = alert;
+    }
+  }
+  return top;
+}
+
+// One tab a chip's badge could stand for, while WorkspaceRailView::BadgedTab
+// picks among them. On the stack for that one walk only.
+struct BadgeCandidate {
+  raw_ptr<tabs::TabInterface> tab = nullptr;
+  tabs::TabAlert alert = tabs::TabAlert::kNone;
+  bool collapsed = false;
+  base::Time left_at;
+  int index = 0;
+};
+
+// Whether `a` is the better tab to stand behind a badge than `b`: the higher
+// alert (D10), then a tab outside a collapsed group, which the press would
+// have to open first (B9), then the tab left last (D10), then the earlier in
+// the strip.
+bool Outranks(const BadgeCandidate& a, const BadgeCandidate& b) {
+  if (a.alert != b.alert) {
+    return tabs::CompareAlerts()(a.alert, b.alert);
+  }
+  if (a.collapsed != b.collapsed) {
+    return !a.collapsed;
+  }
+  if (a.left_at != b.left_at) {
+    return a.left_at > b.left_at;
+  }
+  return a.index < b.index;
+}
