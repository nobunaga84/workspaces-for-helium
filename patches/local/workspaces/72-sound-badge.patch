+void WorkspaceRailView::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  // C14. Only reads and a posted task here: never a model mutation from an
+  // observer method.
+  bool changed = false;
+  switch (change.type()) {
+    case TabStripModelChange::kInserted:
+      // A tab can arrive already playing: dragged in from another window.
+      for (const TabStripModelChange::ContentsWithIndex& inserted :
+           change.GetInsert()->contents) {
+        changed |= UpdateAlerting(inserted.tab);
+      }
+      break;
+    case TabStripModelChange::kRemoved:
+      for (const TabStripModelChange::RemovedTab& removed :
+           change.GetRemove()->contents) {
+        changed |= alerting_.erase(removed.tab->GetHandle()) > 0;
+      }
+      break;
+    case TabStripModelChange::kReplaced:
+      // A discard or a prerender swap: new contents. A discarded tab reads as
+      // silent (BadgeAlertFor); a swapped-in page as whatever it holds.
+      changed = UpdateAlerting(change.GetReplace()->tab);
+      break;
+    default:
+      break;
+  }
+  if (changed) {
+    ScheduleUpdateBadges();
+  }
+}
+
+void WorkspaceRailView::OnTabChangedAt(tabs::TabInterface* tab,
+                                       TabChangeType change_type) {
+  // Sound, its mute and every capture all arrive as kAll (the C14 review);
+  // kLoadingOnly comes per load and never carries an alert (B10).
+  if (change_type == TabChangeType::kAll && tab && UpdateAlerting(tab)) {
+    ScheduleUpdateBadges();
+  }
+}
+
+bool WorkspaceRailView::UpdateAlerting(tabs::TabInterface* tab) {
+  if (BadgeAlertFor(tab)) {
+    alerting_.insert(tab->GetHandle());
+    return true;
+  }
+  return alerting_.erase(tab->GetHandle()) > 0;
+}
+
+void WorkspaceRailView::ScheduleUpdateBadges() {
+  if (badges_scheduled_) {
+    return;
+  }
+  badges_scheduled_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&WorkspaceRailView::UpdateBadges,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void WorkspaceRailView::UpdateBadges() {
+  badges_scheduled_ = false;
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service || !service->IsEnabled()) {
+    return;
+  }
+  // ponytail: a badged chip scrolled out of the row gives the arrows no cue
+  // (D12); add one if workspaces ever outgrow the bar.
+  for (size_t i = 0; i < buttons_.size(); ++i) {
+    tabs::TabInterface* const tab = BadgedTab(guids_[i]);
+    const std::optional<tabs::TabAlert> alert =
+        tab ? BadgeAlertFor(tab) : std::nullopt;
+    // D11: Chromium's own words for the alert, then the name the tab's row
+    // draws -- the user's, else the page's (TabUIHelper::GetTitle's rule).
+    std::u16string line;
+    if (alert) {
+      const std::string custom_title =
+          workspaces::CustomTitleForTab(tab->GetContents());
+      line = base::StrCat(
+          {tabs::TabAlertController::GetTabAlertStateText(*alert), u" - ",
+           custom_title.empty() ? tab->GetContents()->GetTitle()
+                                : base::UTF8ToUTF16(custom_title)});
+    }
+    if (buttons_[i]->SetBadge(alert, std::move(line))) {
+      LOG(INFO) << "[workspaces] rail badge '" << guids_[i] << "' -> "
+                << (alert ? base::NumberToString(static_cast<int>(*alert))
+                          : std::string("none"));
+    }
+  }
+}
+
+tabs::TabInterface* WorkspaceRailView::BadgedTab(std::string_view guid) const {
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service) {
+    return nullptr;
+  }
+  TabStripModel* const model = browser_->GetTabStripModel();
+  BadgeCandidate best;
+  for (const tabs::TabHandle& handle : alerting_) {
+    tabs::TabInterface* const tab = handle.Get();
+    if (!tab) {
+      continue;
+    }
+    // The workspace the strip draws the tab in (B8): an orphan's tag and the
+    // empty one resolve to Home, as they do for the strip. A tab on screen
+    // -- of the workspace shown, or a favorite, drawn in every workspace --
+    // shows its own alert icon and lights no chip (D7). "On screen" is not
+    // "drawn": a page of the workspace shown that sits in a closed folder or
+    // a collapsed group lights nothing either (D16).
+    const std::string tag =
+        workspaces::WorkspaceGuidForTab(tab->GetContents());
+    if (workspaces::ResolveTabGuid(tag, service->known_guids()) != guid ||
+        service->IsTabOnScreen(tab)) {
+      continue;
+    }
+    const std::optional<tabs::TabAlert> alert = BadgeAlertFor(tab);
+    const int index = model->GetIndexOfTab(tab);
+    if (!alert || index == TabStripModel::kNoTab) {
+      continue;
+    }
+    const std::optional<tab_groups::TabGroupId> group = tab->GetGroup();
+    const workspaces::WorkspaceTabData* const data =
+        workspaces::WorkspaceTabData::FromWebContents(tab->GetContents());
+    const BadgeCandidate candidate{
+        .tab = tab,
+        .alert = *alert,
+        .collapsed = group && model->IsGroupCollapsed(*group),
+        .left_at = data ? data->left_at() : base::Time(),
+        .index = index};
+    if (!best.tab || Outranks(candidate, best)) {
+      best = candidate;
+    }
+  }
+  return best.tab;
+}
