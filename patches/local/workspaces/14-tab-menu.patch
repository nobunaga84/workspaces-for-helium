+#ifndef CHROME_BROWSER_UI_TABS_EXISTING_WORKSPACE_SUB_MENU_MODEL_H_
+#define CHROME_BROWSER_UI_TABS_EXISTING_WORKSPACE_SUB_MENU_MODEL_H_
+
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "ui/menus/simple_menu_model.h"
+
+class BrowserWindowInterface;
+class TabStripModel;
+
+// "Move tab to workspace" on the tab context menu: one item per workspace
+// (design 5, and the owner request recorded there on 2026-09-10).
+//
+// E9c already put a move on the rail's own menu, which cost no upstream files
+// at all. This is the same capability where people actually look for it, and
+// it is not redundant: the rail's version acts on the SELECTION, while this one
+// follows Chromium's tab-menu rule -- the selection if the right-clicked tab is
+// part of it, otherwise that tab alone -- so it can move a tab the user never
+// selected.
+//
+// NOT BUILT ON ExistingBaseSubMenuModel, though that class exists for exactly
+// this shape. Its first item is always "add to a NEW object", routed to the
+// parent delegate through a command id the parent has to own, and
+// TabStripModel::IsContextMenuCommandEnabled DCHECKs the id range and ends in
+// NOTREACHED -- so using the base would mean a SECOND ContextMenuCommand value
+// in tab_strip_model.h, a file seven Helium patches touch, for a "move to new
+// workspace" item the rail's "+" already covers in two clicks. A plain
+// SimpleMenuModel we are our own delegate for needs one id instead of two, and
+// the layout is identical.
+class ExistingWorkspaceSubMenuModel : public ui::SimpleMenuModel,
+                                      public ui::SimpleMenuModel::Delegate {
+ public:
+  ExistingWorkspaceSubMenuModel(BrowserWindowInterface* browser,
+                                TabStripModel* tab_strip,
+                                int context_index);
+  ExistingWorkspaceSubMenuModel(const ExistingWorkspaceSubMenuModel&) = delete;
+  ExistingWorkspaceSubMenuModel& operator=(
+      const ExistingWorkspaceSubMenuModel&) = delete;
+  ~ExistingWorkspaceSubMenuModel() override;
+
+  // Whether the tab menu should offer this at all: Workspaces has to be live in
+  // this window, and there has to be somewhere to move a tab TO. With one
+  // workspace the submenu would hold a single, always-disabled item.
+  static bool ShouldShowSubmenu(BrowserWindowInterface* browser);
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+  bool IsCommandIdEnabled(int command_id) const override;
+
+ private:
+  // The workspace a menu item moves tabs into, or empty if `command_id` is not
+  // one of ours.
+  std::string GuidForCommandId(int command_id) const;
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<TabStripModel> tab_strip_;
+  const int context_index_;
+
+  // Parallel to the menu items, in the order they were added.
+  std::vector<std::string> guids_;
+};
+
+#endif  // CHROME_BROWSER_UI_TABS_EXISTING_WORKSPACE_SUB_MENU_MODEL_H_
