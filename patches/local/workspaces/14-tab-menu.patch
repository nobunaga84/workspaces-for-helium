+#include "chrome/browser/ui/tabs/existing_workspace_sub_menu_model.h"
+
+#include <stddef.h>
+
+#include <string>
+#include <vector>
+
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/workspaces/workspace_prefs.h"
+#include "chrome/browser/ui/tabs/workspaces/workspace_service.h"
+#include "chrome/browser/ui/tabs/workspaces/workspace_session_data.h"
+#include "chrome/browser/ui/tabs/workspaces/workspace_stamping.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/tabs/public/tab_interface.h"
+#include "ui/base/l10n/l10n_util.h"
+
+namespace {
+
+// Our own ids, because this model is its own delegate. They are NOT
+// TabStripModel::ContextMenuCommand values and must not become them: only the
+// submenu's parent item needs one of those.
+constexpr int kFirstCommandId = 1;
+
+// The name to show for a workspace: its title, or a localised "Home" for the
+// default workspace, or the guid for anything else still unnamed.
+//
+// DUPLICATED, deliberately, from workspace_rail_view.cc. Sharing it would mean
+// either a new dependency edge from the lean :workspaces target onto //ui/base
+// and the grit headers, or a target of its own for eight lines. Two call sites
+// is the wrong number to pay either price for -- if a third appears, move it
+// onto WorkspaceService and delete both copies.
+std::u16string DisplayNameForWorkspace(
+    const workspaces::prefs::WorkspaceEntry& entry) {
+  if (!entry.title.empty()) {
+    return base::UTF8ToUTF16(entry.title);
+  }
+  if (entry.guid == workspaces::kDefaultWorkspaceGuid) {
+    return l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_DEFAULT_NAME);
+  }
+  return base::UTF8ToUTF16(entry.guid);
+}
+
+}  // namespace
+
+ExistingWorkspaceSubMenuModel::ExistingWorkspaceSubMenuModel(
+    BrowserWindowInterface* browser,
+    TabStripModel* tab_strip,
+    int context_index)
+    : ui::SimpleMenuModel(this),
+      browser_(browser),
+      tab_strip_(tab_strip),
+      context_index_(context_index) {
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service) {
+    return;
+  }
+
+  for (const workspaces::prefs::WorkspaceEntry& entry :
+       service->GetWorkspaces()) {
+    AddItem(kFirstCommandId + static_cast<int>(guids_.size()),
+            DisplayNameForWorkspace(entry));
+    guids_.push_back(entry.guid);
+  }
+}
+
+ExistingWorkspaceSubMenuModel::~ExistingWorkspaceSubMenuModel() = default;
+
+// static
+bool ExistingWorkspaceSubMenuModel::ShouldShowSubmenu(
+    BrowserWindowInterface* browser) {
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser);
+  return service && service->IsEnabled() && service->GetWorkspaces().size() > 1;
+}
+
+std::string ExistingWorkspaceSubMenuModel::GuidForCommandId(
+    int command_id) const {
+  const size_t index = static_cast<size_t>(command_id - kFirstCommandId);
+  return index < guids_.size() ? guids_[index] : std::string();
+}
+
+bool ExistingWorkspaceSubMenuModel::IsCommandIdEnabled(int command_id) const {
+  const std::string guid = GuidForCommandId(command_id);
+  if (guid.empty() || !tab_strip_->ContainsIndex(context_index_)) {
+    return false;
+  }
+
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service) {
+    return false;
+  }
+
+  tabs::TabInterface* const tab = tab_strip_->GetTabAtIndex(context_index_);
+  if (!tab || !tab->GetContents()) {
+    return false;
+  }
+
+  // A pinned tab has no workspace to move out of -- it is drawn in all of them
+  // -- so every destination is disabled rather than quietly doing nothing.
+  if (tab->IsPinned()) {
+    return false;
+  }
+
+  // Disabled on the workspace the tab is already in. Resolved rather than
+  // compared raw, so a tab carrying a tag for a deleted workspace disables
+  // "Home" -- which is where the orphan rule already draws it, and where moving
+  // it would put it (workspace_stamping.h).
+  return workspaces::ResolveTabGuid(
+             workspaces::WorkspaceGuidForTab(tab->GetContents()),
+             service->known_guids()) != guid;
+}
+
+void ExistingWorkspaceSubMenuModel::ExecuteCommand(int command_id,
+                                                   int event_flags) {
+  const std::string guid = GuidForCommandId(command_id);
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (guid.empty() || !service) {
+    return;
+  }
+
+  // Chromium's tab-menu rule, and the reason this does not just call
+  // MoveSelectedTabsToWorkspace(): act on the selection if the right-clicked
+  // tab is part of it, otherwise on that tab alone -- so right-clicking an
+  // unselected tab moves that one and leaves the selection where it is.
+  //
+  // Spelled out rather than delegated, because TabStripModel's own
+  // GetIndicesForCommand(), which answers exactly this, is PRIVATE, and nothing
+  // is a friend of it. Four lines of public API is a better trade than another
+  // hunk in a header seven Helium patches already touch.
+  std::vector<tabs::TabInterface*> tabs;
+  if (tab_strip_->IsTabSelected(context_index_)) {
+    for (tabs::TabInterface* tab :
+         tab_strip_->selection_model().selected_tabs()) {
+      if (tab) {
+        tabs.push_back(tab);
+      }
+    }
+  } else if (tabs::TabInterface* tab =
+                 tab_strip_->GetTabAtIndex(context_index_)) {
+    tabs.push_back(tab);
+  }
+
+  service->MoveTabsToWorkspace(tabs, guid);
+}
