+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/workspace_restore_hooks.h"
+
+#include "base/logging.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_delegate.h"
+#include "chrome/browser/ui/tabs/workspaces/workspace_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "url/gurl.h"
+
+namespace workspaces {
+
+bool LeaveRestoredGroupInPlace(
+    BrowserWindowInterface* browser,
+    sessions::tab_restore::Type original_session_type) {
+  const WorkspaceService* const workspace_service =
+      WorkspaceService::From(browser);
+  if (original_session_type != sessions::tab_restore::Type::WINDOW ||
+      !workspace_service || !workspace_service->IsEnabled()) {
+    return false;
+  }
+  LOG(INFO) << "[workspaces] restore: saved group already open in "
+               "another window, left there";
+  TabStripModel* const model = browser->GetTabStripModel();
+  if (model->empty()) {
+    model->delegate()->AddTabAt(GURL(), -1, true);
+  }
+  return true;
+}
+
+bool IsSplitAlreadyRestored(const TabStripModel& model,
+                            int leading_index,
+                            int trailing_index) {
+  if (!model.GetTabAtIndex(leading_index)->IsSplit() &&
+      !model.GetTabAtIndex(trailing_index)->IsSplit()) {
+    return false;
+  }
+  LOG(INFO) << "[workspaces] restore: split at " << leading_index << " and "
+            << trailing_index << " already in place, not rebuilt";
+  return true;
+}
+
+}  // namespace workspaces
