+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WORKSPACE_RESTORE_HOOKS_H_
+#define CHROME_BROWSER_UI_WORKSPACE_RESTORE_HOOKS_H_
+
+#include "components/sessions/core/tab_restore_types.h"
+
+class BrowserWindowInterface;
+class TabStripModel;
+
+// Helium Workspaces: what BrowserLiveTabContext's restore hooks do. Each hook
+// there is one call, so a rebase that rewrites the code around it moves a
+// line, never a block that still compiles in the wrong place (review #23).
+// Built in that file's own target, so these reach what it reaches.
+namespace workspaces {
+
+// AddRestoredTab, for a saved group open in another window: true when the
+// group stays where it is instead of moving into `browser` (LOCAL.md 42) --
+// a whole WINDOW's reopen, with Workspaces on. Moving all 22 of them out of
+// the window they were open in is what made one Ctrl+Shift+T freeze for three
+// minutes and CHECK on a split. A window that would stay empty gets a New Tab
+// page, as "Close group" does.
+bool LeaveRestoredGroupInPlace(
+    BrowserWindowInterface* browser,
+    sessions::tab_restore::Type original_session_type);
+
+// ReconstructSplit: true when either tab is already a split half (LOCAL.md
+// 42). It arrived with a saved group moved here from the window it was open
+// in, split and all (the stock move, which runs with Workspaces off), and
+// splitting it again CHECKs in AddToSplitImpl.
+bool IsSplitAlreadyRestored(const TabStripModel& model,
+                            int leading_index,
+                            int trailing_index);
+
+}  // namespace workspaces
+
+#endif  // CHROME_BROWSER_UI_WORKSPACE_RESTORE_HOOKS_H_
