+// RepairSplits' reply, back on the UI thread.
+void PairArcSplits(base::WeakPtr<Profile> profile,
+                   std::optional<ArcImportPlan> plan) {
+  if (!profile || !plan) {
+    LOG(INFO) << "[workspaces] pins: split repair -- "
+              << (plan ? "the profile is gone" : "no readable Arc sidebar");
+    return;
+  }
+  workspaces::pins::PinStore* const store =
+      workspaces::pins::PinStore::GetOrCreate(profile.get(),
+                                              profile->GetPath());
+  int found = 0;
+  int paired = 0;
+  for (const ArcWorkspace& workspace : plan->workspaces) {
+    std::vector<const workspaces::pins::PinNode*> splits;
+    CollectSplits(workspace.pinned, splits);
+    // Left then right, as Arc shows them. PairAsSplit refuses what it cannot
+    // join safely -- pages moved into different lists since, or a split
+    // already -- so a second run changes nothing.
+    for (const workspaces::pins::PinNode* const split : splits) {
+      ++found;
+      if (store->PairAsSplit(split->children[0].id, split->children[1].id,
+                             split->id)) {
+        ++paired;
+      } else {
+        LOG(INFO) << "[workspaces] pins: split repair -- Arc split '"
+                  << split->id << "' not joined (its pages are not two "
+                  << "pinned pages of one list here)";
+      }
+    }
+  }
