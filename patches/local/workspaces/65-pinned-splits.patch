+void CollectSplits(const std::vector<workspaces::pins::PinNode>& rows,
+                   std::vector<const workspaces::pins::PinNode*>& splits) {
+  for (const workspaces::pins::PinNode& row : rows) {
+    if (row.type == workspaces::pins::PinNode::Type::kSplit) {
