+bool PinStore::PairAsSplit(std::string_view first,
+                           std::string_view second,
+                           std::string split_id) {
+  if (!loaded_ || read_only_ || first == second) {
+    return false;
+  }
+  PinTree tree = tree_;
+  for (auto& [guid, roots] : tree) {
+    size_t left = 0;
+    std::vector<PinNode>* const list = ListOf(roots, first, left);
+    if (!list) {
+      continue;
+    }
+    const auto right = std::ranges::find(*list, second, &PinNode::id);
+    // Two pages already in a split are found in the split's list: the split
+    // made of them would sit inside the old one, which Commit refuses.
+    if (right == list->end() || (*list)[left].type != PinNode::Type::kItem ||
+        right->type != PinNode::Type::kItem) {
+      return false;
+    }
+    PinNode split;
+    split.type = PinNode::Type::kSplit;
+    split.id = std::move(split_id);
+    split.children = {(*list)[left], *right};
+    // The right page above the left one moves it up by one as it goes.
+    if (right < list->begin() + left) {
+      --left;
+    }
+    list->erase(right);
+    (*list)[left] = std::move(split);
+    return Commit(std::move(tree));
+  }
+  return false;
