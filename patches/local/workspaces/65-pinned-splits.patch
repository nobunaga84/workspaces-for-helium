+// static
+void WorkspacePinnedSectionView::OpenSplit(BrowserWindowInterface* browser,
+                                           const PinNode& split,
+                                           std::string_view guid) {
+  TabStripModel* const model = browser->GetTabStripModel();
+  for (const PinNode& page : split.children) {
+    if (!LinkedTab(model, page.id)) {
+      OpenItem(browser, page, guid);
+    }
+  }
+  tabs::TabInterface* const left = LinkedTab(model, split.children[0].id);
+  tabs::TabInterface* const right = LinkedTab(model, split.children[1].id);
+  // A page with no address a tab can open stays closed (OpenItem logs it).
+  if (!left || !right) {
+    return;
+  }
+  // A favorite -- a page pinned while Workspaces was off keeps its link -- is
+  // not moved among the pinned tabs (review).
+  if (left->IsPinned() || right->IsPinned()) {
+    LOG(INFO) << "[workspaces] pins: a split's page is a favorite; not joined";
+    return;
+  }
+  // A page in a split view with some other tab is left as it is: that split
+  // is the user's.
+  if (left->IsSplit() || right->IsSplit()) {
+    if (left->GetSplit() != right->GetSplit()) {
+      LOG(INFO) << "[workspaces] pins: a split's page is in another split "
+                   "view; left as it is";
+    }
+    return;
+  }
+  // Side by side first. Neither page is in a group -- an item's page never
+  // is -- so the move beside `left` joins none.
+  const int l = model->GetIndexOfTab(left);
+  const int r = model->GetIndexOfTab(right);
+  if (r != l + 1) {
+    model->MoveWebContentsAt(r, r > l ? l + 1 : l,
+                             /*select_after_move=*/false);
+  }
+  const int first = model->GetIndexOfTab(left);
+  if (first + 1 >= model->count() || model->GetTabAtIndex(first + 1) != right) {
+    LOG(WARNING) << "[workspaces] pins: a split's pages could not be put side "
+                    "by side; not joined";
+    return;
+  }
+  // RestoreSplit, not AddToNewSplit: no promo and no metrics, as the importer
+  // makes Arc's splits (36).
+  model->RestoreSplit(split_tabs::SplitTabId::GenerateNew(), {first, first + 1},
+                      split_tabs::SplitTabVisualData());
+  LOG(INFO) << "[workspaces] pins: a split's pages joined as one split view";
+}
+
+// static
+bool WorkspacePinnedSectionView::ShowSplit(BrowserWindowInterface* browser,
+                                           const PinNode& split,
+                                           std::string_view page_id,
+                                           std::string_view key) {
+  // Checked before any workspace is entered: a refusal changes nothing (C1).
+  for (const PinNode& page : split.children) {
+    if (!GURL(page.url).is_valid()) {
+      LOG(WARNING) << "[workspaces] pins: item '" << page.id
+                   << "' has no address a tab can open";
+      return false;
+    }
+  }
+  // One place, as for an item: the window that has a page of it open, this
+  // one first. ponytail: a page open in a third window stays there and a
+  // second one opens -- a split's pages open and close together, so it is not
+  // seen; bringing a page across is UnpinItem's detach, if it ever is.
+  BrowserWindowInterface* const window = WindowOfSplit(browser, split);
+  // A page to open is opened in the split's own workspace, entered first --
+  // Home for a deleted one, as the section draws its rows (design 2.4).
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(window);
+  const std::string guid(
+      service ? workspaces::ResolveTabGuid(key, service->known_guids())
+              : std::string_view());
+  TabStripModel* const model = window->GetTabStripModel();
+  const bool opens = std::ranges::any_of(
+      split.children,
+      [model](const PinNode& page) { return !LinkedTab(model, page.id); });
+  if (service && opens) {
+    service->EnterWorkspaceForInsert(guid);
+  }
+  OpenSplit(window, split, guid);
+  tabs::TabInterface* const tab = LinkedTab(model, page_id);
+  return tab && ShowTab(browser, *tab);
+}
