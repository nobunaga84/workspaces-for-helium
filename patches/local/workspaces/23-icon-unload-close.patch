+int WorkspaceService::UnloadWorkspaceTabs(std::string_view guid, bool others) {
+  // Indices are stable across a discard -- the contents is replaced in place,
+  // nothing is inserted or removed -- so a forward index walk is safe here in
+  // a way it is not for CloseWorkspaceTabs above.
+  //
+  // The foreground tab is skipped by us and not left to the gate, because
+  // CommandDiscard invoked ON the foreground tab means "hibernate every other
+  // tab" (GetIndicesDiscardedByCommand), which is not the question asked. A
+  // selected background tab drags the whole selection through the command,
+  // foreground tab included; the gate declines that one for being visible.
+  // Pinned tabs carry no tag and belong to every workspace, so they are never
+  // "of" one and never "other" than one.
+  std::vector<int> candidates;
+  for (int i = 0; i < tab_strip_->count(); ++i) {
+    tabs::TabInterface* const tab = tab_strip_->GetTabAtIndex(i);
+    if (!tab || tab->IsPinned() || tab_strip_->IsTabInForeground(i)) {
+      continue;
+    }
+    if (IsTabOfWorkspace(tab, guid) == others) {
+      continue;
+    }
+    candidates.push_back(i);
+  }
+  // Logged BEFORE the discards, because a discard lands synchronously and
+  // the observer logs each one as "tab contents replaced": a line written
+  // afterwards reads as if the replacements caused the unload (LOCAL.md 31).
+  LOG(INFO) << "[workspaces] unload " << (others ? "all but" : "workspace")
+            << " '" << guid << "': asking " << candidates.size() << " tab(s)";
+  for (int i : candidates) {
+    tab_strip_->ExecuteContextMenuCommand(i, TabStripModel::CommandDiscard);
+  }
+  return static_cast<int>(candidates.size());
 }
 
