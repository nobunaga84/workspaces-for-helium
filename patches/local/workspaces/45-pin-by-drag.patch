+TabDragTarget* WorkspacePinnedSectionView::GetTabDragTarget(
+    const gfx::Point& point_in_screen) {
+  if (!InZone(point_in_screen)) {
+    return nullptr;
+  }
+  // The drag is this window's context's once attached here (Attach hands it
+  // over); before that, from another window, it is claimed to attach it.
+  const TabDragController* const drag = DragContext()->GetDragController();
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  return !drag || (service &&
+                   !PinnableTabs(*service, drag->GetSessionData()).empty())
+             ? this
+             : nullptr;
+}
+
+bool WorkspacePinnedSectionView::InZone(
+    const gfx::Point& point_in_screen) const {
+  const gfx::Point point =
+      views::View::ConvertPointFromScreen(this, point_in_screen);
+  return list_ && IsDrawn() && GetVisibleBounds().Contains(point) &&
+         point.y() < new_tab_button_->y();
+}
+
+TabDragContext* WorkspacePinnedSectionView::DragContext() {
+  return BrowserView::GetBrowserViewForBrowser(browser_)
+      ->tab_strip_view()
+      ->GetDragContext();
+}
+
+TabDragContext* WorkspacePinnedSectionView::OnTabDragUpdated(
+    TabDragTarget::DragController& controller,
+    const gfx::Point& point_in_screen) {
+  // Never null, which would tear the tabs off into a window of their own:
+  // this window's context, as the list's target answers. Tabs dragged from
+  // another window are attached here first, and pinned only when this window
+  // shows their workspace (CanPin).
+  TabDragContext* const context = DragContext();
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (controller.GetAttachedContext() != context || !service ||
+      PinnableTabs(*service, controller.GetSessionData()).empty()) {
+    EndDrag();
+    return context;
+  }
+  if (!dragging_tabs_) {
+    dragging_tabs_ = true;
+    BeginDrag();
+  }
+  drag_point_ = point_in_screen;
+  UpdateDrag();
+  return context;
+}
+
+void WorkspacePinnedSectionView::OnTabDragExited(
+    const gfx::Point& point_in_screen) {
+  EndDrag();
+}
+
+void WorkspacePinnedSectionView::OnTabDragEnded() {
+  EndDrag();
+}
+
+bool WorkspacePinnedSectionView::CanDropTab() {
+  return dragging_tabs_ && !TabTargetAt(drag_point_).indicator.IsEmpty();
+}
+
+void WorkspacePinnedSectionView::HandleTabDrop(
+    TabDragTarget::DragController& controller) {
+  const DropTarget target = TabTargetAt(drag_point_);
+  EndDrag();
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service) {
+    return;
+  }
+  std::vector<tabs::TabInterface*> tabs =
+      PinnableTabs(*service, controller.GetSessionData());
+  LOG(INFO) << "[workspaces] pins: " << tabs.size()
+            << " tab(s) dropped on the rows";
+  // Now, not posted: linked before the drag's end lays the list out again,
+  // the pages are never drawn back in it.
+  PinTabs(browser_, std::move(tabs), target.to, target.where);
+  // Into a folder: opened, so the page on screen has its row, highlighted
+  // (E15d review #2).
+  if (target.where == Where::kInto && store_) {
+    store_->SetFolderOpen(target.to, true);
+  }
+}
+
+base::CallbackListSubscription
+WorkspacePinnedSectionView::RegisterWillDestroyCallback(
+    base::OnceClosure callback) {
+  return will_destroy_callbacks_.Add(std::move(callback));
+}
