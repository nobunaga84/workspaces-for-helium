+
+int WorkspaceRailView::OnDragUpdated(const ui::DropTargetEvent& event) {
+  if (!DraggedChip(event.data())) {
+    SetReorderGap(-1);
+    return ui::DragDropTypes::DRAG_NONE;
+  }
+  // The gap: the chips whose middle is before the pointer, along the bar,
+  // with the pointer held to the chips in view -- over an arrow, the gap at
+  // that end of what is shown.
+  const gfx::Rect visible = scroll_view_->GetVisibleRect();
+  const gfx::Point point = views::View::ConvertPointToTarget(
+      this, scroll_contents_, event.location());
+  const bool row = GetOrientation() == views::LayoutOrientation::kHorizontal;
+  const int along =
+      row ? std::max(visible.x(), std::min(point.x(), visible.right() - 1))
+          : std::max(visible.y(), std::min(point.y(), visible.bottom() - 1));
+  int gap = 0;
+  for (const WorkspaceChip* chip : buttons_) {
+    // A chip a Rebuild just made has no place until the next layout.
+    if (chip->bounds().IsEmpty()) {
+      continue;
+    }
+    const gfx::Point middle = chip->bounds().CenterPoint();
+    if ((row ? middle.x() : middle.y()) < along) {
+      ++gap;
+    }
+  }
+  SetReorderGap(gap);
+  // A move even beside the chip's own place: the drop logs that it stayed.
+  return ui::DragDropTypes::DRAG_MOVE;
+}
+
+void WorkspaceRailView::OnDragExited() {
+  // Off the bar, Escape, or a drop elsewhere.
+  SetReorderGap(-1);
+}
+
+views::View::DropCallback WorkspaceRailView::GetDropCallback(
+    const ui::DropTargetEvent& event) {
+  // Views sends no OnDragExited after a drop it takes: the line goes here.
+  const int gap = reorder_gap_;
+  SetReorderGap(-1);
+  const std::optional<size_t> from = DraggedChip(event.data());
+  // A gap from before a list change in another window may be past the end.
+  if (!from || gap < 0 || gap > static_cast<int>(guids_.size())) {
+    return base::NullCallback();
+  }
+  const std::string guid = guids_[*from];
+  // The list without the chip: every gap after its own place is one less.
+  const int index = static_cast<int>(*from);
+  const int offset = (gap > index ? gap - 1 : gap) - index;
+  if (offset == 0) {
+    LOG(INFO) << "[workspaces] rail reorder: '" << guid
+              << "' dropped where it was";
+    return base::NullCallback();
+  }
+  LOG(INFO) << "[workspaces] rail reorder: '" << guid << "' gap " << gap
+            << " -> offset " << offset;
+  // Posted: MoveWorkspace rebuilds every bar at once, this one's chips too,
+  // while the drag's loop is still on the dragged chip's stack (View::DoDrag).
+  return base::BindOnce(
+      [](base::WeakPtr<WorkspaceRailView> self, const std::string& guid,
+         int offset, const ui::DropTargetEvent&,
+         ui::mojom::DragOperation& output_drag_op,
+         std::unique_ptr<ui::LayerTreeOwner>) {
+        output_drag_op = ui::mojom::DragOperation::kMove;
+        base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE,
+            base::BindOnce(
+                [](base::WeakPtr<WorkspaceRailView> self,
+                   const std::string& guid, int offset) {
+                  if (workspaces::WorkspaceService* const service =
+                          self ? workspaces::WorkspaceService::From(
+                                     self->browser_)
+                               : nullptr) {
+                    service->MoveWorkspace(guid, offset);
+                  }
+                },
+                self, guid, offset));
+      },
+      weak_factory_.GetWeakPtr(), guid, offset);
+}
+
+std::optional<size_t> WorkspaceRailView::DraggedChip(
+    const ui::OSExchangeData& data) const {
+  const std::optional<base::Pickle> pickle =
+      data.GetPickledData(ChipDragFormat());
+  if (!pickle) {
+    return std::nullopt;
+  }
+  base::PickleIterator iterator(*pickle);
+  std::string guid;
+  std::string profile_path;
+  if (!iterator.ReadString(&guid) || !iterator.ReadString(&profile_path) ||
+      profile_path != browser_->GetProfile()->GetPath().AsUTF8Unsafe()) {
+    return std::nullopt;
+  }
+  const auto it = std::ranges::find(guids_, guid);
+  if (it == guids_.end()) {
+    return std::nullopt;
+  }
+  return static_cast<size_t>(it - guids_.begin());
+}
+
+void WorkspaceRailView::SetReorderGap(int gap) {
+  reorder_gap_ = gap;
+  if (gap < 0) {
+    if (views::View* const line = reorder_line_.view()) {
+      line->SetVisible(false);
+    }
+    return;
+  }
+  if (!reorder_line_.view()) {
+    auto line = std::make_unique<views::View>();
+    // Placed by hand between the chips, never laid out, never hit; a layer
+    // of its own, over the chips' layers. The pinned section's drop colour.
+    line->SetProperty(views::kViewIgnoredByLayoutKey, true);
+    line->SetCanProcessEventsWithinSubtree(false);
+    line->SetPaintToLayer();
+    line->layer()->SetFillsBoundsOpaquely(false);
+    line->SetBackground(
+        views::CreateSolidBackground(ui::kColorFocusableBorderFocused));
+    reorder_line_.SetView(scroll_contents_->AddChildView(std::move(line)));
+  }
+  views::View* const line = reorder_line_.view();
+  // In the middle of the 4 px between two chips; at either end, flush with
+  // the row's edge.
+  const bool row = GetOrientation() == views::LayoutOrientation::kHorizontal;
+  const size_t count = buttons_.size();
+  const size_t at_gap = static_cast<size_t>(gap);
+  const int middle =
+      at_gap < count
+          ? (row ? buttons_[at_gap]->x() : buttons_[at_gap]->y()) - kChipMargin
+          : (row ? buttons_.back()->bounds().right()
+                 : buttons_.back()->bounds().bottom()) +
+                kChipMargin;
+  const int length =
+      row ? scroll_contents_->width() : scroll_contents_->height();
+  const int start = std::max(0, std::min(middle - kDropLineThickness / 2,
+                                         length - kDropLineThickness));
+  line->SetBoundsRect(
+      row ? gfx::Rect(start, 0, kDropLineThickness, scroll_contents_->height())
+          : gfx::Rect(0, start, scroll_contents_->width(),
+                      kDropLineThickness));
+  line->SetVisible(true);
+}
