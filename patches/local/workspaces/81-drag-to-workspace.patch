+}
+
+bool WorkspaceRailView::CanStartDragForView(views::View* sender,
+                                            const gfx::Point& press_pt,
+                                            const gfx::Point& p) {
+  // Along the bar only, and a real move: a touch long-press, which does not
+  // move, opens the chip's menu.
+  const int along_x = std::abs(p.x() - press_pt.x());
+  const int along_y = std::abs(p.y() - press_pt.y());
+  return GetOrientation() == views::LayoutOrientation::kHorizontal
+             ? along_x > along_y
+             : along_y > along_x;
+}
