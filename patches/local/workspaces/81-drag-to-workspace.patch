+// static
+WorkspaceRailView* WorkspaceRailView::FindIn(views::View* view) {
+  return views::ElementTrackerViews::GetInstance()
+      ->GetFirstMatchingViewAs<WorkspaceRailView>(
+          kWorkspaceRailElementId,
+          views::ElementTrackerViews::GetContextForView(view));
+}
+
+// ponytail: no chip slides into view during any of the three drags (D17): a
+// chip scrolled out of the row is no target until the user slides it in. Add
+// a TabDragScrollHandler over the scroller if workspaces outgrow the bar.
+TabDragTarget* WorkspaceRailView::GetTabDragTarget(
+    const gfx::Point& point_in_screen,
+    int list_bottom) {
+  // Only a drag this window holds -- Attach hands its context the drag's
+  // controller, as the pinned section tells. One from another window, if
+  // attached here, would switch this window to its workspace mid-drag (D3).
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service || !service->IsEnabled() || !IsDrawn() ||
+      !DragContext()->GetDragController()) {
+    return nullptr;
+  }
+  // Up to the list's edge: in zen mode the list's bounds end 8 DIP above the
+  // bar, and a drag crossing a point nobody claims tears the tab off.
+  gfx::Rect zone = GetBoundsInScreen();
+  zone.SetVerticalBounds(std::min(zone.y(), list_bottom), zone.bottom());
+  return zone.Contains(point_in_screen) ? this : nullptr;
+}
+
+std::string WorkspaceRailView::DropTargetAt(
+    const gfx::Point& point_in_screen) const {
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service || !IsDrawn()) {
+    return std::string();
+  }
+  // In the chips' row, the layer's scroll offset included; never a chip
+  // scrolled out of view or under an arrow.
+  const gfx::Point point =
+      views::View::ConvertPointFromScreen(scroll_contents_, point_in_screen);
+  if (!scroll_view_->GetVisibleRect().Contains(point)) {
+    return std::string();
+  }
+  for (size_t i = 0; i < buttons_.size(); ++i) {
+    // With its margin, so the chips' slots meet; a chip made by a Rebuild
+    // has no bounds until the next layout.
+    gfx::Rect slot = buttons_[i]->bounds();
+    if (slot.IsEmpty()) {
+      continue;
+    }
+    slot.Outset(kChipMargin);
+    if (slot.Contains(point)) {
+      // The workspace on screen already holds what is dragged.
+      return guids_[i] == service->active_guid() ? std::string() : guids_[i];
+    }
+  }
+  return std::string();
+}
+
+void WorkspaceRailView::SetDropHover(const std::string& guid) {
+  if (guid == drop_hover_guid_) {
+    return;
+  }
+  drop_hover_guid_ = guid;
+  for (size_t i = 0; i < buttons_.size(); ++i) {
+    buttons_[i]->SetDropTarget(guids_[i] == guid);
+  }
+  // On each change only, so "a drag held over a chip lights it" can be read
+  // from the log.
+  LOG(INFO) << "[workspaces] rail drop: over "
+            << (guid.empty() ? std::string("none")
+                             : base::StrCat({"'", guid, "'"}));
+}
+
+TabDragContext* WorkspaceRailView::DragContext() {
+  return BrowserView::GetBrowserViewForBrowser(browser_)
+      ->tab_strip_view()
+      ->GetDragContext();
+}
+
+TabDragContext* WorkspaceRailView::OnTabDragUpdated(
+    TabDragTarget::DragController& controller,
+    const gfx::Point& point_in_screen) {
+  // A chip lights only for a drag that would move something (D5): favorites
+  // are every workspace's, and a group header's datum carries no tab.
+  const bool movable = std::ranges::any_of(
+      controller.GetSessionData().tab_drag_data_,
+      [](const TabDragData& data) { return data.contents && !data.pinned; });
+  SetDropHover(movable ? DropTargetAt(point_in_screen) : std::string());
+  // Never null, which would tear the tabs off: over the rest of the bar the
+  // drop is the list's, where the drag left the tabs (D4).
+  return DragContext();
+}
