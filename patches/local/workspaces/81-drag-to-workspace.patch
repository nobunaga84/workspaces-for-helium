+
+void WorkspaceRailView::HandleTabDrop(
+    TabDragTarget::DragController& controller) {
+  // Handles, copied now: the drag's data is cleared when it ends.
+  std::vector<tabs::TabHandle> dragged;
+  for (const TabDragData& data : controller.GetSessionData().tab_drag_data_) {
+    if (tabs::TabInterface* const tab =
+            data.contents
+                ? tabs::TabInterface::MaybeGetFromContents(data.contents)
+                : nullptr) {
+      dragged.push_back(tab->GetHandle());
+    }
+  }
+  const std::string guid = drop_hover_guid_;
+  LOG(INFO) << "[workspaces] rail drop: " << dragged.size() << " tab(s) -> '"
+            << guid << "'";
+  SetDropHover({});
+  // Posted (D6), never run here. A drop can arrive from inside a dragged
+  // tab's removal, where any model call CHECK-crashes; and a group dragged by
+  // its header has its tab selected again once this returns, which after the
+  // move would switch the window to it. The tabs are drawn in their list
+  // slots meanwhile.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<WorkspaceRailView> self,
+             const std::vector<tabs::TabHandle>& dragged,
+             const std::string& guid) {
+            workspaces::WorkspaceService* const service =
+                self ? workspaces::WorkspaceService::From(self->browser_)
+                     : nullptr;
+            if (!service) {
+              return;
+            }
+            // Those still in this window: one may have closed, or gone to
+            // another window, since the drop.
+            TabStripModel* const model = self->browser_->GetTabStripModel();
+            std::vector<tabs::TabInterface*> tabs;
+            for (const tabs::TabHandle& handle : dragged) {
+              tabs::TabInterface* const tab = handle.Get();
+              if (tab && model->GetIndexOfTab(tab) != TabStripModel::kNoTab) {
+                tabs.push_back(tab);
+              }
+            }
+            // The menu's own move: to the top of that workspace's Today.
+            service->MoveTabsToWorkspace(tabs, guid);
+          },
+          weak_factory_.GetWeakPtr(), std::move(dragged), guid));
+}
+
+base::CallbackListSubscription WorkspaceRailView::RegisterWillDestroyCallback(
+    base::OnceClosure callback) {
+  return will_destroy_callbacks_.Add(std::move(callback));
+}
+
+void WorkspaceRailView::WriteDragDataForView(views::View* sender,
+                                             const gfx::Point& press_pt,
+                                             ui::OSExchangeData* data) {
+  // The guid, never the chip: a list change in any window deletes the chips
+  // in the middle of the drag (Rebuild).
+  for (size_t i = 0; i < buttons_.size(); ++i) {
+    if (buttons_[i] == sender) {
+      base::Pickle pickle;
+      pickle.WriteString(guids_[i]);
+      pickle.WriteString(browser_->GetProfile()->GetPath().AsUTF8Unsafe());
+      data->SetPickledData(ChipDragFormat(), pickle);
+      return;
+    }
+  }
+}
