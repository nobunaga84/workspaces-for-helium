+void WorkspaceRailView::SlideBy(int direction) {
+  // Whole buttons, via ScrollViewToVisible, which stops at the ends;
+  // ScrollView::ScrollByOffset does not clamp. Both rects are in
+  // scroll_contents_'s coordinates.
+  const gfx::Rect visible = scroll_view_->GetVisibleRect();
+  if (direction > 0) {
