+void DropHiddenTabs(const TabStripModelDelegate* delegate,
+                    tabs::TabStripModelSelectionState& selection) {
+  // Collected first: RemoveTabFromSelection() edits the set being walked.
+  std::vector<tabs::TabInterface*> hidden;
+  for (tabs::TabInterface* const tab : selection.selected_tabs()) {
+    if (tab != selection.active_tab() && tab != selection.anchor_tab() &&
+        !delegate->IsTabVisibleInActiveWorkspace(tab)) {
+      hidden.push_back(tab);
+    }
+  }
+  for (tabs::TabInterface* const tab : hidden) {
+    selection.RemoveTabFromSelection(tab);
+  }
+}
