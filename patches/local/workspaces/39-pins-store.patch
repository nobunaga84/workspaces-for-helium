+namespace workspaces::pins {
+namespace {
+
+constexpr char kVersionKey[] = "version";
+constexpr char kWorkspacesKey[] = "workspaces";
+constexpr char kTypeKey[] = "type";
+constexpr char kIdKey[] = "id";
+constexpr char kTitleKey[] = "title";
+constexpr char kOpenKey[] = "open";
+constexpr char kChildrenKey[] = "children";
+constexpr char kUrlKey[] = "url";
+constexpr char kCustomTitleKey[] = "custom_title";
+constexpr char kLastActiveKey[] = "last_active";
+constexpr char kFolderType[] = "folder";
+constexpr char kItemType[] = "item";
+
+// Its address is the store's key among its profile's user data.
+constexpr char kUserDataKey[] = "helium_workspace_pins";
+
+base::DictValue NodeToValue(const PinNode& node) {
+  base::DictValue dict;
+  dict.Set(kIdKey, node.id);
+  dict.Set(kTitleKey, node.title);
+  if (node.type == PinNode::Type::kFolder) {
+    dict.Set(kTypeKey, kFolderType);
+    dict.Set(kOpenKey, node.open);
+    base::ListValue children;
+    for (const PinNode& child : node.children) {
+      children.Append(NodeToValue(child));
+    }
+    dict.Set(kChildrenKey, std::move(children));
+    return dict;
+  }
+  dict.Set(kTypeKey, kItemType);
+  dict.Set(kUrlKey, node.url);
+  if (!node.custom_title.empty()) {
+    dict.Set(kCustomTitleKey, node.custom_title);
+  }
+  if (!node.last_active.is_null()) {
+    dict.Set(kLastActiveKey, base::TimeToValue(node.last_active));
+  }
+  return dict;
+}
+
+std::optional<std::vector<PinNode>> NodesFromValue(const base::ListValue& list);
+
+// Strict about shape, lenient about optional fields: this file is only ever
+// written by NodeToValue, so a node without its type, id or url means the file
+// is not ours to trust, and the whole file is refused rather than written back
+// without the node.
+std::optional<PinNode> NodeFromValue(const base::Value& value) {
+  const base::DictValue* dict = value.GetIfDict();
+  if (!dict) {
+    return std::nullopt;
+  }
+  const std::string* type = dict->FindString(kTypeKey);
+  const std::string* id = dict->FindString(kIdKey);
+  if (!type || !id || id->empty()) {
+    return std::nullopt;
+  }
+  PinNode node;
+  node.id = *id;
+  if (const std::string* title = dict->FindString(kTitleKey)) {
+    node.title = *title;
+  }
+
+  if (*type == kFolderType) {
+    node.type = PinNode::Type::kFolder;
+    node.open = dict->FindBool(kOpenKey).value_or(false);
+    const base::ListValue* children = dict->FindList(kChildrenKey);
+    if (!children) {
+      return std::nullopt;
+    }
+    // Recursion is bounded by JSONReader's own depth limit on the way in.
+    std::optional<std::vector<PinNode>> parsed = NodesFromValue(*children);
+    if (!parsed) {
+      return std::nullopt;
+    }
+    node.children = std::move(*parsed);
+    return node;
+  }
+
+  if (*type != kItemType) {
+    return std::nullopt;
+  }
+  const std::string* url = dict->FindString(kUrlKey);
+  if (!url || url->empty()) {
+    return std::nullopt;
+  }
+  node.url = *url;
+  if (const std::string* custom_title = dict->FindString(kCustomTitleKey)) {
+    node.custom_title = *custom_title;
+  }
+  if (const base::Value* last_active = dict->Find(kLastActiveKey)) {
+    std::optional<base::Time> time = base::ValueToTime(*last_active);
+    if (!time) {
+      return std::nullopt;
+    }
+    node.last_active = *time;
+  }
+  return node;
+}
+
+std::optional<std::vector<PinNode>> NodesFromValue(const base::ListValue& list) {
+  std::vector<PinNode> nodes;
+  nodes.reserve(list.size());
+  for (const base::Value& value : list) {
+    std::optional<PinNode> node = NodeFromValue(value);
+    if (!node) {
+      return std::nullopt;
+    }
+    nodes.push_back(std::move(*node));
+  }
+  return nodes;
+}
+
+// JSONReader and JSONWriter stop at 200 levels, and a folder costs two (its
+// dict and its children list): deeper than this could be kept but never saved.
+constexpr int kMaxFolderDepth = 64;
+
+// What NodeFromValue accepts, not too deep to write, and every id new to
+// `ids`: an open tab finds its item by id (E15c), so no two rows of the whole
+// tree may share one. SetRoots and the load both refuse anything else, so
+// nothing the store saves can make the next load refuse the whole file (code
+// review, LOCAL.md 44).
+bool AddSavable(const std::vector<PinNode>& nodes,
+                std::set<std::string, std::less<>>& ids,
+                int depth = 0) {
+  if (depth > kMaxFolderDepth) {
+    return false;
+  }
+  for (const PinNode& node : nodes) {
+    if (node.id.empty() || !ids.insert(node.id).second) {
+      return false;
+    }
+    const bool ok = node.type == PinNode::Type::kFolder
+                        ? AddSavable(node.children, ids, depth + 1)
+                        : !node.url.empty();
+    if (!ok) {
+      return false;
+    }
+  }
+  return true;
+}
+
+size_t CountNodes(const std::vector<PinNode>& nodes) {
+  size_t count = nodes.size();
+  for (const PinNode& node : nodes) {
+    count += CountNodes(node.children);
+  }
+  return count;
+}
+
+}  // namespace
+
+base::DictValue PinTreeToValue(const PinTree& tree) {
+  base::DictValue workspaces;
+  for (const auto& [guid, roots] : tree) {
+    base::ListValue list;
+    for (const PinNode& node : roots) {
+      list.Append(NodeToValue(node));
+    }
+    workspaces.Set(guid, std::move(list));
+  }
+  base::DictValue file;
+  file.Set(kVersionKey, kPinFileVersion);
+  file.Set(kWorkspacesKey, std::move(workspaces));
+  return file;
+}
+
+std::optional<PinTree> PinTreeFromValue(const base::DictValue& value) {
+  if (value.FindInt(kVersionKey) != kPinFileVersion) {
+    return std::nullopt;
+  }
+  const base::DictValue* workspaces = value.FindDict(kWorkspacesKey);
+  if (!workspaces) {
+    return std::nullopt;
+  }
+  PinTree tree;
+  for (const auto [guid, roots] : *workspaces) {
+    const base::ListValue* list = roots.GetIfList();
+    if (guid.empty() || !list) {
+      return std::nullopt;
+    }
+    std::optional<std::vector<PinNode>> nodes = NodesFromValue(*list);
+    if (!nodes) {
+      return std::nullopt;
+    }
+    // An empty workspace is not stored, so it does not round-trip either.
+    if (!nodes->empty()) {
+      tree.emplace(guid, std::move(*nodes));
+    }
+  }
+  std::set<std::string, std::less<>> ids;
+  for (const auto& [guid, roots] : tree) {
+    if (!AddSavable(roots, ids)) {
+      return std::nullopt;
+    }
+  }
+  return tree;
+}
+
+std::vector<const PinNode*> RootsForWorkspace(
+    const PinTree& tree,
+    std::string_view guid,
+    const std::vector<std::string>& known_guids) {
+  std::vector<const PinNode*> rows;
+  auto add = [&rows](const std::vector<PinNode>& roots) {
+    for (const PinNode& node : roots) {
+      rows.push_back(&node);
+    }
+  };
+  if (auto own = tree.find(guid); own != tree.end()) {
+    add(own->second);
+  }
+  for (const auto& [owner, roots] : tree) {
+    if (owner != guid && ResolveTabGuid(owner, known_guids) == guid) {
+      add(roots);
+    }
+  }
+  return rows;
+}
+
+struct PinStore::LoadResult {
+  enum class Status {
+    kMissing,
+    kLoaded,
+    // Not a pins file this version wrote: renamed to "<file>.bad".
+    kMovedAside,
+    // Unreadable, from a newer version, or could not be moved aside.
+    kReadOnly,
+  };
+  Status status = Status::kMissing;
+  PinTree tree;
+};
+
+// static
+PinStore* PinStore::GetOrCreate(base::SupportsUserData* host,
+                                const base::FilePath& profile_dir) {
+  if (auto* store = static_cast<PinStore*>(host->GetUserData(kUserDataKey))) {
+    return store;
+  }
+  auto owned = std::make_unique<PinStore>(
+      profile_dir.Append(kFileName),
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN}));
+  PinStore* store = owned.get();
+  host->SetUserData(kUserDataKey, std::move(owned));
+  return store;
+}
+
+PinStore::PinStore(const base::FilePath& file,
+                   scoped_refptr<base::SequencedTaskRunner> file_task_runner)
+    : writer_(file, file_task_runner, kSaveDelay) {
+  // The same sequence as the writer's, so the read always runs before any
+  // write -- and no write is scheduled before the read's reply anyway.
+  file_task_runner->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&PinStore::ReadFile, file),
+      base::BindOnce(&PinStore::OnLoaded, weak_factory_.GetWeakPtr()));
+}
+
+PinStore::~PinStore() {
+  // ImportantFileWriter DCHECKs a pending write in its destructor. This is
+  // what saves the last 2.5 s of changes at shutdown: the profile is destroyed
+  // before the thread pool stops, and the write's sequence is BLOCK_SHUTDOWN.
+  if (writer_.HasPendingWrite()) {
+    writer_.DoScheduledWrite();
+  }
+}
+
+bool PinStore::SetRoots(std::string_view guid, std::vector<PinNode> roots) {
+  if (!loaded_ || read_only_ || guid.empty()) {
+    return false;
+  }
+  // The tree as it would be: `roots` plus every other workspace's rows.
+  std::set<std::string, std::less<>> ids;
+  bool savable = AddSavable(roots, ids);
+  for (const auto& [owner, rows] : tree_) {
+    savable = savable && (owner == guid || AddSavable(rows, ids));
+  }
+  if (!savable) {
+    return false;
+  }
+  if (roots.empty()) {
+    if (auto it = tree_.find(guid); it != tree_.end()) {
+      tree_.erase(it);
+    }
+  } else {
+    tree_.insert_or_assign(std::string(guid), std::move(roots));
+  }
+  writer_.ScheduleWrite(this);
+  for (Observer& observer : observers_) {
+    observer.OnPinsChanged();
+  }
+  return true;
+}
+
+void PinStore::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void PinStore::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+// static
+PinStore::LoadResult PinStore::ReadFile(const base::FilePath& file) {
+  LoadResult result;
+  if (!base::PathExists(file)) {
+    return result;
+  }
+  std::string contents;
+  if (!base::ReadFileToString(file, &contents)) {
+    result.status = LoadResult::Status::kReadOnly;
+    return result;
+  }
+  if (std::optional<base::DictValue> dict =
+          base::JSONReader::ReadDict(contents, base::JSON_PARSE_RFC)) {
+    std::optional<int> version = dict->FindInt(kVersionKey);
+    if (version && *version > kPinFileVersion) {
+      result.status = LoadResult::Status::kReadOnly;
+      return result;
+    }
+    if (std::optional<PinTree> tree = PinTreeFromValue(*dict)) {
+      result.status = LoadResult::Status::kLoaded;
+      result.tree = std::move(*tree);
+      return result;
+    }
+  }
+  // Kept, never written over: the next write starts a new file. A second bad
+  // file gets "<file> (1).bad", never the first one's name. An empty unique
+  // path (100 taken) fails the move, and the store stays read-only.
+  result.status =
+      base::Move(file, base::GetUniquePath(
+                           file.AddExtension(FILE_PATH_LITERAL(".bad"))))
+          ? LoadResult::Status::kMovedAside
+          : LoadResult::Status::kReadOnly;
+  return result;
+}
+
+void PinStore::OnLoaded(LoadResult result) {
+  loaded_ = true;
+  tree_ = std::move(result.tree);
+  switch (result.status) {
+    case LoadResult::Status::kMissing:
+      LOG(INFO) << "[workspaces] pins: no file yet at " << writer_.path();
+      break;
+    case LoadResult::Status::kLoaded: {
+      size_t rows = 0;
+      for (const auto& [guid, roots] : tree_) {
+        rows += CountNodes(roots);
+      }
+      LOG(INFO) << "[workspaces] pins: loaded " << rows << " row(s) in "
+                << tree_.size() << " workspace(s) from " << writer_.path();
+      break;
+    }
+    case LoadResult::Status::kMovedAside:
+      LOG(WARNING) << "[workspaces] pins: " << writer_.path()
+                   << " is not a pins file; kept as .bad, starting empty";
+      break;
+    case LoadResult::Status::kReadOnly:
+      read_only_ = true;
+      LOG(WARNING) << "[workspaces] pins: " << writer_.path()
+                   << " could not be read, is from a newer version, or could "
+                      "not be moved aside; it will not be written";
+      break;
+  }
+  for (Observer& observer : observers_) {
+    observer.OnPinsChanged();
+  }
+}
+
+std::optional<std::string> PinStore::SerializeData() {
+  return base::WriteJsonWithOptions(PinTreeToValue(tree_),
+                                    base::JSONWriter::OPTIONS_PRETTY_PRINT);
+}
+
+}  // namespace workspaces::pins
