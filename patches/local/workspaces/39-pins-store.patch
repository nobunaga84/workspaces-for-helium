+class CountingObserver : public PinStore::Observer {
+ public:
+  void OnPinsChanged() override { ++calls; }
+  int calls = 0;
+};
+
+TEST_F(PinStoreTest, ObserversHearTheLoadAndEveryChange) {
+  std::unique_ptr<PinStore> store = NewStore();
+  CountingObserver observer;
+  store->AddObserver(&observer);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(observer.calls, 1);
+  ASSERT_TRUE(store->SetRoots("default", {Item("a", "https://a.example/")}));
+  EXPECT_EQ(observer.calls, 2);
+  store->RemoveObserver(&observer);
+}
+
+// Everything SetRoots accepts, the next load must accept too: one refused row
+// would otherwise send the whole file to .bad. A refusal changes nothing --
+// no row, no observer call, no file.
+TEST_F(PinStoreTest, RefusesRowsTheNextLoadWouldRefuse) {
+  std::unique_ptr<PinStore> store = LoadedStore();
+  CountingObserver observer;
+  store->AddObserver(&observer);
+
+  PinNode no_url = Item("a", "");
+  PinNode no_id = Item("", "https://a.example/");
+  PinNode deepest = Item("leaf", "https://a.example/");
+  for (int level = 0; level <= 65; ++level) {
+    deepest = Folder("f" + base::NumberToString(level), "F", {deepest});
+  }
+  EXPECT_FALSE(store->SetRoots("default", {no_url}));
+  EXPECT_FALSE(store->SetRoots("default", {Folder("f", "F", {no_id})}));
+  EXPECT_FALSE(store->SetRoots("default", {deepest}));
+
+  EXPECT_TRUE(store->tree().empty());
+  EXPECT_EQ(observer.calls, 0);
+  store->RemoveObserver(&observer);
+  store.reset();
+  task_environment_.RunUntilIdle();
+  EXPECT_FALSE(base::PathExists(file()));
+}
+
+// An open tab finds its item by id (E15c), so two rows may never share one --
+// in one workspace or across two. A workspace's own rows may be replaced by
+// rows reusing their ids.
+TEST_F(PinStoreTest, RefusesAnIdTheTreeAlreadyHolds) {
+  std::unique_ptr<PinStore> store = LoadedStore();
+  ASSERT_TRUE(store->SetRoots("work", {Item("w", "https://w.example/")}));
+
+  EXPECT_FALSE(store->SetRoots("default", {Item("w", "https://x.example/")}));
+  EXPECT_FALSE(store->SetRoots(
+      "default", {Item("x", "https://x.example/"),
+                  Folder("f", "F", {Item("x", "https://y.example/")})}));
+  EXPECT_FALSE(store->tree().contains("default"));
+
+  EXPECT_TRUE(store->SetRoots("work", {Item("w", "https://w2.example/")}));
+}
+
+TEST_F(PinStoreTest, ASecondBrokenFileDoesNotReplaceTheFirst) {
+  ASSERT_TRUE(base::WriteFile(file(), "first"));
+  LoadedStore();
+  ASSERT_TRUE(base::WriteFile(file(), "second"));
+  LoadedStore();
+
+  EXPECT_EQ(Contents(bad_file()), "first");
+  EXPECT_EQ(Contents(dir_.GetPath().Append(
+                FILE_PATH_LITERAL("Workspace Pins (1).bad"))),
+            "second");
+}
