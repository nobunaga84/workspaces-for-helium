+TEST_F(PinStoreTest, OneStorePerProfileAndItsDeathSavesTheFile) {
+  auto profile = std::make_unique<FakeProfile>();
+  PinStore* store = PinStore::GetOrCreate(profile.get(), dir_.GetPath());
+  EXPECT_EQ(PinStore::GetOrCreate(profile.get(), dir_.GetPath()), store);
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(store->loaded());
+  ASSERT_TRUE(store->SetRoots("default", {Item("a", "https://a.example/")}));
+
+  // What a browser exit does: the profile, and its user data, are destroyed.
+  profile.reset();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(RootCount(LoadedStore()->tree(), "default"), 1u);
+}
