+
+PinNode Item(std::string id, std::string url) {
+  PinNode node;
+  node.id = std::move(id);
+  node.url = std::move(url);
+  return node;
+}
+
+PinNode Folder(std::string id,
+               std::string title,
+               std::vector<PinNode> children,
+               bool open = false) {
+  PinNode node;
+  node.type = PinNode::Type::kFolder;
+  node.id = std::move(id);
+  node.title = std::move(title);
+  node.children = std::move(children);
+  node.open = open;
+  return node;
+}
+
+// Three folder levels, every field set somewhere, two workspaces.
+PinTree SampleTree() {
+  PinNode deep = Item("c", "https://c.example/");
+  deep.title = "C page";
+  deep.custom_title = "Renamed C";
+  deep.last_active = base::Time::FromSecondsSinceUnixEpoch(1'758'000'000);
+
+  PinTree tree;
+  tree["default"] = {
+      Item("a", "https://a.example/"),
+      Folder("f1", "Outer",
+             {Item("b", "https://b.example/"),
+              Folder("f2", "Middle", {Folder("f3", "Inner", {deep})},
+                     /*open=*/true)}),
+  };
+  tree["work"] = {Item("d", "https://d.example/")};
+  return tree;
+}
+
+// 0 for a workspace the tree does not hold. map::at would abort the whole
+// binary instead (no exceptions here), and a missing write must be a failed
+// check, not a crash that skips the tests after it.
+size_t RootCount(const PinTree& tree, std::string_view guid) {
+  auto it = tree.find(guid);
+  return it == tree.end() ? 0 : it->second.size();
+}
+
+std::vector<std::string> Ids(const std::vector<const PinNode*>& rows) {
+  std::vector<std::string> ids;
+  for (const PinNode* row : rows) {
+    ids.push_back(row->id);
+  }
+  return ids;
+}
+
+TEST(WorkspacePinsTest, JsonRoundTripKeepsNestingAndEveryField) {
+  const PinTree tree = SampleTree();
+  EXPECT_EQ(PinTreeFromValue(PinTreeToValue(tree)), tree);
+}
+
+TEST(WorkspacePinsTest, RefusesFilesItDidNotWrite) {
+  for (std::string_view json : {
+           R"({"workspaces":{}})",
+           R"({"version":2,"workspaces":{}})",
+           R"({"version":1})",
+           R"({"version":1,"workspaces":{"default":{}}})",
+           R"({"version":1,"workspaces":{"default":[{"type":"item","id":"a"}]}})",
+           R"({"version":1,"workspaces":{"default":[{"type":"item","url":"https://a/"}]}})",
+           R"({"version":1,"workspaces":{"default":[{"type":"folder","id":"f"}]}})",
+           R"({"version":1,"workspaces":{"default":[{"type":"tab","id":"x","url":"https://a/"}]}})",
+           R"({"version":1,"workspaces":{"default":[{"type":"item","id":"a","url":"https://a/","last_active":"soon"}]}})",
+           R"({"version":1,"workspaces":{"default":[{"type":"folder","id":"f","children":[{"type":"item","id":"b"}]}]}})",
+           R"({"version":1,"workspaces":{"default":[{"type":"item","id":"a","url":"https://a/"}],"work":[{"type":"item","id":"a","url":"https://b/"}]}})",
+       }) {
+    SCOPED_TRACE(json);
+    std::optional<base::DictValue> dict =
+        base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+    ASSERT_TRUE(dict);
+    EXPECT_FALSE(PinTreeFromValue(*dict).has_value());
+  }
+}
+
+TEST(WorkspacePinsTest, RowsOfADeletedWorkspaceShowUnderDefaultUntilItReturns) {
+  PinTree tree;
+  tree["default"] = {Item("d", "https://d.example/")};
+  tree["gone"] = {Item("g", "https://g.example/")};
+  tree["work"] = {Item("w", "https://w.example/")};
+
+  std::vector<std::string> known = {"default", "work"};
+  EXPECT_EQ(Ids(RootsForWorkspace(tree, "default", known)),
+            (std::vector<std::string>{"d", "g"}));
+  EXPECT_EQ(Ids(RootsForWorkspace(tree, "work", known)),
+            (std::vector<std::string>{"w"}));
+
+  known.push_back("gone");
+  EXPECT_EQ(Ids(RootsForWorkspace(tree, "default", known)),
+            (std::vector<std::string>{"d"}));
+  EXPECT_EQ(Ids(RootsForWorkspace(tree, "gone", known)),
+            (std::vector<std::string>{"g"}));
+}
