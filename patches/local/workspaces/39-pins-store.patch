+// Stands in for a Profile: SupportsUserData's destructor is protected.
+class FakeProfile : public base::SupportsUserData {};
+
+class PinStoreTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+
+  base::FilePath file() const { return dir_.GetPath().Append(PinStore::kFileName); }
+  base::FilePath bad_file() const {
+    return file().AddExtension(FILE_PATH_LITERAL(".bad"));
+  }
+
+  // A store whose load is still on its way.
+  std::unique_ptr<PinStore> NewStore() {
+    return std::make_unique<PinStore>(
+        file(), base::ThreadPool::CreateSequencedTaskRunner(
+                    {base::MayBlock(),
+                     base::TaskShutdownBehavior::BLOCK_SHUTDOWN}));
+  }
+
+  std::unique_ptr<PinStore> LoadedStore() {
+    std::unique_ptr<PinStore> store = NewStore();
+    task_environment_.RunUntilIdle();
+    return store;
+  }
+
+  std::string Contents(const base::FilePath& path) {
+    std::string contents;
+    EXPECT_TRUE(base::ReadFileToString(path, &contents)) << path;
+    return contents;
+  }
+
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  base::ScopedTempDir dir_;
+};
+
+TEST_F(PinStoreTest, NoFileLoadsEmptyAndWritable) {
+  std::unique_ptr<PinStore> store = LoadedStore();
+  EXPECT_TRUE(store->loaded());
+  EXPECT_FALSE(store->read_only());
+  EXPECT_TRUE(store->tree().empty());
+  EXPECT_FALSE(base::PathExists(file()));
+}
+
+TEST_F(PinStoreTest, AChangeIsWrittenAfterTheDelayAndReadBack) {
+  const PinTree tree = SampleTree();
+  std::unique_ptr<PinStore> store = LoadedStore();
+  ASSERT_TRUE(store->SetRoots("default", tree.at("default")));
+  ASSERT_TRUE(store->SetRoots("work", tree.at("work")));
+
+  task_environment_.FastForwardBy(PinStore::kSaveDelay / 2);
+  EXPECT_FALSE(base::PathExists(file()));
+  task_environment_.FastForwardBy(PinStore::kSaveDelay);
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(base::PathExists(file()));
+
+  store.reset();
+  EXPECT_EQ(LoadedStore()->tree(), tree);
+}
+
+TEST_F(PinStoreTest, DestroyingTheStoreWritesTheChangeStillWaiting) {
+  const PinTree tree = SampleTree();
+  std::unique_ptr<PinStore> store = LoadedStore();
+  ASSERT_TRUE(store->SetRoots("default", tree.at("default")));
+
+  // Well inside kSaveDelay: only the destructor can have written it.
+  store.reset();
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(base::PathExists(file()));
+  PinTree expected;
+  expected["default"] = tree.at("default");
+  EXPECT_EQ(LoadedStore()->tree(), expected);
+}
+
+TEST_F(PinStoreTest, EmptyingAWorkspaceRemovesIt) {
+  std::unique_ptr<PinStore> store = LoadedStore();
+  ASSERT_TRUE(store->SetRoots("work", {Item("d", "https://d.example/")}));
+  ASSERT_TRUE(store->SetRoots("work", {}));
+  EXPECT_TRUE(store->tree().empty());
+}
+
+TEST_F(PinStoreTest, ABrokenFileIsKeptAsideAndNeverWrittenOver) {
+  ASSERT_TRUE(base::WriteFile(file(), "{not json"));
+  std::unique_ptr<PinStore> store = LoadedStore();
+  EXPECT_TRUE(store->loaded());
+  EXPECT_FALSE(store->read_only());
+  EXPECT_TRUE(store->tree().empty());
+  EXPECT_FALSE(base::PathExists(file()));
+  EXPECT_EQ(Contents(bad_file()), "{not json");
+
+  ASSERT_TRUE(store->SetRoots("default", {Item("a", "https://a.example/")}));
+  store.reset();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(RootCount(LoadedStore()->tree(), "default"), 1u);
+  EXPECT_EQ(Contents(bad_file()), "{not json");
+}
+
+TEST_F(PinStoreTest, AFileFromANewerVersionIsReadOnly) {
+  const std::string newer = R"({"version":2,"workspaces":{}})";
+  ASSERT_TRUE(base::WriteFile(file(), newer));
+  std::unique_ptr<PinStore> store = LoadedStore();
+  EXPECT_TRUE(store->loaded());
+  EXPECT_TRUE(store->read_only());
+  EXPECT_FALSE(store->SetRoots("default", {Item("a", "https://a.example/")}));
+
+  store.reset();
+  task_environment_.FastForwardBy(PinStore::kSaveDelay * 2);
+  EXPECT_EQ(Contents(file()), newer);
+  EXPECT_FALSE(base::PathExists(bad_file()));
+}
+
+#if BUILDFLAG(IS_WIN)
+// Another program holding the file -- a sync tool, a virus scan: the store
+// must not start empty and then write over what it could not read. Were the
+// lock not taken, "kept" (not JSON) would be moved to .bad and this would fail.
+TEST_F(PinStoreTest, AFileItCannotReadIsNeverWritten) {
+  ASSERT_TRUE(base::WriteFile(file(), "kept"));
+  {
+    base::File lock(file(), base::File::FLAG_OPEN | base::File::FLAG_READ |
+                                base::File::FLAG_WIN_EXCLUSIVE_READ |
+                                base::File::FLAG_WIN_EXCLUSIVE_WRITE);
+    ASSERT_TRUE(lock.IsValid());
+    std::unique_ptr<PinStore> store = LoadedStore();
+    EXPECT_TRUE(store->read_only());
+    EXPECT_FALSE(store->SetRoots("default", {Item("a", "https://a.example/")}));
+  }
+  EXPECT_EQ(Contents(file()), "kept");
+  EXPECT_FALSE(base::PathExists(bad_file()));
+}
+#endif
