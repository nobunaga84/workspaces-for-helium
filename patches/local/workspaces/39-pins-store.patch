+#ifndef CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_PINS_H_
+#define CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_PINS_H_
+
+#include <functional>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/important_file_writer.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/supports_user_data.h"
+#include "base/time/time.h"
+#include "base/values.h"
+
+namespace base {
+class SequencedTaskRunner;
+}
+
+// Each workspace's pinned section: folders and items that are data, not tabs
+// (design 5, E15 spec). Nothing here is a tab; an item becomes one only when it
+// is opened (E15c), and closing that tab leaves the item where it was.
+//
+// //base only, the file included, so all of it is tested in
+// workspaces_unittests (design 3.10). The store attaches to its profile as
+// base::SupportsUserData, which a Profile is: no KeyedService, so no factory in
+// an upstream list (LOCAL.md 43).
+namespace workspaces::pins {
+
+// One row of a pinned section.
+struct PinNode {
+  enum class Type { kFolder, kItem };
+
+  Type type = Type::kItem;
+  // Stable across restarts: an open item's tab points back at it by this id
+  // (the tab's extra data, E15c).
+  std::string id;
+  // A folder's name, or the page title an item last showed.
+  std::string title;
+
+  // Folder only.
+  bool open = false;
+  std::vector<PinNode> children;
+
+  // Item only. The item's saved address -- its anchor.
+  std::string url;
+  // The name the user gave it; empty shows `title`.
+  std::string custom_title;
+  // When the item's page was last shown. Null for never.
+  base::Time last_active;
+
+  bool operator==(const PinNode&) const = default;
+};
+
+// Workspace guid -> that workspace's top-level rows, in order.
+using PinTree = std::map<std::string, std::vector<PinNode>, std::less<>>;
+
+// The file's JSON, and back. std::nullopt when `value` is not a pin file this
+// version can read; the store then keeps the file aside rather than write over
+// it.
+inline constexpr int kPinFileVersion = 1;
+base::DictValue PinTreeToValue(const PinTree& tree);
+std::optional<PinTree> PinTreeFromValue(const base::DictValue& value);
+
+// The rows to draw for workspace `guid`, own rows first. Rows kept under a
+// workspace that no longer exists show under the default workspace, as its
+// tabs do (ResolveTabGuid, design 2.4): nothing is lost when a workspace is
+// deleted, and it all comes back if that guid ever exists again.
+std::vector<const PinNode*> RootsForWorkspace(
+    const PinTree& tree,
+    std::string_view guid,
+    const std::vector<std::string>& known_guids);
+
+// The pins file of one profile, loaded off the UI thread and written through
+// base::ImportantFileWriter, so a crash never leaves half a file. Used on one
+// sequence (the UI thread).
+class PinStore : public base::SupportsUserData::Data,
+                 public base::ImportantFileWriter::DataSerializer {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // After the load and after every change.
+    virtual void OnPinsChanged() = 0;
+  };
+
+  static constexpr base::FilePath::CharType kFileName[] =
+      FILE_PATH_LITERAL("Workspace Pins");
+  // Bookmarks' delay: a restart loses nothing, a crash at most this much.
+  static constexpr base::TimeDelta kSaveDelay = base::Milliseconds(2500);
+
+  // The one store of `host` (a Profile), created -- and its load started -- on
+  // the first call.
+  static PinStore* GetOrCreate(base::SupportsUserData* host,
+                               const base::FilePath& profile_dir);
+
+  // Starts loading `file` on `file_task_runner`, which must be BLOCK_SHUTDOWN
+  // so the destructor's last write finishes.
+  PinStore(const base::FilePath& file,
+           scoped_refptr<base::SequencedTaskRunner> file_task_runner);
+  PinStore(const PinStore&) = delete;
+  PinStore& operator=(const PinStore&) = delete;
+  // Writes any change still waiting for kSaveDelay.
+  ~PinStore() override;
+
+  bool loaded() const { return loaded_; }
+  // The file exists but could not be read, or is from a newer version: it is
+  // never written, so nothing in it is lost.
+  bool read_only() const { return read_only_; }
+  const PinTree& tree() const { return tree_; }
+
+  // Replaces workspace `guid`'s rows. False, and nothing changes -- no write,
+  // no observer call -- before the load has finished, when read_only(), or
+  // when `roots` holds a row the next load would refuse (an empty id, an id
+  // another row of the tree already has, an item without a url) or folders
+  // nested past what the file can hold.
+  bool SetRoots(std::string_view guid, std::vector<PinNode> roots);
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+ private:
+  struct LoadResult;
+  static LoadResult ReadFile(const base::FilePath& file);
+  void OnLoaded(LoadResult result);
+
+  // base::ImportantFileWriter::DataSerializer:
+  std::optional<std::string> SerializeData() override;
+
+  PinTree tree_;
+  bool loaded_ = false;
+  bool read_only_ = false;
+  base::ImportantFileWriter writer_;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<PinStore> weak_factory_{this};
+};
+
+}  // namespace workspaces::pins
+
+#endif  // CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_PINS_H_
