+bool WorkspaceService::IsEnabled() const {
+  if (!browser_window_ || !prefs_) {
+    return false;
+  }
+  if (!prefs_->GetBoolean(prefs::kHeliumWorkspacesEnabled)) {
+    return false;
+  }
+
+  // Ask Helium what it already knows, instead of reading prefs::kHeliumLayout
+  // a second time. Three reasons, in order of what a second reading would
+  // have cost: this is the same value the strip lays itself out from, so the
+  // two can never disagree; it folds in the vertical-tabs feature flag, which
+  // a raw pref read does not; and it copies neither the pref name nor the
+  // HeliumLayoutType enum value into this fork, where a rebase could drift
+  // them apart without a word.
+  //
+  // Null when the vertical-tabs feature is off, because BrowserWindowFeatures
+  // builds the controller only in that case -- which is exactly when this
+  // should answer false anyway.
+  const tabs::VerticalTabStripStateController* vertical_tabs =
+      tabs::VerticalTabStripStateController::From(browser_window_);
+  return vertical_tabs && vertical_tabs->ShouldDisplayVerticalTabs();
+}
