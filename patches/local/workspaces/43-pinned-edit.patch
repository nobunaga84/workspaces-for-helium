+  EXPECT_TRUE(store->Insert("default", Item("y", "https://y.example/"), "b",
+                            Where::kBefore));
+  EXPECT_TRUE(store->Insert("default", Item("z", "https://z.example/"), "c",
+                            Where::kAfter));
+  EXPECT_TRUE(
+      store->Insert("default", Folder("g", "New", {}), "f2", Where::kInto));
+  EXPECT_TRUE(store->Insert("work", Item("w", "https://w.example/"), "",
+                            Where::kAfter));
+  // No such row, an item is no folder, an id the tree has, no place at all.
+  EXPECT_FALSE(store->Insert("default", Item("q", "https://q.example/"),
+                             "nope", Where::kBefore));
+  EXPECT_FALSE(store->Insert("default", Item("q", "https://q.example/"), "a",
+                             Where::kInto));
+  EXPECT_FALSE(store->Insert("default", Item("a", "https://q.example/"), "",
+                             Where::kAfter));
+  EXPECT_FALSE(
+      store->Insert("", Item("q", "https://q.example/"), "", Where::kAfter));
+  EXPECT_EQ(observer.calls, 5);
