+views::View* WorkspacePinnedSectionView::RowFor(std::string_view id) const {
+  if (!list_) {
+    return nullptr;
+  }
+  for (views::View* const child : list_->children()) {
+    if (views::AsViewClass<PinRow>(child)->id() == id) {
+      return child;
+    }
+  }
+  return nullptr;
+}
+
+void WorkspacePinnedSectionView::ShowRenameBubble(const std::string& id) {
+  const PinNode* const row = store_ ? store_->Find(id) : nullptr;
+  views::View* const anchor = RowFor(id);
+  if (!row || !anchor) {
+    return;
+  }
+  anchor->ScrollViewToVisible();
+  WorkspaceRailView::ShowNameBubble(
+      anchor, IDS_BOOKMARKS_RENAME, IDS_HELIUM_WORKSPACE_NAME_LABEL,
+      RowText(*row),
+      base::BindOnce(&WorkspacePinnedSectionView::RenameRow,
+                     weak_factory_.GetWeakPtr(), id));
+}
+
+void WorkspacePinnedSectionView::RenameRow(const std::string& id,
+                                           const std::u16string& text) {
+  const PinNode* const row = store_ ? store_->Find(id) : nullptr;
+  if (!row) {
+    return;
+  }
+  std::u16string trimmed;
+  base::TrimWhitespace(text, base::TRIM_ALL, &trimmed);
+  std::string name = base::UTF16ToUTF8(trimmed);
+  const bool folder = row->type == PinNode::Type::kFolder;
+  // A folder keeps a name. An item named as its page is an item with no name
+  // of its own, and shows its page's title from then on.
+  if (folder && name.empty()) {
+    return;
+  }
+  if (!folder && name == row->title) {
+    name.clear();
+  }
+  if (!store_->Rename(id, name)) {
+    return;
+  }
+  LOG(INFO) << "[workspaces] pins: renamed '" << id << "'";
+  if (folder) {
+    return;
+  }
+  // An open page carries its item's name as its own title (OpenItem): in the
+  // window's title and in tab search.
+  for (BrowserWindowInterface* const window :
+       WindowsOf(browser_->GetProfile())) {
+    workspaces::WorkspaceService* const service =
+        workspaces::WorkspaceService::From(window);
+    if (tabs::TabInterface* const tab =
+            LinkedTab(window->GetTabStripModel(), id);
+        tab && service) {
+      service->SetCustomTitle(tab, name);
+    }
+  }
+}
