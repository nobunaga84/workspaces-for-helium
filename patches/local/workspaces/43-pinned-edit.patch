+  ASSERT_TRUE(again->Find("f1") && again->Find("f2") && again->Find("f3"));
+  EXPECT_EQ(RowIds(again->Find("f1")->children), (RowList{"y", "b", "f2"}));
+  EXPECT_EQ(RowIds(again->Find("f2")->children), (RowList{"g", "f3"}));
+  EXPECT_EQ(RowIds(again->Find("f3")->children), (RowList{"c", "z"}));
+  EXPECT_EQ(RootCount(again->tree(), "work"), 1u);
