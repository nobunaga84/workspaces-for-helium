+// static
+void WorkspacePinnedSectionView::PinTabs(
+    BrowserWindowInterface* browser,
+    std::vector<tabs::TabInterface*> tabs) {
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser);
+  if (!service || !service->IsEnabled()) {
+    return;
+  }
+  Profile* const profile = browser->GetProfile();
+  workspaces::pins::PinStore* const store =
+      workspaces::pins::PinStore::GetOrCreate(profile, profile->GetPath());
+  // In the list's order, each after the one before it: a selection is not
+  // kept in that order.
+  TabStripModel* const model = browser->GetTabStripModel();
+  std::ranges::sort(tabs, {}, [model](tabs::TabInterface* tab) {
+    return model->GetIndexOfTab(tab);
+  });
+  // After the last row DRAWN: the section shows a deleted workspace's rows
+  // after its own, and the end of its own list would be above them (E15d
+  // review).
+  std::string after;
+  if (const std::vector<const PinNode*> roots =
+          workspaces::pins::RootsForWorkspace(store->tree(),
+                                              service->active_guid(),
+                                              service->known_guids());
+      !roots.empty()) {
+    after = roots.back()->id;
+  }
+  for (tabs::TabInterface* const tab : tabs) {
+    content::WebContents* const contents = tab->GetContents();
+    // What the menu asked of the clicked tab, asked of each; and not a tab
+    // this window hides, which a shift-click range can hold (E13).
+    if (!contents || tab->IsPinned() || tab->GetGroup() || tab->IsSplit() ||
+        !service->IsTabOnScreen(tab) || service->IsPinItemTab(tab) ||
+        !workspaces::WorkspaceTabData::IsAnchorableUrl(
+            contents->GetLastCommittedURL())) {
+      continue;
+    }
+    PinNode item;
+    item.id = NewRowId();
+    item.url = contents->GetLastCommittedURL().spec();
+    item.title = base::UTF16ToUTF8(contents->GetTitle());
+    item.custom_title = workspaces::CustomTitleForTab(contents);
+    const std::string id = item.id;
+    // The row first: a link to an item the store does not hold is dropped by
+    // the next state pass (ReadLinks).
+    if (!store->Insert(service->active_guid(), std::move(item), after,
+                       Where::kAfter)) {
+      LOG(WARNING) << "[workspaces] pins: could not pin a tab; the pins file "
+                      "is not loaded yet, or is read-only";
+      return;
+    }
+    service->SetPinItem(tab, id);
+    // Anchored at the page it shows, as an opened item is at its address.
+    service->SetAnchored(tab, true);
+    after = id;
+    LOG(INFO) << "[workspaces] pins: pinned a tab as item '" << id << "'";
+  }
+}
