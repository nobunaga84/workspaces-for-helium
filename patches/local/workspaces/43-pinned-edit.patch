+  // A folder, with the one inside it, to the front.
+  EXPECT_TRUE(store->Move("f2", "default", "a", Where::kBefore));
+  EXPECT_TRUE(store->Move("b", "default", "f3", Where::kInto));
+  EXPECT_FALSE(store->Move("f2", "default", "f3", Where::kInto));
+  EXPECT_FALSE(store->Move("f2", "default", "f2", Where::kInto));
+  EXPECT_FALSE(store->Move("a", "default", "c", Where::kInto));
+  EXPECT_FALSE(store->Move("nope", "default", "a", Where::kBefore));
+  EXPECT_FALSE(store->Move("a", "default", "nope", Where::kBefore));
