+// The list holding the row `id`, at `nodes` or below, and its place in it;
+// null when no row has that id.
+std::vector<PinNode>* ListOf(std::vector<PinNode>& nodes,
+                             std::string_view id,
+                             size_t& index) {
+  for (size_t i = 0; i < nodes.size(); ++i) {
+    if (nodes[i].id == id) {
+      index = i;
+      return &nodes;
+    }
+    if (std::vector<PinNode>* const list =
+            ListOf(nodes[i].children, id, index)) {
+      return list;
+    }
+  }
+  return nullptr;
+}
+
+// Puts `row` `where` the row `to` is, or last in workspace `guid`'s top level
+// when `to` is empty. False when there is no such place.
+bool Place(PinTree& tree,
+           std::string_view guid,
+           PinNode row,
+           std::string_view to,
+           Where where) {
+  if (to.empty()) {
+    if (guid.empty()) {
+      return false;
+    }
+    tree[std::string(guid)].push_back(std::move(row));
+    return true;
+  }
+  for (auto& [owner, roots] : tree) {
+    size_t index = 0;
+    std::vector<PinNode>* const list = ListOf(roots, to, index);
+    if (!list) {
+      continue;
+    }
+    if (where == Where::kInto) {
+      // First inside, as Arc adds to a folder (E15d: 1,694 of 1,724 pairs of
+      // neighbours in the owner's folders have the newer one above).
+      PinNode& folder = (*list)[index];
+      if (folder.type != PinNode::Type::kFolder) {
+        return false;
+      }
+      folder.children.insert(folder.children.begin(), std::move(row));
+    } else {
+      list->insert(list->begin() + index + (where == Where::kAfter ? 1 : 0),
+                   std::move(row));
+    }
+    return true;
+  }
+  return false;
+}
