+bool SortsBefore(const pins::PinNode& a, const pins::PinNode& b) {
+  // What each row is called on screen: a split by its left page.
+  const auto name = [](const pins::PinNode& row) {
+    const pins::PinNode& page =
+        row.type == pins::PinNode::Type::kSplit && !row.children.empty()
+            ? row.children.front()
+            : row;
+    return ShownTitle(page.custom_title, page.title, page.url);
+  };
+  // Chromium's own Sort by name for a bookmark folder (BookmarkModel's
+  // SortComparator): folders first, then the rest, each by name in the
+  // browser's language -- case and accents never decide alone, so "apple"
+  // sorts with "Apple" and "Äpfel" beside "Apfel" (B9).
+  const bool a_folder = a.type == pins::PinNode::Type::kFolder;
+  if (a_folder != (b.type == pins::PinNode::Type::kFolder)) {
+    return a_folder;
+  }
+  // One collator for the process: the language changes only at a restart,
+  // and sorting the biggest folder (1,159 rows) compares ~12,000 times.
+  static const base::NoDestructor<std::unique_ptr<icu::Collator>> collator([] {
+    UErrorCode error = U_ZERO_ERROR;
+    std::unique_ptr<icu::Collator> made(icu::Collator::createInstance(error));
+    if (U_FAILURE(error)) {
+      made.reset();
+    }
+    return made;
+  }());
+  const std::u16string name_a = name(a);
+  const std::u16string name_b = name(b);
+  if (!*collator) {
+    return base::i18n::FoldCase(name_a) < base::i18n::FoldCase(name_b);
+  }
+  return base::i18n::CompareString16WithCollator(**collator, name_a,
+                                                 name_b) == UCOL_LESS;
+}
