+void WorkspacePinnedSectionView::ResumeDrag() {
+  views::Widget* const widget = GetWidget();
+  if (dragging_tabs_) {
+    // A workspace switch under the drag: its tabs were judged for the one it
+    // began in (M8).
+    if (drawn_guid_ != drag_guid_ || !widget) {
