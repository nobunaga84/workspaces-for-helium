+
+bool PinStore::SortFolder(
+    std::string_view id,
+    base::FunctionRef<bool(const PinNode&, const PinNode&)> less) {
+  if (!loaded_ || read_only_) {
+    return false;
+  }
+  for (auto& [guid, roots] : tree_) {
+    if (PinNode* node = FindNode(roots, id)) {
+      if (node->type != PinNode::Type::kFolder) {
+        return false;
+      }
+      std::vector<std::string> before =
+          base::ToVector(node->children, &PinNode::id);
+      std::ranges::stable_sort(node->children, less);
+      std::vector<std::string> after =
+          base::ToVector(node->children, &PinNode::id);
+      // A sort that moved nothing keeps the slot: Sort pressed twice must not
+      // lose the order the first one can give back.
+      if (after != before) {
+        sort_undo_ =
+            SortUndo{std::string(id), std::move(before), std::move(after)};
+      }
+      Changed();
+      return true;
+    }
+  }
+  return false;
+}
+
+bool PinStore::CanUndoSort(std::string_view id) const {
+  if (!sort_undo_ || sort_undo_->folder != id) {
+    return false;
+  }
+  const PinNode* const folder = Find(id);
+  return folder && folder->type == PinNode::Type::kFolder &&
+         base::ToVector(folder->children, &PinNode::id) == sort_undo_->after;
+}
+
+bool PinStore::UndoSort(std::string_view id) {
+  if (!loaded_ || read_only_ || !CanUndoSort(id)) {
+    return false;
+  }
+  for (auto& [guid, roots] : tree_) {
+    if (PinNode* folder = FindNode(roots, id)) {
+      // Its rows are the sort's `after`, in that order, and `before` holds
+      // the same ids: each is found once.
+      const std::vector<std::string>& after = sort_undo_->after;
+      std::vector<PinNode> rows;
+      rows.reserve(folder->children.size());
+      for (const std::string& row : sort_undo_->before) {
+        const auto at = std::ranges::find(after, row) - after.begin();
+        rows.push_back(std::move(folder->children.begin()[at]));
+      }
+      folder->children = std::move(rows);
+      sort_undo_.reset();
+      Changed();
+      return true;
+    }
   }
   return false;
 }
