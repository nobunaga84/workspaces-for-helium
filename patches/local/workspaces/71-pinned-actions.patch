+void WorkspacePinnedSectionView::StartOpenAll(const std::string& id) {
+  // One at a time: a second Open all while one runs does nothing.
+  const PinNode* const folder = store_ ? store_->Find(id) : nullptr;
+  if (!open_all_id_.empty()) {
+    LOG(INFO) << "[workspaces] pins: open all of folder '" << id
+              << "' refused: one is running";
+    return;
+  }
+  if (!folder || drawn_guid_.empty()) {
+    return;
+  }
+  // Computed again: the confirm may have waited while pages opened.
+  std::vector<const PinNode*> units;
+  CollectClosedUnits(*folder, OpenItemIds(WindowsOf(browser_->GetProfile())),
+                     units);
+  if (units.empty()) {
+    return;
+  }
+  open_all_units_.clear();
+  for (const PinNode* const unit : units) {
+    open_all_units_.push_back(*unit);
+  }
+  open_all_next_ = 0;
+  open_all_id_ = id;
+  // In the folder's workspace whatever the window shows by the last slice.
+  open_all_guid_ = drawn_guid_;
+  open_all_pages_ = 0;
+  open_all_timer_ = base::ElapsedTimer();
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&WorkspacePinnedSectionView::OpenAllSlice,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void WorkspacePinnedSectionView::OpenAllSlice() {
+  // A window closing takes the rest with it.
+  TabStripModel* const model = browser_->GetTabStripModel();
+  const bool closing = browser_->IsDeleteScheduled() || model->closing_all();
+  if (!closing) {
+    // The strip lays out once after the slice, not once per tab (patch 37).
+    workspaces::ScopedBulkLayout bulk;
+    // A page opened meanwhile -- its row pressed -- is not opened twice.
+    const ItemIds open_here = OpenItemIds({browser_.get()});
+    // The folder as it is NOW (review): deleted, or moved to another
+    // workspace -- here or in another window -- and the run ends; a unit
+    // unpinned, deleted or moved out of it since is skipped.
+    const PinNode* const folder = store_ ? store_->Find(open_all_id_) : nullptr;
+    const workspaces::WorkspaceService* const service =
+        workspaces::WorkspaceService::From(browser_);
+    ItemIds in_folder;
+    if (folder && service &&
+        std::ranges::any_of(
+            workspaces::pins::RootsForWorkspace(store_->tree(), open_all_guid_,
+                                                service->known_guids()),
+            [this](const PinNode* root) {
+              return root->id == open_all_id_ ||
+                     HoldsRow(root->children, open_all_id_);
+            })) {
+      in_folder = ItemIdsUnder(*folder);
+    } else if (open_all_next_ < open_all_units_.size()) {
+      LOG(INFO) << "[workspaces] pins: open all of folder '" << open_all_id_
+                << "' stopped: the folder changed";
+      open_all_next_ = open_all_units_.size();
+    }
+    const base::ElapsedTimer slice;
+    bool first = true;
+    while (open_all_next_ < open_all_units_.size() &&
+           (first || slice.Elapsed() < kOpenAllSlice)) {
+      first = false;
+      const PinNode& unit = open_all_units_[open_all_next_++];
+      const std::vector<std::string> pages = PageIds(unit);
+      if (std::ranges::any_of(pages,
+                              [&](const std::string& page) {
+                                return open_here.contains(page) ||
+                                       !in_folder.contains(page);
+                              })) {
+        continue;
+      }
+      if (unit.type == PinNode::Type::kSplit) {
+        OpenSplit(browser_, unit, open_all_guid_, /*select=*/false);
+      } else {
+        OpenItem(browser_, unit, open_all_guid_, /*select=*/false);
+      }
+      open_all_pages_ += static_cast<int>(pages.size());
+    }
+    if (open_all_next_ < open_all_units_.size()) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&WorkspacePinnedSectionView::OpenAllSlice,
+                                    weak_factory_.GetWeakPtr()));
+      return;
+    }
+  }
+  LOG(INFO) << "[workspaces] pins: opened " << open_all_pages_
+            << " page(s) of folder '" << open_all_id_ << "' in "
+            << open_all_timer_.Elapsed().InMilliseconds() << " ms";
+  open_all_units_.clear();
+  open_all_id_.clear();
+  // The rows and their states, made again off the widget (B3).
+  ScheduleRebuild();
+}
+
+void WorkspacePinnedSectionView::CloseAll(const std::string& id) {
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  const PinNode* const folder = store_ ? store_->Find(id) : nullptr;
+  if (!service || !folder) {
+    return;
+  }
+  // An Open all running on this folder, on one inside it or on one holding
+  // it stops first: Close all changes nothing a slice could see (review).
+  if (!open_all_id_.empty()) {
+    const PinNode* const opening = store_->Find(open_all_id_);
+    if (open_all_id_ == id || HoldsRow(folder->children, open_all_id_) ||
+        (opening && HoldsRow(opening->children, id))) {
+      LOG(INFO) << "[workspaces] pins: open all of folder '" << open_all_id_
+                << "' stopped by Close all";
+      open_all_next_ = open_all_units_.size();
+    }
+  }
+  // This window's pages, as the row's x closes this window's (D4).
+  const std::vector<tabs::TabInterface*> pages =
+      PagesOf(browser_->GetTabStripModel(), ItemIdsUnder(*folder));
+  int asked = 0;
+  {
+    workspaces::ScopedBulkLayout bulk;
+    for (tabs::TabInterface* const tab : pages) {
+      asked += service->ClosePinItemPage(tab, "Close all") ? 1 : 0;
+    }
+  }
+  // Asked, not yet closed: a page with an unload handler answers later, and
+  // one that asks "Leave site?" may be kept -- each close is logged as it
+  // happens (B13, review).
+  LOG(INFO) << "[workspaces] pins: closing " << asked << " page(s) of folder '"
+            << id << "'";
+}
