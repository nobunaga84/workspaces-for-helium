+std::string WorkspacePinnedSectionView::FoldedPeekId(const Links& links) const {
+  const std::string active_id =
+      links.active ? workspaces::PinItemForTab(links.active->GetContents())
+                   : std::string();
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (active_id.empty() || !links.open.contains(active_id) || !service ||
+      !store_) {
+    return std::string();
+  }
+  // Item against item, never a split's id (M4d): every row of this
+  // workspace's card, all the way down.
+  std::vector<const PinNode*> items;
+  for (const PinNode* const root : workspaces::pins::RootsForWorkspace(
+           store_->tree(), drawn_guid_, service->known_guids())) {
+    CollectItems(*root, items);
+  }
+  return std::ranges::contains(items, active_id, &PinNode::id)
+             ? active_id
+             : std::string();
+}
