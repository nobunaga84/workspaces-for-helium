+void WorkspacePinnedSectionView::MoveRow(const std::string& id,
+                                         const std::string& guid) {
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service || !store_ ||
+      workspaces::ResolveTabGuid(guid, service->known_guids()) != guid) {
+    return;
+  }
+  const PinNode* const row = store_->Find(id);
+  if (!row) {
+    return;
+  }
+  // Copied now: Move replaces the tree (M1).
+  const ItemIds ids = ItemIdsUnder(*row);
+  // Their open pages, one walk of each window's tabs.
+  std::vector<
+      std::pair<BrowserWindowInterface*, std::vector<tabs::TabInterface*>>>
+      pages;
+  for (BrowserWindowInterface* const window :
+       WindowsOf(browser_->GetProfile())) {
+    if (std::vector<tabs::TabInterface*> tabs =
+            PagesOf(window->GetTabStripModel(), ids);
+        !tabs.empty()) {
+      pages.emplace_back(window, std::move(tabs));
+    }
+  }
+  // Last in the target, after its last row DRAWN -- PinTabs' end, below a
+  // deleted workspace's rows in Home (B8, D1). The target stays as it is,
+  // folded or not.
+  const std::vector<const PinNode*> roots = workspaces::pins::RootsForWorkspace(
+      store_->tree(), guid, service->known_guids());
+  const std::string after = roots.empty() ? std::string() : roots.back()->id;
+  if (!store_->Move(id, guid, after, Where::kAfter)) {
+    LOG(WARNING) << "[workspaces] pins: could not move '" << id
+                 << "' to workspace '" << guid << "'";
+    return;
+  }
+  // The pages follow their rows, as a Today tab moves (the owner): pinned
+  // pages and hidden ones too, which MoveTabsToWorkspace skips (B1).
+  int moved = 0;
+  for (const auto& [window, tabs] : pages) {
+    if (workspaces::WorkspaceService* const there =
+            workspaces::WorkspaceService::From(window)) {
+      moved += there->RetagPinItemPages(tabs, guid);
+    }
+  }
+  LOG(INFO) << "[workspaces] pins: moved '" << id << "' to workspace '"
+            << guid << "', " << moved << " open page(s) with it";
+}
