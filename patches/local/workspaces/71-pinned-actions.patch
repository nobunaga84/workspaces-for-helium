+void WorkspacePinnedSectionView::CloseHoverOpened(
+    const std::vector<std::string>& kept) {
+  int closed = 0;
+  for (const std::string& id : std::exchange(hover_opened_, {})) {
+    if (!std::ranges::contains(kept, id) && store_ &&
+        store_->SetFolderOpen(id, false)) {
+      ++closed;
+    }
+  }
+  if (closed > 0) {
+    LOG(INFO) << "[workspaces] pins: closed " << closed
+              << " folder(s) a drag had opened";
+  }
+  // The card it unfolded, in the workspace the drag began in.
+  if (std::exchange(hover_unfolded_, false) && kept.empty()) {
+    workspaces::prefs::SetPinsFolded(browser_->GetProfile()->GetPrefs(),
+                                     drag_guid_, true);
+    LOG(INFO) << "[workspaces] pins: a drag folded '" << drag_guid_
+              << "' again";
+  }
+}
