+int WorkspaceService::RetagPinItemPages(
+    const std::vector<tabs::TabInterface*>& tabs,
+    std::string_view guid) {
+  if (!IsEnabled() || ResolveTabGuid(guid, known_guids_) != guid) {
+    return 0;
+  }
+
+  // MovableTabs' walk without its two skips, which are exactly the tabs that
+  // follow a row (B1): a pinned item's page, and one this window hides -- a
+  // page of another workspace's row, open in this window.
+  std::vector<split_tabs::SplitTabId> splits;
+  for (tabs::TabInterface* tab : tabs) {
+    if (tab && tab->GetSplit()) {
+      splits.push_back(*tab->GetSplit());
+    }
+  }
+  std::vector<tabs::TabInterface*> moving;
+  for (int i = 0; i < tab_strip_->count(); ++i) {
+    tabs::TabInterface* const tab = tab_strip_->GetTabAtIndex(i);
+    if (!tab || !tab->GetContents() || tab->IsPinned()) {
+      continue;
+    }
+    const std::optional<split_tabs::SplitTabId> split = tab->GetSplit();
+    if (std::ranges::contains(tabs, tab) ||
+        (split && std::ranges::contains(splits, *split))) {
+      moving.push_back(tab);
+    }
+  }
+  if (moving.empty()) {
+    return 0;
+  }
+
+  for (tabs::TabInterface* tab : moving) {
+    SetTag(tab->GetContents(), std::string(guid));
+  }
+  LOG(INFO) << "[workspaces] retagged " << moving.size()
+            << " pinned page(s) -> workspace '" << guid << "'";
+
+  // From a menu handler, as MoveTabsToWorkspace: legal to call directly.
+  EnsureActiveTabVisible();
+  return static_cast<int>(moving.size());
+}
