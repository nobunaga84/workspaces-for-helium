+  // are not dragged (M2). The old row went with the old list: the root view
+  // let go of it with no capture lost, while the window kept the mouse.
+  PinRow* row = nullptr;
+  for (size_t i = 0; list_ && !row && i < list_->children().size(); ++i) {
+    auto* const pin_row =
+        views::AsViewClass<PinRow>(list_->children()[i].get());
+    if (pin_row->id() == drag_id_ && !pin_row->peek()) {
+      row = pin_row;
+    }
+  }
+  if (!row || collapsed_ || !widget || !widget->HasCapture() ||
+      !row->TakeDrag()) {
+    EndDrag();
+    CloseHoverOpened({});
+    return;
+  }
+  widget->SetCapture(row);
+  LOG(INFO) << "[workspaces] pins: the drag goes on over the rebuilt rows";
+  widget->LayoutRootViewIfNecessary();
+  UpdateDrag();
+}
