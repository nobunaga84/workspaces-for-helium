+  // The open page's own icon, from its tab (patch 78). The one looked up
+  // when the row was made can be a globe -- a page never visited in this
+  // profile -- or an older icon of the same site (the host fallback); this
+  // one is drawn from now on and kept when the page sleeps again. A
+  // split's page draws it in its half; a split in the collapsed column
+  // shows its first page's, as its lookup does.
+  void SetPageIcon(size_t index, const gfx::ImageSkia& image) {
+    if (index < split_pages_.size()) {
+      split_pages_[index]->TakePageIcon(image);
+      return;
+    }
+    if (index != 0 || image.BackedBySameObjectAs(page_icon_)) {
+      return;
+    }
+    page_icon_ = image;
+    // A lookup still on its way cannot put the older icon back.
+    favicon_tasks_.TryCancelAll();
+    OnFavicon(image);
+  }
