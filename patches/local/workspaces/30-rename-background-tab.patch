--- a/chrome/browser/ui/tabs/workspace_anchor_sub_menu_model.cc
+++ b/chrome/browser/ui/tabs/workspace_anchor_sub_menu_model.cc
@@ -10,9 +10,11 @@
 
 #include "base/functional/bind.h"
 #include "base/functional/callback_helpers.h"
+#include "base/logging.h"
 #include "base/memory/weak_ptr.h"
 #include "base/strings/string_util.h"
 #include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
 #include "chrome/browser/ui/tabs/existing_base_sub_menu_model.h"
 #include "chrome/browser/ui/tabs/tab_strip_model.h"
 #include "chrome/browser/ui/tabs/workspaces/workspace_service.h"
@@ -76,6 +78,24 @@ void ShowRenameTabDialog(tabs::TabInterf
   if (!contents) {
     return;
   }
+  // To the front first. A tab-modal dialog is shown only while its tab is on
+  // screen (WebContentsModalDialogManager), so renaming a background tab showed
+  // nothing until that tab was clicked -- E11 only ever renamed the active tab
+  // (E13). Legal here: this runs from a menu command, not an observer. Only
+  // when it is not already in front, because activating replaces the
+  // selection, and renaming the active tab should not drop a multi-selection.
+  if (TabStripModel* const model =
+          tab->GetBrowserWindowInterface()->GetTabStripModel();
+      model && !tab->IsActivated()) {
+    if (const int index = model->GetIndexOfTab(tab);
+        index != TabStripModel::kNoTab) {
+      model->ActivateTabAt(index);
+      // The one line that says the background case ran; the box appearing is
+      // otherwise only checkable by eye.
+      LOG(INFO) << "[workspaces] rename dialog at index " << index
+                << ", brought to front";
+    }
+  }
   auto delegate =
       std::make_unique<TabTitleDialogDelegate>(contents->GetWeakPtr());
   TabTitleDialogDelegate* const delegate_ptr = delegate.get();
