+
+// Link preview (C20, Arc's Peek): a link opens in a card over its tab -- 85%
+// of the page area, centred, the page behind dimmed -- instead of in the tab.
+//
+//   ( example.org                                   x )
+//   |                                                 |
+//   |               the linked page, live             |
+//   |                                                 |
+//   (                                    [Open as tab] )
+//
+// - The card has no address bar: its title, the page's origin, is the sign of
+//   where the page is, as in the payment handler's window.
+// - "Open as tab" moves the SAME page -- its history, its state, no reload --
+//   to the top of Today in the workspace on screen.
+// - Escape, the x, a click outside the card and a switch of tab close it; so
+//   does a different-site navigation of the tab behind, and that tab leaving
+//   the window (TabDialogManager's own rules).
+// - While in the card the page is a bare WebContents, no tab helpers: no JS
+//   dialogs, no permission prompts, no history visit. It becomes a full tab
+//   only on "Open as tab".
+//
+// Two ways in, each one line in an upstream file:
+// - "Preview link" on a link's context menu (render_view_context_menu.cc).
+//   Where no card can show, the link opens in a new foreground tab instead.
+// - Arc's rule: a link click on an open pinned page to another site
+//   (workspaces::ShouldPreviewPinnedLink), caught by a navigation throttle
+//   (chrome_content_browser_client_navigation_throttles.cc). Where no card
+//   can show, the link goes on in place, as it would without this.
+//
+// Logs, ids and numbers only, never a title or an address:
+//   "[workspaces] link preview: shown (menu|pinned page) over tab <handle>"
+//   "[workspaces] link preview: cannot show (<why>), <trigger>"
+//   "[workspaces] link preview: cannot show -> new tab"
+//   "[workspaces] link preview: dropped (<why>)" -- the link then opens as
+//   without the card
+//   "[workspaces] link preview: a download -> new tab|refused"
+//   "[workspaces] link preview: a pinned page's link to another site"
+//   "[workspaces] link preview: closed (escape|x|outside|tab switch|page
+//   closed it|open as tab|tab behind|other)"
+//   "[workspaces] link preview: opened as tab at index <i>, <n> entries,
+//   loading <0|1>"
+//
+// Forward declarations only: two upstream files include this.
+namespace workspaces {
+
+// "Preview link" on the context menu of a link in `source`'s page. `params`
+// are the ones "Open link in new tab" builds, in the foreground: the card
+// takes its address, referrer and initiator from them, and where no card can
+// show, the link opens with them as they are.
+void PreviewLinkFromMenu(content::WebContents* source,
+                         const content::OpenURLParams& params);
+
+// Adds Arc's rule's throttle to a primary main-frame navigation.
+void MaybeAddLinkPreviewThrottle(content::NavigationThrottleRegistry& registry);
+// A page that was no tab of `browser` -- the card's, a pop-up's (C6) --
+// becomes its active tab at the top of Today in the workspace on screen (the
+// end without Workspaces), its history saved as a reopened tab's. Returns
+// its index.
+int InsertMovedPage(BrowserWindowInterface* browser,
+                    std::unique_ptr<content::WebContents> contents);
+
+}  // namespace workspaces
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_WORKSPACE_LINK_PREVIEW_H_
