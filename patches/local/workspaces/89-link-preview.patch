+// The card: a dialog shown by the tab's TabDialogManager, holding a WebView
+// of a page of its own. Owns itself, and is deleted soon after its widget
+// closes, whichever way it closes (OnClose).
+class WorkspaceLinkPreview : public views::DialogDelegate,
+                             public content::WebContentsDelegate,
+                             public content::WebContentsObserver,
+                             public ui::EventObserver {
+ public:
+  WorkspaceLinkPreview(tabs::TabInterface* tab,
+                       const GURL& url,
+                       const content::Referrer& referrer,
+                       const std::optional<url::Origin>& initiator,
+                       const char* trigger);
+  WorkspaceLinkPreview(const WorkspaceLinkPreview&) = delete;
+  WorkspaceLinkPreview& operator=(const WorkspaceLinkPreview&) = delete;
+  ~WorkspaceLinkPreview() override = default;
+
+  // views::DialogDelegate:
+  views::View* GetInitiallyFocusedView() override;
+
+  // content::WebContentsDelegate:
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override;
+  content::WebContents* AddNewContents(
+      content::WebContents* source,
+      std::unique_ptr<content::WebContents> new_contents,
+      const GURL& target_url,
+      WindowOpenDisposition disposition,
+      const blink::mojom::WindowFeatures& window_features,
+      bool user_gesture,
+      bool* was_blocked) override;
+  bool HandleKeyboardEvent(content::WebContents* source,
+                           const input::NativeWebKeyboardEvent& event) override;
+  void CanDownload(const GURL& url,
+                   const std::string& request_method,
+                   base::OnceCallback<void(bool)> callback) override;
+  void CloseContents(content::WebContents* source) override;
+  bool CanEnterFullscreenModeForTab(
+      content::RenderFrameHost* requesting_frame) override;
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override;
+
+  // ui::EventObserver: a click outside the card.
+  void OnEvent(const ui::Event& event) override;
+
+ private:
+  // TabDialogManager's get_dialog_bounds: the page area in the window's
+  // coordinates, as TabModalDialogHost measures it (a tab-modal dialog is a
+  // CHILD widget on Windows), less the inset.
+  gfx::Rect DialogBounds();
+
+  void OnTabWillDeactivate(tabs::TabInterface* tab);
+  // Closes the card from a task of its own: never inside an event's dispatch
+  // or a tab strip's activation change.
+  void PostClose(const char* cause);
+  void CloseWithCause(const char* cause);
+  // The single way out (Widget::MakeCloseSynchronous): logs, hands the page
+  // to a tab on "Open as tab", destroys the widget, deletes this soon.
+  void OnClose(views::Widget::ClosedReason reason);
+
+  // Null once closed; the card closes before the tab goes (close_on_detach,
+  // and kDelete always closes).
+  raw_ptr<tabs::TabInterface> tab_;
+  // Ours until "Open as tab" moves it to a tab; outlives the widget, so a
+  // close from inside one of its own callbacks never deletes it under them.
+  std::unique_ptr<content::WebContents> contents_;
+  raw_ptr<views::WebView> web_view_ = nullptr;
+  std::unique_ptr<views::Widget> widget_;
+  std::unique_ptr<views::EventMonitor> monitor_;
+  base::CallbackListSubscription deactivate_subscription_;
+  views::UnhandledKeyboardEventHandler unhandled_keys_;
+  // Set by CloseWithCause() for a close the widget's reason cannot tell.
+  const char* cause_ = nullptr;
+  // The link's referrer, for a download the card's first page turns out to be
+  // (CanDownload).
+  const content::Referrer referrer_;
+  // The first commit takes the keyboard back once; later ones leave it where
+  // the user put it (DidFinishNavigation).
+  bool focused_at_commit_ = false;
+  base::WeakPtrFactory<WorkspaceLinkPreview> weak_factory_{this};
+};
+
+WorkspaceLinkPreview::WorkspaceLinkPreview(
+    tabs::TabInterface* tab,
+    const GURL& url,
+    const content::Referrer& referrer,
+    const std::optional<url::Origin>& initiator,
+    const char* trigger)
+    : tab_(tab), referrer_(referrer) {
+  Profile* const profile =
+      Profile::FromBrowserContext(tab->GetContents()->GetBrowserContext());
+
+  // Bare, as the payment handler's page is (see the header).
+  contents_ =
+      content::WebContents::Create(content::WebContents::CreateParams(profile));
+  contents_->SetDelegate(this);
+  Observe(contents_.get());
+  // Helium's WebRTC address policy and the accept-languages: every page gets
+  // them, a tab's through its helpers (constrained_web_dialog_delegate_views).
+  renderer_preferences_util::UpdateFromSystemSettings(
+      contents_->GetMutableRendererPrefs(), profile);
+  contents_->SyncRendererPrefs();
+
+  SetOwnershipOfNewWidget(views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+  SetModalType(ui::mojom::ModalType::kChild);
+  SetButtons(static_cast<int>(ui::mojom::DialogButton::kOk));
+  SetButtonLabel(
+      ui::mojom::DialogButton::kOk,
+      l10n_util::GetStringUTF16(IDS_HELIUM_LINK_PREVIEW_OPEN_AS_TAB));
+  // An Enter the page leaves alone must never promote the page.
+  SetDefaultButton(static_cast<int>(ui::mojom::DialogButton::kNone));
+  SetShowCloseButton(true);
+  SetAccessibleTitle(l10n_util::GetStringUTF16(IDS_HELIUM_LINK_PREVIEW));
+  SetTitle(url_formatter::FormatOriginForSecurityDisplay(
+      url::Origin::Create(url),
+      url_formatter::SchemeDisplay::OMIT_CRYPTOGRAPHIC));
+  set_margins(gfx::Insets());
+
+  // No browser context: a WebView with one makes a WebContents of its own
+  // whenever asked for one it has not got -- as after "Open as tab".
+  web_view_ = SetContentsView(std::make_unique<views::WebView>());
+  web_view_->SetWebContents(contents_.get());
+  // Widget::Init needs a size; the real one is DialogBounds()
+  // (chrome_webui_dialog.cc does the same).
+  web_view_->SetPreferredSize(gfx::Size(1, 1));
+
+  tabs::TabDialogManager* const manager =
+      tab->GetTabFeatures()->tab_dialog_manager();
+  widget_ = manager->CreateTabScopedDialog(this);
+  widget_->MakeCloseSynchronous(base::BindOnce(&WorkspaceLinkPreview::OnClose,
+                                               base::Unretained(this)));
+  // The rest of Params stays the default: the page behind is dimmed and
+  // takes no input, no other dialog opens over it, and a different-site
+  // navigation of the tab behind or its detach closes the card. Unretained:
+  // the manager drops the params with our widget, which goes before us.
+  auto params = std::make_unique<tabs::TabDialogManager::Params>();
+  params->get_dialog_bounds = base::BindRepeating(
+      &WorkspaceLinkPreview::DialogBounds, base::Unretained(this));
+  manager->ShowDialog(widget_.get(), std::move(params));
+  // The keyboard is the card's from the start (the owner's try): ShowDialog
+  // only shows it, and the page behind, blocked, drops every key -- Escape
+  // and Ctrl+Tab too.
+  web_view_->RequestFocus();
+
+  // The dim behind takes no events (scrim_view.cc), and the page ignores
+  // input while blocked, so a click outside is only seen this way.
+  monitor_ = views::EventMonitor::CreateWindowMonitor(
+      this, manager->GetHostWidget()->GetNativeWindow(),
+      {ui::EventType::kMousePressed});
+  // TabDialogManager would only hide the card with its tab; a hidden live
+  // page would keep playing.
+  deactivate_subscription_ = tab->RegisterWillDeactivate(base::BindRepeating(
+      &WorkspaceLinkPreview::OnTabWillDeactivate, base::Unretained(this)));
+
+  // Browser-initiated, with no opener: the page cannot reach the tab behind.
+  content::NavigationController::LoadURLParams load(url);
+  load.referrer = referrer;
+  load.initiator_origin = initiator;
+  load.transition_type = ui::PAGE_TRANSITION_LINK;
+  load.has_user_gesture = true;
+  contents_->GetController().LoadURLWithParams(load);
+
+  LOG(INFO) << "[workspaces] link preview: shown (" << trigger
+            << ") over tab " << tab->GetHandle().raw_value();
+}
