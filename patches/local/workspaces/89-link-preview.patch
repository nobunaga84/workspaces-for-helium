+views::View* WorkspaceLinkPreview::GetInitiallyFocusedView() {
+  return web_view_;
+}
+
+content::WebContents* WorkspaceLinkPreview::OpenURLFromTab(
+    content::WebContents* source,
+    const content::OpenURLParams& params,
+    base::OnceCallback<void(content::NavigationHandle&)>
+        navigation_handle_callback) {
+  // The page's own navigations stay in the card.
+  if (params.disposition == WindowOpenDisposition::CURRENT_TAB) {
+    base::WeakPtr<content::NavigationHandle> handle =
+        source->GetController().LoadURLWithParams(
+            content::NavigationController::LoadURLParams(params));
+    if (handle && navigation_handle_callback) {
+      std::move(navigation_handle_callback).Run(*handle);
+    }
+    return source;
+  }
+  // A new tab or window (a middle click, the link menu): the window opens
+  // it, as from the tab behind.
+  if (!tab_) {
+    return nullptr;
+  }
+  return tab_->GetBrowserWindowInterface()->OpenURL(
+      params, std::move(navigation_handle_callback));
+}
+
+content::WebContents* WorkspaceLinkPreview::AddNewContents(
+    content::WebContents* source,
+    std::unique_ptr<content::WebContents> new_contents,
+    const GURL& target_url,
+    WindowOpenDisposition disposition,
+    const blink::mojom::WindowFeatures& window_features,
+    bool user_gesture,
+    bool* was_blocked) {
+  // target=_blank and window.open(): into the window after a click; without
+  // one, dropped -- there is no popup blocker here to ask (the payment
+  // handler does the same).
+  if (user_gesture && tab_) {
+    chrome::AddWebContents(tab_->GetBrowserWindowInterface(), source,
+                           std::move(new_contents), target_url, disposition,
+                           window_features);
+  }
+  return nullptr;
+}
+
+bool WorkspaceLinkPreview::HandleKeyboardEvent(
+    content::WebContents* source,
+    const input::NativeWebKeyboardEvent& event) {
+  // The window's shortcuts act on its active tab, the one behind the card:
+  // closing, going back or reloading means the card here. Back, forward and
+  // reload are taken even when the card cannot do them, so they never reach
+  // the tab behind.
+  if (event.GetType() == blink::WebInputEvent::Type::kRawKeyDown) {
+    const ui::Accelerator key =
+        ui::GetAcceleratorFromNativeWebKeyboardEvent(event);
+    const int mods = key.modifiers();
+    const ui::KeyboardCode code = key.key_code();
+    content::NavigationController& nav = source->GetController();
+    if (mods == ui::EF_CONTROL_DOWN &&
+        (code == ui::VKEY_W || code == ui::VKEY_F4)) {
+      PostClose("ctrl+w");
+      return true;
+    }
+    if ((mods == ui::EF_ALT_DOWN && code == ui::VKEY_LEFT) ||
+        code == ui::VKEY_BROWSER_BACK) {
+      if (nav.CanGoBack()) {
+        nav.GoBack();
+      }
+      return true;
+    }
+    if ((mods == ui::EF_ALT_DOWN && code == ui::VKEY_RIGHT) ||
+        code == ui::VKEY_BROWSER_FORWARD) {
+      if (nav.CanGoForward()) {
+        nav.GoForward();
+      }
+      return true;
+    }
+    if ((mods == ui::EF_NONE && code == ui::VKEY_F5) ||
+        (mods == ui::EF_CONTROL_DOWN && code == ui::VKEY_R)) {
+      nav.Reload(content::ReloadType::NORMAL, /*check_for_repost=*/true);
+      return true;
+    }
+  }
+  // Keys the page left alone go to the window's focus manager: Escape reaches
+  // the card, and the browser's shortcuts keep working. It is null while the
+  // widget has no top level, and the handler CHECKs it
+  // (chrome_webui_dialog.cc).
+  views::FocusManager* const focus_manager =
+      widget_ ? widget_->GetFocusManager() : nullptr;
+  return focus_manager &&
+         unhandled_keys_.HandleKeyboardEvent(event, focus_manager);
+}
+
+void WorkspaceLinkPreview::CanDownload(
+    const GURL& url,
+    const std::string& request_method,
+    base::OnceCallback<void(bool)> callback) {
+  // Never in the card: its page is no tab, which the download's own UI and
+  // helpers expect. A GET goes to a new tab of the window instead, where it
+  // downloads as any link does (the tab switch closes the card).
+  std::move(callback).Run(false);
+  const bool to_tab = request_method == "GET" && tab_;
+  LOG(INFO) << "[workspaces] link preview: a download -> "
+            << (to_tab ? "new tab" : "refused");
+  if (to_tab) {
+    // From the card's page, as the request was; the link's own when the
+    // download is the card's first page. The default policy: an origin only
+    // across sites.
+    const GURL& page = contents_->GetLastCommittedURL();
+    tab_->GetBrowserWindowInterface()->OpenURL(
+        content::OpenURLParams(
+            url,
+            page.is_valid() ? content::Referrer(
+                                  page, network::mojom::ReferrerPolicy::kDefault)
+                            : referrer_,
+            WindowOpenDisposition::NEW_FOREGROUND_TAB,
+            ui::PAGE_TRANSITION_LINK, /*is_renderer_initiated=*/false),
+        /*navigation_handle_callback=*/{});
+  }
+}
+
+void WorkspaceLinkPreview::CloseContents(content::WebContents* source) {
+  CloseWithCause("page closed it");
+}
+
+bool WorkspaceLinkPreview::CanEnterFullscreenModeForTab(
+    content::RenderFrameHost* requesting_frame) {
+  return false;
+}
+
+void WorkspaceLinkPreview::DidFinishNavigation(
+    content::NavigationHandle* handle) {
+  // The card has no address bar: its title is where the page is.
+  if (handle->IsInPrimaryMainFrame() && handle->HasCommitted()) {
+    SetTitle(url_formatter::FormatOriginForSecurityDisplay(
+        web_contents()->GetPrimaryMainFrame()->GetLastCommittedOrigin(),
+        url_formatter::SchemeDisplay::OMIT_CRYPTOGRAPHIC));
+    // Again once the page is in: a context menu closing after the card showed
+    // hands the focus back to the tab behind. Only the first commit: later
+    // ones leave the keyboard where the user put it.
+    if (web_view_ && !std::exchange(focused_at_commit_, true)) {
+      web_view_->RequestFocus();
+    }
+  }
+}
+
+void WorkspaceLinkPreview::OnEvent(const ui::Event& event) {
+  // Every press in the window comes here, the card's own too; the location
+  // is in screen coordinates (EventObserver).
+  if (widget_ && event.IsLocatedEvent() &&
+      !widget_->GetWindowBoundsInScreen().Contains(
+          event.AsLocatedEvent()->root_location())) {
+    PostClose("outside");
+  }
+}
+
+gfx::Rect WorkspaceLinkPreview::DialogBounds() {
+  // Over the tab's own pane: in a split, the other pane stays clear.
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(tab_->GetBrowserWindowInterface());
+  views::View* area =
+      browser_view->GetContentsContainerViewFor(tab_->GetContents());
+  if (!area) {
+    area = browser_view->contents_container();
+  }
+  gfx::Rect bounds = area->ConvertRectToWidget(area->GetLocalBounds());
+  bounds.Inset(gfx::Insets::VH(bounds.height() * kInsetFortieths / 40,
+                               bounds.width() * kInsetFortieths / 40));
+  return bounds;
+}
+
+void WorkspaceLinkPreview::OnTabWillDeactivate(tabs::TabInterface* tab) {
+  PostClose("tab switch");
+}
+
+void WorkspaceLinkPreview::PostClose(const char* cause) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&WorkspaceLinkPreview::CloseWithCause,
+                                weak_factory_.GetWeakPtr(), cause));
+}
+
+void WorkspaceLinkPreview::CloseWithCause(const char* cause) {
+  cause_ = cause;
+  OnClose(views::Widget::ClosedReason::kUnspecified);
+}
+
+void WorkspaceLinkPreview::OnClose(views::Widget::ClosedReason reason) {
+  // A second way out arriving after the first (a posted close, a press
+  // while the widget goes) finds nothing left to close.
+  if (!widget_) {
+    return;
+  }
+  const char* cause = cause_;
+  if (!cause) {
+    switch (reason) {
+      case views::Widget::ClosedReason::kEscKeyPressed:
+        cause = "escape";
+        break;
+      case views::Widget::ClosedReason::kCloseButtonClicked:
+        cause = "x";
+        break;
+      case views::Widget::ClosedReason::kAcceptButtonClicked:
+        cause = "open as tab";
+        break;
+      case views::Widget::ClosedReason::kUnspecified:
+        // TabDialogManager's own close: the tab behind went to another site,
+        // or left the window.
+        cause = "tab behind";
+        break;
+      default:
+        cause = "other";
+        break;
+    }
+  }
+  LOG(INFO) << "[workspaces] link preview: closed (" << cause << ")";
+
+  monitor_.reset();
+  deactivate_subscription_ = {};
+  Observe(nullptr);
+  contents_->SetDelegate(nullptr);
+  // Out of the WebView before it goes, and before a tab strip takes it.
+  web_view_->SetWebContents(nullptr);
+  web_view_ = nullptr;
+  if (reason == views::Widget::ClosedReason::kAcceptButtonClicked) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&InsertAsTab,
+                       tab_->GetBrowserWindowInterface()->GetWeakPtr(),
+                       std::move(contents_)));
+  }
+  widget_.reset();
+  tab_ = nullptr;
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, this);
+}
+
+// Shows the card a task after it was asked for: out of the context menu's
+// command and out of the throttle's navigation. Things may have changed in
+// between, so the gates are asked again.
+void ShowNow(base::WeakPtr<content::WebContents> source,
+             const GURL& url,
+             const content::Referrer& referrer,
+             const std::optional<url::Origin>& initiator,
+             const char* trigger) {
+  if (const char* const why = CannotShowReason(source.get(), url)) {
+    LOG(INFO) << "[workspaces] link preview: dropped (" << why << ")";
+    // The link still opens, as it would have without the card: a pinned
+    // page's in place (browser-initiated, so the throttle lets it go), the
+    // menu's in a new tab. The scheme gate passed when it was asked.
+    if (source) {
+      source->OpenURL(
+          content::OpenURLParams(
+              url, referrer,
+              std::string_view(trigger) == "pinned page"
+                  ? WindowOpenDisposition::CURRENT_TAB
+                  : WindowOpenDisposition::NEW_FOREGROUND_TAB,
+              ui::PAGE_TRANSITION_LINK, /*is_renderer_initiated=*/false),
+          /*navigation_handle_callback=*/{});
+    }
+    return;
+  }
+  // Owns itself (OnClose).
+  new WorkspaceLinkPreview(tabs::TabInterface::GetFromContents(source.get()),
+                           url, referrer, initiator, trigger);
+}
+
+// Whether a card will show for `url` over `source`'s tab; it shows a task
+// later. `trigger` names the way in, for the logs.
+bool ShowLinkPreview(content::WebContents* source,
+                     const GURL& url,
+                     const content::Referrer& referrer,
+                     const std::optional<url::Origin>& initiator,
+                     const char* trigger) {
+  if (const char* const why = CannotShowReason(source, url)) {
+    LOG(INFO) << "[workspaces] link preview: cannot show (" << why << "), "
+              << trigger;
+    return false;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ShowNow, source->GetWeakPtr(), url, referrer,
+                                initiator, trigger));
+  return true;
+}
+
+// Arc's rule. Redirects are never judged: only WillStartRequest is here.
+class LinkPreviewThrottle : public content::NavigationThrottle {
+ public:
+  using content::NavigationThrottle::NavigationThrottle;
+
+  ThrottleCheckResult WillStartRequest() override {
+    content::NavigationHandle* const handle = navigation_handle();
+    content::WebContents* const contents = handle->GetWebContents();
+    tabs::TabInterface* const tab =
+        tabs::TabInterface::MaybeGetFromContents(contents);
+    WorkspaceService* const service =
+        tab ? WorkspaceService::From(tab->GetBrowserWindowInterface())
+            : nullptr;
+    // The rule's first condition (gated on IsEnabled(); open pinned pages
+    // only, never favorites), asked first: every other navigation of every
+    // tab stops here, before the domain test.
+    const bool pinned_page = service && service->IsPinItemTab(tab);
+    if (!pinned_page) {
+      return PROCEED;
+    }
+    const GURL& from = contents->GetLastCommittedURL();
+    const GURL& to = handle->GetURL();
+    PinnedLinkFacts facts;
+    facts.pinned_page = pinned_page;
+    facts.renderer_initiated = handle->IsRendererInitiated();
+    facts.user_gesture = handle->HasUserGesture();
+    facts.link_click = handle->WasInitiatedByLinkClick();
+    facts.post = handle->IsPost();
+    facts.http_or_https =
+        from.SchemeIsHTTPOrHTTPS() && to.SchemeIsHTTPOrHTTPS();
+    // TabDialogManager's own test of a different site.
+    facts.same_site = net::registry_controlled_domains::SameDomainOrHost(
+        from, to,
+        net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+    if (!ShouldPreviewPinnedLink(facts)) {
+      return PROCEED;
+    }
+    LOG(INFO) << "[workspaces] link preview: a pinned page's link to another "
+                 "site";
+    // Cancelled only once a card is sure to show; else the link goes on in
+    // place, as without this.
+    return ShowLinkPreview(contents, to,
+                           content::Referrer(handle->GetReferrer()),
+                           handle->GetInitiatorOrigin(), "pinned page")
+               ? CANCEL_AND_IGNORE
+               : PROCEED;
+  }
+
+  const char* GetNameForLogging() override {
+    return "WorkspaceLinkPreviewThrottle";
+  }
+};
+
+}  // namespace
+
+void PreviewLinkFromMenu(content::WebContents* source,
+                         const content::OpenURLParams& params) {
+  if (!source || ShowLinkPreview(source, params.url, params.referrer,
+                                 params.initiator_origin, "menu")) {
+    return;
+  }
+  // The link still opens, in a new foreground tab (the owner's choice), with
+  // the menu's own params: they carry the frame's SiteInstance, which a data:
+  // or about: address needs (OpenURLParams::Valid, a DCHECK).
+  LOG(INFO) << "[workspaces] link preview: cannot show -> new tab";
+  source->OpenURL(params, /*navigation_handle_callback=*/{});
+}
+
+void MaybeAddLinkPreviewThrottle(
+    content::NavigationThrottleRegistry& registry) {
+  if (registry.GetNavigationHandle().IsInPrimaryMainFrame()) {
+    registry.AddThrottle(std::make_unique<LinkPreviewThrottle>(registry));
+  }
+}
+
+int InsertMovedPage(BrowserWindowInterface* browser,
+                    std::unique_ptr<content::WebContents> contents) {
+  content::WebContents* const raw = contents.get();
+  TabStripModel* const model = browser->GetTabStripModel();
+  // Where the archive's restore puts a tab; the insert stamps it with the
+  // workspace on screen (StampInsertedTab).
+  const WorkspaceService* const service = WorkspaceService::From(browser);
+  int index = service ? service->TopOfListIndex(nullptr) : -1;
+  if (index < 0) {
+    index = model->count();
+  }
+  index = model->InsertWebContentsAt(index, std::move(contents),
+                                     AddTabTypes::ADD_ACTIVE);
+  // An insert writes no navigations (session_service_base.cc TabInserted):
+  // without this the page's history is lost at a restart, as
+  // browser_tabrestore.cc does for a reopened tab.
+  if (SessionServiceBase* const session =
+          GetAppropriateSessionServiceIfExisting(browser)) {
+    session->TabRestored(raw, /*pinned=*/false);
+  }
+  return index;
+}
