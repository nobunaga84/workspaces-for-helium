+// C20, Arc's rule: what the navigation throttle knows about a navigation that
+// starts in a tab's main frame. Plain values, so the rule below is tested here.
+struct PinnedLinkFacts {
+  bool pinned_page = false;         // the tab is an open pinned page
+  bool renderer_initiated = false;  // the page asked, not the address bar
+  bool user_gesture = false;        // a click or key, not a timer or script
+  bool link_click = false;          // Blink marked it a link click
+  bool post = false;                // a form sent with POST
+  bool http_or_https = false;       // both the page and the target
+  bool same_site = false;           // same registrable domain (or host)
+};
+
+// C20: whether this navigation opens in the link preview instead of taking
+// the pinned page away from its address.
+bool ShouldPreviewPinnedLink(const PinnedLinkFacts& facts);
+
