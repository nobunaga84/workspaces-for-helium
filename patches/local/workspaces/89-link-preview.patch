+// "Open as tab", posted from the card's button: never inside a tab strip
+// notification, and the window may have closed in between -- a Browser
+// scheduled for deletion must not take a tab (browser.cc OnTabInsertedAt).
+void InsertAsTab(base::WeakPtr<BrowserWindowInterface> browser,
+                 std::unique_ptr<content::WebContents> contents) {
+  if (!browser || browser->IsDeleteScheduled()) {
+    LOG(INFO) << "[workspaces] link preview: its window closed first";
+    return;
+  }
+  content::WebContents* const raw = contents.get();
+  // The tab's model attaches the tab helpers the card's page went without.
+  const int index = InsertMovedPage(browser.get(), std::move(contents));
+  // The favicon driver, new with the helpers, takes icons only for a page it
+  // was told to fetch for (a navigation's commit tells it; this page committed
+  // before it existed): start that fetch, then hand it the icons the page
+  // reported already, which a loaded page never reports again. No fetch for
+  // an error page, as the commit's own path skips it. The override is
+  // private; the base's is not.
+  if (favicon::ContentFaviconDriver* const favicons =
+          favicon::ContentFaviconDriver::FromWebContents(raw)) {
+    if (!raw->GetPrimaryMainFrame()->IsErrorDocument()) {
+      favicons->FetchFavicon(raw->GetLastCommittedURL(),
+                             /*is_same_document=*/false);
+    }
+    static_cast<content::WebContentsObserver*>(favicons)->DidUpdateFaviconURL(
+        raw->GetPrimaryMainFrame(), raw->GetFaviconURLs(),
+        blink::mojom::FaviconUpdateReason::kPageLoad);
+  }
+  LOG(INFO) << "[workspaces] link preview: opened as tab at index " << index
+            << ", "
+            << raw->GetController().GetEntryCount() << " entries, loading "
+            << (raw->IsLoading() ? 1 : 0);
+}
