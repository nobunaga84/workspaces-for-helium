+// The card's inset from each edge of the page area, in 40ths: 3 a side leaves
+// 85% of the width and of the height, centred (Arc's look).
+constexpr int kInsetFortieths = 3;
+
+// Why no card can show over `source` for `url` now, for the logs; null when
+// one can.
+const char* CannotShowReason(content::WebContents* source, const GURL& url) {
+  tabs::TabInterface* const tab =
+      source ? tabs::TabInterface::MaybeGetFromContents(source) : nullptr;
+  if (!tab) {
+    return "not a tab";
+  }
+  // "Open as tab" adds a tab to the window, which an app's or a popup's
+  // window must not get.
+  if (tab->GetBrowserWindowInterface()->GetType() !=
+      BrowserWindowInterface::TYPE_NORMAL) {
+    return "not a normal window";
+  }
+  if (!tab->IsActivated()) {
+    return "background tab";
+  }
+  if (!tab->CanShowModalUI()) {
+    return "a dialog is up";
+  }
+  if (!tab->GetTabFeatures() || !tab->GetTabFeatures()->tab_dialog_manager()) {
+    return "no dialog manager";
+  }
+  // The card's load is browser-initiated, so the renderer's own checks of the
+  // address never ran: the web only, or a file from a file.
+  if (!url.SchemeIsHTTPOrHTTPS() &&
+      !(url.SchemeIsFile() && source->GetLastCommittedURL().SchemeIsFile())) {
+    return "scheme";
+  }
+  return nullptr;
+}
