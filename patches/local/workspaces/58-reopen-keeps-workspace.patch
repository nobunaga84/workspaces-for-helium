+std::optional<tab_groups::TabGroupId> OpenRestoredSavedGroup(
+    BrowserWindowInterface* browser,
+    const base::Uuid& saved_group_id,
+    const std::map<std::string, std::string>& extra_data) {
+  // OpenSavedTabGroup() inserts every tab before it returns, so the stamp
+  // lives exactly as long as that call.
+  std::optional<base::AutoReset<std::string>> stamp;
+  WorkspaceService* const workspace_service = WorkspaceService::From(browser);
+  const auto closed_in = extra_data.find(kWorkspaceExtraDataKey);
+  if (workspace_service && closed_in != extra_data.end() &&
+      !closed_in->second.empty()) {
+    stamp.emplace(workspace_service->StampInsertedTabsFor(closed_in->second));
+  }
+  const std::optional<tab_groups::TabGroupId> group_id =
+      tab_groups::SavedTabGroupUtils::OpenSavedTabGroup(
+          browser, saved_group_id,
+          tab_groups::OpeningSource::kOpenedFromTabRestore);
+  if (stamp && group_id) {
+    LOG(INFO) << "[workspaces] restore: saved group reopened into "
+                 "workspace '"
+              << closed_in->second << "'";
+  }
+  return group_id;
+}
+
 }  // namespace workspaces
