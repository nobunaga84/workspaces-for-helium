+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_WORKSPACE_SIDEBAR_BUBBLE_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_WORKSPACE_SIDEBAR_BUBBLE_H_
+
+#include <memory>
+
+#include "ui/views/bubble/bubble_border.h"
+
+namespace ui {
+class DialogModel;
+}  // namespace ui
+
+namespace views {
+class BubbleDialogModelHost;
+class View;
+}  // namespace views
+
+// The box for something in the sidebar: hung off `anchor` with `arrow`, or,
+// while zen mode floats the sidebar (zen on, sidebar unpinned), centred over
+// the page. That sidebar slides away the moment the mouse leaves it -- zen
+// mode keeps only its top bar out for a box hanging off it
+// (BrowserView::HasOpenBubbleFromTopContainer) -- and took any box anchored in
+// it along (the owner's report, 2026-10-28, patch 94). Over the page is where
+// the Archive's shortcut already opens (C22). Logs
+// "[workspaces] zen: box over the page" when it moves one.
+std::unique_ptr<views::BubbleDialogModelHost> MakeSidebarBubble(
+    std::unique_ptr<ui::DialogModel> model,
+    views::View* anchor,
+    views::BubbleBorder::Arrow arrow);
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_WORKSPACE_SIDEBAR_BUBBLE_H_
