+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/vertical/workspace_sidebar_bubble.h"
+
+#include <utility>
+
+#include "base/logging.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "ui/base/models/dialog_model.h"
+#include "ui/views/bubble/bubble_dialog_model_host.h"
+#include "ui/views/view_utils.h"
+
+std::unique_ptr<views::BubbleDialogModelHost> MakeSidebarBubble(
+    std::unique_ptr<ui::DialogModel> model,
+    views::View* anchor,
+    views::BubbleBorder::Arrow arrow) {
+  // The window's view, if `anchor` is in one: an anchor inside another box has
+  // none above it, and stays where it is.
+  BrowserView* browser_view = nullptr;
+  for (views::View* view = anchor; view && !browser_view;
+       view = view->parent()) {
+    browser_view = views::AsViewClass<BrowserView>(view);
+  }
+  if (browser_view && browser_view->IsZenModeEnabledForLayout() &&
+      !browser_view->IsZenModeSideChromePinned() &&
+      anchor != browser_view->contents_container()) {
+    LOG(INFO) << "[workspaces] zen: box over the page";
+    anchor = browser_view->contents_container();
+    arrow = views::BubbleBorder::FLOAT;
+  }
+  return std::make_unique<views::BubbleDialogModelHost>(std::move(model),
+                                                        anchor, arrow);
+}
