+bool WorkspacePinnedSectionView::SyncPeek(views::View& list,
+                                          const Links& links) {
+  // The active item, open in this window, with no row of its own drawn: the
+  // top-most closed folder drawn that holds it (AddRow never goes into one).
+  const std::string active_id =
+      links.active ? workspaces::PinItemForTab(links.active->GetContents())
+                   : std::string();
+  std::string want;
+  std::string folder_id;
+  if (!collapsed_ && store_ && !active_id.empty() &&
+      links.open.contains(active_id) &&
+      std::ranges::none_of(list.children(), [&](const views::View* child) {
+        const auto* const row = views::AsViewClass<PinRow>(child);
+        return row->id() == active_id && !row->peek();
+      })) {
+    for (const views::View* const child : list.children()) {
+      const auto* const row = views::AsViewClass<PinRow>(child);
+      const PinNode* const folder =
+          row->folder() && !row->open() ? store_->Find(row->id()) : nullptr;
+      if (!folder) {
+        continue;
+      }
+      std::vector<const PinNode*> items;
+      CollectItems(*folder, items);
+      if (std::ranges::any_of(items, [&](const PinNode* item) {
+            return item->id == active_id;
+          })) {
+        want = active_id;
+        folder_id = row->id();
+        break;
+      }
+    }
+  }
+  if (want == peek_id_) {
+    return false;
+  }
+  for (views::View* const child : list.children()) {
+    if (views::AsViewClass<PinRow>(child)->peek()) {
+      list.RemoveChildViewT(child);
+      break;
+    }
+  }
+  peek_id_ = want;
+  if (want.empty()) {
+    LOG(INFO) << "[workspaces] pins: no peek row";
+    return true;
+  }
+  const views::View::Views& rows = list.children();
+  for (size_t i = 0; i < rows.size(); ++i) {
+    const auto* const row = views::AsViewClass<PinRow>(rows[i].get());
+    if (row->id() == folder_id) {
+      AddRow(list, *store_->Find(want), row->level() + 1, IsFrameActive(),
+             i + 1);
+      break;
+    }
+  }
+  LOG(INFO) << "[workspaces] pins: a closed folder shows its page in front '"
+            << want << "'";
+  return true;
+}
