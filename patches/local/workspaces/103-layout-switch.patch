+bool WorkspaceService::FollowTab(tabs::TabInterface* tab) {
+  if (IsTabOnScreen(tab)) {
+    return false;
+  }
+  if (std::optional<std::string> target = ResolveActiveWorkspaceAfterSelection(
+          GuidOf(tab), active_guid_, /*is_removal=*/false)) {
+    SetActiveWorkspace(*target);
+    return true;
