+// and a workspace left empty goes too; each removal is announced and saved.
+TEST_F(PinStoreTest, FindAndRemoveReachAnyDepth) {
+  const PinTree tree = SampleTree();
+  std::unique_ptr<PinStore> store = LoadedStore();
+  ASSERT_TRUE(store->SetRoots("default", tree.at("default")));
+  ASSERT_TRUE(store->SetRoots("work", tree.at("work")));
+  CountingObserver observer;
+  store->AddObserver(&observer);
+
+  ASSERT_TRUE(store->Find("c"));
+  EXPECT_EQ(store->Find("c")->url, "https://c.example/");
+  EXPECT_TRUE(store->Find("d"));
+  EXPECT_FALSE(store->Find("nope"));
+
+  EXPECT_TRUE(store->Remove("f2"));
+  EXPECT_FALSE(store->Find("f2"));
+  EXPECT_FALSE(store->Find("f3"));
+  EXPECT_FALSE(store->Find("c"));
+  EXPECT_TRUE(store->Find("b"));
+  EXPECT_TRUE(store->Remove("d"));
+  EXPECT_EQ(RootCount(store->tree(), "work"), 0u);
+  EXPECT_FALSE(store->Remove("nope"));
+  EXPECT_EQ(observer.calls, 2);
+  store->RemoveObserver(&observer);
