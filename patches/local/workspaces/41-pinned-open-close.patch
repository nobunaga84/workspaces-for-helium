+const PinNode* PinStore::Find(std::string_view id) const {
+  for (const auto& [guid, roots] : tree_) {
+    if (const PinNode* node = FindNode(roots, id)) {
+      return node;
+    }
+  }
+  return nullptr;
+}
+
+bool PinStore::Remove(std::string_view id) {
+  if (!loaded_ || read_only_) {
+    return false;
+  }
+  for (auto it = tree_.begin(); it != tree_.end(); ++it) {
+    if (EraseNode(it->second, id)) {
+      // An empty workspace is not stored, as the load does not keep one.
+      if (it->second.empty()) {
+        tree_.erase(it);
+      }
+      Changed();
+      return true;
+    }
+  }
+  return false;
+}
+
+bool PinStore::SetLastActive(std::string_view id, base::Time time) {
+  if (!loaded_ || read_only_) {
+    return false;
+  }
+  for (auto& [guid, roots] : tree_) {
+    if (PinNode* node = FindNode(roots, id)) {
+      if (node->type != PinNode::Type::kItem) {
+        return false;
+      }
+      // A minute is fine enough, and each write is the whole file -- about a
+      // megabyte after a big import (E15c review #7).
+      if ((time - node->last_active).magnitude() < base::Minutes(1)) {
+        return true;
+      }
+      node->last_active = time;
+      // Written, not announced (the header says why).
+      writer_.ScheduleWrite(this);
+      return true;
+    }
+  }
+  return false;
 }
 
