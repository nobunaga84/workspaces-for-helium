+base::RepeatingCallback<std::vector<tabs::TabInterface*>()> DrawnTabsOnly(
+    const TabStripModelDelegate* delegate,
+    base::RepeatingCallback<std::vector<tabs::TabInterface*>()> get_tabs) {
+  return base::BindRepeating(
+      [](const TabStripModelDelegate* drawn_by,
+         const base::RepeatingCallback<std::vector<tabs::TabInterface*>()>&
+             get) {
+        std::vector<tabs::TabInterface*> tabs = get.Run();
+        if (tabs.size() > 1) {
+          std::erase_if(tabs, [drawn_by](const tabs::TabInterface* tab) {
+            return !drawn_by->IsTabVisibleInActiveWorkspace(tab);
+          });
+        }
+        return tabs;
+      },
+      base::Unretained(delegate), std::move(get_tabs));
+}
+
