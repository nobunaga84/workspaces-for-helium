+void WorkspacePinnedSectionView::OpenItem(const PinNode& item, bool linked) {
+  const GURL url(item.url);
+  if (!url.is_valid()) {
+    LOG(WARNING) << "[workspaces] pins: item '" << item.id
+                 << "' has no address a tab can open";
+    return;
+  }
+  // The importer's road (LOCAL.md 43): one history entry, the item's address,
+  // and everything the tab is -- linked and anchored -- on the contents BEFORE
+  // the insert, so the list never draws it for a moment. The workspace tag is
+  // left to stamping: a new tab joins the workspace on screen, which is the
+  // one whose row was clicked.
+  sessions::SerializedNavigationEntry navigation;
+  navigation.set_index(0);
+  navigation.set_virtual_url(url);
+  navigation.set_title(base::UTF8ToUTF16(item.title));
+  std::map<std::string, std::string> extra_data;
+  if (linked) {
+    extra_data[workspaces::kPinItemExtraDataKey] = item.id;
+    // The anchor is what makes a typed address open a new tab (E10b) and
+    // what the back arrow returns to.
+    extra_data[workspaces::kAnchorUrlExtraDataKey] = item.url;
+  }
+  if (!item.custom_title.empty()) {
+    extra_data[workspaces::kCustomTitleExtraDataKey] = item.custom_title;
+  }
+  TabStripModel* const model = browser_->GetTabStripModel();
+  // Appended: the session service re-records every tab after an insert point
+  // (E14c), and where a hidden tab sits in the list does not matter.
+  chrome::AddRestoredTab(
+      browser_, base::span_from_ref(navigation), model->count(),
+      /*selected_navigation=*/0, /*extension_app_id=*/std::string(),
+      /*group=*/std::nullopt, /*select=*/true, /*pin=*/false,
+      base::TimeTicks::Now(), base::Time::Now(),
+      /*storage_namespace=*/nullptr, sessions::SerializedUserAgentOverride(),
+      extra_data, /*from_session_restore=*/false,
+      /*is_active_browser=*/std::nullopt,
+      chrome::RestoredTabLoadPolicy::kLoadIfVisible);
+  LOG(INFO) << "[workspaces] pins: opened item '" << item.id << "'"
+            << (linked ? "" : " as a Today tab");
+}
+
+void WorkspacePinnedSectionView::UnpinItem(const std::string& id) {
+  const PinNode* const found = store_ ? store_->Find(id) : nullptr;
+  if (!found || found->type != PinNode::Type::kItem) {
+    return;
+  }
+  // The page first, the row after, so that nothing is lost in between: an open
+  // page stays where it is and joins the list, a sleeping item opens here.
+  bool had_page = false;
+  for (BrowserWindowInterface* const window :
+       WindowsOf(browser_->GetProfile())) {
+    workspaces::WorkspaceService* const service =
+        workspaces::WorkspaceService::From(window);
+    if (tabs::TabInterface* const tab =
+            LinkedTab(window->GetTabStripModel(), id);
+        tab && service) {
+      service->SetPinItem(tab, std::string());
+      service->SetAnchored(tab, false);
+      had_page = true;
+    }
+  }
+  if (!had_page) {
+    const PinNode item = *found;
+    OpenItem(item, /*linked=*/false);
+  }
+  store_->Remove(id);
+  LOG(INFO) << "[workspaces] pins: unpinned item '" << id << "'";
+}
+
+void WorkspacePinnedSectionView::DeleteRow(const std::string& id) {
+  const PinNode* const row = store_ ? store_->Find(id) : nullptr;
+  if (!row) {
+    return;
+  }
+  std::vector<std::string> ids;
+  CollectItemIds(*row, ids);
+  // Their open pages close with them. A page that asks "Leave site?" and is
+  // kept loses its link with the row, and joins the list (ReadLinks).
+  int closed = 0;
+  for (BrowserWindowInterface* const window :
+       WindowsOf(browser_->GetProfile())) {
+    workspaces::WorkspaceService* const service =
+        workspaces::WorkspaceService::From(window);
+    TabStripModel* const model = window->GetTabStripModel();
+    std::vector<tabs::TabInterface*> pages;
+    for (int i = 0; service && i < model->count(); ++i) {
+      tabs::TabInterface* const tab = model->GetTabAtIndex(i);
+      if (std::ranges::contains(ids,
+                                workspaces::PinItemForTab(tab->GetContents()))) {
+        pages.push_back(tab);
+      }
+    }
+    for (tabs::TabInterface* const tab : pages) {
+      closed += service->ClosePinItemPage(tab, "Delete") ? 1 : 0;
+    }
+  }
+  store_->Remove(id);
+  LOG(INFO) << "[workspaces] pins: deleted '" << id << "' (" << ids.size()
+            << " item(s), " << closed << " open page(s) closed)";
+}
