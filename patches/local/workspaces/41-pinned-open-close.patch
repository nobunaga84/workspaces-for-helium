+      workspaces::WorkspaceService::From(browser_);
+  if (tabs::TabInterface* const tab =
+          LinkedTab(browser_->GetTabStripModel(), id);
+      tab && service) {
+    service->ClosePinItemPage(tab, "the row's close button");
+  }
