+bool WorkspaceService::IsPinItemTab(const tabs::TabInterface* tab) const {
+  // Not a pinned tab: one pinned while Workspaces was off is a favorite now,
+  // drawn at the top, and its row leaves it alone (E15c review #6).
+  return IsEnabled() && tab && !tab->IsPinned() &&
+         !PinItemForTab(tab->GetContents()).empty();
