+  std::unique_ptr<PinStore> store = LoadedStore();
+  ASSERT_TRUE(store->SetRoots("default", SampleTree().at("default")));
+  CountingObserver observer;
+  store->AddObserver(&observer);
+  const base::Time when = base::Time::FromSecondsSinceUnixEpoch(1'760'000'000);
+  EXPECT_TRUE(store->SetLastActive("b", when));
+  // Within a minute of the last stamp: accepted, and nothing changes.
+  EXPECT_TRUE(store->SetLastActive("b", when + base::Seconds(30)));
+  EXPECT_FALSE(store->SetLastActive("f1", when));
+  EXPECT_FALSE(store->SetLastActive("nope", when));
+  EXPECT_EQ(observer.calls, 0);
