+void WorkspacePinnedSectionView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  const auto* const row = views::AsViewClass<PinRow>(source);
+  if (!row) {
+    return;
+  }
+  context_menu_id_ = row->id();
+  context_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  if (row->folder()) {
+    context_menu_model_->AddItemWithStringId(kCommandDeleteFolder,
+                                             IDS_HELIUM_PINNED_FOLDER_DELETE);
+  } else {
+    context_menu_model_->AddItemWithStringId(kCommandUnpin,
+                                             IDS_HELIUM_PINNED_ITEM_UNPIN);
+    context_menu_model_->AddItemWithStringId(kCommandDelete,
+                                             IDS_HELIUM_PINNED_ITEM_DELETE);
+  }
+  context_menu_runner_ = std::make_unique<views::MenuRunner>(
+      context_menu_model_.get(),
+      views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+  context_menu_runner_->RunMenuAt(
+      source->GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+      views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+void WorkspacePinnedSectionView::ExecuteCommand(int command_id,
+                                                int event_flags) {
+  const std::string id = context_menu_id_;
+  switch (command_id) {
+    case kCommandUnpin:
+      UnpinItem(id);
+      break;
+    case kCommandDelete:
+      DeleteRow(id);
+      break;
+    case kCommandDeleteFolder: {
+      // Asks only when there is something to lose: an empty folder just goes.
+      const PinNode* const folder = store_ ? store_->Find(id) : nullptr;
+      if (!folder) {
+        break;
+      }
+      int items = 0;
+      int folders = 0;
+      workspaces::pins::CountRows(folder->children, items, folders);
+      if (items > 0) {
+        ShowDeleteFolderConfirm(id, items);
+      } else {
+        DeleteRow(id);
+      }
+      break;
+    }
+    default:
+      break;
+  }
+}
