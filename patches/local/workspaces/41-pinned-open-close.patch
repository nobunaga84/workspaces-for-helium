+void WorkspacePinnedSectionView::UpdateRowStates() {
+  row_states_scheduled_ = false;
+  const Links links = ReadLinks();
+  // An item's address that redirects -- a moved site, a shortened or tracking
+  // link -- lands somewhere else on its first load, and where it lands is the
+  // page's home. Otherwise the back arrow shows from the start, and pressing it
+  // loads the redirect that lands in the same place again (the owner's check
+  // of E15c: an Amazon affiliate link). Only while the page holds its ONE
+  // history entry: a link followed since makes a second. The item keeps its
+  // own address; the next open redirects and settles the same way.
+  if (workspaces::WorkspaceService* const service =
+          workspaces::WorkspaceService::From(browser_)) {
+    for (const auto& [id, tab] : links.open) {
+      content::WebContents* const contents = tab->GetContents();
+      if (contents->GetController().GetEntryCount() == 1 &&
+          workspaces::HasDrifted(contents) &&
+          workspaces::WorkspaceTabData::IsAnchorableUrl(
+              contents->GetLastCommittedURL())) {
+        service->SetAnchored(tab, true);
+      }
+    }
+  }
+  if (list_) {
+    ApplyStates(*list_, links);
+  }
+  // The evidence that a restart brought the pages back as their rows.
+  if (links.open.size() != open_count_) {
+    open_count_ = links.open.size();
+    LOG(INFO) << "[workspaces] pins: " << open_count_
+              << " item page(s) open in this window";
+  }
+
+  // Once per activation, not per tab change: the item's last-used time
+  // (design 5, from Arc) and its row scrolled into view -- the list does not
+  // scroll to a tab it does not draw (TabStripView::OnTabChanged).
+  const std::string active_id =
+      links.active ? workspaces::PinItemForTab(links.active->GetContents())
+                   : std::string();
+  if (active_id == active_id_) {
+    return;
+  }
+  active_id_ = active_id;
+  if (active_id.empty() || !links.open.contains(active_id)) {
+    return;
+  }
+  store_->SetLastActive(active_id, base::Time::Now());
+  if (list_) {
+    for (views::View* const child : list_->children()) {
+      if (views::AsViewClass<PinRow>(child)->id() == active_id) {
+        child->ScrollViewToVisible();
+        break;
+      }
+    }
+  }
+}
