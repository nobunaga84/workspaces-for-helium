+void WorkspacePinnedSectionView::ShowDeleteFolderConfirm(const std::string& id,
+                                                         int items) {
+  // Logged when asked and when cancelled, as the rail's confirm is, so a test
+  // can tell "asked, then cancelled" from "never asked".
+  LOG(INFO) << "[workspaces] confirm asked: delete folder '" << id << "', "
+            << items << " item(s)";
+  std::unique_ptr<ui::DialogModel> model =
+      ui::DialogModel::Builder()
+          .SetTitle(l10n_util::GetPluralStringFUTF16(
+              IDS_HELIUM_PINNED_FOLDER_CONFIRM_DELETE, items))
+          .AddParagraph(ui::DialogModelLabel(l10n_util::GetStringUTF16(
+              IDS_HELIUM_PINNED_FOLDER_CONFIRM_BODY)))
+          .AddOkButton(
+              base::BindOnce(&WorkspacePinnedSectionView::DeleteRow,
+                             weak_factory_.GetWeakPtr(), id),
+              ui::DialogModel::Button::Params().SetLabel(
+                  l10n_util::GetStringUTF16(IDS_HELIUM_PINNED_FOLDER_DELETE)))
+          .AddCancelButton(base::BindOnce(
+              [] { LOG(INFO) << "[workspaces] confirm cancelled"; }))
+          .Build();
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(model), this, views::BubbleBorder::TOP_LEFT);
+  views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET)
+      ->Show();
+}
