+// Erases the row with `id` from `nodes` or below. True when it was there.
+bool EraseNode(std::vector<PinNode>& nodes, std::string_view id) {
+  for (auto it = nodes.begin(); it != nodes.end(); ++it) {
+    if (it->id == id) {
+      nodes.erase(it);
+      return true;
+    }
+    if (EraseNode(it->children, id)) {
+      return true;
+    }
+  }
+  return false;
