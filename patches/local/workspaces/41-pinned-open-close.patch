+
+bool WorkspaceService::IsDrawnAsPinnedRow(
+    const tabs::TabInterface* tab) const {
+  const tabs::VerticalTabStripStateController* const vertical = VerticalTabs();
+  return IsPinItemTab(tab) && !(vertical && vertical->IsCollapsed());
+}
+
+int WorkspaceService::ListTabNear(int index, int delta) const {
+  std::vector<bool> selectable;
+  selectable.reserve(static_cast<size_t>(tab_strip_->count()));
+  for (int i = 0; i < tab_strip_->count(); ++i) {
+    // IsTabOnScreen, not IsTabVisible: the latter judges by tag, and a
+    // pinned tab has no tag, so a workspace holding one anchor and one
+    // pinned tab would find no fallback and spawn a blank tab beside a
+    // perfectly good neighbour (E10b). Not an open pinned page: it is not in
+    // the list, and landing there leaves the user on a page the list does not
+    // show (E15c review #3).
+    tabs::TabInterface* const tab = tab_strip_->GetTabAtIndex(i);
+    selectable.push_back(i != index && !tab_strip_->IsTabCollapsed(i) &&
+                         IsTabOnScreen(tab) && !IsDrawnAsPinnedRow(tab));
+  }
+  return NextVisibleTabIndex(selectable, index, delta);
+}
+
+void WorkspaceService::MoveOffPinnedPage() {
+  if (!IsDrawnAsPinnedRow(tab_strip_->GetActiveTab())) {
+    return;
+  }
+  const int index = tab_strip_->active_index();
+  const int target = ListTabNear(index, -1);
+  if (target != index) {
+    tab_strip_->ActivateTabAt(
+        target, TabStripUserGestureDetails(
+                    TabStripUserGestureDetails::GestureType::kOther));
+  }
+}
+
+void WorkspaceService::SetPinItem(tabs::TabInterface* tab, std::string id) {
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return;
+  }
+  WorkspaceTabData* const data =
+      WorkspaceTabData::GetOrCreateForWebContents(contents);
+  if (data->pin_item() == id) {
+    return;
+  }
+  data->set_pin_item(std::move(id));
+  PersistTag(contents);
+  LOG(INFO) << "[workspaces] pin item link -> '" << data->pin_item() << "'";
+  // The tab leaves or joins the list, so the strip must lay out again: the
+  // same reason, and the same callbacks, as SetTag().
+  workspace_changed_callbacks_.Notify();
+}
+
+bool WorkspaceService::ClosePinItemPage(tabs::TabInterface* tab,
+                                        const char* via) {
+  if (!IsPinItemTab(tab)) {
+    return false;
+  }
+  const int index = tab_strip_->GetIndexOfTab(tab);
+  if (index == TabStripModel::kNoTab) {
+    return false;
+  }
+  // Logged first: the close can destroy the tab.
+  LOG(INFO) << "[workspaces] closed the page of pinned item '"
+            << PinItemForTab(tab->GetContents()) << "' (" << via << ")";
+  // CLOSE_USER_GESTURE without CLOSE_CREATE_HISTORICAL_TAB: no Recently Closed
+  // entry. The unload listener still runs -- a real close is what asks.
+  tab_strip_->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE);
+  return true;
+}
