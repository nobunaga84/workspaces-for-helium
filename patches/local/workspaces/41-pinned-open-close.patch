+void WorkspacePinnedSectionView::OnItemPressed(const std::string& id) {
+  const PinNode* const item = store_ ? store_->Find(id) : nullptr;
+  if (!item || item->type != PinNode::Type::kItem) {
+    return;
+  }
+  const TabStripUserGestureDetails gesture(
+      TabStripUserGestureDetails::GestureType::kOther);
+  TabStripModel* const model = browser_->GetTabStripModel();
+  if (tabs::TabInterface* const tab = LinkedTab(model, id)) {
+    model->ActivateTabAt(model->GetIndexOfTab(tab), gesture);
+    return;
+  }
+  // One place: an item open in another window of this profile is shown
+  // there, not opened a second time here.
+  for (BrowserWindowInterface* const window :
+       WindowsOf(browser_->GetProfile())) {
+    TabStripModel* const other = window->GetTabStripModel();
+    if (tabs::TabInterface* const tab = LinkedTab(other, id)) {
+      other->ActivateTabAt(other->GetIndexOfTab(tab), gesture);
+      window->GetWindow()->Activate();
+      LOG(INFO) << "[workspaces] pins: item '" << id
+                << "' is open in another window; showed it there";
+      return;
+    }
+  }
+  OpenItem(*item, /*linked=*/true);
+}
