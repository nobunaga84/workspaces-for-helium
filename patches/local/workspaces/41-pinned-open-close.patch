+WorkspacePinnedSectionView::Links WorkspacePinnedSectionView::ReadLinks() {
+  Links links;
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  // Links are dormant while Workspaces is off, as anchors are (E10b): kept,
+  // and not judged.
+  if (!service || !service->IsEnabled() || !store_ || !store_->loaded()) {
+    return links;
+  }
+  TabStripModel* const model = browser_->GetTabStripModel();
+  links.active = model->GetActiveTab();
+  // A link to an item that is gone -- deleted, or a pins file that was set
+  // aside as broken -- or a second page of an item already open here (a window
+  // brought back from Recently Closed) is dropped: that page becomes an
+  // ordinary tab of the list. Never a hidden page nothing leads to (design 5).
+  // Not while the file is read-only: its rows are not in the tree then, but
+  // they are not gone, and a drop is persisted (E15c review #1).
+  const bool judge = !store_->read_only();
+  std::vector<tabs::TabInterface*> unlinked;
+  for (int i = 0; i < model->count(); ++i) {
+    tabs::TabInterface* const tab = model->GetTabAtIndex(i);
+    std::string id = workspaces::PinItemForTab(tab->GetContents());
+    // A favorite pinned while Workspaces was off keeps its link, unjudged:
+    // it is drawn at the top, not as its row (IsPinItemTab, review #6).
+    if (id.empty() || tab->IsPinned()) {
+      continue;
+    }
+    const PinNode* const item = store_->Find(id);
+    if ((!item || item->type != PinNode::Type::kItem) && !judge) {
+      continue;
+    }
+    if (!item || item->type != PinNode::Type::kItem ||
+        !links.open.emplace(std::move(id), tab).second) {
+      unlinked.push_back(tab);
+    }
+  }
+  for (tabs::TabInterface* const tab : unlinked) {
+    LOG(INFO) << "[workspaces] pins: a page's item is gone or already open; "
+                 "it is an ordinary tab now";
+    // The anchor OpenItem gave it goes too, as Unpin's does: an ordinary tab
+    // closes on Ctrl+W instead of going to sleep (E15c review #2).
+    service->SetPinItem(tab, std::string());
+    service->SetAnchored(tab, false);
+  }
+  return links;
+}
