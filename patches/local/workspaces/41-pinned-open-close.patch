+void WorkspacePinnedSectionView::ApplyStates(views::View& list,
+                                             const Links& links) {
+  for (views::View* const child : list.children()) {
+    auto* const row = views::AsViewClass<PinRow>(child);
+    const auto it = links.open.find(row->id());
+    if (it == links.open.end()) {
+      row->SetItemState(PinRow::ItemState::kSleeping, false);
+      continue;
+    }
+    row->SetItemState(it->second == links.active ? PinRow::ItemState::kActive
+                                                 : PinRow::ItemState::kOpen,
+                      workspaces::HasDrifted(it->second->GetContents()));
+  }
 }
 
