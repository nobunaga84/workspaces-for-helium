+#include "chrome/browser/ui/workspace_command_hooks.h"
+
+#include <string>
+
+#include "base/i18n/rtl.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/command_updater.h"
+#include "chrome/browser/ui/browser_shortcuts/browser_shortcut_metadata.h"
+#include "chrome/browser/ui/tabs/workspaces/workspace_service.h"
+#include "chrome/grit/generated_resources.h"
+
+namespace workspaces {
+
+namespace {
+
+using Label = browser_shortcuts::BrowserShortcutCommandLabel;
+
+// The fork's block of ids in chrome_command_ids.h, 34110-34139.
+constexpr int kFirstCommand = IDC_HELIUM_WORKSPACE_NEXT;
+constexpr int kLastCommand = IDC_HELIUM_WORKSPACE_NEXT + 29;
+
+}  // namespace
+
+bool ExecuteWorkspaceCommand(BrowserWindowInterface* browser, int id) {
+  switch (id) {
+    case IDC_HELIUM_WORKSPACE_NEXT:
+    case IDC_HELIUM_WORKSPACE_PREV: {
+      // Next and previous swap under RTL for the same reason Chromium's tab
+      // group commands do it: these are bound to arrow keys, and an arrow
+      // pointing at the start of the strip has to mean "previous" whichever
+      // way the strip runs.
+      const bool forward =
+          (id == IDC_HELIUM_WORKSPACE_NEXT) != base::i18n::IsRTL();
+      // Null on window types Workspaces does not apply to; doing nothing is
+      // the right answer there, not a crash.
+      if (WorkspaceService* service = WorkspaceService::From(browser)) {
+        service->ActivateRelativeWorkspace(forward ? 1 : -1);
+      }
+      break;
+    }
+    default:
+      return false;
+  }
+  return true;
+}
+
+void EnableWorkspaceCommands(CommandUpdater* updater) {
+  // One list to keep, WorkspaceShortcutLabel's: an id of the block is a
+  // command exactly when the shortcuts page names it, and the ids still
+  // reserved have no name, so they stay off.
+  for (int id = kFirstCommand; id <= kLastCommand; ++id) {
+    if (WorkspaceShortcutLabel(id)) {
+      updater->UpdateCommandEnabled(id, true);
+    }
+  }
+}
+
+std::optional<browser_shortcuts::BrowserShortcutCommandLabel>
+WorkspaceShortcutLabel(int id) {
+  switch (id) {
+    case IDC_HELIUM_WORKSPACE_NEXT:
+      return Label{IDS_SHORTCUT_COMMAND_HELIUM_WORKSPACE_NEXT};
+    case IDC_HELIUM_WORKSPACE_PREV:
+      return Label{IDS_SHORTCUT_COMMAND_HELIUM_WORKSPACE_PREVIOUS};
+    default:
+      return std::nullopt;
+  }
+}
+
+}  // namespace workspaces
