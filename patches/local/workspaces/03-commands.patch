+std::string RelativeWorkspaceGuid(const std::vector<std::string>& workspaces,
+                                  std::string_view active_guid,
+                                  int offset) {
+  if (workspaces.empty()) {
+    return std::string(kDefaultWorkspaceGuid);
+  }
+
+  const std::string_view effective_active =
+      active_guid.empty() ? kDefaultWorkspaceGuid : active_guid;
+
+  const int size = static_cast<int>(workspaces.size());
+  int index = 0;
+  for (int i = 0; i < size; ++i) {
+    if (workspaces[i] == effective_active) {
+      index = i;
+      break;
+    }
+  }
+
+  // In C++ the sign of a % b follows a, so (0 + -1) % 2 is -1 and would
+  // index off the front of the vector. Adding one more `size` before the
+  // second modulo makes the result non-negative for any offset.
+  const int target = ((index + offset) % size + size) % size;
+  return workspaces[target];
+}
+
 }  // namespace workspaces
