+// Switching wraps in both directions. Without this a user who reaches the
+// last workspace and keeps pressing Next simply stops moving, with no
+// feedback to explain why.
+TEST(WorkspaceRelativeTest, NextAndPreviousWrapAround) {
+  const std::vector<std::string> list = {"a", "b", "c"};
+  EXPECT_EQ("b", RelativeWorkspaceGuid(list, "a", 1));
+  EXPECT_EQ("a", RelativeWorkspaceGuid(list, "c", 1));
+  EXPECT_EQ("a", RelativeWorkspaceGuid(list, "b", -1));
+  EXPECT_EQ("c", RelativeWorkspaceGuid(list, "a", -1));
+}
+
+// The reason the modulo is written the way it is: the sign of a % b follows
+// a in C++, so a negative offset would index off the front of the vector.
+// Large offsets in both directions are checked because nothing stops a
+// future caller passing one.
+TEST(WorkspaceRelativeTest, LargeOffsetsStayInRange) {
+  const std::vector<std::string> list = {"a", "b", "c"};
+  EXPECT_EQ("b", RelativeWorkspaceGuid(list, "a", 4));
+  EXPECT_EQ("c", RelativeWorkspaceGuid(list, "a", -4));
+  EXPECT_EQ("a", RelativeWorkspaceGuid(list, "a", 300));
+  EXPECT_EQ("a", RelativeWorkspaceGuid(list, "a", -300));
+}
+
+// One workspace means every switch is a no-op, not a crash and not an empty
+// guid. This is first run, before anyone has made a second workspace.
+TEST(WorkspaceRelativeTest, SingleWorkspaceStaysPut) {
+  const std::vector<std::string> list = {std::string(kDefaultWorkspaceGuid)};
+  EXPECT_EQ(kDefaultWorkspaceGuid, RelativeWorkspaceGuid(list, "", 1));
+  EXPECT_EQ(kDefaultWorkspaceGuid,
+            RelativeWorkspaceGuid(list, kDefaultWorkspaceGuid, -1));
+}
+
+// An empty list cannot happen today, but the implicit default workspace is
+// what the whole design leans on when nothing else is known, so it is what
+// this returns rather than an empty string every caller would have to check.
+TEST(WorkspaceRelativeTest, EmptyListReturnsDefaultWorkspace) {
+  EXPECT_EQ(kDefaultWorkspaceGuid, RelativeWorkspaceGuid({}, "work", 1));
+}
+
+// An empty active guid means the default workspace here exactly as it does
+// in IsVisibleInWorkspace. If these two disagreed, a fresh window would
