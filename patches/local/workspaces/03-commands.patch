+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WORKSPACE_COMMAND_HOOKS_H_
+#define CHROME_BROWSER_UI_WORKSPACE_COMMAND_HOOKS_H_
+
+#include <optional>
+
+class BrowserWindowInterface;
+class CommandUpdater;
+
+namespace browser_shortcuts {
+struct BrowserShortcutCommandLabel;
+}
+
+// Helium Workspaces: the fork's browser commands, its block of ids in
+// chrome_command_ids.h. BrowserCommandController and the shortcut metadata
+// each ask these in one call, so a rebase that rewrites Chromium's lists of
+// commands moves a line, never a block of cases (review #16). Built in
+// browser_command_controller.cc's own target, so these reach what it reaches.
+namespace workspaces {
+
+// HandleCommandWithDisposition: runs `id` and returns true when it is one of
+// the fork's commands; false leaves it to Chromium's switch.
+bool ExecuteWorkspaceCommand(BrowserWindowInterface* browser, int id);
+
+// InitCommandState: every id of the fork's block that WorkspaceShortcutLabel
+// names. Not optional: an id that is never enabled is silently dropped by
+// CommandUpdater, so the accelerator would fire and nothing would happen.
+void EnableWorkspaceCommands(CommandUpdater* updater);
+
+// GetBrowserShortcutCommandLabel: the name the Settings shortcuts page shows
+// for one of the fork's commands; nullopt for every other id.
+std::optional<browser_shortcuts::BrowserShortcutCommandLabel>
+WorkspaceShortcutLabel(int id);
+
+}  // namespace workspaces
+
+#endif  // CHROME_BROWSER_UI_WORKSPACE_COMMAND_HOOKS_H_
