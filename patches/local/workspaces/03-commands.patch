+
+  // Lay out again whenever this window's Workspace changes. The visibility
+  // predicate in UnpinnedTabContainerViewLayout is re-read on every layout,
+  // so an invalidation is the whole of what a switch needs -- and it has to
+  // be an invalidation rather than cached state, because switching
+  // kHeliumLayout destroys and rebuilds this view entirely.
+  //
+  // Both ends of this already exist by the time we get here, which is the
+  // part worth checking rather than assuming: TabCollectionNode::
+  // AddNewChild() gives a node its controller before it builds the node's
+  // view, and WorkspaceService is older still -- browser.cc creates
+  // BrowserWindowFeatures before the browser window exists at all, and says
+  // so in a comment. If either were not yet built, subscribing here would
+  // fail silently, and switching would look like a broken predicate rather
+  // than missing wiring.
+  if (TabStripCollectionController* controller =
+          collection_node_->GetController()) {
+    workspace_changed_subscription_ =
+        controller->RegisterWorkspaceChangedCallback(base::BindRepeating(
+            &views::View::InvalidateLayout, base::Unretained(this),
+            /*avoid_propagate_during_layout=*/false));
+  }
