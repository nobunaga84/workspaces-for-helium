+std::vector<tabs::TabHandle> WorkspaceService::TabsToClose(
+    std::string_view guid,
+    int* pinned_kept) const {
+  // Pinned tabs are skipped: they have no tag, and no tag resolves to the
+  // default workspace, so "Close all tabs" on Home closed every pinned tab
+  // until E13. A pinned tab belongs to every workspace (design 2.5), the
+  // same rule UnloadWorkspaceTabs applies below.
+  std::vector<tabs::TabHandle> doomed;
+  for (int i = 0; i < tab_strip_->count(); ++i) {
+    tabs::TabInterface* tab = tab_strip_->GetTabAtIndex(i);
+    if (!tab || !IsTabOfWorkspace(tab, guid)) {
+      continue;
+    }
+    if (tab->IsPinned()) {
+      if (pinned_kept) {
+        ++*pinned_kept;
+      }
+      continue;
+    }
+    doomed.push_back(tab->GetHandle());
+  }
+  return doomed;
+}
+
+int WorkspaceService::CountTabsToClose(std::string_view guid) const {
+  return static_cast<int>(TabsToClose(guid, nullptr).size());
+}
