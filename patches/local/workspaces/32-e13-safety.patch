+void WorkspaceRailView::ShowCloseConfirmBubble(const std::string& guid,
+                                               int count,
+                                               bool deleting) {
+  // Logged when asked and when cancelled, so a test can tell "asked, then
+  // cancelled, nothing closed" from "never asked".
+  LOG(INFO) << "[workspaces] confirm asked: "
+            << (deleting ? "delete" : "close all") << " of workspace '" << guid
+            << "', " << count << " tab(s)";
+  auto on_accept = base::BindOnce(
+      [](base::WeakPtr<WorkspaceRailView> self, const std::string& guid,
+         bool deleting) {
+        workspaces::WorkspaceService* const service =
+            self ? workspaces::WorkspaceService::From(self->browser_) : nullptr;
+        if (!service) {
+          return;
+        }
+        if (deleting) {
+          service->DeleteWorkspace(guid);
+        } else {
+          service->CloseWorkspaceTabs(guid);
+        }
+      },
+      weak_factory_.GetWeakPtr(), guid, deleting);
+
+  std::unique_ptr<ui::DialogModel> model =
+      ui::DialogModel::Builder()
+          .SetTitle(l10n_util::GetPluralStringFUTF16(
+              deleting ? IDS_HELIUM_WORKSPACE_CONFIRM_DELETE
+                       : IDS_HELIUM_WORKSPACE_CONFIRM_CLOSE_ALL,
+              count))
+          .AddParagraph(ui::DialogModelLabel(
+              l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_CONFIRM_BODY)))
+          .AddOkButton(std::move(on_accept),
+                       ui::DialogModel::Button::Params().SetLabel(
+                           l10n_util::GetStringUTF16(
+                               deleting ? IDS_HELIUM_WORKSPACE_DELETE
+                                        : IDS_HELIUM_WORKSPACE_CLOSE_ALL)))
+          .AddCancelButton(base::BindOnce(
+              [] { LOG(INFO) << "[workspaces] confirm cancelled"; }))
+          .Build();
+
+  // Anchored to the rail, like the name bubble below.
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(model), this, views::BubbleBorder::TOP_LEFT);
+  views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET)
+      ->Show();
+}
