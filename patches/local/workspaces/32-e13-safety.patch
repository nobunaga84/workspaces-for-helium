+// Whether any live frame of `contents` has a beforeunload handler -- the page
+// asks "Leave site?" before it is closed. Not NeedToFireBeforeUnloadOrUnload
+// Events(): that is also true for unload / pagehide / visibilitychange
+// handlers, which nearly every page with analytics has, and would make this
+// true almost everywhere.
+bool AsksBeforeLeaving(content::WebContents* contents) {
+  if (!contents) {
+    return false;
+  }
+  bool asks = false;
+  contents->GetPrimaryMainFrame()->ForEachRenderFrameHost(
+      [&asks](content::RenderFrameHost* frame) {
+        asks |= frame->IsRenderFrameLive() &&
+                frame->GetSuddenTerminationDisablerState(
+                    blink::mojom::SuddenTerminationDisablerType::
+                        kBeforeUnloadHandler);
+      });
+  return asks;
+}
