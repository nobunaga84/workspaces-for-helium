+std::vector<std::string> DueToWake(const std::vector<ArchiveEntry>& entries,
+                                   base::Time now) {
+  std::vector<const ArchiveEntry*> due;
+  for (const ArchiveEntry& entry : entries) {
+    if (entry.snoozed() && entry.wake_at <= now) {
+      due.push_back(&entry);
+    }
+  }
+  std::ranges::stable_sort(due, {}, &ArchiveEntry::wake_at);
+  std::vector<std::string> ids;
+  ids.reserve(due.size());
+  for (const ArchiveEntry* const entry : due) {
+    ids.push_back(entry->id);
+  }
+  return ids;
+}
