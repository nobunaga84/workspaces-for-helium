+std::optional<base::TimeDelta> SnoozeDelay(std::u16string_view amount,
+                                           SnoozeUnit unit) {
+  int count = 0;
+  if (!base::StringToInt(base::TrimWhitespace(amount, base::TRIM_ALL),
+                         &count) ||
+      count < 1) {
+    return std::nullopt;
+  }
+  base::TimeDelta one;
+  switch (unit) {
+    case SnoozeUnit::kMinutes:
+      one = base::Minutes(1);
+      break;
+    case SnoozeUnit::kHours:
+      one = base::Hours(1);
+      break;
+    case SnoozeUnit::kDays:
+      one = base::Days(1);
+      break;
+    case SnoozeUnit::kWeeks:
+      one = base::Days(7);
+      break;
+  }
+  // Checked before multiplying, so a huge number never becomes a huge span.
+  if (count > kLongestSnooze / one) {
+    return std::nullopt;
+  }
+  return one * count;
+}
