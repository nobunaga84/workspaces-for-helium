+void WorkspaceRailView::WakeSnoozedTabs() {
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service || !service->IsEnabled()) {
+    return;
+  }
+  // One window wakes: the profile's with Workspaces activated last -- the
+  // walk a new window takes for its workspace (InitialWorkspace, E15e).
+  BrowserWindowInterface* last_used = nullptr;
+  ProfileBrowserCollection::GetForProfile(browser_->GetProfile())
+      ->ForEach(
+          [&last_used](BrowserWindowInterface* other) {
+            if (!workspaces::WorkspaceService::From(other)) {
+              return true;
+            }
+            last_used = other;
+            return false;
+          },
+          BrowserCollection::Order::kActivation);
+  // Not while this window closes -- the page would close with it, its entry
+  // spent -- nor under a drag, whose tabs an insert would move: the
+  // auto-archive's two rules (review).
+  const DesktopBrowserWindowCapabilities* const capabilities =
+      browser_->capabilities();
+  TabStripModel* const model = browser_->GetTabStripModel();
+  if (last_used != browser_ || !capabilities ||
+      capabilities->IsAttemptingToCloseBrowser() ||
+      !model->delegate()->IsTabStripEditable()) {
+    return;
+  }
+  Profile* const profile = browser_->GetProfile();
+  const workspaces::archive::ArchiveStore* const store =
+      workspaces::archive::ArchiveStore::GetOrCreate(profile,
+                                                     profile->GetPath());
+  if (!store->loaded() || store->read_only()) {
+    return;
+  }
+  const std::vector<std::string> due =
+      workspaces::archive::DueToWake(store->entries(), base::Time::Now());
+  if (due.empty()) {
+    return;
+  }
+  size_t woke = 0;
+  // The latest first: each goes to the top, so the soonest ends there and
+  // Today reads in wake order, as the Archive's Snoozed rows do (review).
+  for (const std::string& id : std::views::reverse(due)) {
+    if (tabs::TabInterface* const tab =
+            WorkspaceArchiveView::Wake(browser_, id)) {
+      woken_.push_back(tab->GetHandle());
+      ++woke;
     }
   }
+  LOG(INFO) << "[workspaces] snooze: woke " << woke << " of " << due.size()
+            << " due tab(s)";
+  ScheduleUpdateBadges();
 }
 
