+namespace {
+
+using workspaces::archive::kSnoozeHours;
+using workspaces::archive::SnoozeUnit;
+
+// One item per hour of kSnoozeHours, then Custom..., in the registry range
+// ExistingBaseSubMenuModel keeps (LOCAL.md 21).
+constexpr int kFirstHours =
+    ExistingBaseSubMenuModel::kMinWorkspaceSnoozeCommandId;
+constexpr int kHourItems = static_cast<int>(std::size(kSnoozeHours));
+constexpr int kCustom = kFirstHours + kHourItems;
+
+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kSnoozeAmountFieldId);
+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kSnoozeUnitFieldId);
+
+// The tabs the menu acts on: the selection when the right-clicked tab is part
+// of it, else that tab alone -- Chromium's tab-menu rule, spelled out as
+// ExistingWorkspaceSubMenuModel spells it (GetIndicesForCommand is private).
+std::vector<tabs::TabInterface*> TargetTabs(TabStripModel* tab_strip,
+                                            int context_index) {
+  std::vector<tabs::TabInterface*> tabs;
+  if (!tab_strip->ContainsIndex(context_index)) {
+    return tabs;
+  }
+  if (tab_strip->IsTabSelected(context_index)) {
+    for (tabs::TabInterface* tab :
+         tab_strip->selection_model().selected_tabs()) {
+      if (tab) {
+        tabs.push_back(tab);
+      }
+    }
+  } else {
+    tabs.push_back(tab_strip->GetTabAtIndex(context_index));
+  }
+  return tabs;
+}
+
+// When a snooze of `delay` made now wakes -- or, with the hidden test switch,
+// that many seconds from now whatever was chosen.
+base::Time WakeTime(base::TimeDelta delay) {
+  int seconds = 0;
+  if (base::StringToInt(
+          base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+              workspaces::archive::kSnoozeTestSecondsSwitch),
+          &seconds) &&
+      seconds > 0) {
+    delay = base::Seconds(seconds);
+  }
+  return base::Time::Now() + delay;
+}
+
+// Snoozes the ones of `handles` still open, through their window's service.
+// They are one window's -- the menu's -- and one that moved to another window
+// meanwhile is skipped by its CloseTabs(), which looks for it in its own strip.
+void SnoozeLiveTabs(const std::vector<tabs::TabHandle>& handles,
+                    base::Time wake_at) {
+  std::vector<tabs::TabInterface*> tabs;
+  for (const tabs::TabHandle& handle : handles) {
+    if (tabs::TabInterface* const tab = handle.Get()) {
+      tabs.push_back(tab);
+    }
+  }
+  workspaces::WorkspaceService* const service =
+      tabs.empty() ? nullptr
+                   : workspaces::WorkspaceService::From(
+                         tabs.front()->GetBrowserWindowInterface());
+  if (service) {
+    service->SnoozeTabs(tabs, wake_at);
+  }
+}
+
+// Custom...'s box. Holds the tabs by handle: the menu that opened it is gone
+// by OK time, and a tab may have closed meanwhile.
+class SnoozeDialogDelegate : public ui::DialogModelDelegate {
+ public:
+  explicit SnoozeDialogDelegate(std::vector<tabs::TabHandle> tabs)
+      : tabs_(std::move(tabs)) {}
+
+  // OK: false -- the box stays open -- for a number SnoozeDelay refuses.
+  bool OnAccepted() {
+    const std::optional<base::TimeDelta> delay =
+        workspaces::archive::SnoozeDelay(
+            dialog_model()->GetTextfieldByUniqueId(kSnoozeAmountFieldId)->text(),
+            static_cast<SnoozeUnit>(
+                dialog_model()
+                    ->GetComboboxByUniqueId(kSnoozeUnitFieldId)
+                    ->selected_index()));
+    if (!delay) {
+      LOG(INFO) << "[workspaces] snooze: custom amount refused";
+      return false;
+    }
+    // What was typed, before WakeTime's test switch replaces it.
+    LOG(INFO) << "[workspaces] snooze: custom " << delay->InSeconds() << " s";
+    // Posted: the box can sit on one of the tabs this closes, and is still
+    // closing when this returns.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&SnoozeLiveTabs, tabs_, WakeTime(*delay)));
+    return true;
+  }
+
+ private:
+  const std::vector<tabs::TabHandle> tabs_;
+};
+
+// Custom...: the box on the tab in front, which is where a tab-modal box shows
+// (WebContentsModalDialogManager) -- not on the right-clicked tab, which would
+// have to be activated first and lose the selection. Its title counts the
+// tabs, so the box says what it acts on.
+void ShowCustomSnoozeDialog(TabStripModel* tab_strip,
+                            const std::vector<tabs::TabInterface*>& tabs) {
+  content::WebContents* const host = tab_strip->GetActiveWebContents();
+  if (!host || tabs.empty()) {
+    return;
+  }
+  std::vector<tabs::TabHandle> handles;
+  for (tabs::TabInterface* const tab : tabs) {
+    handles.push_back(tab->GetHandle());
+  }
+  // In SnoozeUnit's order: its index is the unit.
+  std::vector<ui::SimpleComboboxModel::Item> units;
+  for (const int id :
+       {IDS_HELIUM_WORKSPACE_SNOOZE_MINUTES, IDS_HELIUM_WORKSPACE_SNOOZE_HOURS,
+        IDS_HELIUM_WORKSPACE_SNOOZE_DAYS, IDS_HELIUM_WORKSPACE_SNOOZE_WEEKS}) {
+    units.emplace_back(l10n_util::GetStringUTF16(id));
+  }
+  auto delegate = std::make_unique<SnoozeDialogDelegate>(std::move(handles));
+  SnoozeDialogDelegate* const delegate_ptr = delegate.get();
+  constrained_window::ShowWebModal(
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(l10n_util::GetPluralStringFUTF16(
+              IDS_HELIUM_WORKSPACE_SNOOZE_TITLE,
+              static_cast<int>(tabs.size())))
+          .AddParagraph(ui::DialogModelLabel(
+              IDS_HELIUM_WORKSPACE_SNOOZE_CUSTOM_HINT))
+          .AddOkButton(base::BindRepeating(&SnoozeDialogDelegate::OnAccepted,
+                                           base::Unretained(delegate_ptr)),
+                       ui::DialogModel::Button::Params().SetLabel(
+                           l10n_util::GetStringUTF16(
+                               IDS_HELIUM_WORKSPACE_SNOOZE_OK)))
+          .AddCancelButton(base::DoNothing())
+          .AddTextfield(kSnoozeAmountFieldId,
+                        l10n_util::GetStringUTF16(
+                            IDS_HELIUM_WORKSPACE_SNOOZE_AMOUNT),
+                        u"30", ui::DialogModelTextfield::Params())
+          .AddCombobox(
+              kSnoozeUnitFieldId,
+              l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_SNOOZE_UNIT),
+              std::make_unique<ui::SimpleComboboxModel>(std::move(units)))
+          .SetInitiallyFocusedField(kSnoozeAmountFieldId)
+          .Build(),
+      host);
+  LOG(INFO) << "[workspaces] snooze: custom box for " << tabs.size()
+            << " tab(s)";
+}
+
+}  // namespace
+
+WorkspaceSnoozeSubMenuModel::WorkspaceSnoozeSubMenuModel(
+    BrowserWindowInterface* browser,
+    TabStripModel* tab_strip,
+    int context_index)
+    : ui::SimpleMenuModel(this),
+      browser_(browser),
+      tab_strip_(tab_strip),
+      context_index_(context_index) {
+  // The time each choice wakes at, as the menu opens: "In 3 hours (5:40 PM)".
+  const base::Time now = base::Time::Now();
+  for (int i = 0; i < kHourItems; ++i) {
+    AddItem(kFirstHours + i,
+            base::StrCat({l10n_util::GetPluralStringFUTF16(
+                              IDS_HELIUM_WORKSPACE_SNOOZE_IN_HOURS,
+                              kSnoozeHours[i]),
+                          u" (",
+                          base::TimeFormatTimeOfDay(
+                              now + base::Hours(kSnoozeHours[i])),
+                          u")"}));
+  }
+  AddItemWithStringId(kCustom, IDS_HELIUM_WORKSPACE_SNOOZE_CUSTOM);
+}
+
+WorkspaceSnoozeSubMenuModel::~WorkspaceSnoozeSubMenuModel() = default;
+
+// static
+bool WorkspaceSnoozeSubMenuModel::ShouldShowSubmenu(
+    BrowserWindowInterface* browser,
+    TabStripModel* tab_strip,
+    int context_index) {
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser);
+  if (!service) {
+    return false;
+  }
+  return std::ranges::any_of(
+      TargetTabs(tab_strip, context_index),
+      [service](tabs::TabInterface* tab) { return service->CanSnooze(tab); });
+}
+
+void WorkspaceSnoozeSubMenuModel::ExecuteCommand(int command_id,
+                                                 int event_flags) {
+  const std::vector<tabs::TabInterface*> tabs =
+      TargetTabs(tab_strip_, context_index_);
+  if (command_id == kCustom) {
+    ShowCustomSnoozeDialog(tab_strip_, tabs);
+    return;
+  }
+  const int i = command_id - kFirstHours;
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service || i < 0 || i >= kHourItems) {
+    return;
+  }
+  // From the menu, outside every observer: the close is legal here.
+  service->SnoozeTabs(tabs, WakeTime(base::Hours(kSnoozeHours[i])));
+}
