+int WorkspaceService::SnoozeTabs(const std::vector<tabs::TabInterface*>& tabs,
+                                 base::Time wake_at) {
+  // A read-only archive refuses every entry: the close would leave nothing to
+  // wake (review). Before the load it is not read-only, and Add() holds.
+  Profile* const profile = browser_window_->GetProfile();
+  if (archive::ArchiveStore::GetOrCreate(profile, profile->GetPath())
+          ->read_only()) {
+    LOG(INFO) << "[workspaces] snooze: refused, the archive is read-only";
+    return 0;
+  }
+  // Only this window's tabs: CloseTabs() closes none of another's, and a mark
+  // left on an open tab would file its next ordinary close as a snooze
+  // (review: a tab dragged away before Custom...'s posted task).
+  std::vector<tabs::TabHandle> snoozed;
+  for (tabs::TabInterface* const tab : tabs) {
+    if (CanSnooze(tab) &&
+        tab_strip_->GetIndexOfTab(tab) != TabStripModel::kNoTab) {
+      snoozed.push_back(tab->GetHandle());
+    }
+  }
+  if (snoozed.empty()) {
+    LOG(INFO) << "[workspaces] snooze: nothing that can be snoozed ("
+              << tabs.size() << " asked)";
+    return 0;
+  }
+  if (std::ssize(snoozed) >= tab_strip_->count()) {
+    LOG(INFO) << "[workspaces] snooze: refused, it would close every tab of "
+                 "the window";
+    return 0;
+  }
+  // Marked before any close: a close can show the next tab, and only the
+  // marked ones file a wake time (AddToArchive).
+  for (const tabs::TabHandle& handle : snoozed) {
+    WorkspaceTabData::GetOrCreateForWebContents(handle.Get()->GetContents())
+        ->set_snooze_until(wake_at);
+  }
+  LOG(INFO) << "[workspaces] snooze: " << snoozed.size() << " of "
+            << tabs.size() << " tab(s), waking in "
+            << (wake_at - base::Time::Now()).InSeconds() << " s";
+  return CloseTabs(std::move(snoozed));
+}
