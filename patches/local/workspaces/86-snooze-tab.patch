+
+class BrowserWindowInterface;
+class TabStripModel;
+
+// C33 "Snooze tab" (c33-progress.md): the tab-menu submenu that files the
+// right-clicked tab -- or the selection it is part of -- in the Archive with a
+// wake time, and closes it (WorkspaceService::SnoozeTabs): "In 2 hours" ...
+// "In 11 hours" (the owner's primes 2, 3, 5, 7, 11), each with the time it
+// wakes, or Custom..., a tab-modal box with a whole number and a unit
+// (minutes, hours, days, weeks). The window used last wakes it at the top of
+// its workspace's Today (WorkspaceRailView). Its own delegate, like the anchor
+// submenu, so TabStripModel needs no command plumbing beyond the parent id.
+class WorkspaceSnoozeSubMenuModel : public ui::SimpleMenuModel,
+                                    public ui::SimpleMenuModel::Delegate {
+ public:
+  WorkspaceSnoozeSubMenuModel(BrowserWindowInterface* browser,
+                              TabStripModel* tab_strip,
+                              int context_index);
+  WorkspaceSnoozeSubMenuModel(const WorkspaceSnoozeSubMenuModel&) = delete;
+  WorkspaceSnoozeSubMenuModel& operator=(const WorkspaceSnoozeSubMenuModel&) =
+      delete;
+  ~WorkspaceSnoozeSubMenuModel() override;
+
+  // Shown only when a tab it would act on can be snoozed
+  // (WorkspaceService::CanSnooze): never on a favorite, a pinned page, an
+  // anchored tab or a split's half alone, and never with Workspaces off.
+  static bool ShouldShowSubmenu(BrowserWindowInterface* browser,
+                                TabStripModel* tab_strip,
+                                int context_index);
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<TabStripModel> tab_strip_;
+  const int context_index_;
+};
+
+#endif  // CHROME_BROWSER_UI_TABS_WORKSPACE_SNOOZE_SUB_MENU_MODEL_H_
