+// static
+void WorkspaceRailView::ClearToday(BrowserWindowInterface* browser) {
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser);
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser);
+  if (!service || !service->IsEnabled() || !browser_view) {
+    return;
+  }
+  // A copy: the close below switches nothing, but the confirm outlives this.
+  const std::string guid = service->active_guid();
+  const int count = service->CountTabsToClose(guid, /*today_only=*/true);
+  LOG(INFO) << "[workspaces] shortcut: clear Today, " << count << " tab(s)";
+  if (count <= kRecentlyClosedLimit) {
+    service->CloseWorkspaceTabs(guid, /*today_only=*/true);
+    return;
+  }
+  ShowCloseConfirm(
+      browser_view->contents_container(), views::BubbleBorder::FLOAT,
+      "clear Today", guid, count, /*deleting=*/false,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserWindowInterface> browser,
+             const std::string& guid) {
+            if (workspaces::WorkspaceService* const service =
+                    browser ? workspaces::WorkspaceService::From(browser.get())
+                            : nullptr) {
+              service->CloseWorkspaceTabs(guid, /*today_only=*/true);
+            }
+          },
+          browser->GetWeakPtr(), guid));
 }
 
