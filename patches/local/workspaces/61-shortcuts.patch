+void WorkspacePinnedSectionView::TogglePin(BrowserWindowInterface* browser) {
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser);
+  tabs::TabInterface* const tab = browser->GetTabStripModel()->GetActiveTab();
+  if (!service || !service->IsEnabled() || !tab) {
+    return;
+  }
+  if (service->IsPinItemTab(tab)) {
+    Profile* const profile = browser->GetProfile();
+    workspaces::pins::PinStore* const store =
+        workspaces::pins::PinStore::GetOrCreate(profile, profile->GetPath());
+    const std::string id = workspaces::PinItemForTab(tab->GetContents());
+    if (const PinNode* const item = store->Find(id);
+        item && item->type == PinNode::Type::kItem) {
+      UnlinkItem(browser, *store, id, /*index=*/-1, std::nullopt);
+    }
+    return;
+  }
+  if (!CanPin(*service, tab)) {
+    LOG(INFO) << "[workspaces] shortcut: pin -- the page in front cannot be "
+                 "pinned (a favorite, in a group or a split, or not a web "
+                 "page)";
+    return;
+  }
+  PinTabs(browser, {tab});
+}
