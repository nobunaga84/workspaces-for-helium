+      // Moved while still linked, THEN unlinked: the list scrolls to an active
+      // tab that moves, but not to a pinned page's (TabStripView::OnTabChanged,
+      // E15c), so it stays where it is (the owner, E15d). A page's tab never
+      // sits in a group, and the top of the list is the first tab of a unit,
+      // so that move joins no group (GetGroupToAssign looks at the new
+      // neighbours). A drop into a group is told which group: the drop's
+      // place is inside it or at its first tab, so the group stays whole.
+      const bool dropped_here = window == here && index >= 0;
+      const int from = model->GetIndexOfTab(tab);
+      const int to =
+          dropped_here ? index : service->TopOfListIndex(/*opener=*/nullptr);
+      const int final_index = from < to ? to - 1 : to;
+      if (dropped_here && group) {
+        model->MoveWebContentsAt(from, final_index,
+                                 /*select_after_move=*/false, group);
+      } else if (to >= 0 && final_index != from) {
+        model->MoveWebContentsAt(from, final_index,
+                                 /*select_after_move=*/false);
+      }
+      service->SetPinItem(tab, std::string());
+      service->SetAnchored(tab, false);
+    }
+  }
+  store.Remove(id);
+  LOG(INFO) << "[workspaces] pins: unpinned item '" << id << "'"
+            << (index >= 0 ? " (dropped in the list)" : "");
+}
