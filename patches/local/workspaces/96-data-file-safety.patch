+std::optional<std::string> WithoutClearedEntries(std::string_view export_json,
+                                                 base::Time since) {
+  ParseResult parsed = ParseExport(export_json);
+  if (!parsed.value || !parsed.value->archive) {
+    return std::nullopt;
+  }
+  Export& file = *parsed.value;
+  if (std::erase_if(*file.archive,
+                    [since](const archive::ArchiveEntry& entry) {
+                      return archive::IsClearedBy(entry, since);
+                    }) == 0) {
+    return std::nullopt;
+  }
+  return BuildExport(file.prefs, file.pins ? &*file.pins : nullptr,
+                     &*file.archive, file.exported_at, file.source);
+}
+
+void ClearBackups(const base::FilePath& folder, base::Time since) {
+  int rewritten = 0;
+  base::FileEnumerator files(folder, /*recursive=*/false,
+                             base::FileEnumerator::FILES, kBackupPattern);
+  for (base::FilePath file = files.Next(); !file.empty(); file = files.Next()) {
+    std::string text;
+    if (!base::ReadFileToString(file, &text)) {
+      continue;
+    }
+    std::optional<std::string> cleared = WithoutClearedEntries(text, since);
+    if (!cleared) {
+      continue;
+    }
+    if (base::ImportantFileWriter::WriteFileAtomically(file, *cleared,
+                                                       "WorkspaceTransfer")) {
+      ++rewritten;
+    } else {
+      LOG(WARNING) << "[workspaces] backups: could not rewrite " << file;
+    }
+  }
+  LOG(INFO) << "[workspaces] backups: " << rewritten
+            << " before-import cop(ies) cleared too";
+}
