+  ArchiveEntry snoozed = later;
+  snoozed.id = "e3";
+  snoozed.wake_at = later.archived_at + base::Days(1);
+  entries.push_back(later);
+  entries.push_back(snoozed);
+  const std::string text =
+      BuildExport(Prefs(), &tree, &entries, kExportedAt, "test");
+
+  const std::optional<std::string> cleared =
+      WithoutClearedEntries(text, later.archived_at);
+  ASSERT_TRUE(cleared);
+  ParseResult result = ParseExport(*cleared);
+  ASSERT_TRUE(result.value) << result.error;
+  ASSERT_TRUE(result.value->archive);
+  std::vector<std::string> ids;
+  for (const ArchiveEntry& entry : *result.value->archive) {
+    ids.push_back(entry.id);
