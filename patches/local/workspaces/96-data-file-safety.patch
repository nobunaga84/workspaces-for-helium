+  EXPECT_EQ(result.value->exported_at, kExportedAt);
+  EXPECT_EQ(result.value->source, "test");
+
+  // Nothing in the range, no Archive, not an export: left alone.
+  EXPECT_FALSE(WithoutClearedEntries(*cleared, later.archived_at));
+  EXPECT_FALSE(WithoutClearedEntries(
