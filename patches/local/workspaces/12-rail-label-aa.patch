+// A rail button, with the one line that keeps it from crashing a DCHECK build.
+//
+// TopContainerButton's constructor calls SetPaintToLayer() and then
+// layer()->SetFillsBoundsOpaquely(false). Upstream it is an ICON button --
+// CalculatePreferredSize() is a fixed square that ignores its text -- so its
+// Label never has anything to draw and nothing ever looked at that layer.
+//
+// Put text on it and views::Label's subpixel-antialiasing path walks up the
+// view tree for something opaque to draw onto, finds a transparent layer first,
+// and DCHECKs (ui/views/controls/label.cc:955, "we must paint to an opaque
+// layer"). In a release build the DCHECK compiles out and the rail renders
+// fine, which is why E9a and E9b both verified clean on screen. In a DCHECK
+// build it is FATAL at startup, so out/Dcheck could not launch at all from E9a
+// until this landed -- found 2026-09-12 the first time it was exercised.
+//
+// Grayscale antialiasing is the right answer regardless: subpixel AA over a
+// transparent layer has no fixed background to sample, which is exactly what
+// the DCHECK is complaining about.
+class WorkspaceRailButton : public TopContainerButton {
+  METADATA_HEADER(WorkspaceRailButton, TopContainerButton)
+
+ public:
+  WorkspaceRailButton() {
+    // A subclass rather than one line at the call site, because
+    // views::LabelButton::label() is PROTECTED -- reaching the label from
+    // outside does not compile, and there is no setter for this on the button.
+    label()->SetSubpixelRenderingEnabled(false);
+  }
+  WorkspaceRailButton(const WorkspaceRailButton&) = delete;
+  WorkspaceRailButton& operator=(const WorkspaceRailButton&) = delete;
+  ~WorkspaceRailButton() override = default;
+};
+
+// Required even for a one-file helper view: views::View::AddChildView<T>
+// static_asserts that T implements metadata, so a subclass without these does
+// not compile at the call site rather than at its declaration.
+BEGIN_METADATA(WorkspaceRailButton)
+END_METADATA
+
+std::unique_ptr<WorkspaceRailButton> MakeRailButton(
+    const std::u16string& text,
+    const std::u16string& tooltip,
+    views::Button::PressedCallback callback) {
+  auto button = std::make_unique<WorkspaceRailButton>();
+  button->SetText(text);
+  button->SetTooltipText(tooltip);
+  button->SetCallback(std::move(callback));
+  return button;
+}
