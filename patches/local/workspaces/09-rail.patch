+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/vertical/workspace_rail_view.h"
+
+#include <stddef.h>
+
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/browser/ui/tabs/workspaces/workspace_prefs.h"
+#include "chrome/browser/ui/tabs/workspaces/workspace_service.h"
+#include "chrome/browser/ui/views/tabs/vertical/top_container_button.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/views/layout/layout_types.h"
+
+namespace {
+
+// What a workspace's button says.
+//
+// TopContainerButton is a fixed square -- CalculatePreferredSize returns
+// kVerticalTabStripCollapseButtonSize both ways -- so this has to be one
+// character, not a name. That is also the only shape that survives the strip
+// being collapsed to an icon rail, which is the state the rail has to work in
+// as much as the expanded one.
+//
+// The title's first character if there is a title, otherwise the workspace's
+// position in the list, which is the same number Shift+Alt+arrow counts
+// through. The full name is in the tooltip either way.
+std::u16string LabelForWorkspace(const workspaces::prefs::WorkspaceEntry& entry,
+                                 size_t index) {
+  const std::u16string title = base::UTF8ToUTF16(entry.title);
+  if (title.empty()) {
+    return base::NumberToString16(static_cast<int>(index) + 1);
+  }
+
+  // One character means one code point, not one UTF-16 unit. Half a surrogate
+  // pair renders as a replacement glyph, and a title can already be an emoji
+  // today -- local/set-workspaces-pref.py takes whatever it is given, and the
+  // emoji field design 2.4 plans for does not exist yet, so an emoji name is
+  // the obvious thing for someone to try first.
+  const bool is_lead_surrogate = (title[0] & 0xFC00) == 0xD800;
+  return title.substr(0, is_lead_surrogate && title.size() > 1 ? 2 : 1);
+}
+
+// The full name, or the guid when there is no name. The guid is chosen by hand
+// in this build (local/set-workspaces-pref.py), so it is a real answer rather
+// than a placeholder -- and it is better than a localised "Workspace 2", which
+// would mean a string resource in generated_resources.grd, one of the hottest
+// files in the tree, for a name E9b is about to make editable anyway.
+std::u16string TooltipForWorkspace(
+    const workspaces::prefs::WorkspaceEntry& entry) {
+  return base::UTF8ToUTF16(entry.title.empty() ? entry.guid : entry.title);
+}
+
+}  // namespace
+
+WorkspaceRailView::WorkspaceRailView(
+    BrowserWindowInterface* browser,
+    tabs::VerticalTabStripStateController* state_controller)
+    : browser_(browser) {
+  // Hidden until AddedToWidget() has looked at the list. Starting hidden rather
+  // than starting shown and hiding later is what keeps a profile that never
+  // opts in from seeing the rail flash on at startup.
+  SetVisible(false);
+
+  if (state_controller) {
+    OnCollapseStateChanged(state_controller->GetCollapseState());
+    collapse_changed_subscription_ = state_controller->RegisterOnCollapseChanged(
+        base::BindRepeating(&WorkspaceRailView::OnCollapseStateChanged,
+                            base::Unretained(this)));
+  }
+}
+
+WorkspaceRailView::~WorkspaceRailView() = default;
+
+void WorkspaceRailView::AddedToWidget() {
+  views::FlexLayoutView::AddedToWidget();
+
+  // base::Unretained is safe both times: the subscription is a member, so it is
+  // cancelled when this view is destroyed, and the service's callback list
+  // binds a weak pointer of its own so a service that dies first is also fine
+  // (workspace_service.h).
+  if (workspaces::WorkspaceService* service =
+          workspaces::WorkspaceService::From(browser_)) {
+    workspace_changed_subscription_ = service->RegisterWorkspaceChangedCallback(
+        base::BindRepeating(&WorkspaceRailView::UpdateHighlight,
+                            base::Unretained(this)));
+  }
+
+  Rebuild();
+}
+
+void WorkspaceRailView::Rebuild() {
+  RemoveAllChildViews();
+  buttons_.clear();
+  guids_.clear();
+
+  workspaces::WorkspaceService* service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service || !service->IsEnabled()) {
+    SetVisible(false);
+    return;
+  }
+
+  const std::vector<workspaces::prefs::WorkspaceEntry> entries =
+      service->GetWorkspaces();
+
+  // One workspace is not a switcher. Design 5 wants stock Helium to stay stock
+  // until someone opts in, and a rail offering a single destination is worse
+  // than no rail: it takes space at the bottom of the strip to say nothing.
+  if (entries.size() < 2) {
+    SetVisible(false);
+    return;
+  }
+
+  for (size_t i = 0; i < entries.size(); ++i) {
+    auto button = std::make_unique<TopContainerButton>();
+    button->SetText(LabelForWorkspace(entries[i], i));
+    button->SetTooltipText(TooltipForWorkspace(entries[i]));
+    button->SetCallback(
+        base::BindRepeating(&WorkspaceRailView::OnWorkspacePressed,
+                            base::Unretained(this), entries[i].guid));
+
+    guids_.push_back(entries[i].guid);
+    buttons_.push_back(AddChildView(std::move(button)));
+  }
+
+  SetVisible(true);
+  UpdateHighlight();
+}
+
+void WorkspaceRailView::UpdateHighlight() {
+  const workspaces::WorkspaceService* service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service) {
+    return;
+  }
+
+  // SetHighlighted rather than a colour of our own: it is the ink-drop
+  // highlight Chromium already uses for "this button's thing is the one that is
+  // currently up", so it follows the theme, dark mode and the strip's own
+  // colours without this file naming a single ui::ColorId.
+  const std::string& active_guid = service->active_guid();
+  for (size_t i = 0; i < buttons_.size(); ++i) {
+    buttons_[i]->SetHighlighted(guids_[i] == active_guid);
+  }
+}
+
+void WorkspaceRailView::OnWorkspacePressed(const std::string& guid) {
+  workspaces::WorkspaceService* service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!service) {
+    return;
+  }
+
+  // SwitchToWorkspace and not SetActiveWorkspace: this moves the user onto a
+  // tab they can see, which is a TabStripModel mutation and therefore only
+  // legal outside the observer scope (design 2.2). A button press is delivered
+  // from the message loop, so this is as safe a caller as the command handler
+  // the method was written for.
+  service->SwitchToWorkspace(guid);
+}
+
+void WorkspaceRailView::OnCollapseStateChanged(
+    tabs::VerticalTabStripCollapseState state) {
+  // Follows the parent container: a row beside the new tab button when the
+  // strip is expanded, a column under it when the strip is an icon rail. Taking
+  // this from the controller rather than from the container is what keeps
+  // vertical_tab_strip_bottom_container.h out of this patch entirely.
+  const bool collapsed = state != tabs::VerticalTabStripCollapseState::kExpanded;
+  SetOrientation(collapsed ? views::LayoutOrientation::kVertical
+                           : views::LayoutOrientation::kHorizontal);
+}
