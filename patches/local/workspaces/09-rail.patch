+class BrowserWindowInterface;
+class TopContainerButton;
+
+namespace tabs {
+class VerticalTabStripStateController;
+enum class VerticalTabStripCollapseState;
+}  // namespace tabs
+
+// The workspace switcher: one button per workspace, at the bottom of the
+// vertical tab strip beside the new tab button (design 5, and the owner request
+// recorded there on 2026-09-10).
+//
+// Read-only in this build. It shows the workspaces and switches between them;
+// creating, renaming, deleting and reordering arrive with the context menu in
+// E9b, and until then the list is edited with local/set-workspaces-pref.py.
+//
+// STOCK HELIUM STAYS STOCK. The rail hides itself entirely when there is one
+// workspace or when Workspaces is switched off, so a profile that never opts in
+// sees the tab strip it had before (design 5, "hide the rail entirely when there
+// is one workspace"). A hidden view is what that has to mean rather than an
+// absent one: the container lays out whatever children it has, and
+// IsPositionInWindowCaption already skips invisible children when deciding what
+// is draggable window caption.
+//
+// This view knows nothing about prefs or tab strips. It asks WorkspaceService
+// for the list and tells it to switch; everything else is the service's
+// (design 3.1).
+class WorkspaceRailView : public views::FlexLayoutView {
+  METADATA_HEADER(WorkspaceRailView, views::FlexLayoutView)
+
+ public:
+  // `state_controller` is the vertical strip's own, and is subscribed to
+  // directly rather than being driven by the parent container.
+  //
+  // That is deliberate and it is what keeps this feature out of
+  // vertical_tab_strip_bottom_container.h entirely: driving the rail from
+  // VerticalTabStripBottomContainer::UpdateButtonStyles would have cost a
+  // forward declaration, a raw_ptr member and a third hunk, all of them inside
+  // hunks layout/vertical.patch already owns (LOCAL.md 1).
+  WorkspaceRailView(BrowserWindowInterface* browser,
+                    tabs::VerticalTabStripStateController* state_controller);
+  WorkspaceRailView(const WorkspaceRailView&) = delete;
+  WorkspaceRailView& operator=(const WorkspaceRailView&) = delete;
+  ~WorkspaceRailView() override;
+
+  // views::View:
+  //
+  // The rail is built here rather than in the constructor. WorkspaceService is
+  // reached through BrowserWindowInterface, and its answer to IsEnabled()
+  // depends on the vertical-tab-strip controller being up; being in a widget is
+  // the cheapest moment that is certainly after all of that, and it needs no
+  // subscription of its own. Switching kHeliumLayout destroys and rebuilds the
+  // whole view tree (design 2.7), so this runs again on the way back to
+  // vertical.
+  void AddedToWidget() override;
+
+ private:
+  // Throws the buttons away and makes them again from the current list, then
+  // decides whether the rail is shown at all.
+  void Rebuild();
+
+  // Moves the highlight to the workspace now being shown. Cheap enough to run
+  // on every switch, and it is the only thing a switch changes here -- the
+  // list itself cannot change in this build.
+  void UpdateHighlight();
+
+  void OnWorkspacePressed(const std::string& guid);
+
+  void OnCollapseStateChanged(tabs::VerticalTabStripCollapseState state);
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+
+  // Parallel to `buttons_`: the guid each button switches to. Held separately
+  // because a button carries no workspace identity of its own, and binding the
+  // guid into the pressed callback is not enough -- UpdateHighlight() has to
+  // ask, per button, "is this the active one".
+  std::vector<std::string> guids_;
+  std::vector<raw_ptr<TopContainerButton>> buttons_;
+
+  base::CallbackListSubscription workspace_changed_subscription_;
+  base::CallbackListSubscription collapse_changed_subscription_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_WORKSPACE_RAIL_VIEW_H_
