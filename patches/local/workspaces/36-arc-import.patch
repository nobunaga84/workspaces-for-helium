+WorkspaceArcImporter::WorkspaceArcImporter(BrowserWindowInterface* browser)
+    : browser_(browser) {}
+
+WorkspaceArcImporter::~WorkspaceArcImporter() = default;
+
+void WorkspaceArcImporter::Start(DoneCallback done) {
+  if (running_) {
+    return;
+  }
+  running_ = true;
+  done_ = std::move(done);
+  result_ = Result();
+  window_ = nullptr;
+  items_.clear();
+  next_item_ = 0;
+  color_ = 0;
+  LOG(INFO) << "[workspaces] arc import: reading";
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&ReadAndParse, ArcSidebarPath()),
+      base::BindOnce(&WorkspaceArcImporter::OnPlanReady,
+                     weak_factory_.GetWeakPtr(), base::Time::Now()));
+}
+
+void WorkspaceArcImporter::OnPlanReady(base::Time started,
+                                       std::optional<ArcImportPlan> plan) {
+  // A reply to a posted task, so outside every observer: inserting is legal.
+  started_ = started;
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  Profile* const profile = browser_->GetProfile();
+  if (!plan || !service || !service->IsEnabled() || !profile) {
+    LOG(INFO) << "[workspaces] arc import: nothing imported ("
+              << (plan ? "workspaces unavailable" : "no readable Arc sidebar")
+              << ")";
+    Finish();
+    return;
+  }
+  result_.found = true;
+  prefs_ = profile->GetPrefs();
+
+  // A re-run adds only what Arc gained since the last one (owner's choice,
+  // LOCAL.md 39): a tab closed or archived here since then stays gone.
+  const ArcImportPlan todo = workspaces::arc_import::KeepCreatedAfter(
+      *std::move(plan),
+      prefs_->GetTime(workspaces::prefs::kHeliumWorkspacesArcImportedAt));
+  result_.skipped = todo.skipped;
+
+  // The plan, flattened into the order the strip gets it: favorites first,
+  // while the strip is short (a pinned insert is the one insert here that is
+  // not at the very end), then each workspace's pinned units, then its Today
+  // units. A folder's group id is made here and travels with its items, so a
+  // group may straddle slices: a later tab with the same id is inserted into
+  // the group's range, which stays contiguous.
+  for (const ArcTab& tab : todo.favorites) {
+    items_.push_back(Item{{tab}, std::string(), std::nullopt, std::string(),
+                          /*pin=*/true});
+  }
+  for (const ArcWorkspace& workspace : todo.workspaces) {
+    if (workspace.pinned.empty() && workspace.today.empty()) {
+      continue;  // a re-run with nothing new: no empty workspace appears
+    }
+    // Never CreateWorkspace(): it switches, and spawns a loaded tab.
+    const std::string guid =
+        service->EnsureWorkspaceForImport(workspace.title, workspace.icon);
+    ++result_.workspaces;
+    for (const std::vector<ArcUnit>* units :
+         {&workspace.pinned, &workspace.today}) {
+      for (const ArcUnit& unit : *units) {
+        std::optional<tab_groups::TabGroupId> group;
+        if (!unit.group_title.empty()) {
+          group = tab_groups::TabGroupId::GenerateNew();
+        }
+        const size_t first = items_.size();
+        for (const ArcItem& item : unit.items) {
+          items_.push_back(
+              Item{item.tabs, guid, group, std::string(), /*pin=*/false});
+        }
+        if (group && items_.size() > first) {
+          items_.back().group_title_to_apply = unit.group_title;
+        }
+      }
+    }
+  }
+  for (const Item& item : items_) {
+    result_.planned += static_cast<int>(item.tabs.size());
+  }
+  LOG(INFO) << "[workspaces] arc import: start: " << result_.planned
+            << " tab(s) planned";
+
+  // Imported tabs live in the session file and nowhere else. The Windows
+  // default for "On startup" is the New Tab page, which would drop them all
+  // at the next launch (LOCAL.md 37).
+  if (SessionStartupPref::GetStartupPref(profile).type !=
+      SessionStartupPref::LAST) {
+    SessionStartupPref::SetStartupPref(
+        profile, SessionStartupPref(SessionStartupPref::LAST));
+    result_.startup_changed = true;
+  }
+
+  // This window, held weakly: a slice may run after the user closed it.
+  window_ = browser_->GetWeakPtr();
+  ImportSlice();
+}
+
+void WorkspaceArcImporter::ImportSlice() {
+  // Closing the window is how an import is cancelled: whatever arrived went
+  // with it, and the import time is not recorded, so the next run starts over
+  // rather than skipping what was lost.
+  BrowserWindowInterface* const window = window_.get();
+  TabStripModel* const model = window ? window->GetTabStripModel() : nullptr;
+  if (!model || window->IsDeleteScheduled() || model->closing_all()) {
+    result_.aborted = true;
+    window_ = nullptr;
+    LOG(INFO) << "[workspaces] arc import: window closed after "
+              << result_.tabs << " tab(s); stopped";
+    Finish();
+    return;
+  }
+
+  base::ElapsedTimer timer;
+  bool first = true;
+  while (next_item_ < items_.size() &&
+         (first || timer.Elapsed() < kSliceBudget)) {
+    first = false;
+    const Item& item = items_[next_item_++];
+    std::vector<content::WebContents*> made;
+    for (const ArcTab& tab : item.tabs) {
+      if (content::WebContents* const contents =
+              AddSleepingTab(window, tab, item.guid, item.group, item.pin)) {
+        made.push_back(contents);
+        ++result_.tabs;
+      } else {
+        ++result_.skipped;
+      }
+    }
+    if (item.group && !made.empty() &&
+        !std::ranges::contains(groups_made_, *item.group)) {
+      groups_made_.push_back(*item.group);
+    }
+    // RestoreSplit, not AddToNewSplit: no promo, no metrics, and it is what
+    // lazy session restore uses between two sleeping tabs.
+    if (item.tabs.size() == 2 && made.size() == 2) {
+      const int a = model->GetIndexOfWebContents(made[0]);
+      const int b = model->GetIndexOfWebContents(made[1]);
+      if (a != TabStripModel::kNoTab && b == a + 1) {
+        model->RestoreSplit(split_tabs::SplitTabId::GenerateNew(), {a, b},
+                            split_tabs::SplitTabVisualData());
+        ++result_.splits;
+      }
+    }
+    // Named and collapsed after its last tab, the order session restore uses:
+    // adding a tab to a collapsed group expands it again (TabGroupView). A
+    // group made through AddRestoredTab is not a saved group until someone
+    // says so, and M153 expects every group to be one (a restart would save
+    // it anyway): the same pairing as BrowserLiveTabContext::AddRestoredTab,
+    // once per group. Saved groups as built -- owner, 2026-09-22 (design 5).
+    if (!item.group_title_to_apply.empty() && item.group &&
+        std::ranges::contains(groups_made_, *item.group)) {
+      model->ChangeTabGroupVisuals(
+          *item.group,
+          tab_groups::TabGroupVisualData(
+              base::UTF8ToUTF16(item.group_title_to_apply),
+              static_cast<tab_groups::TabGroupColorId>(
+                  color_++ %
+                  static_cast<int>(tab_groups::TabGroupColorId::kNumEntries)),
+              /*is_collapsed=*/true));
+      if (tab_groups::TabGroupSyncService* const saved_groups =
+              tab_groups::TabGroupSyncServiceFactory::GetForProfile(
+                  window->GetProfile());
+          saved_groups && !saved_groups->GetGroup(*item.group).has_value()) {
+        saved_groups->SaveGroup(
+            tab_groups::SavedTabGroupUtils::CreateSavedTabGroupFromLocalId(
+                *item.group));
+      }
+      ++result_.groups;
+    }
+  }
+
+  LOG(INFO) << "[workspaces] arc import: " << result_.tabs << " of "
+            << result_.planned << " tab(s)";
+  if (next_item_ >= items_.size()) {
+    Finish();
+    return;
+  }
+  SetStatus(l10n_util::GetStringFUTF16(
+      IDS_HELIUM_WORKSPACE_IMPORT_ARC_PROGRESS, base::FormatNumber(result_.tabs),
+      base::FormatNumber(result_.planned)));
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&WorkspaceArcImporter::ImportSlice,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void WorkspaceArcImporter::SetStatus(const std::u16string& text) {
+  BrowserWindowInterface* const window = window_.get();
+  BrowserUiController* const ui = window ? BrowserUiController::From(window)
+                                         : nullptr;
+  if (!ui) {
+    return;
+  }
+  for (StatusBubble* bubble : ui->GetStatusBubbles()) {
+    bubble->SetStatus(text);
+  }
+}
+
+void WorkspaceArcImporter::Finish() {
+  SetStatus(std::u16string());
+  if (result_.found && !result_.aborted && prefs_) {
+    // `started_`, not now: a tab Arc gains while this runs must count as new.
+    prefs_->SetTime(workspaces::prefs::kHeliumWorkspacesArcImportedAt,
+                    started_);
+  }
+  result_.elapsed = base::Time::Now() - started_;
+  if (result_.found) {
+    LOG(INFO) << "[workspaces] arc import: done: " << result_.tabs << " tab(s), "
+              << result_.groups << " group(s), " << result_.splits
+              << " split(s), " << result_.workspaces << " workspace(s), "
+              << result_.skipped << " skipped, startup "
+              << (result_.startup_changed ? "set to continue" : "unchanged")
+              << ", " << result_.elapsed.InMilliseconds() << " ms"
+              << (result_.aborted ? ", aborted" : "");
+  }
+  running_ = false;
+  prefs_ = nullptr;
+  items_.clear();
+  groups_made_.clear();
+  if (done_) {
+    std::move(done_).Run(result_);
+  }
+}
