+
+class BrowserWindowInterface;
+class PrefService;
+
+// "Import from Arc...": turns an ArcImportPlan (E14b) into sleeping tabs in the
+// window whose rail was clicked (design 5, E14 spec). A new window was built,
+// rehearsed and withdrawn the same day: closed before the original, it left the
+// session, and the next launch restored the original alone (LOCAL.md 40). Not
+// a view. It lives
+// beside the rail, its only caller, because chrome::AddRestoredTab belongs to
+// //chrome/browser/ui, which the workspaces target can never depend on (E10a),
+// and this directory already reaches it the way the rail reaches
+// browser_commands.h.
+//
+// Every tab is created through the session-restore door: no renderer, not
+// loaded until clicked, and tagged with its workspace, anchor and custom title
+// BEFORE it is inserted, through the extra-data hook 08 put there -- a tag
+// written after the insert would be a change, and a relayout, per tab.
+//
+// The tabs arrive in SLICES: posted tasks of a few dozen milliseconds each,
+// so the window paints, scrolls and answers between them and the status line
+// at its bottom-left counts up. One synchronous loop froze the window for
+// 324 s on the owner's 3,873 tabs (LOCAL.md 40). Each slice re-checks that the
+// window is still there; closing it is how an import is cancelled.
+class WorkspaceArcImporter {
+ public:
+  struct Result {
+    // False when Arc's file is missing, unreadable or not a sidebar.
+    bool found = false;
+    // The window was closed before the import finished.
+    bool aborted = false;
+    int tabs = 0;
+    int planned = 0;
+    int groups = 0;
+    int splits = 0;
+    int workspaces = 0;
+    // Left out: no web URL (counted by the parser) or an unusable one.
+    int skipped = 0;
+    // "On startup" was switched to "Continue where you left off". Without it
+    // the imported tabs would not come back after a restart.
+    bool startup_changed = false;
+    base::TimeDelta elapsed;
+  };
+  using DoneCallback = base::OnceCallback<void(const Result&)>;
+
+  explicit WorkspaceArcImporter(BrowserWindowInterface* browser);
+  WorkspaceArcImporter(const WorkspaceArcImporter&) = delete;
+  WorkspaceArcImporter& operator=(const WorkspaceArcImporter&) = delete;
+  ~WorkspaceArcImporter();
+
+  // True from Start() until `done` has run: the file is read off-thread and
+  // the tabs arrive over many tasks, and a second click must not start a
+  // second import.
+  bool running() const { return running_; }
+
+  // Only from a menu or command handler: it ends in TabStripModel inserts
+  // (design 2.2). `done` runs on this sequence, never if `this` is destroyed.
+  void Start(DoneCallback done);
+
+ private:
+  // One thing the strip takes as a whole: a tab, or a split view's two tabs,
+  // with everything AddRestoredTab needs to place it.
+  struct Item {
+    std::vector<workspaces::arc_import::ArcTab> tabs;
+    std::string guid;  // the workspace; empty only for a pinned favorite
+    std::optional<tab_groups::TabGroupId> group;
+    // Set on a group's last item: name and collapse the group after it.
+    std::string group_title_to_apply;
+    bool pin = false;
+  };
+
+  void OnPlanReady(base::Time started,
+                   std::optional<workspaces::arc_import::ArcImportPlan> plan);
+  void ImportSlice();
+  void Finish();
+  void SetStatus(const std::u16string& text);
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  // The same window, as a WeakPtr: a slice may run after it was closed.
+  base::WeakPtr<BrowserWindowInterface> window_;
+  bool running_ = false;
+  DoneCallback done_;
+  Result result_;
+  base::Time started_;
+  raw_ptr<PrefService> prefs_ = nullptr;
+  std::vector<Item> items_;
+  size_t next_item_ = 0;
+  // Groups that received at least one tab: only these exist in the model.
+  // A vector: TabGroupId has no ordering, and there are a few dozen.
+  std::vector<tab_groups::TabGroupId> groups_made_;
+  int color_ = 0;
+  base::WeakPtrFactory<WorkspaceArcImporter> weak_factory_{this};
+};
+
