+// The owner's file is 8 MB. A cap, because it is read whole into memory and
+// comes from outside the profile.
+constexpr size_t kMaxSidebarBytes = 64 * 1024 * 1024;
+
+// How long one slice may keep the UI thread. Long enough that a slice does
+// real work, short enough that the window keeps painting between slices.
+constexpr base::TimeDelta kSliceBudget = base::Milliseconds(40);
+
+// HELIUM_ARC_SIDEBAR overrides the path: a copy of the file, a smaller one for
+// a rehearsal, or Arc's location on another OS. The same variable points the
+// parser's real-file test at a file (LOCAL.md 39).
+base::FilePath ArcSidebarPath() {
+  if (std::optional<std::string> path =
+          base::Environment::Create()->GetVar("HELIUM_ARC_SIDEBAR")) {
+    return base::FilePath::FromUTF8Unsafe(*path);
+  }
+#if BUILDFLAG(IS_WIN)
+  // The exact name, never a glob: Arc keeps dated StorableSidebar.*.json
+  // backups beside it.
+  base::FilePath local_app_data;
+  if (base::PathService::Get(base::DIR_LOCAL_APP_DATA, &local_app_data)) {
+    return local_app_data.AppendASCII("Packages")
+        .AppendASCII("TheBrowserCompany.Arc_ttt1ap7aakyb4")
+        .AppendASCII("LocalCache")
+        .AppendASCII("Local")
+        .AppendASCII("Arc")
+        .AppendASCII("StorableSidebar.json");
+  }
+#endif
+  return base::FilePath();
+}
+
+// On the thread pool: the read blocks, and the parsed tree (which includes a
+// sync copy of the sidebar nobody uses) lives and dies here. Only the plan
+// crosses back. Arc may be running; the read does not lock the file.
+std::optional<ArcImportPlan> ReadAndParse(const base::FilePath& path) {
+  std::string json;
+  if (path.empty() ||
+      !base::ReadFileToStringWithMaxSize(path, &json, kMaxSidebarBytes)) {
+    return std::nullopt;
+  }
+  return workspaces::arc_import::ParseArcSidebarJson(json);
+}
+
+// One sleeping tab, tagged before it is inserted. ALWAYS appended (a pinned
+// one at the end of the pinned run): the session service re-records every
+// tab after an insert point, so an append is O(1) and anything else is O(n).
+content::WebContents* AddSleepingTab(BrowserWindowInterface* window,
+                                     const ArcTab& tab,
+                                     const std::string& guid,
+                                     std::optional<tab_groups::TabGroupId> group,
+                                     bool pin) {
+  const GURL url(tab.url);
+  if (!url.is_valid()) {
+    return nullptr;
+  }
+  sessions::SerializedNavigationEntry navigation;
+  navigation.set_index(0);
+  navigation.set_virtual_url(url);
+  navigation.set_title(base::UTF8ToUTF16(tab.title));
+
+  std::map<std::string, std::string> extra_data;
+  if (!guid.empty()) {
+    extra_data[workspaces::kWorkspaceExtraDataKey] = guid;
+  }
+  if (tab.anchored) {
+    // The same spec as the entry's URL, or the tab reads as drifted.
+    extra_data[workspaces::kAnchorUrlExtraDataKey] = url.spec();
+  }
+  if (!tab.custom_title.empty()) {
+    extra_data[workspaces::kCustomTitleExtraDataKey] = tab.custom_title;
+  }
+
+  // Only a Today tab carries its age: it is what auto-archive will count
+  // from (E14d). The session service persists it from here on. The ticks
+  // formula is session restore's own.
+  base::Time last_active;
+  base::TimeTicks last_active_ticks;
+  const base::Time now = base::Time::Now();
+  if (!tab.anchored && !pin && !tab.last_active.is_null() &&
+      tab.last_active <= now) {
+    last_active = tab.last_active;
+    last_active_ticks = base::TimeTicks::Now() - (now - last_active);
+  }
+
+  TabStripModel* const model = window->GetTabStripModel();
+  return chrome::AddRestoredTab(
+      window, base::span_from_ref(navigation),
+      pin ? model->IndexOfFirstNonPinnedTab() : model->count(),
+      /*selected_navigation=*/0, /*extension_app_id=*/std::string(), group,
+      /*select=*/false, pin, last_active_ticks, last_active,
+      /*storage_namespace=*/nullptr, sessions::SerializedUserAgentOverride(),
+      extra_data, /*from_session_restore=*/false,
+      /*is_active_browser=*/std::nullopt,
+      chrome::RestoredTabLoadPolicy::kDeferUntilActivation);
+}
