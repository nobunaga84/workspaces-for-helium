+void WorkspaceRailView::OnArcImportDone(
+    const WorkspaceArcImporter::Result& result) {
+  ui::DialogModel::Builder builder;
+  if (!result.found) {
+    builder.SetTitle(
+        l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_IMPORT_ARC_NOT_FOUND));
+  } else {
+    // Two strings, two placeholder counts: GetStringFUTF16 checks them.
+    builder.SetTitle(
+        result.aborted
+            ? l10n_util::GetStringFUTF16(IDS_HELIUM_WORKSPACE_IMPORT_ARC_ABORTED,
+                                         base::FormatNumber(result.tabs),
+                                         base::FormatNumber(result.planned))
+            : l10n_util::GetStringFUTF16(IDS_HELIUM_WORKSPACE_IMPORT_ARC_DONE,
+                                         base::FormatNumber(result.tabs)));
+    builder.AddParagraph(ui::DialogModelLabel(l10n_util::GetStringFUTF16(
+        IDS_HELIUM_WORKSPACE_IMPORT_ARC_DETAILS,
+        base::NumberToString16(result.groups),
+        base::NumberToString16(result.skipped))));
+    if (result.startup_changed) {
+      builder.AddParagraph(ui::DialogModelLabel(l10n_util::GetStringUTF16(
+          IDS_HELIUM_WORKSPACE_IMPORT_ARC_STARTUP)));
+    }
+  }
+  builder.AddOkButton(base::DoNothing());
+
+  // Anchored to the rail, like the confirm bubble above.
