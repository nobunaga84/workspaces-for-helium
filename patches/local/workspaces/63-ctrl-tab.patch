+  // Null for a tab never left in a window that has a service: a service-less
+  // window's MRU order is then stock, by last-active time alone.
+  const workspaces::WorkspaceTabData* const data =
+      workspaces::WorkspaceTabData::FromWebContents(tab->GetContents());
+  return data ? data->left_at() : base::Time();
+}
