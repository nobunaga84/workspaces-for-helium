+bool BrowserTabStripModelDelegate::IsTabCycleStop(
+    const tabs::TabInterface* tab) const {
+  // The question above without its last clause (C2): an open pinned page of
+  // the workspace on screen IS a stop for Ctrl+Tab, as in Arc -- inside a
+  // closed folder too (D4), where the peek row draws it once it is in front
+  // (C12). IsTabVisible() answers by tag, so another workspace's tabs and
+  // pinned pages stay out. Favorites and service-less windows as above.
+  if (tab && tab->IsPinned()) {
+    return true;
+  }
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  return !service || service->IsTabVisible(tab);
+}
