+void SelectMRUTab(TabStripModel* model,
+                  std::vector<int>* cycle,
+                  bool next,
+                  TabStripUserGestureDetails detail) {
+  // As SelectRelativeTab: buffered key presses can arrive after the last tab
+  // went, and GetWebContentsAt(0) below would CHECK.
+  if (model->empty()) {
+    return;
+  }
+
+  // The list holds tab HANDLES, never indices (D1). Brave's raw indices went
+  // stale on the first close or move inside one Ctrl hold: Ctrl held, Tab, W,
+  // Tab activated an index past the end and CHECK-crashed. Built from EVERY
+  // tab of the window: MRU crosses workspaces, as Arc's does (design 3.6, the
+  // owner's answer), so no IsTabCycleStop here.
+  if (cycle->empty()) {
+    BrowserWindowInterface* browser =
+        GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+            model->GetWebContentsAt(0));
+    if (!browser) {
+      return;
+    }
+
+    // The order (D2): the active tab first, then the tabs the user LEFT, the
+    // latest leave first, then the tabs never left, by last-active time. Not
+    // last-active time alone: a tab opened in the background keeps its
+    // creation time, so it outranked the page used a moment before and the
+    // first Ctrl+Tab landed on it. Each value read ONCE, and one clock per
+    // rank, so the comparison is a strict weak ordering.
+    // Walked with the iterator, not GetTabAtIndex(i): an index lookup walks
+    // the collection, and the Arc import put 3,862 tabs in one window.
+    // Brave's comparator looked both tabs up by index on every comparison.
+    struct Entry {
+      int rank = 2;  // 0 the active tab, 1 left, 2 never left.
+      base::Time left_at;
+      base::TimeTicks last_active;
+      int32_t handle = 0;
+    };
+    std::vector<Entry> entries;
+    entries.reserve(model->count());
+    const tabs::TabInterface* const active_tab = model->GetActiveTab();
+    for (tabs::TabInterface* tab : *model) {
+      Entry entry;
+      entry.handle = tab->GetHandle().raw_value();
+      entry.left_at = model->delegate()->GetTabLeftTime(tab);
+      if (tab == active_tab) {
+        entry.rank = 0;
+      } else if (!entry.left_at.is_null()) {
+        entry.rank = 1;
+      } else {
+        entry.last_active = tab->GetContents()->GetLastActiveTimeTicks();
+      }
+      entries.push_back(entry);
+    }
+    std::sort(entries.begin(), entries.end(),
+              [](const Entry& a, const Entry& b) {
+                if (a.rank != b.rank) {
+                  return a.rank < b.rank;
+                }
+                return a.rank == 1 ? a.left_at > b.left_at
+                                   : a.last_active > b.last_active;
+              });
+    for (const Entry& entry : entries) {
+      cycle->push_back(entry.handle);
+    }
+
+    if (BrowserView* browser_view =
+            BrowserView::GetBrowserViewForBrowser(browser)) {
+      browser_view->StartTabCycling();
+    }
+    // StartTabCycling() replaces the Ctrl-release handler. When an older one
+    // is still live (the list emptied by the prune below while Ctrl stayed
+    // down), destroying it runs StopTabCycling() -> StopMRUCycling(), which
+    // clears the list just built (D1). This press then does nothing; the
+    // next one finds no handler and starts clean. Never clear the list
+    // mid-cycle for the same reason.
+    if (cycle->empty()) {
+      return;
+    }
+  }
+
+  // Every press: drop the tabs closed, or moved to another window, since the
+  // list was built -- BEFORE the rotate, so the press never lands on one.
+  // owning_model() rather than GetIndexOfTab() == kNoTab: the same answer
+  // without a walk of the collection per entry, and the very test
+  // ActivateTab() CHECKs below.
+  std::erase_if(*cycle, [model](int handle) {
+    const tabs::TabInterface* const tab = tabs::TabHandle(handle).Get();
+    return !tab ||
+           static_cast<const tabs::TabModel*>(tab)->owning_model() != model;
+  });
+  if (cycle->empty()) {
+    return;
+  }
+
+  // D17: start the step from the tab on screen. After a Ctrl+W mid-hold the
+  // model activated a tab of its own choosing, which is not the list's
+  // front; stepping from the front would skip it, or land back on it.
+  if (const tabs::TabInterface* const active = model->GetActiveTab()) {
+    if (auto it = std::ranges::find(*cycle, active->GetHandle().raw_value());
+        it != cycle->end()) {
+      std::rotate(cycle->begin(), it, cycle->end());
+    } else {
+      // A tab made during the hold (a New Tab the close spawned, Ctrl+T)
+      // joins the cycle at the front, so the step still starts from it
+      // (code review); the prune drops it like any other once it closes.
+      cycle->insert(cycle->begin(), active->GetHandle().raw_value());
+    }
+  }
+
+  if (next) {
+    std::rotate(cycle->begin(), cycle->begin() + 1, cycle->end());
+  } else {
+    std::rotate(cycle->rbegin(), cycle->rbegin() + 1, cycle->rend());
+  }
+
+  model->ActivateTab(tabs::TabHandle(cycle->front()).Get(), detail);
+}
