+
+class BrowserWindowInterface;
+
+namespace tabs {
+class VerticalTabStripStateController;
+enum class VerticalTabStripCollapseState;
+}  // namespace tabs
+
+// The pinned section of the workspace this window shows (design 5, E15 spec):
+// its folders and items, above today's tabs and scrolling with them. Read-only
+// in E15b -- a folder opens and closes, an item is a row that opens nothing
+// yet (E15c).
+//
+// The rows are the pins file's data, not tabs: a closed folder makes no rows
+// for what it holds, so a 1,159-item folder costs one row until it is opened,
+// and nothing is ever loaded to draw one. Plain LabelButtons, no layer each.
+//
+// Made by TabStripCollectionController for every vertical strip of a regular
+// profile, and mounted by the one hunk in TabStripView::AddScrollViewContents.
+// It hides itself while Workspaces is off, while the strip is collapsed, and
+// while the workspace has no pinned rows.
+class WorkspacePinnedSectionView
+    : public views::View,
+      public workspaces::pins::PinStore::Observer {
+  METADATA_HEADER(WorkspacePinnedSectionView, views::View)
+
+ public:
+  WorkspacePinnedSectionView(
+      BrowserWindowInterface* browser,
+      tabs::VerticalTabStripStateController* state_controller);
+  WorkspacePinnedSectionView(const WorkspacePinnedSectionView&) = delete;
+  WorkspacePinnedSectionView& operator=(const WorkspacePinnedSectionView&) =
+      delete;
+  ~WorkspacePinnedSectionView() override;
+
+  // views::View:
+  //
+  // Subscribes here rather than in the constructor, as the rail does: being
+  // in a widget is certainly after the window's WorkspaceService and the
+  // vertical strip's controller are up.
+  void AddedToWidget() override;
+  void RemovedFromWidget() override;
+  void OnThemeChanged() override;
+  // Never wider than it is given: a long title elides, it does not widen the
+  // strip. The height is the rows', measured once per rebuild.
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+
+  // workspaces::pins::PinStore::Observer:
+  void OnPinsChanged() override;
+
+ private:
+  // Every change goes through a posted Rebuild(), never a direct one: a folder
+  // row's own click changes the store, and rebuilding inside that click would
+  // delete the button while its click handler is still running. Posting also
+  // folds several changes in one task into one rebuild.
+  void ScheduleRebuild();
+  void Rebuild();
+  // Adds `row` to `list`, then its children if it is an open folder. Returns
+  // how many rows that made.
+  size_t AddRow(views::View& list,
+                const workspaces::pins::PinNode& row,
+                int level,
+                bool frame_active);
+  void OnFolderPressed(const std::string& id);
+  void OnCollapseChanged(tabs::VerticalTabStripCollapseState state);
+  // Whether the window paints as active: the rows dim with the tabs when not.
+  bool IsFrameActive() const;
+  void UpdateRowColors();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<tabs::VerticalTabStripStateController> state_controller_;
+  // The profile's; outlives every window's views.
+  raw_ptr<workspaces::pins::PinStore> store_ = nullptr;
+  base::ScopedObservation<workspaces::pins::PinStore,
+                          workspaces::pins::PinStore::Observer>
+      store_observation_{this};
+  base::CallbackListSubscription workspace_changed_subscription_;
+  base::CallbackListSubscription workspace_list_changed_subscription_;
+  base::CallbackListSubscription collapse_changed_subscription_;
+  base::CallbackListSubscription paint_as_active_subscription_;
+  // The rows' container, made by each Rebuild(); every child is a row.
+  raw_ptr<views::View> list_ = nullptr;
+  // CalculatePreferredSize()'s answer until the next rebuild or theme change.
+  mutable std::optional<int> preferred_height_;
+  bool rebuild_scheduled_ = false;
+  base::WeakPtrFactory<WorkspacePinnedSectionView> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_WORKSPACE_PINNED_SECTION_VIEW_H_
