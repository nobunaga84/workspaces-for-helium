+using workspaces::pins::PinNode;
+
+// Per nesting level, and on each side of a row.
+constexpr int kIndent = 16;
+constexpr int kRowInset = 8;
+
+std::u16string RowText(const PinNode& node) {
+  const std::string& text = !node.custom_title.empty() ? node.custom_title
+                            : !node.title.empty()      ? node.title
+                                                       : node.url;
+  return base::UTF8ToUTF16(text);
+}
+
+// One row: a folder (its icon shows open or closed) or an item (its page's
+// icon, a globe until one is found). Only the icon of a DRAWN row is looked
+// up, so a closed folder asks nothing.
+class PinRow : public views::LabelButton {
+  METADATA_HEADER(PinRow, views::LabelButton)
+
+ public:
+  PinRow(const PinNode& node,
+         int level,
+         Profile* profile,
+         bool frame_active,
+         views::Button::PressedCallback callback)
+      : views::LabelButton(std::move(callback), RowText(node)),
+        id_(node.id),
+        folder_(node.type == PinNode::Type::kFolder),
+        open_(node.open) {
+    SetTooltipText(folder_ ? RowText(node)
+                           : base::StrCat({RowText(node), u"\n",
+                                           base::UTF8ToUTF16(node.url)}));
+    SetBorder(views::CreateEmptyBorder(
+        gfx::Insets::TLBR(0, kRowInset + level * kIndent, 0, kRowInset)));
+    SetMinSize(
+        gfx::Size(0, GetLayoutConstant(LayoutConstant::kVerticalTabHeight)));
+    // No opaque background under the text, as on the rail's buttons.
+    label()->SetSubpixelRenderingEnabled(false);
+    // The ring drawn inside: the rows sit in a clipping scroll view (E13).
+    views::FocusRing::Get(this)->SetOutsetFocusRingDisabled(true);
+    ConfigureInkDrop(this);
+    // A tree to assistive tech (design 5): an item at its level, a folder
+    // expanded or collapsed; the arrow keys move and open (OnKeyPressed).
+    GetViewAccessibility().SetRole(ax::mojom::Role::kTreeItem);
+    GetViewAccessibility().SetHierarchicalLevel(level + 1);
+
+    if (folder_) {
+      if (open_) {
+        GetViewAccessibility().SetIsExpanded();
+      } else {
+        GetViewAccessibility().SetIsCollapsed();
+      }
+      vector_icon_ = open_ ? &vector_icons::kFolderOpenIcon
+                           : &vector_icons::kFolderFlippableIcon;
+      SetFrameActive(frame_active);
+      return;
+    }
+    vector_icon_ = &vector_icons::kGlobeIcon;
+    SetFrameActive(frame_active);
+    // With fallback_to_host: most items were never visited in this profile,
+    // but another page of the same site often was (LOCAL.md 43).
+    if (favicon::FaviconService* const favicons =
+            FaviconServiceFactory::GetForProfile(
+                profile, ServiceAccessType::EXPLICIT_ACCESS)) {
+      favicons->GetRawFaviconForPageURL(
+          GURL(node.url), {favicon_base::IconType::kFavicon},
+          gfx::kFaviconSize * 2, /*fallback_to_host=*/true,
+          // Unretained: `favicon_tasks_` is a member, so a row destroyed first
+          // cancels its own request.
+          base::BindOnce(&PinRow::OnFavicon, base::Unretained(this)),
+          &favicon_tasks_);
+    }
+  }
+  PinRow(const PinRow&) = delete;
+  PinRow& operator=(const PinRow&) = delete;
+  ~PinRow() override = default;
+
+  const std::string& id() const { return id_; }
+
+  // Tabs dim in a window that is not the active one, and so do the rows.
+  void SetFrameActive(bool active) {
+    const ui::ColorId color = active ? kColorTabForegroundInactiveFrameActive
+                                     : kColorTabForegroundInactiveFrameInactive;
+    SetEnabledTextColors(color);
+    if (vector_icon_) {
+      SetImageModel(views::Button::STATE_NORMAL,
+                    ui::ImageModel::FromVectorIcon(*vector_icon_, color,
+                                                   gfx::kFaviconSize));
+    }
+  }
+
+  // views::View:
+  //
+  // Up and Down move between rows; Right opens a closed folder and Left closes
+  // an open one. Enter and Space stay the button's.
+  bool OnKeyPressed(const ui::KeyEvent& event) override {
+    switch (event.key_code()) {
+      case ui::VKEY_UP:
+      case ui::VKEY_DOWN: {
+        const views::View::Views& rows = parent()->children();
+        const auto it = std::ranges::find(rows, this);
+        if (event.key_code() == ui::VKEY_UP ? it != rows.begin()
+                                            : std::next(it) != rows.end()) {
+          (event.key_code() == ui::VKEY_UP ? *std::prev(it) : *std::next(it))
+              ->RequestFocus();
+        }
+        return true;
+      }
+      case ui::VKEY_LEFT:
+      case ui::VKEY_RIGHT:
+        if (folder_ && open_ == (event.key_code() == ui::VKEY_LEFT)) {
+          NotifyClick(event);
+        }
+        return true;
+      default:
+        return views::LabelButton::OnKeyPressed(event);
+    }
+  }
+  // A pane (F6) registers the arrow keys as its own shortcuts, and views runs
+  // those BEFORE the focused view sees the key: without this, Right and Left on
+  // a folder moved the focus instead of opening or closing it (the owner's
+  // check of E15b). Up and Down stay the pane's, which carry on into the tabs.
+  bool SkipDefaultKeyEventProcessing(const ui::KeyEvent& event) override {
+    return (folder_ && (event.key_code() == ui::VKEY_LEFT ||
+                        event.key_code() == ui::VKEY_RIGHT)) ||
+           views::LabelButton::SkipDefaultKeyEventProcessing(event);
+  }
+
+ private:
+  // Asked for at twice the icon size, so it is crisp at 200 %.
+  void OnFavicon(const favicon_base::FaviconRawBitmapResult& result) {
+    if (!result.is_valid()) {
+      return;
+    }
+    const SkBitmap bitmap = gfx::PNGCodec::Decode(
+        base::span<const uint8_t>(*result.bitmap_data));
+    if (bitmap.isNull()) {
+      return;
+    }
+    // The page's own icon from now on: SetFrameActive leaves it alone.
+    vector_icon_ = nullptr;
+    SetImageModel(views::Button::STATE_NORMAL,
+                  ui::ImageModel::FromImageSkia(gfx::ImageSkia::CreateFromBitmap(
+                      bitmap, static_cast<float>(bitmap.width()) /
+                                  gfx::kFaviconSize)));
+  }
+
+  const std::string id_;
+  const bool folder_;
+  const bool open_;
+  // The icon drawn in the text color; null once the page's own icon arrived.
+  raw_ptr<const gfx::VectorIcon> vector_icon_ = nullptr;
+  base::CancelableTaskTracker favicon_tasks_;
+};
+
