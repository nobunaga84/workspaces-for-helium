+WorkspacePinnedSectionView::WorkspacePinnedSectionView(
+    BrowserWindowInterface* browser,
+    tabs::VerticalTabStripStateController* state_controller)
+    : browser_(browser), state_controller_(state_controller) {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+                       views::BoxLayout::Orientation::kVertical))
+      ->set_inside_border_insets(gfx::Insets::TLBR(0, 0, 4, 0));
+  SetVisible(false);
+}
+
+WorkspacePinnedSectionView::~WorkspacePinnedSectionView() = default;
+
+void WorkspacePinnedSectionView::AddedToWidget() {
+  views::View::AddedToWidget();
+  // Once: a view can be added to a widget again.
+  if (!store_) {
+    Profile* const profile = browser_->GetProfile();
+    store_ = workspaces::pins::PinStore::GetOrCreate(profile,
+                                                     profile->GetPath());
+    store_observation_.Observe(store_.get());
+    // Unretained: the subscriptions are members, cancelled with this view.
+    if (workspaces::WorkspaceService* const service =
+            workspaces::WorkspaceService::From(browser_)) {
+      workspace_changed_subscription_ =
+          service->RegisterWorkspaceChangedCallback(base::BindRepeating(
+              &WorkspacePinnedSectionView::ScheduleRebuild,
+              base::Unretained(this)));
+      // Also how the settings toggle arrives (OnEnabledChanged).
+      workspace_list_changed_subscription_ =
+          service->RegisterWorkspaceListChangedCallback(base::BindRepeating(
+              &WorkspacePinnedSectionView::ScheduleRebuild,
+              base::Unretained(this)));
+    }
+    if (state_controller_) {
+      collapse_changed_subscription_ =
+          state_controller_->RegisterOnCollapseChanged(base::BindRepeating(
+              &WorkspacePinnedSectionView::OnCollapseChanged,
+              base::Unretained(this)));
+    }
+  }
+  paint_as_active_subscription_ =
+      GetWidget()->RegisterPaintAsActiveChangedCallback(base::BindRepeating(
+          &WorkspacePinnedSectionView::UpdateRowColors,
+          base::Unretained(this)));
+  ScheduleRebuild();
+}
+
+void WorkspacePinnedSectionView::RemovedFromWidget() {
+  paint_as_active_subscription_ = {};
+  views::View::RemovedFromWidget();
+}
+
+void WorkspacePinnedSectionView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  // A font change is a theme change: measure again.
+  preferred_height_.reset();
+  PreferredSizeChanged();
+}
+
+gfx::Size WorkspacePinnedSectionView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  // Measured once per rebuild: every row is one line at a fixed height, so the
+  // answer cannot change until the rows do. A bounded width is never cached by
+  // the layout manager (LayoutManagerBase::GetPreferredSize), so without this
+  // every strip layout asked each of the 1,313 rows (E15b review).
+  if (!preferred_height_) {
+    preferred_height_ =
+        views::View::CalculatePreferredSize(available_size).height();
+  }
+  return gfx::Size(0, *preferred_height_);
+}
+
+void WorkspacePinnedSectionView::OnPinsChanged() {
+  ScheduleRebuild();
+}
+
+void WorkspacePinnedSectionView::ScheduleRebuild() {
+  if (rebuild_scheduled_) {
+    return;
+  }
+  rebuild_scheduled_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&WorkspacePinnedSectionView::Rebuild,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void WorkspacePinnedSectionView::Rebuild() {
+  rebuild_scheduled_ = false;
+  const base::ElapsedTimer timer;
+  // The row with keyboard focus keeps it across the rebuild, so a folder
+  // opened or closed from the keyboard stays under the cursor (E15b review).
+  std::string focused_id;
+  if (const views::FocusManager* const focus = GetFocusManager()) {
+    const views::View* const focused = focus->GetFocusedView();
+    if (focused && Contains(focused)) {
+      if (const auto* const row = views::AsViewClass<PinRow>(focused)) {
+        focused_id = row->id();
+      }
+    }
+  }
+  // Cleared BEFORE the views go: `list_` would dangle across the delete.
+  list_ = nullptr;
+  preferred_height_.reset();
+  RemoveAllChildViews();
+
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  std::vector<const PinNode*> roots;
+  if (service && service->IsEnabled() && store_ && store_->loaded() &&
+      !(state_controller_ && state_controller_->IsCollapsed())) {
+    roots = workspaces::pins::RootsForWorkspace(
+        store_->tree(), service->active_guid(), service->known_guids());
+  }
+  SetVisible(!roots.empty());
+  if (roots.empty()) {
+    return;
+  }
+
+  // Built OFF the widget, then attached as one child. Every child added to or
+  // removed from a view in the widget makes views walk the whole layer subtree
+  // of its nearest layered ancestor (View::ReorderLayers) -- here the scroll
+  // view's contents, which holds every tab of the strip as well -- so rows
+  // added one by one cost rows x everything: 1,313 rows took 5.3 s at the E15b
+  // gate. Detached, an add walks nothing; attached once, the walk runs once.
+  auto list = std::make_unique<views::View>();
+  list->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+  const bool frame_active = IsFrameActive();
+  size_t rows = 0;
+  for (const PinNode* root : roots) {
+    rows += AddRow(*list, *root, /*level=*/0, frame_active);
+  }
+  list_ = AddChildView(std::move(list));
+  AddChildView(std::make_unique<views::Separator>());
+  if (!focused_id.empty()) {
+    for (views::View* const child : list_->children()) {
+      if (views::AsViewClass<PinRow>(child)->id() == focused_id) {
+        child->RequestFocus();
+        break;
+      }
+    }
+  }
+  LOG(INFO) << "[workspaces] pins: drew " << rows << " row(s) of '"
+            << service->active_guid() << "' in "
+            << timer.Elapsed().InMilliseconds() << " ms";
+}
+
+size_t WorkspacePinnedSectionView::AddRow(views::View& list,
+                                          const PinNode& row,
+                                          int level,
+                                          bool frame_active) {
+  views::Button::PressedCallback callback;
+  if (row.type == PinNode::Type::kFolder) {
+    // The id only: the folder's state is read when it is clicked, since
+    // another window may have opened or closed it since this row was made.
+    callback = base::BindRepeating(&WorkspacePinnedSectionView::OnFolderPressed,
+                                   base::Unretained(this), row.id);
+  }
+  list.AddChildView(std::make_unique<PinRow>(
+      row, level, browser_->GetProfile(), frame_active, std::move(callback)));
+  size_t count = 1;
+  if (row.type == PinNode::Type::kFolder && row.open) {
+    for (const PinNode& child : row.children) {
+      count += AddRow(list, child, level + 1, frame_active);
+    }
+  }
+  return count;
+}
+
+void WorkspacePinnedSectionView::OnFolderPressed(const std::string& id) {
+  if (store_) {
+    store_->ToggleFolder(id);
+  }
+}
+
+bool WorkspacePinnedSectionView::IsFrameActive() const {
+  return GetWidget() ? GetWidget()->ShouldPaintAsActive() : true;
+}
+
+void WorkspacePinnedSectionView::UpdateRowColors() {
+  if (!list_) {
+    return;
+  }
+  const bool frame_active = IsFrameActive();
+  for (views::View* const child : list_->children()) {
+    views::AsViewClass<PinRow>(child)->SetFrameActive(frame_active);
+  }
+}
+
+void WorkspacePinnedSectionView::OnCollapseChanged(
+    tabs::VerticalTabStripCollapseState state) {
+  ScheduleRebuild();
+}
