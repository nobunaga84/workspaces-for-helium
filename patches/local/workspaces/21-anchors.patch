+bool WorkspaceService::IsAnchored(const tabs::TabInterface* tab) const {
+  return tab && !AnchorUrlForTab(tab->GetContents()).empty();
+}
+
+void WorkspaceService::SetAnchored(tabs::TabInterface* tab, bool anchored) {
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return;
+  }
+  WorkspaceTabData* const data =
+      WorkspaceTabData::GetOrCreateForWebContents(contents);
+  data->set_anchor_url(anchored ? contents->GetLastCommittedURL().spec()
+                                : std::string());
+  PersistTag(contents);
+  LOG(INFO) << "[workspaces] anchor at index " << tab_strip_->GetIndexOfTab(tab)
+            << " -> '" << data->anchor_url() << "'";
+}
+
+void WorkspaceService::ResetToAnchor(tabs::TabInterface* tab) {
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return;
+  }
+  const GURL anchor(AnchorUrlForTab(contents));
+  if (!anchor.is_valid() || contents->GetLastCommittedURL() == anchor) {
+    return;
+  }
+  contents->GetController().LoadURL(anchor, content::Referrer(),
+                                    ui::PAGE_TRANSITION_TYPED, std::string());
+  LOG(INFO) << "[workspaces] reset to anchor '" << anchor.spec() << "'";
+}
+
+bool WorkspaceService::HibernateAnchoredTab(tabs::TabInterface* tab,
+                                            DiscardFn discard) {
+  if (!tab || !IsAnchored(tab) || tab->IsSplit()) {
+    return false;
+  }
+  content::WebContents* const contents = tab->GetContents();
+  const int index = tab_strip_->GetIndexOfTab(tab);
+  if (!contents || index == TabStripModel::kNoTab) {
+    return false;
+  }
+  if (contents->WasDiscarded()) {
+    // Already asleep. Consumed rather than closed: an anchor leaves only by
+    // being unanchored.
+    return true;
+  }
+
+  // Move activation away first, from this command, never from an observer
+  // (design 2.2). Candidates are the other tabs drawn in the active
+  // workspace, outside collapsed groups; the walk is the tested helper
+  // SelectRelativeTab used before M153 gave it its own bounded loop.
+  if (index == tab_strip_->active_index()) {
+    std::vector<bool> selectable;
+    selectable.reserve(static_cast<size_t>(tab_strip_->count()));
+    for (int i = 0; i < tab_strip_->count(); ++i) {
+      selectable.push_back(i != index && !tab_strip_->IsTabCollapsed(i) &&
+                           IsTabVisible(tab_strip_->GetTabAtIndex(i)));
+    }
+    const int fallback = NextVisibleTabIndex(selectable, index, 1);
+    if (fallback == index) {
+      // Nothing else to show in this workspace: spawn one, the way switching
+      // into an empty workspace does. StampInsertedTab tags it as it lands.
+      tab_strip_->delegate()->AddTabAt(GURL(), -1, /*foreground=*/true);
+    } else {
+      tab_strip_->ActivateTabAt(
+          fallback, TabStripUserGestureDetails(
+                        TabStripUserGestureDetails::GestureType::kOther));
+    }
+    if (tab_strip_->active_index() == index) {
+      return false;
+    }
+  }
+
+  // Copied out before the discard: `contents` does not survive it. The
+  // replacement observer carries tag and anchor onto the new contents.
+  const GURL anchor(AnchorUrlForTab(contents));
+  content::WebContents* const discarded = discard(contents);
+  if (!discarded) {
+    LOG(INFO) << "[workspaces] anchored tab at index " << index
+              << " could not be discarded; kept live";
+    return true;
+  }
+  if (content::NavigationEntry* const entry =
+          discarded->GetController().GetLastCommittedEntry();
+      entry && anchor.is_valid()) {
+    entry->SetURL(anchor);
+    entry->SetVirtualURL(anchor);
+  }
+  LOG(INFO) << "[workspaces] hibernated anchored tab at index " << index
+            << " -> '" << anchor.spec() << "'";
+  return true;
+}
+
 }  // namespace workspaces
