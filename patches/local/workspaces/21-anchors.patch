+#ifndef CHROME_BROWSER_UI_TABS_WORKSPACE_ANCHOR_SUB_MENU_MODEL_H_
+#define CHROME_BROWSER_UI_TABS_WORKSPACE_ANCHOR_SUB_MENU_MODEL_H_
+
+#include "base/memory/raw_ptr.h"
+#include "ui/menus/simple_menu_model.h"
+
+class BrowserWindowInterface;
+class TabStripModel;
+
+namespace tabs {
+class TabInterface;
+}
+
+// The "Anchor" tab-menu submenu (design 5, E10 spec): anchor the right-clicked
+// tab at its page or unanchor it, go back to the anchor, or move the anchor to
+// the page it is showing now. Its own delegate, like
+// ExistingWorkspaceSubMenuModel, so TabStripModel needs no command plumbing
+// beyond the parent id. Acts on the right-clicked tab only: an anchor is a
+// property of one tab, not of a selection.
+class WorkspaceAnchorSubMenuModel : public ui::SimpleMenuModel,
+                                    public ui::SimpleMenuModel::Delegate {
+ public:
+  WorkspaceAnchorSubMenuModel(BrowserWindowInterface* browser,
+                              TabStripModel* tab_strip,
+                              int context_index);
+  WorkspaceAnchorSubMenuModel(const WorkspaceAnchorSubMenuModel&) = delete;
+  WorkspaceAnchorSubMenuModel& operator=(const WorkspaceAnchorSubMenuModel&) =
+      delete;
+  ~WorkspaceAnchorSubMenuModel() override;
+
+  static bool ShouldShowSubmenu(BrowserWindowInterface* browser);
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+  bool IsCommandIdEnabled(int command_id) const override;
+
+ private:
+  tabs::TabInterface* ContextTab() const;
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<TabStripModel> tab_strip_;
+  const int context_index_;
+};
+
+#endif  // CHROME_BROWSER_UI_TABS_WORKSPACE_ANCHOR_SUB_MENU_MODEL_H_
