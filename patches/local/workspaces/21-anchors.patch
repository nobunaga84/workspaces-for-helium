+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/workspace_anchor_sub_menu_model.h"
+
+#include <string>
+
+#include "chrome/browser/ui/tabs/existing_base_sub_menu_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/workspaces/workspace_service.h"
+#include "chrome/browser/ui/tabs/workspaces/workspace_session_data.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+
+// Three fixed items in the registry range ExistingBaseSubMenuModel keeps
+// (LOCAL.md 21 is why a submenu never picks its own ids).
+constexpr int kToggleAnchor =
+    ExistingBaseSubMenuModel::kMinWorkspaceAnchorCommandId;
+constexpr int kResetToAnchor = kToggleAnchor + 1;
+constexpr int kReplaceAnchor = kToggleAnchor + 2;
+
+// Whether the tab has wandered off its anchor -- the only state in which
+// "go back" and "move anchor here" do anything.
+bool HasDrifted(const tabs::TabInterface* tab) {
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return false;
+  }
+  const std::string anchor = workspaces::AnchorUrlForTab(contents);
+  return !anchor.empty() && contents->GetLastCommittedURL().spec() != anchor;
+}
+
+}  // namespace
+
+WorkspaceAnchorSubMenuModel::WorkspaceAnchorSubMenuModel(
+    BrowserWindowInterface* browser,
+    TabStripModel* tab_strip,
+    int context_index)
+    : ui::SimpleMenuModel(this),
+      browser_(browser),
+      tab_strip_(tab_strip),
+      context_index_(context_index) {
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  const bool anchored = service && service->IsAnchored(ContextTab());
+  AddItemWithStringId(kToggleAnchor, anchored
+                                         ? IDS_HELIUM_WORKSPACE_UNANCHOR_TAB
+                                         : IDS_HELIUM_WORKSPACE_ANCHOR_TAB);
+  AddItemWithStringId(kResetToAnchor, IDS_HELIUM_WORKSPACE_RESET_TO_ANCHOR);
+  AddItemWithStringId(kReplaceAnchor, IDS_HELIUM_WORKSPACE_REPLACE_ANCHOR);
+}
+
+WorkspaceAnchorSubMenuModel::~WorkspaceAnchorSubMenuModel() = default;
+
+// static
+bool WorkspaceAnchorSubMenuModel::ShouldShowSubmenu(
+    BrowserWindowInterface* browser) {
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser);
+  return service && service->IsEnabled();
+}
+
+tabs::TabInterface* WorkspaceAnchorSubMenuModel::ContextTab() const {
+  return tab_strip_->ContainsIndex(context_index_)
+             ? tab_strip_->GetTabAtIndex(context_index_)
+             : nullptr;
+}
+
+bool WorkspaceAnchorSubMenuModel::IsCommandIdEnabled(int command_id) const {
+  tabs::TabInterface* const tab = ContextTab();
+  const workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!tab || !service) {
+    return false;
+  }
+  switch (command_id) {
+    case kToggleAnchor:
+      // Unanchoring is always allowed; anchoring declines a split, as Ctrl+W
+      // on a split closes rather than hibernates (design 5).
+      return service->IsAnchored(tab) || !tab->IsSplit();
+    case kResetToAnchor:
+    case kReplaceAnchor:
+      return HasDrifted(tab);
+    default:
+      return false;
+  }
+}
+
+void WorkspaceAnchorSubMenuModel::ExecuteCommand(int command_id,
+                                                 int event_flags) {
+  tabs::TabInterface* const tab = ContextTab();
+  workspaces::WorkspaceService* const service =
+      workspaces::WorkspaceService::From(browser_);
+  if (!tab || !service) {
+    return;
+  }
+  switch (command_id) {
+    case kToggleAnchor:
+      service->SetAnchored(tab, !service->IsAnchored(tab));
+      break;
+    case kResetToAnchor:
+      service->ResetToAnchor(tab);
+      break;
+    case kReplaceAnchor:
+      // Re-anchoring at the current page is exactly "anchor here".
+      service->SetAnchored(tab, true);
+      break;
+    default:
+      break;
+  }
+}
