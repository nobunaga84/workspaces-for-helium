+void WorkspaceService::OnEnabledChanged() {
+  // The pref is logged, not IsEnabled(), because the two answer different
+  // questions and only one of them just changed: in a classic-layout window
+  // IsEnabled() stays false through a flip in either direction, and a line
+  // reading "enabled -> false" for a switch the user had just turned ON is
+  // exactly the class of small lie LOCAL.md 22 is about. Both are printed, so
+  // the log tells "off" apart from "on, but not vertical in this window".
+  LOG(INFO) << "[workspaces] enabled pref -> "
+            << (prefs_->GetBoolean(prefs::kHeliumWorkspacesEnabled) ? "true"
+                                                                    : "false")
+            << ", feature " << (IsEnabled() ? "on" : "off")
+            << " in this window";
+
+  // Everything that has to be re-read here is already reachable from the two
+  // notifications a list change fires: the rail re-runs IsEnabled() inside
+  // Rebuild(), and the visibility predicate re-runs per tab on the next
+  // layout. Reusing that path rather than a second one of our own keeps
+  // "something about workspaces changed, redraw" in a single place. Refreshing
+  // known_guids_ on the way through is a no-op, not a cost worth a branch.
+  OnWorkspaceListChanged();
+
+  // Switching the feature back ON can leave the active tab hidden. While it
+  // was off every tab was visible, so the user could select one belonging to
+  // some other workspace, and SetActiveWorkspace() is gated -- so active_guid_
+  // did not follow it. Nothing else re-checks afterwards: OnSelectionChanged()
+  // asks only at the moment of selection, which was while the gate was shut.
+  //
+  // Posted rather than called, for the reason OnWorkspaceListChanged() gives
+  // where it does the same thing: a pref observer can be reached from inside a
+  // TabStripModel notification, and activating a tab there would trip the
+  // re-entrancy CHECK (design 2.2). A no-op when the feature is off, when the
+  // strip is empty, or when the active tab is already on screen.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&WorkspaceService::EnsureActiveTabVisible,
+                                weak_factory_.GetWeakPtr()));
+}
