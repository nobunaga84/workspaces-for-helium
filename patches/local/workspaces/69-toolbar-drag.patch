+
+  // ui::EventHandler: views starts no drag from a disabled view -- Forward
+  // with nowhere to go, Back on a new tab -- so the toolbar starts it, as
+  // View::ProcessMouseDragged would.
+  void OnMouseEvent(ui::MouseEvent* event) override {
+    auto* const view = static_cast<views::View*>(event->target());
+    const bool ours = !view->GetEnabled() && view->drag_controller() == this;
+    if (event->type() == ui::EventType::kMousePressed) {
+      disabled_press_ = ours && event->IsOnlyLeftMouseButton()
+                            ? std::make_optional(event->location())
+                            : std::nullopt;
+      // Taken here: a disabled button does not take it, and the press -- and
+      // with it the moves that follow -- would go on to the toolbar.
+      if (disabled_press_) {
+        event->SetHandled();
+      }
+      return;
+    }
+    if (!ours || event->type() != ui::EventType::kMouseDragged ||
+        !disabled_press_ ||
+        !views::View::ExceededDragThreshold(event->location() -
+                                            *disabled_press_) ||
+        !CanStartDragForView(view, *disabled_press_, event->location()) ||
+        !GetDragOperationsForView(view, *disabled_press_) ||
+        view->GetWidget()->dragged_view()) {
+      return;
+    }
+    auto data = std::make_unique<ui::OSExchangeData>();
+    WriteDragDataForView(view, *disabled_press_, data.get());
+    disabled_press_.reset();
+    gfx::Point location = event->location();
+    views::View::ConvertPointToWidget(view, &location);
+    event->StopPropagation();
+    // Blocks until the drop; this window may be gone after it.
+    view->GetWidget()->RunDragDropLoop(view, std::move(data), location,
+                                       ui::DragDropTypes::DRAG_MOVE,
+                                       ui::mojom::DragEventSource::kMouse);
+  }
+
+  // views::ViewObserver:
+  void OnViewHierarchyWillBeDeleted(views::View*) override {
+    registrar_.RemoveAll();
+    event_observation_.Reset();
+    view_observation_.Reset();
+  }
+
+  // The toolbar as the drop target of its own buttons (ToolbarView's
+  // forwarders).
+  bool CanDrop(const ui::OSExchangeData& data) {
+    return data.HasCustomFormat(DragFormat()) &&
+           UnitName(Unit(DraggedView()));
+  }
+
+  int OnDragUpdated(const ui::DropTargetEvent& event) {
+    views::View* const dragged = Unit(DraggedView());
+    const std::optional<std::string> name = UnitName(dragged);
+    if (!name) {
+      return ui::DragDropTypes::DRAG_NONE;
+    }
+    // Between the other buttons drawn either side of the pointer, each
+    // passed at its middle -- the address bar too.
+    std::string after;
+    std::string before;
+    for (views::View* child : toolbar_->children()) {
+      const std::optional<std::string> anchor =
+          child == dragged || !child->GetVisible() ? std::nullopt
+                                                   : UnitName(child);
+      if (!anchor) {
+        continue;
+      }
+      if ((child->GetMirroredBounds().CenterPoint().x() > event.x()) !=
+          base::i18n::IsRTL()) {
+        before = *anchor;
+        break;
+      }
+      after = *anchor;
+    }
+    // The preview: the button itself moves there while the drag goes on.
+    std::vector<std::string> preview = toolbar_order::Dropped(
+        Order(), PinnedNames(toolbar_->browser()->GetProfile()),
+        *name, after, before);
+    if (preview != preview_) {
+      preview_ = std::move(preview);
+      Lay();
+    }
+    return ui::DragDropTypes::DRAG_MOVE;
+  }
+
+  void OnDragExited() {
+    // Out of the toolbar, or Escape: the saved order again.
+    if (!preview_.empty()) {
+      preview_.clear();
+      toolbar_->UpdateToolbarLayout();
+    }
+  }
+
+  views::View::DropCallback GetDropCallback() {
+    if (preview_.empty()) {
+      return base::NullCallback();
+    }
+    return base::BindOnce(&ToolbarOrderController::Save,
+                          weak_factory_.GetWeakPtr(),
+                          std::exchange(preview_, {}));
+  }
+
+ private:
+  // The saved order, or Helium's own while nothing is saved (as Place).
+  std::vector<std::string> Order() const {
+    std::vector<std::string> saved = SavedOrder(prefs_);
+    return saved.empty() ? helium_order_ : saved;
+  }
+
+  // The toolbar child `view` is part of: itself, or the extensions box for
+  // its puzzle piece. Null outside the toolbar.
+  views::View* Unit(views::View* view) const {
+    while (view && view->parent() != toolbar_) {
+      view = view->parent();
+    }
+    return view;
+  }
+
+  // The name `unit` is dragged and dropped by, if it is placed on its own --
+  // not Collapse by the sidebar, where Helium keeps it.
+  std::optional<std::string> UnitName(views::View* unit) const {
+    std::optional<std::string> name = unit ? ChildName(unit) : std::nullopt;
+    if (name == toolbar_order::kCollapse && collapse_by_sidebar_) {
+      return std::nullopt;
+    }
+    return name;
+  }
+
+  // The view being dragged from this window, if any.
+  views::View* DraggedView() const {
+    views::Widget* const widget = toolbar_->GetWidget();
+    return widget ? widget->dragged_view() : nullptr;
+  }
+
+  // As CustomizeToolbarHandler::SetToolbarOrder: the list, then the pinned
+  // box's own order, so the two read the same. Settings' Toolbar list and
+  // every window redraw from the prefs.
+  void Save(std::vector<std::string> order,
+            const ui::DropTargetEvent& event,
+            ui::mojom::DragOperation& output_drag_op,
+            std::unique_ptr<ui::LayerTreeOwner> drag_image_layer_owner) {
+    output_drag_op = ui::mojom::DragOperation::kMove;
+    Profile* const profile = toolbar_->browser()->GetProfile();
+    if (order == toolbar_order::Complete(Order(), PinnedNames(profile))) {
+      LOG(INFO) << "[workspaces] toolbar drag: dropped where it was";
+      toolbar_->UpdateToolbarLayout();
+      return;
+    }
+    LOG(INFO) << "[workspaces] toolbar drag: dropped, order saved";
+    base::ListValue list;
+    for (const std::string& name : order) {
+      list.Append(name);
+    }
+    prefs_->SetList(prefs::kHeliumWorkspacesToolbarOrder, std::move(list));
+    PinnedToolbarActionsModel* const model =
+        PinnedToolbarActionsModel::Get(profile);
+    int index = 0;
+    for (const std::string& name : order) {
+      const std::optional<actions::ActionId> id =
+          actions::ActionIdMap::StringToActionId(name);
+      if (id && model->Contains(*id)) {
+        model->MovePinnedAction(*id, index++);
+      }
+    }
+  }
+
+  const raw_ptr<ToolbarView> toolbar_;
+  const raw_ptr<PrefService> prefs_;
+  // NamedOrder on the first layout, when this is made.
+  const std::vector<std::string> helium_order_;
+  PrefChangeRegistrar registrar_;
+  bool collapse_by_sidebar_ = false;
+  // Where a disabled button was pressed, until its drag starts.
+  std::optional<gfx::Point> disabled_press_;
+  // What a drop now would save; empty while no drag is over the toolbar.
+  std::vector<std::string> preview_;
+  base::ScopedObservation<ui::EventTarget, ui::EventHandler>
+      event_observation_{this};
+  base::ScopedObservation<views::View, views::ViewObserver> view_observation_{
+      this};
+  base::WeakPtrFactory<ToolbarOrderController> weak_factory_{this};
+};
+
+}  // namespace workspaces
+
+DEFINE_UI_CLASS_PROPERTY_TYPE(workspaces::ToolbarOrderController*)
+
+namespace workspaces {
+
+namespace {
+
+DEFINE_OWNED_UI_CLASS_PROPERTY_KEY(ToolbarOrderController,
+                                   kToolbarOrderControllerKey)
+
+}  // namespace
+
+void ApplyToolbarOrder(ToolbarView* toolbar) {
+  BrowserWindowInterface* const browser = toolbar->browser();
+  if (!browser || browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return;
+  }
+  Profile* const profile = browser->GetProfile();
+  // The regular profile's prefs, also for an incognito window: the order is
+  // saved there, and its changes reach this window's controller directly.
+  PrefService* const pref_service = profile->GetOriginalProfile()->GetPrefs();
+  ToolbarOrderController* controller =
+      toolbar->GetProperty(kToolbarOrderControllerKey);
+  const bool first_layout = !controller;
+  if (first_layout) {
+    controller = toolbar->SetProperty(
+        kToolbarOrderControllerKey,
+        std::make_unique<ToolbarOrderController>(toolbar, pref_service));
+    // Wish 6b: the pinned box lends its buttons to the toolbar, which places
+    // each one on its own; a pin or unpin lays the toolbar out again.
+    const auto box_view = FindById(toolbar->children(),
+                                   kPinnedToolbarActionsContainerElementId);
+    if (auto* box = box_view == toolbar->children().end()
+                        ? nullptr
+                        : views::AsViewClass<PinnedToolbarActionsContainer>(
+                              box_view->get())) {
+      box->SetButtonHost(
+          toolbar, base::BindRepeating(&ToolbarView::UpdateToolbarLayout,
+                                       base::Unretained(toolbar)));
+    }
+  }
+  // Helium's UpdateToolbarLayout has just put Collapse first, or right after
+  // the menu when vertical tabs are on the right.
+  controller->set_collapse_by_sidebar(
+      FindById(toolbar->children(),
+               kToolbarVerticalTabsCollapseButtonElementId) >
+      FindById(toolbar->children(), kToolbarAppMenuButtonElementId));
+  controller->Lay();
+  // Off the record the toolbar follows the order but cannot change it, as
+  // with Chrome's own pinning (PinnedToolbarActionsModel::CanUpdate).
+  if (!profile->IsOffTheRecord()) {
+    controller->Adopt();
+  }
+}
+
+bool CanDropOnToolbar(ToolbarView* toolbar, const ui::OSExchangeData& data) {
+  ToolbarOrderController* const controller =
+      toolbar->GetProperty(kToolbarOrderControllerKey);
+  return controller && controller->CanDrop(data);
+}
+
+int OnToolbarDragUpdated(ToolbarView* toolbar,
+                         const ui::DropTargetEvent& event) {
+  ToolbarOrderController* const controller =
+      toolbar->GetProperty(kToolbarOrderControllerKey);
+  return controller ? controller->OnDragUpdated(event)
+                    : ui::DragDropTypes::DRAG_NONE;
+}
+
+void OnToolbarDragExited(ToolbarView* toolbar) {
+  if (ToolbarOrderController* const controller =
+          toolbar->GetProperty(kToolbarOrderControllerKey)) {
+    controller->OnDragExited();
+  }
+}
+
+views::View::DropCallback GetToolbarDropCallback(ToolbarView* toolbar) {
+  ToolbarOrderController* const controller =
+      toolbar->GetProperty(kToolbarOrderControllerKey);
+  return controller ? controller->GetDropCallback() : base::NullCallback();
+}
+
 }  // namespace workspaces
