+    registrar_.Init(prefs);
+    // UpdateToolbarLayout, not ApplyToolbarOrder: Helium's own Collapse move
+    // runs first there, so the saved order always has the last word.
+    const base::RepeatingClosure relayout = base::BindRepeating(
+        &ToolbarView::UpdateToolbarLayout, base::Unretained(toolbar));
+    registrar_.Add(prefs::kHeliumWorkspacesToolbarOrder, relayout);
+    registrar_.Add(::prefs::kPinnedActions, relayout);
+    event_observation_.Observe(toolbar);
+    view_observation_.Observe(toolbar);
