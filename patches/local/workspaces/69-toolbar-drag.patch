+  // Puts the toolbar in the saved order -- or, while a drag is over it, in the
+  // order its drop would save, through any other relayout too.
+  void Lay() {
+    Place(toolbar_, preview_.empty() ? SavedOrder(prefs_) : preview_,
+          helium_order_, collapse_by_sidebar_);
