+#include "components/prefs/pref_registry_simple.h"
+
+namespace workspaces::prefs {
+
+void RegisterProfilePrefs(PrefRegistrySimple* registry) {
+  // Defaults on: this is a private fork built to run Workspaces, so there is
+  // nobody to opt in. The settings-page toggle lands in Stage 5 with the rest
+  // of the settings integration (helium-workspaces-design.md 3.4).
+  registry->RegisterBooleanPref(kHeliumWorkspacesEnabled, true);
+}
+
