+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/workspaces/workspace_prefs.h"
+
+#include "components/prefs/pref_service.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+// These tests deliberately use TestingPrefServiceSimple rather than
+// TestingProfile: that keeps this binary off //chrome/test:test_support, which
+// does not link in this fork (LOCAL.md 8). Keep it that way -- anything needing
+// a full Profile belongs in a different target.
+
+namespace workspaces::prefs {
+namespace {
+
+TEST(WorkspacePrefsTest, RegistersEnabledPref) {
+  TestingPrefServiceSimple pref_service;
+  RegisterProfilePrefs(pref_service.registry());
+
+  EXPECT_TRUE(pref_service.FindPreference(kHeliumWorkspacesEnabled));
+}
+
+TEST(WorkspacePrefsTest, EnabledDefaultsToTrue) {
+  TestingPrefServiceSimple pref_service;
+  RegisterProfilePrefs(pref_service.registry());
+
+  const PrefService::Preference* pref =
+      pref_service.FindPreference(kHeliumWorkspacesEnabled);
+  ASSERT_TRUE(pref);
+  EXPECT_TRUE(pref->IsDefaultValue());
+  EXPECT_TRUE(pref_service.GetBoolean(kHeliumWorkspacesEnabled));
+}
+
+TEST(WorkspacePrefsTest, EnabledIsWritable) {
+  TestingPrefServiceSimple pref_service;
+  RegisterProfilePrefs(pref_service.registry());
+
+  pref_service.SetBoolean(kHeliumWorkspacesEnabled, false);
+
+  EXPECT_FALSE(pref_service.GetBoolean(kHeliumWorkspacesEnabled));
+  EXPECT_FALSE(
+      pref_service.FindPreference(kHeliumWorkspacesEnabled)->IsDefaultValue());
+}
+
+// The pref name is written into every user profile the moment it is set, so it
+// is effectively permanent. Pin it.
+TEST(WorkspacePrefsTest, PrefNameIsStable) {
+  EXPECT_STREQ("helium.workspaces.enabled", kHeliumWorkspacesEnabled);
+}
+
+}  // namespace
+}  // namespace workspaces::prefs
