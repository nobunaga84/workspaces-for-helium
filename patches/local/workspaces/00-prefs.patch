+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_PREFS_H_
+#define CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_PREFS_H_
+
+class PrefRegistrySimple;
+
+namespace workspaces::prefs {
+
+// Whether Workspaces is active for this profile.
+//
+// Local-only by construction: this is registered on a PrefRegistrySimple and is
+// never added to the sync allowlist. Helium's vault syncs PREFERENCES only for
+// allow-listed prefs, and SESSIONS sync carries no per-tab extra_data -- so a
+// synced workspace list would arrive with tagless tabs, which is worse than not
+// syncing at all. See helium-workspaces-design.md 2.4.
+inline constexpr char kHeliumWorkspacesEnabled[] = "helium.workspaces.enabled";
+
+void RegisterProfilePrefs(PrefRegistrySimple* registry);
+
+}  // namespace workspaces::prefs
+
+#endif  // CHROME_BROWSER_UI_TABS_WORKSPACES_WORKSPACE_PREFS_H_
