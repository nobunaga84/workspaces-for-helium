+# Copyright 2026 The Helium Authors
+# You can use, redistribute, and/or modify this source code under
+# the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import("//testing/test.gni")
+
+# Pref declarations for Workspaces, deliberately split into their own leaf
+# target rather than living in the main workspaces target that arrives in E5.
+#
+# //chrome/browser/prefs:impl has to depend on this in order to register the
+# prefs at startup. The full workspaces target will itself depend on
+# //chrome/browser/ui/tabs:tab_strip, which reaches //chrome/browser/prefs. If
+# the pref declarations lived in that target, those two edges would close a
+# dependency cycle, and GN fails outright on a cycle rather than warning.
+#
+# Keeping this target a leaf -- no //chrome dependencies at all -- makes the
+# cycle impossible to form no matter what the workspaces target later grows. See
+# helium-workspaces-design.md 3.1.
+source_set("prefs") {
+  sources = [
+    "workspace_prefs.cc",
+    "workspace_prefs.h",
+  ]
+
+  deps = [ "//components/prefs" ]
+}
+
+source_set("unit_tests") {
+  testonly = true
+
+  sources = [ "workspace_prefs_unittest.cc" ]
+
+  deps = [
+    ":prefs",
+    "//components/prefs",
+    "//components/prefs:test_support",
+    "//testing/gtest",
+  ]
+}
+
+# A standalone test binary owned by this fork, deliberately NOT a source_set
+# folded into //chrome/test:unit_tests.
+#
+# That binary does not link here at all: the fork patches production APIs and
+# never updates Chromium's test doubles, and Helium CI builds no tests, so
+# several of them still call pre-patch signatures. //chrome/test:test_support
+# hard-depends on the broken ones, so nothing that links it can be built.
+# LOCAL.md 8 has the diagnosis.
+#
+# This target depends on none of that -- //base, //components/prefs and gtest
+# only -- so it is immune to that rot and stays cheap to run. The constraint it
+# imposes is a good one: logic reachable from here has to be expressible over
+# plain inputs rather than a live Profile or TabStripModel, which is the shape
+# the workspace decision logic should have anyway (design 3.10).
+#
+#   resume-build.ps1 -Targets workspaces_unittests
+#   out/Default/workspaces_unittests.exe
+test("workspaces_unittests") {
+  deps = [
+    ":unit_tests",
+    "//base/test:run_all_unittests",
+    "//testing/gtest",
+  ]
+}
