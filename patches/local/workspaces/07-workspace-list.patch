 namespace workspaces::prefs {
 
+namespace {
+
+// What every failure falls back to, and the only list this file ever invents.
+//
+// No title: naming the default workspace puts a user-visible string on screen,
+// which has to be localised and belongs with the Stage 5 rail that draws it.
+// An absent title already parses as an empty one.
+std::vector<WorkspaceEntry> DefaultOnly() {
+  return {WorkspaceEntry{std::string(kDefaultWorkspaceGuid), std::string()}};
+}
+
+bool ContainsGuid(const std::vector<WorkspaceEntry>& entries,
+                  std::string_view guid) {
+  for (const WorkspaceEntry& entry : entries) {
+    if (entry.guid == guid) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
 void RegisterProfilePrefs(PrefRegistrySimple* registry) {
   // Defaults on: this is a private fork built to run Workspaces, so there is
   // nobody to opt in. The settings-page toggle lands in Stage 5 with the rest
   // of the settings integration (helium-workspaces-design.md 3.4).
   registry->RegisterBooleanPref(kHeliumWorkspacesEnabled, true);
+
+  registry->RegisterDictionaryPref(kHeliumWorkspacesList, DefaultWorkspacesDict());
+}
+
+base::DictValue DefaultWorkspacesDict() {
+  base::DictValue entry;
+  entry.Set(kGuidKey, std::string(kDefaultWorkspaceGuid));
+
+  base::ListValue list;
+  list.Append(std::move(entry));
+
+  base::DictValue dict;
+  dict.Set(kSchemaVersionKey, kSchemaVersion);
+  dict.Set(kItemsKey, std::move(list));
+  return dict;
+}
+
+std::vector<WorkspaceEntry> ParseWorkspaces(const base::DictValue& dict) {
+  // An exact match rather than "at least kSchemaVersion". A version this build
+  // has never heard of was written by a newer one, and reading its list with
+  // this build's rules would quietly drop whatever that version added. Falling
+  // back costs the user one session of their list; guessing could cost them
+  // the list itself, because a later write would persist the guess.
+  if (dict.FindInt(kSchemaVersionKey).value_or(-1) != kSchemaVersion) {
+    return DefaultOnly();
+  }
+
+  const base::ListValue* const list = dict.FindList(kItemsKey);
+  if (!list) {
+    return DefaultOnly();
+  }
+
+  std::vector<WorkspaceEntry> entries;
+  for (const base::Value& element : *list) {
+    const base::DictValue* const entry = element.GetIfDict();
+    if (!entry) {
+      continue;
+    }
+
+    // The guid is the entry's identity -- there is nothing to tag a tab with
+    // without one. An empty guid is skipped rather than kept because empty
+    // already means "the default workspace" to IsVisibleInWorkspace, and the
+    // default workspace is guaranteed below in any case.
+    const std::string* const guid = entry->FindString(kGuidKey);
+    if (!guid || guid->empty() || ContainsGuid(entries, *guid)) {
+      continue;
+    }
+
+    const std::string* const title = entry->FindString(kTitleKey);
+    entries.push_back(WorkspaceEntry{*guid, title ? *title : std::string()});
+  }
+
+  if (entries.empty()) {
+    return DefaultOnly();
+  }
+
+  // The default workspace always exists (design 2.4), and this is where that
+  // is made true rather than merely assumed. A tab with no tag belongs to it,
+  // so a list without it leaves every untagged tab matching no workspace at
+  // all -- drawn nowhere, with no rail, menu or shortcut in this build that
+  // could bring it back. Prepending costs one entry; not prepending costs the
+  // user every tab they had not yet stamped.
+  if (!ContainsGuid(entries, kDefaultWorkspaceGuid)) {
+    entries.insert(entries.begin(), DefaultOnly().front());
+  }
+  return entries;
+}
+
+std::vector<std::string> GetWorkspaceGuids(const PrefService* prefs) {
+  const std::vector<WorkspaceEntry> entries =
+      prefs ? ParseWorkspaces(prefs->GetDict(kHeliumWorkspacesList))
+            : DefaultOnly();
+
+  std::vector<std::string> guids;
+  guids.reserve(entries.size());
+  for (const WorkspaceEntry& entry : entries) {
+    guids.push_back(entry.guid);
+  }
+  return guids;
 }
 
 }  // namespace workspaces::prefs
